@model ExchangeProofVM
@{
    ViewData["Title"] = Resource2.ExchangeProof2 ?? " ";
    ViewData["Title ListIndex"] = Resource2.CashDisbursementVoucherList ?? " ";

    var boolManagerSignature = Model.ManagerSigniture != null && !string.IsNullOrEmpty(Model.ManagerSigniture.ImagePath);
    var boolAccountantSigniture = Model.AccountantSigniture != null && !string.IsNullOrEmpty(Model.AccountantSigniture.ImagePath);
    var bool2And = (boolAccountantSigniture && boolManagerSignature);
    var MakeEditOpen = (!boolAccountantSigniture || (!bool2And && Model.IsUserLogedInISManager));
    var NoEdit = !MakeEditOpen;
    // compute details total for initial render
    decimal _detailsTotal = 0m;
    if (Model?.Details != null && Model.Details.Any())
    {
        _detailsTotal = Model.Details.Sum(d => d.Amount ?? 0m);
    }
}
