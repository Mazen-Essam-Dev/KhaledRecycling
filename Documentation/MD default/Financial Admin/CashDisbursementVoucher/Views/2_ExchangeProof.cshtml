@section Scripts {
        <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const otpInputs = Array.from(document.querySelectorAll("#otpModal .otp-digit")).reverse(); // reverse order for RTL
            const otpModal = document.getElementById("otpModal");
            const invalidFeedback = document.querySelector("#otpModal .invalid-feedback");

            otpInputs.forEach((input, index) => {
                input.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ""); // only digits
                    if (e.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus(); // move left (since reversed)
                    }
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });

            otpModal.addEventListener("shown.bs.modal", () => {
                otpInputs.forEach(i => i.value = "");
                otpInputs[0].focus();
                invalidFeedback.style.display = "none";
            });

            document.getElementById("otpForm").addEventListener("submit", function (e) {
                const otpValue = otpInputs.map(i => i.value).reverse().join(""); // restore normal order
                if (otpValue.length < 4) {
                    e.preventDefault();
                    invalidFeedback.style.display = "block";
                    return false;
                }
                invalidFeedback.style.display = "none";
                console.log("OTP entered:", otpValue);
            });
        });
    </script>


        <script>
            $(document).ready(function () {

            const noEdit = "@Html.Raw(NoEdit)";
            console.log(noEdit);
        if(noEdit == "True"){
            $("#DocumentNo").prop("disabled", true);
            $("#DocumentNo").prop("readonly", true);
            $("#BasedOn").prop("disabled", true);
            $("#ItWas").prop("disabled", true);
            $("#Amount").prop("disabled", true);
            $("#By").prop("disabled", true);
            $("#Date").prop("disabled", true);
            $("#Bank").prop("disabled", true);
            $("#Being").prop("disabled", true);
            }

                function openOtpModal(role) {
                    $('#otpRole').val(role);
                    // Send OTP
                    $.ajax({
                        url: '/Admin/MonthlyAdministrativeReport/SendOtp',
                        type: 'POST',
                        data: { id: $('#otpEntityId').val(), role: role },
                        success: function (response) {
                            if (response.success) {
                                const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
                                otpModal.show();
                            } else {
                                alert('Failed to send OTP.');
                            }
                        },
                        error: function () {
                            alert('Error sending OTP.');
                        }
                    });
                }
                $('#accountantSignatureSection').on('click', function () { openOtpModal('accountant'); });
                $('#managerSignatureSection').on('click', function () { openOtpModal('manager'); });

                // OTP form logic
                const otpModalEl = document.getElementById('otpModal');
                if (!otpModalEl) return;
                const otpModal = new bootstrap.Modal(otpModalEl, { backdrop: 'static', keyboard: false });
                const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit'));
                const otpForm = document.getElementById('otpForm');
                const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

                otpForm.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const code = otpDigits.map(d => d.value.trim()).join('');
                    const id = document.getElementById('otpEntityId')?.value;
                    const role = document.getElementById('otpRole')?.value;

                    if (!/^\d{4}$/.test(code)) {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.style.display = 'block';
                        return;
                    }

                    otpDigits.forEach(d => d.classList.remove('is-invalid'));
                    otpInvalid.style.display = 'none';

                    try {
                        const response = await fetch('/Admin/CashDisbursementVoucher/ExchangeProofRequestValidateOtp', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: id, code: code, role: role })
                        });
                        const result = await response.json();

                        if (result.success) {
                            otpModal.hide();
                            // Optionally reload page or update signature section
                            location.reload();
                        } else {
                            otpDigits.forEach(d => d.classList.add('is-invalid'));
                            otpInvalid.textContent = result.message || "Invalid OTP.";
                            otpInvalid.style.display = 'block';
                        }
                    } catch (err) {
                        alert('OTP validation failed.');
                    }
                });
            });
        </script>
}
        <script>
            function printPage() {
                const overlay = document.getElementById('loadingOverlay');

                if (overlay) {
                    setTimeout(() => { overlay.style.display = 'none'; }, 500);
                }
                setTimeout(() => { window.print(); }, 800);
            }

            // Exchange rows client-side management
            (function () {
                let rows = [];
                // server-side initial rows JSON (safe projection)
                const initialRows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model?.Details ?? new List<FougeraClub.Areas.Admin.ViewModels.CashDisbursementVoucher.ExchangeProofDetailVM>()).Select(d => new {
                    AccountNo = d.AccountNo ?? "",
                    CurrentBalance = d.CurrentBalance ?? 0m,
                    Item = d.Item ?? "",
                    Amount = d.Amount ?? 0m,
                    PaymentType = d.PaymentType ?? "",
                    Balance = d.Balance ?? 0m
                }))) ;

                function loadRows() {
                    // no localStorage usage; rows will be initialized from server-side `initialRows` if present
                    rows = [];
                }

                function saveToLocalStorage() {
                    // persist rows only to hidden input for server binding (do not use localStorage)
                    $('#exchangeRowsJson').val(JSON.stringify(rows));
                }

            function updateTotal() {
                const total = rows.reduce((s, r) => s + (parseFloat(r.Amount || 0) || 0), 0);
                $('#totalAmount').val(total.toFixed(2));
                // update tafqeet using client-side Arabic number to words
                const words = arabicTafqeet(total);
                $('#totalTafqeet').text(words);
            }

            // Simple Arabic number to words (tafqeet) for amounts up to millions
            function arabicTafqeet(amount) {
                if (isNaN(amount) || amount === 0) return 'صفر درهم';
                const ones = ['','واحد','اثنان','ثلاثة','أربعة','خمسة','ستة','سبعة','ثمانية','تسعة'];
                const tens = ['','عشر','عشرون','ثلاثون','أربعون','خمسون','ستون','سبعون','ثمانون','تسعون'];
                const teens = ['عشرة','أحد عشر','اثنا عشر','ثلاثة عشر','أربعة عشر','خمسة عشر','ستة عشر','سبعة عشر','ثمانية عشر','تسعة عشر'];

                function twoDigits(n) {
                    n = parseInt(n,10);
                    if (n < 10) return ones[n];
                    if (n >=10 && n < 20) return teens[n-10];
                    const o = n % 10;
                    const t = Math.floor(n/10);
                    if (o === 0) return tens[t];
                    return ones[o] + ' و ' + tens[t];
                }

                function threeDigits(n) {
                    n = parseInt(n,10);
                    const h = Math.floor(n/100);
                    const rem = n % 100;
                    let parts = [];
                    if (h > 0) {
                        if (h === 1) parts.push('مائة');
                        else if (h === 2) parts.push('مئتان');
                        else parts.push(ones[h] + ' مائة');
                    }
                    if (rem > 0) parts.push(twoDigits(rem));
                    return parts.join(' و ');
                }

                function chunkNumber(n) {
                    // returns [millions, thousands, hundreds]
                    const millions = Math.floor(n / 1000000);
                    const thousands = Math.floor((n % 1000000) / 1000);
                    const hundreds = n % 1000;
                    return { millions, thousands, hundreds };
                }

                const integer = Math.floor(Math.abs(amount));
                const cents = Math.round((Math.abs(amount) - integer) * 100);
                const ch = chunkNumber(integer);
                const parts = [];

                if (ch.millions > 0) {
                    if (ch.millions === 1) parts.push('مليون');
                    else if (ch.millions === 2) parts.push('مليونان');
                    else parts.push(threeDigits(ch.millions) + ' ملايين');
                }
                if (ch.thousands > 0) {
                    if (ch.thousands === 1) parts.push('ألف');
                    else if (ch.thousands === 2) parts.push('ألفان');
                    else parts.push(threeDigits(ch.thousands) + ' آلاف');
                }
                if (ch.hundreds > 0) {
                    parts.push(threeDigits(ch.hundreds));
                }

                let mainPart = parts.join(' و ');
                if (!mainPart) mainPart = 'صفر';

                if (cents > 0) {
                    return mainPart + ' درهم' + ' و ' + twoDigits(cents) + ' فلس';
                }

                return mainPart + ' درهم';
            }

                function renderRows() {
                    const $tb = $('#exchangeTbody');
                    $tb.empty();
                    rows.forEach((r, idx) => {
                        const tr = $('<tr>');
                        // 1 - account number (string)
                        tr.append($('<td>').html('<input class="form-control form-control-sm text-center accountNo" value="' + (r.AccountNo || '') + '" />'));
                        // 2 - current balance (decimal)
                        tr.append($('<td>').html('<input type="number" min="0" step="0.01" class="form-control form-control-sm text-center currentBalance" value="' + (r.CurrentBalance || '') + '" />'));
                        // 3 - item / chapter (string)
                        const itemCellHtml = '<input class="form-control form-control-sm text-center item" placeholder="البند / الموازنة" value="' + (r.Item || '') + '" />';
                        tr.append($('<td>').html(itemCellHtml));
                        // 4 - amount (decimal)
                        tr.append($('<td>').html('<input type="number" min="0" step="0.01" class="form-control form-control-sm text-center amount" value="' + (r.Amount || '') + '" />'));
                        // 5 - payment type (string)
                        tr.append($('<td>').html('<input class="form-control form-control-sm text-center paymentType" value="' + (r.PaymentType || '') + '" />'));
                        // 6 - balance (decimal)
                        tr.append($('<td>').html('<input type="number" min="0" step="0.01" class="form-control form-control-sm text-center balance" value="' + (r.Balance || '') + '" />'));

                        const $actions = $('<td class="print-none">');
                        const $del = $('<button type="button" class="btn btn-sm btn-outline-danger" title="حذف">').html('<i class="fa fa-trash"></i>');
                        $actions.append($del);
                        tr.append($actions);

                        // events
                        $del.on('click', function () {
                            if (!confirm('هل أنت متأكد من حذف هذا السجل؟')) return;
                            rows.splice(idx, 1);
                            renderRows();
                            updateTotal();
                        });

                        // input events
                        tr.on('input', 'input', function () {
                            rows[idx].AccountNo = tr.find('.accountNo').val();
                            rows[idx].CurrentBalance = parseFloat(tr.find('.currentBalance').val() || 0);
                            rows[idx].Item = tr.find('.item').val();
                            rows[idx].Amount = parseFloat(tr.find('.amount').val() || 0);
                            rows[idx].PaymentType = tr.find('.paymentType').val();
                            rows[idx].Balance = parseFloat(tr.find('.balance').val() || 0);
                            updateTotal();
                        });

                        $tb.append(tr);
                    });
                    saveToLocalStorage();
                }

                function addRow() {
                    rows.push({ AccountNo: '', CurrentBalance: 0, Item: '', Amount: 0, PaymentType: '', Balance: 0 });
                    renderRows();
                    const $last = $('#exchangeTbody tr').last();
                    $last.find('.accountNo').focus();
                }

                window.saveExchangeRows = function () {
                    saveToLocalStorage();
                    // remove previously added detail inputs
                    $('#mainForm').find('input[name^="Details"]').remove();
                    // append hidden inputs for model binding: Details[index].Property
                    rows.forEach((r, idx) => {
                        const prefix = `Details[${idx}].`;
                        $('<input>').attr({ type: 'hidden', name: prefix + 'AccountNo', value: r.AccountNo || '' }).appendTo('#mainForm');
                        $('<input>').attr({ type: 'hidden', name: prefix + 'CurrentBalance', value: r.CurrentBalance ?? '' }).appendTo('#mainForm');
                        $('<input>').attr({ type: 'hidden', name: prefix + 'Item', value: r.Item || '' }).appendTo('#mainForm');
                        $('<input>').attr({ type: 'hidden', name: prefix + 'Amount', value: r.Amount ?? '' }).appendTo('#mainForm');
                        $('<input>').attr({ type: 'hidden', name: prefix + 'PaymentType', value: r.PaymentType || '' }).appendTo('#mainForm');
                        $('<input>').attr({ type: 'hidden', name: prefix + 'Balance', value: r.Balance ?? '' }).appendTo('#mainForm');
                    });
                    // submit the main form to send ExchangeProof + Details to server
                    $('#mainForm').submit();
                };

                // init
                loadRows();
                // if localStorage empty, initialize from server-side details
                if ((!rows || rows.length === 0) && Array.isArray(initialRows) && initialRows.length > 0) {
                    rows = initialRows.map(r => ({
                        AccountNo: r.AccountNo || '',
                        CurrentBalance: parseFloat(r.CurrentBalance) || 0,
                        Item: r.Item || '',
                        Amount: parseFloat(r.Amount) || 0,
                        PaymentType: r.PaymentType || '',
                        Balance: parseFloat(r.Balance) || 0
                    }));
                }
                renderRows();
                updateTotal();

                // bind add
                $('#btnAddRow').on('click', function () { addRow(); });

                // update budget year header when Date changes
                $('#Date').on('change input', function () {
                    const dateVal = $(this).val();
                    const year = dateVal ? (new Date(dateVal)).getFullYear() : (new Date()).getFullYear();
                    $('.budgetYearHeader').text('موازنة ' + year);
                });

                // set initial budget year header
                (function () {
                    const dateVal = $('#Date').val();
                    const year = dateVal ? (new Date(dateVal)).getFullYear() : (new Date()).getFullYear();
                    $('.budgetYearHeader').text('موازنة ' + year);
                })();

            })();
        </script>
