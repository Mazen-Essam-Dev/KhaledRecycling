@model AcknowledgmentReceiptVM
@{
    ViewData["Title"] = Resource2.AcknowledgmentReceipt2 ?? " ";
    ViewData["Title ListIndex"] = Resource2.CashDisbursementVoucherList ?? " ";
    var boolAccountantSigniture = Model.AccountantSigniture != null && !string.IsNullOrEmpty(Model.AccountantSigniture.ImagePath);
}
<style>
    .gray-border{border-color:#ccc !important;}

    lable {
        color: #000 !important;
    }
    @@media print {
       
        .custom-navbar, 
        .sidenav-menu, 
        .print-none {
            display: none !important;
        }

        /* Reset layout */
        body, html {
            background: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            color: #000 !important;
            margin: 0;
            padding: 0;
            font-size: 14px;
        }

        * {
            max-width: 100% !important;
        }
        /* Centered container for print */
        .container {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 auto !important;
            border: none !important;
            padding: 10px !important;
        }
        /* Make inputs look like text for print */

        input[type="date"], input[type="number"] {
            appearance: none;
            -webkit-appearance: none;
        }
        
        /* Make textarea look like regular text for print */
        textarea {
            border: none !important;
            background: transparent !important;
            resize: none !important;
        }
        
        /* Avoid page breaks mid-section */
        .container, form, .row {
            page-break-inside: avoid;
        }
        /* Ensure proper RTL/LTR rendering */
        [dir="rtl"], .text-end {
            direction: rtl !important;
        }
        /* Keep colored titles */
        .bg-lightgreen, .bg-gray {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }

</style>
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap print-none">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">
                        وحدة إدارة الماليات
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/Admin/CashDisbursementVoucher/Index">
                        @ViewData["Title ListIndex"]
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">
                        @ViewData["Title"]
                    </a>
                </li>
            </ol>
        </nav>
    </div>
    <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-end gap-2">
            @if (boolAccountantSigniture)
            {
                <a href="#" onclick="printPage(); return false;" class="print-btn btn btn-success btn-sm">
                    <i class="fa fa-print me-1"></i> @Resource2.Print
                </a>
            }
            else
            {
                <a href="#" onclick="submitForm(); return false;" class="print-btn btn btn-success btn-sm">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                </a>
            }
            <a asp-action="Index" class="btn btn-cancel-search btn-sm back-btn">
               @Resource2.Back <i class="fa-solid fa-arrow-left me-1"></i>
            </a>
        </div>
    </div>
</div>
<div class="card">
    <div class="container mt-1 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap border-black  border-bottom py-3  mb-3">
            <div class="d-flex justify-content-between align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
                </div>
            </div>
            <div class="flex-fill text-center">
                <center>
                    <img src="~/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
                </center>
            </div>
            <div class="d-flex justify-content-end align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                </div>
            </div>
        </div>
        <div class="inner-container mt-1">
            <form action="AcknowledgmentReceipt" method="post" class="mt-2 mb-4 text-start" id="mainForm">
                <input hidden asp-for="CashDisbursementVoucherId" />
                <input hidden asp-for="Id" />
                <div class="mb-0 w-100">
                    <div class="w-50 mx-auto text-center fs-4 py-1 fw-bold" style="color:#af1717">
                        أقرار أستلام
                    </div>
                </div>
                <div class="row gap-2 d-flex justify-content-between text-center">
                    <div class="col-3 p-2">
                        <span class="mt-1">تاريخ</span>
                        <div class=" border border-1 border-black  py-1 px-3 mt-2">
                            <input asp-for="HeaderDate" type="date" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 text-center" style="border:0; background: transparent;" />
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="">
                            <h3 class="fs-4 ">Receipt Voucher</h3>
                            <input asp-for="Title" type="text" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100  text-center" style="background-color:#eeeeee !important; border:0; color:#af1717 !important;padding: 0 10px;
" />
                        </div>
                    </div>
                    <div class="col-3 p-2">
                        <span class="mt-1">قيمة</span>
                        <div class=" border border-1 border-black  py-1 px-3 mt-2">
                            <input asp-for="HeaderMonth" type="text" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 text-center" style="border:0; background: transparent;" />
                        </div>
                    </div>
                </div>
                <!-- Declare  -->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-3  fs-5 fw-normal">
                        <label class="text-black" asp-for="ThisTo">بهذا نقر بأننا نحن </label>
                    </div>
                    <div class="col-6">
                        <input asp-for="ThisTo" type="text" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 border-dashed border-bottom  text-center gray-border" style=" border:0;" />
                    </div>
                    <div class="col-3 text-end fs-4 fw-normal text-black" style="direction:ltr;">
                        <label asp-for="ThisTo">This To Declare That We </label>
                    </div>
                </div>
                <!-- Recived-->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-3  fs-5 fw-normal">
                        <label class="text-black" asp-for="Recived">قد استلمنا من  </label>
                    </div>
                    <div class="col-6">
                        <input asp-for="Recived" type="text" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 border-dashed border-bottom gray-border text-center" style="border:0;" />
                    </div>
                    <div class="col-3 text-end  fs-4 fw-normal" style="direction:ltr;">
                        <label class="text-black" asp-for="Recived">Have Recived From</label>
                    </div>
                </div>
                <!-- Payment -->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-3  fs-5 fw-normal">
                        <label class="text-black" asp-for="PaymentVoucherNo">بسند صرف رقم </label>
                    </div>
                    <div class="col-6">
                        <input asp-for="PaymentVoucherNo" type="number" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 border-dashed border-bottom gray-border text-center" style=" border:0;" />
                    </div>
                    <div class="col-3 text-end  fs-4 fw-normal" style="direction:ltr;">
                        <label class="text-black" asp-for="PaymentVoucherNo">Payment voucher No.</label>
                    </div>
                </div>
                <!-- Sum of Amount -->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-3  fs-5 fw-normal">
                        <label class="text-black"  asp-for="Amount">مبلغ وقدره درهم</label>
                    </div>
                    <div class="col-6">
                        <input asp-for="Amount" type="text" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 border-dashed border-bottom gray-border text-center" style=" border:0;" />
                    </div>
                    <div class="col-3 text-end fs-4 fw-normal" style="direction:ltr;">
                        <label class="text-black" asp-for="Amount">Sum Of Amount</label>
                    </div>
                </div>
                <!-- Cheque -->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-3  fs-5 fw-normal">
                        <label class="text-black" asp-for="Cheque">بموجب  شيك رقم / نقدا</label>
                    </div>
                    <div class="col-6">
                        <input asp-for="Cheque" type="text" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 border-dashed border-bottom text-center gray-border" style="border:0;" />
                    </div>
                    <div class="col-3 text-end  fs-4 fw-normal" style="direction:ltr;">
                        <label class="text-black" asp-for="Cheque">By Cheque No. / Cash</label>
                    </div>
                </div>
                <!--Bank & Date-->
                <div class="row">
                    <div class="col-6">
                        <div class="row d-flex align-items-center my-2">
                            <div class="col-3 fs-5 fw-normal">
                                <label class="text-black" asp-for="Date">التاريخ</label>
                            </div>
                            <div class="col-6">
                                <input asp-for="Date" type="date" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 border-dashed border-bottom text-center gray-border" style=" border:0;" />
                            </div>
                            <div class="col-3 text-end fs-4 fw-normal" style="direction:ltr;">
                                <label class="text-black" asp-for="Date">Date</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row d-flex align-items-center my-2">
                            <div class="col-3 fs-5 fw-normal">
                                <label class="text-black" asp-for="Bank">البنك</label>
                            </div>
                            <div class="col-6">
                                <input asp-for="Bank" type="text" readonly="@(boolAccountantSigniture ? "readonly" : null)" class="w-100 border-dashed border-bottom text-center gray-border" style=" border:0;" />
                            </div>
                            <div class="col-3 text-end  fs-4 fw-normal" style="direction:ltr;">
                                <label class="text-black" asp-for="Bank">Bank</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row d-flex align-items-center my-2">
                    <div class="col-1 fs-5 fw-normal">
                        <label class="text-black" asp-for="Being">وذلك عن</label>
                    </div>

                    <div class="col-10">
                        <input asp-for="Being"
                               readonly="@(boolAccountantSigniture ? "readonly" : null)"
                               type="text"
                               class="w-100 border-dashed border-bottom text-center gray-border"
                               style="border:0;" />
                    </div>

                    <div class="col-1 text-end fs-4 fw-normal" style="direction:ltr;">
                        <label class="text-black" asp-for="Being">Being</label>
                    </div>
                </div>

                <div class="my-2">
                    <textarea asp-for="AcknowledgmentText" 
                              readonly="@(boolAccountantSigniture ? "readonly" : null)" 
                              class="form-control text-center" 
                              rows="3" 
                              style="border: 1px solid #ccc; resize: none;"></textarea>
                </div>
            </form>
        </div>
        <!-- Signature Section -->
        @if (Model.Id != 0)
        {
            <hr class="red-hr" style="border-color:#000;" />

            <div class="row g-3 align-items-start">

                <!-- LEFT Signature (Manual After Print) -->
                <div class="col-4 text-center">
                    <div class="form-label fw-semibold text-black">
                        توقيع المستلم
                    </div>

                    <!-- Empty space for manual signature -->
                </div>

                <!-- spacer -->
                <div class="col-4"></div>

                <!-- RIGHT Signature (Accountant) -->
                <div class="col-4 text-center">

                    <!-- Title -->
                    <div class="form-label fw-semibold text-black">
                        @Resource2.AccountantSignature :
                        <span class="fw-bold">@Model.AccountantFullName</span>
                    </div>

                    @if (Model.isSavedFull)
                    {
                        @if (Model.AccountantSigniture != null &&
                                        !string.IsNullOrEmpty(Model.AccountantSigniture.ImagePath))
                        {
                            <!-- Signature Image BELOW text -->
                            <div class="mt-2">
                                <img src="~/@Model.AccountantSigniture.ImagePath"
                                     class="img-fluid d-block mx-auto"
                                     style="height:70px;" />
                            </div>
                        }
                        else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Accountant &&
                        await PermissionScanner.CheckLoggedUserIfHasSignature())
                        {
                            <div id="accountantSignatureSection"
                                 class="signature-trigger mt-2"
                                 role="button"
                                 style="cursor:pointer;">
                                إضغط هنا للتوقيع
                            </div>
                        }
                    }

                </div>

            </div>
        }


        <!-- OTP Modal: shared for both roles -->
        <div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="otpModalLabel">@Resource2.EnterOTP</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="otpForm">
                        <input type="hidden" id="otpEntityId" name="id" value="@Model.Id" />
                        <input type="hidden" id="otpRole" name="role" value="" />
                        <div class="modal-body text-center">
                            <p>@Resource2.PleaseEnterOTPToConfirmSignature</p>
                            <div class="d-flex justify-content-center gap-2">
                                @for (int i = 0; i < 4; i++)
                                {
                                    <input inputmode="numeric" maxlength="1" class="form-control otp-digit text-center fs-4" style="width:60px;" />
                                }
                            </div>
                            <div class="invalid-feedback text-center mt-2" style="display:none;">@Resource2.EnterValidDigitsCode</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-cancel-search btn" data-bs-dismiss="modal">@Resource2.Close</button>
                            <button type="submit" class="btn btn-success">@Resource2.Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const otpInputs = Array.from(document.querySelectorAll("#otpModal .otp-digit")).reverse(); // reverse order for RTL
            const otpModal = document.getElementById("otpModal");
            const invalidFeedback = document.querySelector("#otpModal .invalid-feedback");

            otpInputs.forEach((input, index) => {
                input.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ""); // only digits
                    if (e.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus(); // move left (since reversed)
                    }
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });

            otpModal.addEventListener("shown.bs.modal", () => {
                otpInputs.forEach(i => i.value = "");
                otpInputs[0].focus();
                invalidFeedback.style.display = "none";
            });

            document.getElementById("otpForm").addEventListener("submit", function (e) {
                const otpValue = otpInputs.map(i => i.value).reverse().join(""); // restore normal order
                if (otpValue.length < 4) {
                    e.preventDefault();
                    invalidFeedback.style.display = "block";
                    return false;
                }
                invalidFeedback.style.display = "none";
                console.log("OTP entered:", otpValue);
            });
        });
    </script>


    <script>
        $(document).ready(function () {

            const bool2and = "@Html.Raw(boolAccountantSigniture)";
            console.log(bool2and);
        if(bool2and == "True"){
            $("#Title").prop("disabled", true);
            $("#ThisTo").prop("disabled", true);
            $("#Recived").prop("disabled", true);
            $("#PaymentVoucherNo").prop("disabled", true);
            $("#Amount").prop("disabled", true);
            $("#Cheque").prop("disabled", true);
            $("#Date").prop("disabled", true);
            $("#Bank").prop("disabled", true);
            $("#Being").prop("disabled", true);
            $("#AcknowledgmentText").prop("disabled", true);
            $("#HeaderDate").prop("disabled", true);
            $("#HeaderMonth").prop("disabled", true);
            }

            function openOtpModal(role) {
                $('#otpRole').val(role);
                // Send OTP
                $.ajax({
                    url: '/Admin/CashDisbursementVoucher/SendOtp',
                    type: 'POST',
                    data: { id: $('#otpEntityId').val(), role: role },
                    success: function (response) {
                        if (response.success) {
                            const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
                            otpModal.show();
                        } else {
                            alert('Failed to send OTP.');
                        }
                    },
                    error: function () {
                        alert('Error sending OTP.');
                    }
                });
            }
            $('#accountantSignatureSection').on('click', function () { openOtpModal('accountant'); });

            // OTP form logic
            const otpModalEl = document.getElementById('otpModal');
            if (!otpModalEl) return;
            const otpModal = new bootstrap.Modal(otpModalEl, { backdrop: 'static', keyboard: false });
            const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit'));
            const otpForm = document.getElementById('otpForm');
            const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

            otpForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const code = otpDigits.map(d => d.value.trim()).join('');
                const id = document.getElementById('otpEntityId')?.value;
                const role = document.getElementById('otpRole')?.value;

                if (!/^\d{4}$/.test(code)) {
                    otpDigits.forEach(d => d.classList.add('is-invalid'));
                    otpInvalid.style.display = 'block';
                    return;
                }

                otpDigits.forEach(d => d.classList.remove('is-invalid'));
                otpInvalid.style.display = 'none';

                try {
                    const response = await fetch('/Admin/CashDisbursementVoucher/AcknowledgmentReceiptRequestValidateOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: id, code: code, role: role })
                    });
                    const result = await response.json();

                    if (result.success) {
                        otpModal.hide();
                        // Optionally reload page or update signature section
                        location.reload();
                    } else {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.textContent = result.message || "Invalid OTP.";
                        otpInvalid.style.display = 'block';
                    }
                } catch (err) {
                    alert('OTP validation failed.');
                }
            });
        });
    </script>

    <script>
        function printPage() {
            const overlay = document.getElementById('loadingOverlay');

            // Hide loading overlay if it exists
            if (overlay) {
                setTimeout(() => {
                    overlay.style.display = 'none';
                }, 500);
            }

            // Trigger print
            setTimeout(() => {
                window.print();
            }, 800);

        }
        function submitForm(){
            $('#mainForm').submit();
            }
    </script>

}