@using FougeraClub.Areas.Admin.ViewModels.CashExchangeBond
@model CashExchangeBondVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? Resource1.EditCashExchangeBond : Resource1.CreateCashExchangeBond;
    ViewData["Title pakage"] = @Resource2.FinancialManagement ?? " ";
    ViewData["Title ListIndex"] = Resource2.ListofCashExchangeBonds ?? " ";
    ViewData["Title Single"] = ((Model?.Id == 0) ? @Resource1.CreateCashExchangeBond : @Resource1.EditCashExchangeBond) ?? " ";

    var boolManagerSignature = Model.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath);
    var boolAccountantSigniture = Model.AccountantSigniture != null &&
    !string.IsNullOrEmpty(Model.AccountantSigniture.ImagePath);
    var bool2And = (boolAccountantSigniture && boolManagerSignature);
}
<!-- Breadcrumb Navigation Column -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <h4 class="ico-header-title">
            <i class="fa-solid fa-money-check-dollar me-1 text-ico"></i>
            @ViewData["Title"]
        </h4>
    </div>
    <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-end">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item"><a href="/Admin/CashExchangeBond/Index">@ViewData["Title ListIndex"]</a>
                </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
</div>
<div class="border d-flex flex-wrap align-items-start p-3">
    <div class="container-fluid">
        <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Date" class="form-label asteriskRequired fw-semibold">@Resource2.Date</label>
                    <input asp-for="Date" class="form-control" type="date" id="DateInput" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Code" class="form-label asteriskRequired fw-semibold">@Resource1.Code</label>
                    <input asp-for="Code" class="form-control" placeholder="@Resource1.Code" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="col-md-3 mb-2">
                    <label asp-for="Money" class="form-label asteriskRequired fw-semibold">@Resource1.Money</label>
                    <input asp-for="Money" id="Money2" type="number" placeholder="0.00" class="form-control"
                        placeholder="@Resource1.Money2" />
                    <span asp-validation-for="Money" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-2">
                    <input id="ArMoney" name="ArMoney" class="form-control bg-light" readonly
                        placeholder="@Resource1.ArMoney" />
                </div>

                <div class="col-md-6 mb-2">
                    <input id="EnMoney" name="EnMoney" class="form-control bg-light" readonly
                        placeholder="@Resource1.EnMoney" />
                </div>

                <!-- PersonName -->
                <div class="col-md-6 mb-2">
                    <label asp-for="PersonName" class="form-label asteriskRequired fw-semibold">@Resource1.DisbursedTo</label>
                    <input asp-for="PersonName" class="form-control"
                        placeholder="@Resource1.DisbursedTo @Resource1.PersonName" />
                    <span asp-validation-for="PersonName" class="text-danger small"></span>
                </div>

                <!-- AboutText -->
                <div class="col-md-6 mb-2">
                    <label asp-for="AboutText" class="form-label asteriskRequired fw-semibold">@Resource1.AboutText</label>
                    <input asp-for="AboutText" class="form-control" placeholder="@Resource1.AboutText" />
                    <span asp-validation-for="AboutText" class="text-danger small"></span>
                </div>
            </div>


            <div class="row">
                <div class="col-md-12 mt-3">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource1.AddDocuments</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>
            <div class="c-edit-form mb-3">

                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label for="DocumentNo" class="form-label asteriskRequired fw-semibold">@Resource1.DocumentNo</label>
                        <input id="DocumentNo" class="form-control" type="text" />
                        <span id="DocumentNoResult" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label for="DocumentDate" class="form-label asteriskRequired fw-semibold">@Resource1.DocumentDate</label>
                        <div class="input-icon-left">
                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                                class="date-icon">
                            <input id="DocumentDate" class="form-control green-border form-control-sm filter-bordered"
                                type="date" />
                        </div>
                        <span id="DocumentDateResult" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12 mb-2">
                        <label for="Particular" class="form-label asteriskRequired fw-semibold">@Resource1.Particular</label>
                        <input id="Particular" class="form-control" />
                        <span id="ParticularResult" class="text-danger small"></span>

                    </div>
                    <div class="col-md-6 mb-2">
                        <label for="AccountNo" class="form-label asteriskRequired fw-semibold">@Resource1.AccountNo</label>
                        <input id="AccountNo" class="form-control" />
                        <span id="AccountNoResult" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label for="Money" class="form-label asteriskRequired fw-semibold">@Resource1.Money</label>
                        <input id="Money" class="form-control" placeholder="0.00" type="number" />
                        <span id="MoneyResult" class="text-danger small"></span>

                    </div>

                    <div class="col-md-12 d-flex justify-content-end mt-2">
                        <button type="button" class="btn btn-secondary btn-sm px-4" onclick="addRow()">
                            <i class="fa-solid fa-plus-circle  me-1 "></i> @Resource2.Add
                        </button>
                    </div>
                </div>

                <!-- Table -->
                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>@Resource1.DocumentNo</th>
                                <th>@Resource1.DocumentDate</th>
                                <th>@Resource1.AccountNo</th>
                                <th>@Resource1.Particular</th>
                                <th>@Resource1.Money</th>
                                <th>@Resource1.ControlTools</th>
                            </tr>
                        </thead>
                        <tbody id="Details">
                            @if (Model?.Details != null)
                            {
                                var index = 0;
                                foreach (var detail in Model.Details)
                                {
                                    <tr>
                                        <td><input class="form-control" name="Details[@index].DocumentNo"
                                                value="@detail.DocumentNo" readonly /></td>
                                        <td><input class="form-control" type="date" name="Details[@index].DocumentDate"
                                                value="@detail.DocumentDate?.ToString("yyyy-MM-dd")" readonly /></td>
                                        <td><input class="form-control" name="Details[@index].AccountNo"
                                                value="@detail.AccountNo" readonly /></td>
                                        <td><input class="form-control" name="Details[@index].Particular"
                                                value="@detail.Particular" readonly /></td>
                                        <td><input class="form-control Amount" name="Details[@index].Money" type="number"
                                                placeholder="0.00" onchange="calculateTotal();" value="@detail.Money"
                                                readonly /></td>

                                        <td class="text-center"><button type="button"
                                                class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i
                                                    class="fa-solid fa-trash fs-5"></i></button></td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="20" class="text-center p-5">
                                        <div
                                            class="d-flex flex-column align-items-center justify-content-center text-muted">
                                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                            <h5 class="mt-3">@Resource1.NoData</h5>
                                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                                        </div>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                    <div class="row m-lg-0 mr-0 ml-0">
                        <div class="col-md-9">
                            <input class="form-control fw-semibold bg-light mt-2" readonly id="sum2" name="sum2"
                                value="@Resource1.Total ........." />
                        </div>
                        <div class="col-md-3">
                            <input class="form-control fw-semibold bg-light mt-2" readonly asp-for="Total" id="sum1"
                                value="" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="data-part pt-1 pb-1">
                <div class="col-md-12">
                    <!-- Actions -->
                    <div class="d-flex justify-content-center gap-2">
                        @if (!bool2And)
                        {
                            <button type="submit" class="btn btn-success btn-sm me-2">
                                <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                            </button>
                        }
                        else //Fake
                        {
                            <button type="button" disabled class="btn btn-success btn-sm me-2">
                                <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                            </button>
                        }


                        <a asp-action="Index" class="btn-cancel-search btn btn-sm me-2">
                            @Resource2.Back <i class="fa-solid fa-arrow-left me-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        $('.typeradiobtn, #DateInput').on('change', function () {
            let id = document.getElementById("Id").value;
            let selectedType = $(this).val();
            let selectedDate = document.getElementById("DateInput").value;
            const msgValid = "@Html.Raw(Resource1.Dateisvalid)";
            const msgInvalid = "@Html.Raw(@Resource2.ReportIsExist)";
            validateReportDate(id, selectedType, selectedDate, msgValid, msgInvalid);
        });

        function validateReportDate(id, selectedType, selectedDate, msgValid, msgInvalid) {
            $.ajax({
                url: '@Url.Action("CheckDate", "CashExchangeBond", new { area = "Admin" })',
                type: 'POST',
                data: { id: id, date: selectedDate },
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    $("#typeValidVM").text("");
                    if (result === false) {
                        $("#TypeCheckResult").text(msgValid)
                            .removeClass("text-danger").addClass("text-success");
                    } else {
                        $("#TypeCheckResult").text(msgInvalid)
                            .removeClass("text-success").addClass("text-danger");
                    }
                },
                error: function () {
                    $("#TypeCheckResult").text("⚠ Error checking date")
                        .removeClass("text-success").addClass("text-warning");
                }
            });
        }
    </script>

    <script>
        $(document).ready(function () {
            //let money = document.getElementById("Money2").value;
            let money = parseFloat($("#Money2").val()) || 0;


            GetMoneyText(money);
            calculateTotal();
            GetMoneySum2Text();
        });
        $('#Money2').on('change', function () {
            //let money = document.getElementById("Money2").value;
            let money = parseFloat($("#Money2").val()) || 0;

            const msgValid = "@Html.Raw(Resource1.Dateisvalid)";
            const msgInvalid = "@Html.Raw(@Resource2.ReportIsExist)";
            GetMoneyText(money);
        });

        function GetMoneyText(money) {
            $.ajax({
                url: '@Url.Action("MoneyText", "CashExchangeBond", new { area = "Admin" })',
                type: 'POST',
                data: { money },
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    $("#ArMoney").val("");
                    $("#EnMoney").val("");
                    if (result.status === true) {
                        $("#ArMoney").val(result.arMoney);
                        $("#EnMoney").val(result.enMoney);
                    } else {
                        $("#ArMoney").val("");
                        $("#EnMoney").val("");
                    }
                },
                error: function () {
                    $("#ArMoney").val("");
                    $("#EnMoney").val("");
                }
            });
        }
    </script>
    <script>

        function GetMoneySum2Text() {
            //let sum1 = $("#sum1").val();
            let sum1 = parseFloat($("#sum1").val()) || 0;

            const totalValueTxt = '@Html.Raw($"{Resource1.Total} .........")';
            const totalResource = '@Html.Raw($"{Resource1.Total}")';
            $.ajax({
                url: '@Url.Action("MoneyText", "CashExchangeBond", new { area = "Admin" })',
                type: 'POST',
                data: { money: sum1 },
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    $("#sum2").val(totalValueTxt);
                    if (result.status === true) {
                        $("#sum2").val(totalResource + " : " + result.arMoney);
                    } else {
                        $("#sum2").val(totalValueTxt);
                    }
                },
                error: function () {
                    $("#sum2").val(totalValueTxt);
                }
            });
        }
    </script>

    <script>
        let rowIndex = @Model?.Details?.Count() ?? 0;

        function calculateTotal() {
            let total = 0;
            document.querySelectorAll('#Details .Amount').forEach(input => {
                const value = parseFloat(input.value) || 0;
                total += value;
            });
            document.getElementById("sum1").value = total.toFixed(2);
            GetMoneySum2Text();
        }

        function addRow() {
            // clear previous validation marks
            $("#DocumentNoResult").text('')
            $("#DocumentDateResult").text('')
            $("#AccountNoResult").text('')
            $("#ParticularResult").text('')
            $("#MoneyResult").text('')

            const DocumentNo = $("#DocumentNo").val().trim();
            const DocumentDate = $("#DocumentDate").val().trim();
            const AccountNo = $("#AccountNo").val().trim();
            const Particular = $("#Particular").val().trim();
            const Money = $("#Money").val().trim();

            let isValid = true;
            if (!DocumentNo) { $("#DocumentNoResult").text("@Html.Raw(Resource1.Required)"); isValid = false; }
            if (!DocumentDate) { $("#DocumentDateResult").text("@Html.Raw(Resource1.Required)"); isValid = false; }
            if (!AccountNo) { $("#AccountNoResult").text("@Html.Raw(Resource1.Required)"); isValid = false; }
            if (!Particular) { $("#ParticularResult").text("@Html.Raw(Resource1.Required)"); isValid = false; }
            if (!Money) { $("#MoneyResult").text("@Html.Raw(Resource1.Required)"); isValid = false; }

            if (!isValid) return;

            const tbody = document.getElementById("Details");
            const row = document.createElement("tr");
            row.innerHTML = `
                    <td><input class="form-control" name="Details[${rowIndex}].DocumentNo" value="${DocumentNo}" readonly /></td>
                    <td><input class="form-control" type="date" name="Details[${rowIndex}].DocumentDate" value="${DocumentDate}" readonly /></td>
                    <td><input class="form-control" name="Details[${rowIndex}].AccountNo" value="${AccountNo}" readonly /></td>
                    <td><input class="form-control" name="Details[${rowIndex}].Particular" value="${Particular}" readonly /></td>
                    <td><input class="form-control Amount" name="Details[${rowIndex}].Money" type="number" placeholder="0.00" value="${Money}" readonly /></td>
                    <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
                `;

            tbody.appendChild(row);
            rowIndex++;

            // Clear inputs
            $("#DocumentNo, #DocumentDate, #AccountNo, #Particular, #Money").val("");

            calculateTotal();
        }

        // Store the row to be deleted
        let rowToDelete = null;
        function removeRow(button) {
            rowToDelete = button.closest("tr");
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        function confirmDeleteRow() {
            if (rowToDelete) {
                rowToDelete.remove();
                // Reindex rows
                const rows = document.querySelectorAll("#Details tr");
                rows.forEach((row, i) => {
                    const inputs = row.querySelectorAll("input");
                    inputs.forEach(input => {
                        const name = input.getAttribute("name");
                        if (name) input.setAttribute("name", name.replace(/\[\d+\]/, `[${i}]`));
                    });
                });
                rowIndex = rows.length;
                calculateTotal();
                rowToDelete = null;
            }
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            if (modal) modal.hide();
        }

    </script>


    <!-- Delete Modal (matches CashDisbursementVoucher/AddEdit) -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Resource2.ConfirmDelete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>هل أنت متأكد من أنك تريد حذف هذا العنصر؟ هذا الإجراء لا يمكن التراجع عنه.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">@Resource2.Cancel</button>
                    <button type="button" class="btn-cancel-search btn"
                        onclick="confirmDeleteRow()">@Resource2.Delete</button>
                </div>
            </div>
        </div>
    </div>
}