@section Scripts {

    <script>
        function printDiv(divId) {
            window.print();
            document.body.innerHTML = originalPage;
            location.reload();
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const otpInputs = Array.from(document.querySelectorAll("#otpModal .otp-digit")).reverse(); // reverse order for RTL
            const otpModal = document.getElementById("otpModal");
            const invalidFeedback = document.querySelector("#otpModal .invalid-feedback");

            otpInputs.forEach((input, index) => {
                input.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ""); // only digits
                    if (e.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus(); // move left (since reversed)
                    }
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });

            otpModal.addEventListener("shown.bs.modal", () => {
                otpInputs.forEach(i => i.value = "");
                otpInputs[0].focus();
                invalidFeedback.style.display = "none";
            });

            document.getElementById("otpForm").addEventListener("submit", function (e) {
                const otpValue = otpInputs.map(i => i.value).reverse().join(""); // restore normal order
                if (otpValue.length < 4) {
                    e.preventDefault();
                    invalidFeedback.style.display = "block";
                    return false;
                }
                invalidFeedback.style.display = "none";
                console.log("OTP entered:", otpValue);
            });
        });
    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#monthSelect').val(filters.selectedMonth);
                $('#yearSelect').val(filters.selectedYear);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                const monthSelect2 = document.getElementById('monthSelect');
                const yearSelect2 = document.getElementById('yearSelect');
                // ✅ Validate selected value, not element existence
                if (!monthSelect2.value || !yearSelect2.value) {
                    //$('#empId').addClass('is-invalid'); // highlight invalid select
                    e.preventDefault();
                    showToastrCannotPrintPleseSelectFirst(); // Toaster Can't Print Please Select First
                    return;
                }
                else {
                    //$('#empId').removeClass('is-invalid'); // remove highlight

                    e.preventDefault();
                    saveFilters(1); // We store from the first page
                    loadNewPartialList(1);
                }
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#monthSelect').val('');
                $('#yearSelect').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    selectedMonth: $('#monthSelect').val(),
                    selectedYear: $('#yearSelect').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var selectedMonth = $('#monthSelect').val();
                var selectedYear = $('#yearSelect').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/ExpenseAndReceipt/ExpensesReport',
                    type: 'GET',
                    data: { selectedYear, selectedMonth, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function (xhr) {
                        const err = xhr.responseText ? xhr.responseText.substring(0, 200) : 'Unknown error';
                        $('#PartialNewListContainer').html(`<div class="alert alert-danger">Error loading data:<br>${err}</div>`);
                    }
                });
            }
        });
    </script>

    <!-- Print helper (kept your exact params & ids) -->
    <script>
        function openPrintPage() {
            const selectedYear = encodeURIComponent(document.getElementById('yearSelect').value);
            const selectedMonth = encodeURIComponent(document.getElementById('monthSelect').value);
            var countRecords = document.getElementById('NewCountRecords').value;
            if(!selectedYear || !selectedMonth){
                showToastrCannotPrintPleseSelectFirst(); // Toaster Can't PrintDiscountsAndBonusesReport
                return ;
            }
            if(countRecords && countRecords>3999){
                showToastrCannotPrint(); // Toaster Can't Print more 3999 record
            }
            else{
                const url = `/Admin/ExpenseAndReceipt/Print_ExpensesReport?selectedYear=${selectedYear}&selectedMonth=${selectedMonth}`;
                //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                // Open a standalone pop window (not a tab) so the original page doesn't freeze
                const printWindow = window.open(
                    url,
                    'printWindow',
                    'width=1000,height=800,noopener,noreferrer'
                );

            }
        }
    </script>

    <script>
        function openExcelPage() {
            const selectedYear = encodeURIComponent(document.getElementById('yearSelect').value);
            const selectedMonth = encodeURIComponent(document.getElementById('monthSelect').value);
            if(!selectedYear || !selectedMonth){
                showToastrCannotPrintPleseSelectFirst(); // Toaster Can't PrintDiscountsAndBonusesReport
                return ;
            }
            const url = `/Admin/ExpenseAndReceipt/createExcelReport_Download_ExpensesReport?selectedYear=${selectedYear}&selectedMonth=${selectedMonth}`;
            window.open(url, '_self');
        }
    </script>

    <script>
        function OpenDetails_ExpensesReportPage() {
            const selectedYear = encodeURIComponent(document.getElementById('yearSelect').value);
            const selectedMonth = encodeURIComponent(document.getElementById('monthSelect').value);
            if(!selectedYear || !selectedMonth){
                showToastrCannotPrintPleseSelectFirst(); // Toaster Can't PrintDiscountsAndBonusesReport
                return ;
            }
            const url = `/Admin/ExpenseAndReceipt/OpenDetails_ExpensesReport?selectedYear=${selectedYear}&selectedMonth=${selectedMonth}`;
            window.open(url, '_blank');
        }
    </script>

        <script>
            // Toaster For you can't Print
            function showToastrCannotPrintPleseSelectFirst() {
              toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-center",
                "timeOut": "3000"
              };
              var cantPrint2 ='@Html.Raw(Resource1.PleaseChooseYearAndMonthFirstly)';

              toastr.error(cantPrint2);
            }
        </script>

    <script>
        $(document).ready(function () {
            function openOtpModal(role) {
                $('#otpRole').val(role);
                // Send OTP
                $.ajax({
                    url: '/Admin/ExpenseAndReceipt/SendOtp',
                    type: 'POST',
                    data: { year: $('#otpYear').val(), month: $('#otpMonth').val(), role: role },
                    success: function (response) {
                        if (response.success) {
                            bootstrap.Modal.getOrCreateInstance(document.getElementById('otpModal')).show();
                        } else {
                            alert('Failed to send OTP.');
                        }
                    },
                    error: function () {
                        alert('Error sending OTP.');
                    }
                });
            }
            $('#trainerSignatureSection').on('click', function () { openOtpModal('Acountant'); });
            $('#managerSignatureSection').on('click', function () { openOtpModal('manager'); });

            // OTP form logic
            const otpModalEl = document.getElementById('otpModal');
            if (!otpModalEl) return;
            const otpModal = bootstrap.Modal.getOrCreateInstance(otpModalEl, { backdrop: 'static', keyboard: false });
            const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit'));
            const otpForm = document.getElementById('otpForm');
            const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

            otpForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const code = otpDigits.map(d => d.value.trim()).join('');
                const year = document.getElementById('otpYear')?.value;
                const month = document.getElementById('otpMonth')?.value;
                const role = document.getElementById('otpRole')?.value;

                if (!/^\d{4}$/.test(code)) {
                    otpDigits.forEach(d => d.classList.add('is-invalid'));
                    otpInvalid.style.display = 'block';
                    return;
                }

                otpDigits.forEach(d => d.classList.remove('is-invalid'));
                otpInvalid.style.display = 'none';

                try {
                    const response = await fetch('/Admin/ExpenseAndReceipt/ValidateOtp_OpenDetails_ExpensesReport', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ year: parseInt(year), month: parseInt(month), code: code, role: role })
                    });
                    const result = await response.json();

                    if (result.success) {
                        otpModal.hide();
                        location.reload();
                    } else {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.textContent = result.message || "Invalid OTP.";
                        otpInvalid.style.display = 'block';
                    }
                } catch (err) {
                    alert('OTP validation failed.');
                }
            });
        });
    </script>
}
 