    var acctUser = (Model?.AcountantSignature != null && !string.IsNullOrEmpty(Model.AcountantSignature.UserId)) ? await UserManager.FindByIdAsync(Model.AcountantSignature.UserId) : null;
    var mgrUser = (Model?.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.UserId)) ? await UserManager.FindByIdAsync(Model.ManagerSignature.UserId) : null;
