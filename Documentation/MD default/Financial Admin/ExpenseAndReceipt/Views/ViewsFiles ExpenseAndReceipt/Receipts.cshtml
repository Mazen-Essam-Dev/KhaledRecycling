
@model PaginatedList<ExpenseAndReceiptVM>
@{
    ViewData["Title"] = @Resource2.Receipts2 ?? " ";
    ViewData["Title pakage"] = @Resource2.FinancialManagement ?? " ";
    ViewData["Title Single"] = @Resource2.ReceiptsList ?? " ";
    var addPermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Add");
    var editPermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Delete");
}
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource1.RecordsCount:</span>
            <span id="countRecords">@Model.Count</span>
        </div>
        
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <span class="fa fa-money-bill-trend-up me-2 text-ico"></span>
                            @ViewData["Title Single"]
                        </h4>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-end gap-1">
                    @if (addPermission)
                    {
                        <a asp-action="AddEdit" asp-route-itemType="@ItemType.Receipts" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource2.CreateNew
                        </a>
                    }

                    <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>

                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"></i>
                        @Resource1.createExcelReport_Download
                    </a>
                </div>
            </div>

            <div class="rounded shadow-sm p-3">
                <form method="get" id="receiptsFilterForm" class="filterImg rounded px-2 pt-2">
                    <div class="row">
                        <!-- First row: first 3 filters -->
                        <div class="filter-dropdown col-md-4">
                            <label for="searchTermInput" class="fw-medium mb-2">@Resource2.Search:</label>
                            <div class="search-box position-relative">
                                <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                <input type="text" name="searchTerm" id="searchTermInput"
                                       value="@Model.SearchTerm"
                                       class="form-control green-border form-control-sm filter-bordered ps-4"
                                       placeholder="@Resource1.Description" />
                            </div>
                        </div>

                        <div class="filter-dropdown col-md-4">
                            <label for="selectedSupplier" class="fw-medium mb-2">@Resource1.Destenation_Supplierss:</label>
                            <select class="form-select green-border form-select-sm filter-bordered select2"
                                    id="selectedSupplier" name="selectedSupplier">
                                <option value="">@Resource2.Select</option>
                                @foreach (var item in ViewBag?.SuppliersList as IEnumerable<SelectListItem>)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="filter-dropdown col-md-4">
                            <label for="selectedSource" class="fw-medium mb-2">@Resource2.Source:</label>
                            <select class="form-select green-border form-select-sm filter-bordered"
                                    id="selectedSource" name="selectedSource">
                                <option value="">@Resource2.Select</option>
                                @foreach (var item in (ViewBag?.ExpensesSourcesList as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>())
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <!-- Second row: Date From & Date To -->
                        <div class="filter-dropdown col-md-6">
                            <label for="dateFrom" class="fw-medium mb-2">@Resource2.DateFrom:</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png"
                                     alt="calendar icon" class="date-icon">
                                <input type="date" name="dateFrom" id="dateFrom"
                                       class="form-control green-border form-control-sm filter-bordered"
                                       value="@ViewBag.DateFrom" />
                            </div>
                        </div>

                        <div class="filter-dropdown col-md-6">
                            <label for="dateTo" class="fw-medium mb-2">@Resource2.DateTo:</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png"
                                     alt="calendar icon" class="date-icon">
                                <input type="date" name="dateTo" id="dateTo"
                                       class="form-control green-border form-control-sm filter-bordered"
                                       value="@ViewBag.DateTo" />
                            </div>
                        </div>
                    </div>





                    <div class="d-flex justify-content-end align-items-center p-2 gap-2 flex-wrap">
                        <button type="button" id="btnClearFilters" class="btn-cancel-search btn-sm btn">
                            <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                        </button>
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="ri-filter-line me-1"></i> @Resource1.Search
                        </button>
                    </div>
                </form>
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ReceiptsListPartial", Model)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">@Resource1.Delete @Resource1.Supplier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Resource1.Close"></button>
            </div>
            <div class="modal-body">
                <p>@Resource1.are_you_sure_Delete <strong id="empName"></strong>؟</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="empId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource1.Cancel</button>
                    <button type="submit" class="btn btn-danger">@Resource1.Yes_delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Attachments Modal -->
<div class="modal fade" id="uploadFilesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div id="attachmentsContent"></div>
    </div>
</div>
<style>
    .select2-container--default .select2-selection--single {
        min-height: calc(1.5em + 1rem);
        padding: .5rem .75rem;
    }

    .select2-selection__rendered {
        line-height: 1.8;
    }

</style>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (ViewBag.ReopenModal != null && (bool)ViewBag.ReopenModal)
    {
        <script>
            var myModal = new bootstrap.Modal(document.getElementById('uploadFilesModal'));
            myModal.show();
        </script>
    }
    <script>
        $(document).on("click", ".show-delete-info", function () {
            var message = $(this).data("message");
            $("#deleteInfoMessage").text(message);
            var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
            modal.show();
        });
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var empId = button.getAttribute('data-emp-id');
            var empName = button.getAttribute('data-emp-name');
            var modalEmpId = deleteModal.querySelector('#empId');
            var modalEmpName = deleteModal.querySelector('#empName');
            modalEmpId.value = empId;
            modalEmpName.textContent = empName;
        });
        $(document).ready(function () {
            $('.expiryDate').each(function () {
                const endDateStr = $(this).text().trim();
                if (!endDateStr) return;
                const expiryDate = new Date(endDateStr);
                if (isNaN(expiryDate.getTime())) return;
                const today = new Date();
                const in30Days = new Date();
                today.setHours(0, 0, 0, 0);
                in30Days.setDate(today.getDate() + 30);
                in30Days.setHours(0, 0, 0, 0);
                expiryDate.setHours(0, 0, 0, 0);
                if (expiryDate < today) {
                    $(this).closest('tr').addClass('badge-expired');
                } else if (expiryDate <= in30Days) {
                    $(this).closest('tr').addClass('badge-warning');
                }
            });
            document.querySelectorAll('.open-attachments').forEach(btn => {
                btn.addEventListener('click', async function () {
                    var employeeId = this.getAttribute('data-employee-id');
                    let response = await fetch('/Admin/Supplier/GetEmployeeAttachments?id=' + employeeId);
                    let html = await response.text();
                    document.getElementById('attachmentsContent').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('uploadFilesModal'));
                    modal.show();
                });
            });
            const pageKey = window.location.pathname + "_filters";
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#dateFrom').val(filters.dateFrom);
                $('#dateTo').val(filters.dateTo);
                $('#pageSizeSelect').val(filters.pageSize);
                $('#selectedSupplier').val(filters.selectedSupplier);
                $('#selectedSource').val(filters.selectedSource);
                loadNewPartialList(filters.page, filters.pageSize);
            }
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1);
                loadNewPartialList(1);
            });
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                $('#selectedSupplier').val('');
                $('#selectedSource').val('');
                $('#dateFrom').val('');
                $('#dateTo').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    selectedSupplier: $('#selectedSupplier').val(),
                    selectedSource: $('#selectedSource').val(),
                    dateFrom: $('#dateFrom').val(),
                    dateTo: $('#dateTo').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }
            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();
                var selectedSupplier = $('#selectedSupplier').val();
                var selectedSource = $('#selectedSource').val();
                var dateFrom = $('#dateFrom').val();
                var dateTo = $('#dateTo').val();
                $.ajax({
                    url: '/Admin/ExpenseAndReceipt/Receipts',
                    type: 'GET',
                    data: { searchTerm,selectedSupplier,selectedSource,dateFrom,dateTo, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips && initTooltips();
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
        function openPrintPage() {
            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
            const selectedSupplier = encodeURIComponent(document.getElementById('selectedSupplier').value);
            const selectedSource = encodeURIComponent(document.getElementById('selectedSource').value);
            const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
            const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
            var countRecords = document.getElementById('NewCountRecords').value;
            if(countRecords && countRecords>3999){
                showToastrCannotPrint();
            }
            else{
                const url = `/Admin/ExpenseAndReceipt/Print_Receipts?searchTerm=${searchTerm}&selectedSupplier=${selectedSupplier}&selectedSource=${selectedSource}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                const printWindow = window.open(url,'printWindow','width=1000,height=800,noopener,noreferrer');
            }
        }
        function openExcelPage() {
            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
            const selectedSupplier = encodeURIComponent(document.getElementById('selectedSupplier').value);
            const selectedSource = encodeURIComponent(document.getElementById('selectedSource').value);
            const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
            const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
            const url = `/Admin/ExpenseAndReceipt/createExcelReport_Download_Receipts?searchTerm=${searchTerm}&selectedSupplier=${selectedSupplier}&selectedSource=${selectedSource}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
            window.open(url, '_self');
        }
    </script>
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script>
        (function initSelect2() {
            function doInit() {
                try {
                    var $sel = $('#selectedSupplier.select2');
                    if ($sel.length && $.fn && $.fn.select2) {
                        $sel.select2({ allowClear: false, width: '100%' , dir: 'rtl' });
                    }

                    // Preserve selected value when reloading via sessionStorage
                    const pageKey = window.location.pathname + "_filters";
                    if (sessionStorage.getItem(pageKey)) {
                        let filters = JSON.parse(sessionStorage.getItem(pageKey));
                        if (filters && filters.selectedSupplier) {
                            $('#selectedSupplier').val(filters.selectedSupplier).trigger('change');
                        }
                    }
                } catch (e) {
                    console.warn('Select2 init failed', e);
                }
            }

            if (typeof jQuery === 'undefined') {
                console.warn('jQuery not found; skipping Select2 init');
                return;
            }

            if (jQuery.fn && jQuery.fn.select2) {
                doInit();
                return;
            }

            var script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
            script.onload = doInit;
            script.onerror = function () { console.error('Failed to load Select2 script'); };
            document.head.appendChild(script);
        })();
    </script>
}
