@using FougeraClub.Areas.Admin.ViewModels.ExpenseAndReceipts
@model ExpensesReportVM

@{
    ViewData["Title"] = @Resource2.PettyCashReport ?? " ";
    ViewData["Title pakage"] = @Resource2.FinancialManagement ?? " ";
    ViewData["Title Single"] = @Resource2.PettyCashReport ?? " ";


    var addPermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Add");
    var editPermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Delete");
}

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count Display Column -->
    <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource1.RecordsCount:</span>
            <span id="countRecords">@Model?.PaginatedExpenses?.Count</span>
        </div>
    
    </div>
</div>
<input hidden asp-for="IsAbleToOpen" id="IsAbleToOpen" />
<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <span class="fa-solid fa-money-bill-trend-up me-2 text-ico"></span>
                            @ViewData["Title Single"]
                        </h4>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
                    <button type="button" class="btn btn-success btn-sm" onclick="OpenDetails_ExpensesReportPage();">
                        <i class="fa-solid fa-pen me-1"></i> @Resource2.Approval1
                    </button>

                    @* <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button> *@
                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"></i>@Resource1.createExcelReport_Download
                    </a>
            </div>
        </div>

            <div class="rounded shadow-sm p-3">
                <form method="get" class="filterImg rounded">
                    <div class="row p-2">
                        <div class="col-md-5">
                            <div class="filter-dropdown">
                                <label for="monthSelect" class="fw-medium mb-2">الشهر:</label>
                                <div class="input-icon-left">
                                    <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">

                                    <select class="form-select form-select-sm filter-bordered" id="monthSelect" name="selectedMonth">
                                        <option value="">-- @Resource2.Select --</option>
                                        @foreach (var month in ViewBag.Months as List<SelectListItem>)
                                        {
                                            <option value="@month.Value" selected="@(month.Value == ViewBag.SelectedMonth?.ToString())">@month.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="filter-dropdown">
                                <label for="monthSelect" class="fw-medium mb-2">@Resource1.Year:</label>
                                <div class="input-icon-left">
                                    <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">
                                    <select class="form-select form-select-sm filter-bordered" id="yearSelect" name="selectedYear">
                                        <option value="">-- @Resource2.Select --</option>
                                        @foreach (var year in ViewBag.Years as List<int>)
                                        {
                                            <option value="@year" selected="@(year == ViewBag.SelectedYear)">@year</option>
                                        }
                                    </select>
                                </div>


                            </div>
                        </div>
                        <div class="d-flex justify-content-end align-items-center gap-1  col-md-2">
                            <button type="button" id="btnClearFilters" class="btn-cancel-search btn-sm btn coustom-min-w mt-3">
                                <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                            </button>
                            <button type="submit" class="btn btn-success btn-sm coustom-min-w mt-3">
                                <i class="ri-filter-line me-1"></i> @Resource1.Search
                            </button>
                        </div>

                    </div>

                </form>






                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ExpensesReportListPartial", Model)
                </div>

            </div>

    </div>
</div>


@section Scripts {

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#monthSelect').val(filters.selectedMonth);
                $('#yearSelect').val(filters.selectedYear);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                const monthSelect2 = document.getElementById('monthSelect');
                const yearSelect2 = document.getElementById('yearSelect');
                // ✅ Validate selected value, not element existence
                if (!monthSelect2.value || !yearSelect2.value) {
                    //$('#empId').addClass('is-invalid'); // highlight invalid select
                    e.preventDefault();
                    showToastrCannotPrintPleseSelectFirst(); // Toaster Can't Print Please Select First
                    return;
                }
                else {
                    //$('#empId').removeClass('is-invalid'); // remove highlight

                    e.preventDefault();
                    saveFilters(1); // We store from the first page
                    loadNewPartialList(1);
                }
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#monthSelect').val('');
                $('#yearSelect').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    selectedMonth: $('#monthSelect').val(),
                    selectedYear: $('#yearSelect').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var selectedMonth = $('#monthSelect').val();
                var selectedYear = $('#yearSelect').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/ExpenseAndReceipt/ExpensesReport',
                    type: 'GET',
                    data: { selectedYear, selectedMonth, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function (xhr) {
                        const err = xhr.responseText ? xhr.responseText.substring(0, 200) : 'Unknown error';
                        $('#PartialNewListContainer').html(`<div class="alert alert-danger">Error loading data:<br>${err}</div>`);
                    }
                });
            }
        });
    </script>

    <!-- Print helper (kept your exact params & ids) -->
    <script>
        function openPrintPage() {
            const selectedYear = encodeURIComponent(document.getElementById('yearSelect').value);
            const selectedMonth = encodeURIComponent(document.getElementById('monthSelect').value);
            var countRecords = document.getElementById('NewCountRecords').value;
            if(!selectedYear || !selectedMonth){
                showToastrCannotPrintPleseSelectFirst(); // Toaster Can't PrintDiscountsAndBonusesReport
                return ;
            }
            if(countRecords && countRecords>3999){
                showToastrCannotPrint(); // Toaster Can't Print more 3999 record
            }
            else{
                const url = `/Admin/ExpenseAndReceipt/Print_ExpensesReport?selectedYear=${selectedYear}&selectedMonth=${selectedMonth}`;
                //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                // Open a standalone pop window (not a tab) so the original page doesn't freeze
                const printWindow = window.open(
                    url,
                    'printWindow',
                    'width=1000,height=800,noopener,noreferrer'
                );

            }
        }
    </script>

    <script>
        function openExcelPage() {
            const selectedYear = encodeURIComponent(document.getElementById('yearSelect').value);
            const selectedMonth = encodeURIComponent(document.getElementById('monthSelect').value);
            if(!selectedYear || !selectedMonth){
                showToastrCannotPrintPleseSelectFirst(); // Toaster Can't PrintDiscountsAndBonusesReport
                return ;
            }
            const url = `/Admin/ExpenseAndReceipt/createExcelReport_Download_ExpensesReport?selectedYear=${selectedYear}&selectedMonth=${selectedMonth}`;
            window.open(url, '_self');
        }
    </script>

    <script>
        function OpenDetails_ExpensesReportPage() {
            const isAbleOpen = encodeURIComponent(document.getElementById('IsAbleToOpen').value);
            const selectedYear = encodeURIComponent(document.getElementById('yearSelect').value);
            const selectedMonth = encodeURIComponent(document.getElementById('monthSelect').value);
            console.log("isAbleOpen:", isAbleOpen);
            if(!selectedYear || !selectedMonth){
                showToastrCannotPrintPleseSelectFirst(); // Toaster Can't PrintDiscountsAndBonusesReport
                return ;
            }
            if(isAbleOpen != "true"){
                showToastrCannotPrintPleseSelectAnotherFirst(); // Toaster Can't PrintDiscountsAndBonusesReport
                return ;
            }
            const url = `/Admin/ExpenseAndReceipt/OpenDetails_ExpensesReport?selectedYear=${selectedYear}&selectedMonth=${selectedMonth}`;
            window.open(url, '_self');
        }
    </script>

        <script>
            // Toaster For you can't Print
            function showToastrCannotPrintPleseSelectFirst() {
              toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-center",
                "timeOut": "3000"
              };
              var cantPrint2 ='@Html.Raw(Resource1.PleaseChooseYearAndMonthFirstly)';

              toastr.error(cantPrint2);
            }
        </script>
        <script>
            // Toaster For you can't Print
            function showToastrCannotPrintPleseSelectAnotherFirst() {
              toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-center",
                "timeOut": "3000"
              };
              var cantPrint2 ='@Html.Raw(Resource1.PleaseChooseYearAndMonthAnother)';

              toastr.error(cantPrint2);
            }
        </script>
}
