@page
@using Domain.Resources
@using System.Globalization
@model LoginModel

@{
    ViewData["Title"] = Resource1.Login;
    Layout = null;
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">

<head>
    <link href="~/assets/css/adminlogin.css" rel="stylesheet" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css">
    <!-- Font-Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer"   />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap"
        rel="stylesheet" />
    <link href="~/css/premium-ui.css" rel="stylesheet" />
    <link rel="shortcut icon" href="~/assets/images/logo.png" type="image/x-icon" />
    <title>@Resource1.Login</title>
</head>

<body class="premium-login-page">
    <div class="premium-login-shell">
        <main class="premium-login-grid">
            <section class="premium-login-hero reveal reveal-right" aria-label="Green life introduction">
                <div>
                    <span class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-white bg-opacity-10 fw-bold">
                        <i class="fa-solid fa-recycle"></i>
                        Khaled Team Recycling
                    </span>
                    <h1 class="mt-4">Green Life Dashboard</h1>
                    <p>
                        منصة حديثة لإدارة عمليات إعادة التدوير والبيانات والفرق بأسلوب واضح وموثوق.
                    </p>
                </div>

                <div class="premium-impact-row">
                    <div class="premium-impact-item">
                        <strong>Eco</strong>
                        <span>Clean operations</span>
                    </div>
                    <div class="premium-impact-item">
                        <strong>Smart</strong>
                        <span>Admin control</span>
                    </div>
                    <div class="premium-impact-item">
                        <strong>Fast</strong>
                        <span>Secure access</span>
                    </div>
                </div>
            </section>

            <section class="premium-login-card reveal reveal-left" aria-labelledby="loginTitle">
                <div class="py-3 d-flex flex-column align-items-center text-center">
                    <img class="logo-img" src="~/assets/images/logo.png" alt="Khaled Team Recycling">
                    <h4 id="loginTitle" class="mt-4 text-font-family text-fw">
                        مرحبا بكم
                    </h4>
                    <p class="mt-2 mb-0 text-muted fw-bold">
                        في الشركة المختصة لإعادة التدوير
                    </p>
                </div>

                <form id="account" method="post" class="mt-2">
                    <div class="text-danger text-center my-2 py-2 fw-bold" dir="rtl">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>

                    <div class="mobile-form p-0">
                        <div class="mb-3">
                            <label class="form-label" asp-for="Input.Email">@Resource2.Username</label>
                            <input required class="form-control text-font-family" asp-for="Input.Email"
                                   style="direction:rtl;" placeholder="@Resource2.Username" autocomplete="username" />
                        </div>

                        <div class="mb-2 input-shell" dir="ltr">
                            <label class="form-label d-block text-end" asp-for="Input.Password">@Resource2.Password</label>
                            <i class="fa fa-eye position-absolute start-0 translate-middle-y ms-3 cursor-pointer"
                               style="cursor:pointer; z-index: 2; top: 70%;" onclick="togglePassword('Password', this)"></i>
                            <input asp-for="Input.Password" class="form-control text-font-family ps-5"
                                   style="direction:rtl;" type="password" id="Password"
                                   placeholder="@Resource2.Password" autocomplete="current-password" required />
                        </div>

                        <button class="text-white text-font-family loadind-btn" type="submit">
                            <span class="login">@Resource1.Login</span>
                            <span class="spinner loader d-none" aria-hidden="true">
                                <span class="bounce1"></span>
                                <span class="bounce2"></span>
                                <span class="bounce3"></span>
                            </span>
                        </button>

                        <a class="premium-register-link" href="/auth/Register" type="button">
                            انشاء حساب جديد
                        </a>
                    </div>
                </form>
            </section>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js"></script>
</body>

</html>
<script>
    // Toggle password visibility
    function togglePassword(inputId, iconElement) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
            iconElement.classList.remove("fa-eye");
            iconElement.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            iconElement.classList.remove("fa-eye-slash");
            iconElement.classList.add("fa-eye");
        }
    }

    // Loader logic for login button
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("account");
        const submitButton = form?.querySelector(".loadind-btn");
        const loader = submitButton?.querySelector(".loader");
        const loginText = submitButton?.querySelector(".login");
        if (!form || !loader || !loginText) {
            return;
        }

        form.addEventListener("submit", function () {
            loader.classList.remove("d-none");
            loginText.classList.add("d-none");
        });

        // If validation errors, hide loader again
        const validationSummary = document.querySelector("[asp-validation-summary]");
        if (validationSummary && validationSummary.textContent.trim() !== "") {
            loader.classList.add("d-none");
            loginText.classList.remove("d-none");
        }
    });
</script>
