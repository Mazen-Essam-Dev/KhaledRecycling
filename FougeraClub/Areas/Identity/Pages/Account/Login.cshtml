@page
@using Domain.Resources
@using System.Globalization
@model LoginModel

@{
    ViewData["Title"] = Resource1.Login;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <link href="~/assets/css/adminlogin.css" rel="stylesheet" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css">
    <!-- Font-Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer"   />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap"
        rel="stylesheet" />
    <link rel="shortcut icon" href="~/assets/images/logo.png" type="image/x-icon" />
    <title>@Resource1.Login</title>
    <style>
        .background {
            background-image: url("/assets/images/bg.jpg");
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-size: cover;
            background-position: center;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(7px);
            -webkit-backdrop-filter: blur(7px);
        }

        /* Placeholder styling */
        input::placeholder,
        .form-control::placeholder {
            font-size: 0.8rem;
            color: #bfbfbf;
            opacity: 1;
        }
    </style>

</head>

<body>
    <div class="background">
        <main>
            <div class="form-outline shadow glass-card">
                <div class="py-3 d-flex flex-column align-items-center">
                    <img class="logo-img" src="~/assets/images/logo.png" alt="">
                    <h4 class=" text-green mt-3 text-font-family text-fw text-center" >
                        رفاد  

                    </h4>
                    <h5 class=" mt-3 text-font-family text-fw text-center" style=" color:gray;">
                          للنظام الإداري والمالي لنادي الفجيرة العلمي

                    </h5>
                   
                </div>
              
                <form id="account" method="post">
                    <!-- Validation summary -->
                    <div class="text-danger text-center my-2 py-2 fw-bold" dir="rtl">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>

                    <div class="mobile-form">
                        <!-- Username -->
                        <div class="mb-3">
                            <input required class="form-control text-font-family" asp-for="Input.Email"
                                   style="direction:rtl;" placeholder="@Resource2.Username" />
                        </div>


                        <!-- Password -->
                        <div class="mt-4 mb-1 position-relative" dir="ltr">
                            <i class="fa fa-eye position-absolute top-50 start-0 translate-middle-y ms-3 cursor-pointer"
                               style="cursor:pointer; z-index: 2;" onclick="togglePassword('Password', this)"></i>

                            <input asp-for="Input.Password" class="form-control text-font-family ps-5"
                                   style="direction:rtl;" type="password" id="Password"
                                   placeholder="@Resource2.Password" required />
                        </div>




                        <!-- Login button -->
                        <button class="btn text-white text-font-family loadind-btn mt-3" type="submit">
                            <div class="login">@Resource1.Login</div>
                            <div class="spinner loader d-none">
                                <div class="bounce1"></div>
                                <div class="bounce2"></div>
                                <div class="bounce3"></div>
                            </div>
                        </button>
                    </div>
                </form>

            </div>
        </main>
    </div>
</body>

</html>
<script>
    // Toggle password visibility
    function togglePassword(inputId, iconElement) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
            iconElement.classList.remove("fa-eye");
            iconElement.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            iconElement.classList.remove("fa-eye-slash");
            iconElement.classList.add("fa-eye");
        }
    }

    // Loader logic for login button
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("account");
        const loader = document.querySelector(".loader");
        const loginText = document.querySelector(".login");
        form.addEventListener("submit", function () {
            loader.classList.remove("d-none");
            loginText.classList.add("d-none");
        });

        // If validation errors, hide loader again
        const validationSummary = document.querySelector("[asp-validation-summary]");
        if (validationSummary && validationSummary.textContent.trim() !== "") {
            loader.classList.add("d-none");
            loginText.classList.remove("d-none");
        }
    });
</script>
