@model IEnumerable<ActivityVM>

@{
    ViewData["Title"] = @Resource2.Activities;
    var lang = SessionHelper.GetCurrentLanguage();
}
<style>
    .bg-lightgreen {
        background-color: #e5f8c7;
    }

</style>
<div class="content">
    

    <div class="content-inner">
        <div class="d-flex justify-content-end align-items-center gap-2 my-2 mx-1">
            <div>
                <span class="badge bg-lightgreen rounded-pill p-3 text-dark  border border-1 border-black ">
                    @Resource3.Subscriber
                </span>
            </div>

        </div>
        <div class="data-part mt-0">
            <h3 class="home-second-title">@Resource2.Activities</h3>
            <div class=" table-responsive" style="overflow-x:hidden">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">@Resource1.ActivityDate</th>
                            <th scope="col">@Resource1.ActivityDuration</th>
                            <th scope="col">@Resource2.Activity</th>
                            <th scope="col">@Resource1.Ages</th>
                            <th scope="col">@Resource2.Location</th>
                            <th scope="col" >@Resource2.Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="20" class="text-center p-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                        <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3">@Resource1.NoActivities</h5>
                                        <p class="mb-0">@Resource1.NoData</p>
                                    </div>
                                </td>
                            </tr>

                        }
                        else
                        {
                            var TRcolor = "";
                            var TDcolor = "";
                            @foreach (var item in Model.OrderByDescending(i => i.Id))
                            {
                                if (item.Subscribed)
                                {
                                    TRcolor = "#e5f8c7";
                                    TDcolor = "#e5f8c7";
                                }
                                else
                                {
                                    TRcolor = "";
                                    TDcolor = "";
                                }
                                <tr style="background-color:@TRcolor;">
                                    <td>@item.StartDate?.ToString("d")?.Replace("/","-")</td>
                                    @{
                                        if (item.StartDate.HasValue && item.EndDate.HasValue)
                                        {
                                            var diff = item.EndDate.Value.ToDateTime(TimeOnly.MinValue)
                                            - item.StartDate.Value.ToDateTime(TimeOnly.MinValue);
                                            <td>@(diff.Days + 1) @Resource2.Day</td>
                                        }
                                        else
                                        {
                                            <td>-</td>
                                        }
                                    }
                                    <td>@(lang == "ar" ? item.TitleAr : item.TitleEn)</td>
                                    @* <td>@($"{Resource2.Above} {item.MinimumAge} {Resource1.Year1}")</td> *@
                                    <td>@($"{item.MinimumAge}")</td>
                                    <td>@item.Location</td>
                                    <td>
                                        <div class="ms-3">
                                            <ul class="list-unstyled d-flex justify-content-start">
                                                <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                    data-bs-custom-class="custom-tooltip"
                                                    data-bs-title="@Resource1.Details2">
                                                    <a href="" data-bs-toggle="modal"
                                                       data-bs-target="#activityDetailsModal"
                                                       data-id="@item.Id"
                                                       >
                                                        <div class="icon-bg" >
                                                            <i class="fa-solid fa-eye"></i>
                                                        </div>
                                                    </a>

                                                </li>
                                                <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                    data-bs-custom-class="custom-tooltip"
                                                    data-bs-title="@Resource3.Subscription">
                                                    @if (!item.Subscribed && item.EndDate != null && item.EndDate >= DateOnly.FromDateTime(AppDubaiTime.Now.Date))
                                                    {
                                                         
                                                        <a href="#" onclick="CheckAge(@item.Id)">
                                                            <div class="icon-bg" >
                                                                <i class="fa-solid fa-file-signature"></i>
                                                            </div>
                                                        </a>

                                                    }
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Activity Details Modal -->
<div class="modal fade" id="activityDetailsModal" tabindex="-1" aria-labelledby="activityDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Optional: modal-lg for more width -->
        <div class="modal-content">
            <div id="activityDetailsBody">
                <div class="text-center text-muted">Loading...</div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function CheckAge(activityId) {
            const failedcheckage= "@Html.Raw(Resource1.Failedcheckage)";

            $.ajax({
                url: '/Member/Activity/CheckAge',
                type: 'GET',
                data: { activityId: activityId },
                success: function (response) {
                    if (response.valid) {
                        window.location.href = '/Member/Activity/Subscribe?id=' + activityId;
                    } else {
                         Swal.fire({
                            icon: 'error',
                            title: '@Resource2.Invalid',
                            text: response.message,
                            confirmButtonText: '@Resource2.Ok',
                            confirmButtonColor: '#09B080' // Bootstrap "success" green
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                         icon: 'error',
                        title: failedcheckage,
                        text: 'فشل في التحقق من العمر.'
                    });
                }
            });
        }
        $(document).ready(function () {
            $('#activityDetailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var body = $(this).find('#activityDetailsBody');
                body.html('<div class="text-center text-muted py-3">Loading...</div>');
                $.ajax({
                    url: '/Member/Activity/Details',
                    type: 'GET',
                    data: { id: id },
                    success: function (data) { body.html(data); },
                    error: function () {
                        body.html('<div class="alert alert-danger text-center m-0">فشل في تحميل بيانات الفعالية.</div>');
                    }
                });
            });
        });
    </script>
}
