@model Activity

@{
    ViewData["Title"] = @Resource2.SubscribeInActivity;
}

@{
    var lang = Context.Session.GetString("CurrentCulture") ?? "ar";
}


<div class="content">
    <div class="title d-flex  mt-2 ms-4 ">
        <div class="menu-btn" id="menu-icon">
            <i class="fa-solid fa-bars" id="menu-icon"></i>
        </div>
        <h3>@Resource2.SubscribeInActivity</h3>
    </div>

    <div class="content-inner">
        <div class="data-part mt-3 pt-3">
            <div class="container">
                <form asp-action="Subscribe" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="StartDate" />
                    <input type="hidden" asp-for="EndDate" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Event Title and Name Section -->
                    <div class="row mb-2">
                        @if (lang == "ar")
                        {
                            <div class="col-md-12 col-12 mb-3">
                                <label asp-for="TitleAr" class="form-label">@Resource1.ActivityTitle</label>
                                <input asp-for="TitleAr" class="form-control" placeholder="@Resource2.ActivityTitleAr" readonly/>
                                <span asp-validation-for="TitleAr" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12 col-12 mb-3">
                                <label asp-for="TitleEn" class="form-label">@Resource1.ActivityTitle</label>
                                <input asp-for="TitleEn" class="form-control" placeholder="@Resource2.ActivityTitleEn" readonly />
                                <span asp-validation-for="TitleEn" class="text-danger"></span>
                            </div>
                        }
                    </div>

                    <!-- Additional Date Field -->
                    <div class="row mb-2">
                        <div class="col-md-6 col-12 mb-3">
                            <label asp-for="StartDate" class="form-label">@Resource2.DateFrom</label>
                            <input id ="s" name="s" value="@Model.StartDate?.ToString("d")?.Replace("/", "-")"  type="text" class="form-control" readonly />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 col-12 mb-3">
                            <label asp-for="EndDate" class="form-label">@Resource2.DateTo</label>
                            <input id="e" name="e" value="@Model.EndDate?.ToString("d")?.Replace("/", "-")" type="text" class="form-control" readonly />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Terms and Conditions Section -->
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="agreeCheck" required>

                            <label class="form-check-label" for="agreeCheck">
                                @Resource1.I_have_read_and_agree_to_terms_and_conditions

                                <a href="~/assets/الشروط و الأحكام.pdf" target="_blank">
                                    @Resource1.terms
                                </a>
                            </label>
                        </div>
                    </div>

                    <!-- Register Button -->
                    <div class="text-center" style="display: flex; justify-content: center; align-content: center; gap: 5px;">
                        <button type="submit" id="submitBtn" class="all-btn btn" disabled>
                            @Resource2.Subscribe
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary"
                           style="margin-top: 5px; padding-left: 30px; padding-right: 30px;">
                            <i class="bi bi-x-circle"></i> @Resource2.Back
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
<script>
    //this script to activate the save button when the terms are approved
    document.getElementById('agreeCheck').addEventListener('change', function() {
        document.getElementById('submitBtn').disabled = !this.checked;
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const checkbox = document.getElementById("agreeCheck");
        const submitBtn = document.getElementById("submitBtn");

        checkbox.addEventListener("change", function () {
            submitBtn.disabled = !this.checked;
        });
    </script>
}
