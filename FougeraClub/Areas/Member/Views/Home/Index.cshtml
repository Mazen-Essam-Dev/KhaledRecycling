@* @model HomeActivityCourseVM

@{
    ViewData["Title"] = Resource1.MasterPage;
    var lang = SessionHelper.GetCurrentLanguage();
}

<div class="content-inner">
    <div class="data-part">
        <h2 class="home-second-title"> @Resource1.NextCourses </h2>
        <div class=" table-responsive" style="overflow-x:hidden">
            <table class="table table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th scope="col" style="min-width: 100px;"> @Resource1.CourseDate </th>
                        <th scope="col">@Resource1.Department </th>
                        <th scope="col">@Resource1.Time </th>
                        <th scope="col">@Resource1.Location </th>
                        <th scope="col">@Resource1.CourseTitle </th>
                        <th scope="col">@Resource1.ControlTools </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Courses?.Count() == 0)
                    {
                       
                        <tr>
                            <td colspan="20" class="text-center p-5">
                                <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                    <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                    <h5 class="mt-3">@Resource1.NoNewCourses</h5>
                                    <p class="mb-0">@Resource1.NoData</p>
                                </div>
                            </td>
                        </tr>

                    }
                    else
                    {
                        string TRcolor;
                        string TDcolor;
                        foreach (var course in Model.Courses)
                        {

                            @if (course.Accepted.HasValue && course.Accepted.Value)
                            {
                                TRcolor = "#e5f8c7";
                                TDcolor = "#e5f8c7";
                            }
                            else
                            {
                                TRcolor = "";
                                TDcolor = "";
                            }
                            <tr style="background-color:@TRcolor;">
                                <td>@course.StartDate?.ToString("d")?.Replace("/","-")</td>

                                @if (SessionHelper.GetCurrentLanguage() == "ar")
                                {
                                    <td>@course.Department?.NameAr</td>
                                    <td>@course.Time</td>
                                    <td>@course.Location</td>
                                    <td>@course.TitleAr</td>
                                }
                                else
                                {
                                    <td>@course.Department?.NameEn</td>
                                    <td>@course.Time</td>
                                    <td>@course.Location</td>
                                    <td>@course.TitleEn</td>
                                }


                                <td>
                                    <div class="ms-3">
                                        <ul class="list-unstyled d-flex justify-content-start align-items-center">
                                            <!-- View Details -->
                                            <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                data-bs-custom-class="custom-tooltip"
                                                data-bs-title="@Resource1.Details2">
                                                <div class="icon-bg show-course-btn" style="cursor: pointer;">
                                                    <i class="fa-solid fa-eye"
                                                       data-bs-toggle="modal"
                                                       data-course-id="@course.Id"
                                                       data-bs-target="#showCourseModal"></i>
                                                </div>
                                            </li>

                                            <!-- Subscribe or Rate -->
                                                @if (course.Subscribed.HasValue && course.Subscribed.Value && course.Attendance.HasValue && course.Attendance.Value)
                                                {
                                                <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                    data-bs-custom-class="custom-tooltip"
                                                    data-bs-title="@Resource1.Rate2">
                                                    <a 
                                                       data-bs-toggle="modal"
                                                       data-bs-target="#ratingModal"
                                                       data-id="@course.Id"
                                                       data-rateid="@course.Id"
                                                       data-selectedrate="@course.selectedRate">
                                                        <div class="icon-bg" style="cursor: pointer;">
                                                            <i class="fa-solid fa-star"></i>
                                                        </div>
                                                    </a>
                                                    </li>
                                                }
                                                @if (course.Subscribed.HasValue && !course.Subscribed.Value)
                                                {
                                                <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                    data-bs-custom-class="custom-tooltip"
                                                    data-bs-title="@Resource3.Subscription">
                                                    <a asp-controller="Course" asp-action="Subscribe" asp-route-id="@course.Id">
                                                        <div class="icon-bg" style="cursor: pointer;">
                                                            <i class="fa-solid fa-file-signature"></i>
                                                        </div>
                                                    </a>
                                                      </li>
                                                }
                                            <!-- Certificate and Finished Icons -->
                                            @if (course.selectedRate.HasValue && course.Attendance.HasValue && course.Attendance.Value)
                                            {
                                                <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                    data-bs-custom-class="custom-tooltip"
                                                    data-bs-title="@Resource1.Certificate">
                                                    <a onclick="PrintCertificate(@course.SubscriptionId)" >
                                                        <div class="icon-bg" style="cursor: pointer;">
                                                            <i class="fa-solid fa-certificate"></i>
                                                        </div>

                                                    </a>
                                                </li>
                                            
                                            }

                                        </ul> 
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="btn-center p-2">
                <a asp-controller="Course" asp-action="Index" asp-area="Member" class="all-btn">
                    @Resource1.More
                </a>
            </div>
        </div>
    </div>
    <div class="data-part">
        <h2 class="home-second-title">@Resource1.NextActivities </h2>

        <div class=" table-responsive" style="overflow-x:hidden">
            <table class="table table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th scope="col">@Resource1.ActivityDate</th>
                        <th scope="col">@Resource1.ActivityDuration</th>
                        <th scope="col">@Resource2.Activity</th>
                        <th scope="col">@Resource1.Ages</th>
                        <th scope="col">@Resource2.Location</th>
                        <th scope="col">@Resource1.ControlTools</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Activities?.Count() == 0)
                    {

                        <tr>
                            <td colspan="20" class="text-center p-5">
                                <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                    <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                    <h5 class="mt-3">@Resource1.NoNewActivities</h5>
                                    <p class="mb-0">@Resource1.NoData</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        if (Model != null && Model.Activities != null)
                        {
                            var TRcolor = "";
                            var TDcolor = "";
                            foreach (var item in Model.Activities)
                            {
                                @if (item.Subscribed)
                                {
                                    TRcolor = "#e5f8c7";
                                    TDcolor = "#e5f8c7";
                                }
                                else
                                {
                                    TRcolor = "";
                                    TDcolor = "";
                                }
                                <tr style="background-color:@TRcolor;">
                                    <td>@item.StartDate?.ToString("d")?.Replace("/","-")</td>
                                    @{
                                        if (item.StartDate.HasValue && item.EndDate.HasValue)
                                        {
                                            var diff = item.EndDate.Value.ToDateTime(TimeOnly.MinValue)
                                            - item.StartDate.Value.ToDateTime(TimeOnly.MinValue);
                                            <td>@(diff.Days + 1) @Resource2.Day</td>
                                        }
                                        else
                                        {
                                            <td>-</td>
                                        }
                                    }
                                    <td>@(lang == "ar" ? item.TitleAr : item.TitleEn)</td>
                                    <td>@($"{item.MinimumAge}")</td>
                                    <td>@item.Location</td>
                                    <td>
                                        <div class=" ms-3">
                                            <ul class="list-unstyled d-flex justify-content-start">
                                                <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                    data-bs-custom-class="custom-tooltip"
                                                    data-bs-title="@Resource1.Details2">

                                                    <a href="" data-bs-toggle="modal"
                                                       data-bs-target="#activityDetailsModal"
                                                       data-id="@item.Id">
                                                        <div class="icon-bg">
                                                            <i class="fa-solid fa-eye"></i>
                                                        </div>
                                                    </a>


                                                </li>
                                                <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                    data-bs-custom-class="custom-tooltip"
                                                    data-bs-title="@Resource3.Subscription">
                        
                                                    @if (!item.Subscribed && item.EndDate != null && item.EndDate > DateOnly.FromDateTime(AppDubaiTime.Now.Date))
                                                    {

                                                        <a href="#" onclick="CheckAge(@item.Id)">
                                                            <div class="icon-bg">
                                                                <i class="fa-solid fa-file-signature"></i>
                                                            </div>
                                                        </a>

                                                    }
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
            <div class="btn-center p-2">
                <a asp-controller="Activity" asp-action="Index" class="all-btn">
                    @Resource1.More
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Course Details Modal -->
<div class="modal fade" id="showCourseModal" tabindex="-1" aria-labelledby="showCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="showCourseModalLabel">@Resource1.Course_Data1</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="courseDetailsForm">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label for="modalDepartment" class="form-label">@Resource1.Specialization</label>
                            <input type="text" readonly class="form-control" id="modalDepartment" name="modalDepartment" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label for="modalTitle" class="form-label">@Resource1.CourseTitle</label>
                            <input type="text" readonly class="form-control" id="modalTitle" name="modalTitle" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="modalStartDate" class="form-label">@Resource1.StartDate</label>
                            <input type="text" readonly class="form-control" id="modalStartDate" name="modalStartDate" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="modalEndDate" class="form-label">@Resource1.EndDate</label>
                            <input type="text" readonly class="form-control" id="modalEndDate" name="modalEndDate" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label for="modalLocation" class="form-label">@Resource1.Location</label>
                            <input type="text" readonly class="form-control" id="modalLocation" name="modalLocation" required />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label for="modalTime" class="form-label">@Resource1.Time</label>
                            <input type="text" readonly class="form-control" id="modalTime" name="modalTime" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label for="modalDescription" class="form-label">@Resource1.Course_Data</label>
                            <textarea readonly class="form-control" id="modalDescription" name="modalDescription" required></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-6">
                            <label class="form-label">@Resource1.For_more_details_ClickHere</label>
                            <div class="">
                                <a class="btn btn-outline-secondary" id="attachmentPath" href="#" target="_blank">
                                    @Resource1.View_File1
                                </a>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button class="all-btn btn btn-secondary" data-bs-dismiss="modal">@Resource1.Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Activity Details Modal -->
<div class="modal fade" id="activityDetailsModal" tabindex="-1" aria-labelledby="activityDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Optional: modal-lg for more width -->
        <div class="modal-content">
            <div  id="activityDetailsBody">
                <div class="text-center text-muted">Loading...</div>
            </div>
        </div>
    </div>
</div>

<!-- Rating Modal -->
<div class="modal fade" id="ratingModal" tabindex="-1" aria-labelledby="ratingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ratingModalLabel">@Resource1.CourseRate2</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <h4>@Resource2.PleaseSelectRating</h4>

                <div class="row">
                    <div class="col-md-3">
                        <label class="rate">
                            <input type="radio" name="ratingValue" value="5">
                            <div class="rate-card">
                                <img src="~/ar/assets/rate/very-happy-face.png" class="img-fluid">
                                <p>@Resource1.Excellent</p>
                            </div>
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label class="rate">
                            <input type="radio" name="ratingValue" value="4">
                            <div class="rate-card">
                                <img src="~/ar/assets/rate/happy-face.png" class="img-fluid">
                                <p>@Resource1.Good</p>
                            </div>
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label class="rate">
                            <input type="radio" name="ratingValue" value="3">
                            <div class="rate-card">
                                <img src="~/ar/assets/rate/smiling-face.png" class="img-fluid">
                                <p>@Resource1.Fair</p>
                            </div>
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label class="rate">
                            <input type="radio" name="ratingValue" value="2">
                            <div class="rate-card">
                                <img src="~/ar/assets/rate/sad-face.png" class="img-fluid">
                                <p>@Resource1.UnHappy</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="mt-4">
                    <button id="ratebtn" class="btn btn-success" type="button">
                        @Resource2.SubmitRating
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Certificate Modal -->
<div class="modal fade" id="certificateModal" tabindex="-1" aria-labelledby="certificateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="certificateModalLabel">@Resource1.Certificate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Certificate_Message</p>
                <div class="text-center">
                    <a href="#" id="downloadCertificate" class="all-btn">
                        <i class="fa-solid fa-download"></i> Download_Certificate
                    </a>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource1.Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function CheckAge(activityId) {
            const failedcheckage= "@Html.Raw(Resource1.Failedcheckage)";

            $.ajax({
                url: '/Member/Activity/CheckAge',
                type: 'GET',
                data: { activityId: activityId },
                success: function (response) {
                    if (response.valid) {
                        window.location.href = '/Member/Activity/Subscribe?id=' + activityId;
                    } else {
                         Swal.fire({
                            icon: 'error',
                            title: '@Resource2.Invalid',
                            text: response.message,
                            confirmButtonText: '@Resource2.Ok',
                            confirmButtonColor: '#09B080' // Bootstrap "success" green
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                         icon: 'error',
                        title: failedcheckage,
                        text: 'فشل في التحقق من العمر.'
                    });
                }
            });
        }
    </script>

    <script>
        function PrintCertificate(subscriptionId) {
             const url = `/Member/Course/PrintCertificate?subscriptionId=${subscriptionId}`;
            //window.open(url, '_blank'); //old For open in newTab but this freeze main page
            // Open a standalone pop window (not a tab) so the original page doesn't freeze
            const printWindow = window.open(
                url,
                'printWindow',
                'width=1000,height=800,noopener,noreferrer'
            );
         }

        $(document).ready(function () {

            ShowToastrLoginSuccesfullyLoggedIn();

            // Handle course details modal
            $('.show-course-btn').click(function () {
                var courseId = $(this).find('i').data('course-id');

                $.get('/Member/Course/GetCourse', { id: courseId }, function (data) {
                    $('#modalDepartment').val(data.department);
                    $('#modalTitle').val(data.title);
                    $('#modalStartDate').val(data.startDate);
                    $('#modalEndDate').val(data.endDate);
                    $('#modalLocation').val(data.location);
                    $('#modalTime').val(data.time);
                    $('#modalDescription').val(data.description);
                    if(data.attachmentPath !==null){
                        $('#attachmentPath').attr('href','../../'+data.attachmentPath);
                        $('#attachmentPath').attr('target','_blank');
                        $('#attachmentPath').removeClass('disabled');
                    }
                    else{
                        $('#attachmentPath').attr('href','#');
                        $('#attachmentPath').attr('target','_self');
                        $('#attachmentPath').addClass('disabled');
                    }
                });
            });

            $('#activityDetailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var body = $(this).find('#activityDetailsBody');
                body.html('<div class="text-center text-muted py-3">Loading...</div>');
                $.ajax({
                    url: '/Member/Activity/Details',
                    type: 'GET',
                    data: { id: id },
                    success: function (data) { body.html(data); },
                    error: function () {
                        body.html('<div class="alert alert-danger text-center m-0">فشل في تحميل بيانات الفعالية.</div>');
                    }
                });
            });
            // Handle rating submission
            let currentCourseId = null;

            $('#ratingModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                currentCourseId = button.data('rateid');
                var selectedRate = button.data('selectedrate');

                // Clear previous selection
                $('input[name="ratingValue"]').prop('checked', false);

                // Preselect the radio if selectedRate exists
                if (selectedRate) {
                    $('input[name="ratingValue"][value="' + selectedRate + '"]').prop('checked', true);
                }
            });

            $('#ratebtn').on('click', function () {
                var selectedRating = $('input[name="ratingValue"]:checked').val();

                if (!selectedRating) {
                    return;
                }

                if (!currentCourseId) {
                    return;
                }

                $.ajax({
                    url: '/Member/Course/DoRate',
                    method: 'POST',
                    data: {
                        ratingValue: selectedRating,
                        id: currentCourseId
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        $('#ratingModal').modal('hide');
                        location.reload();
                    },
                    error: function () {
                    }
                });
            });

            // Handle certificate download
            $('#certificateModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var courseId = button.data('id');

                $('#downloadCertificate').attr('href', '/Member/Course/DownloadCertificate?id=' + courseId);
            });
        });




        $('#ratingModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget);
            currentCourseId = button.data('rateid');
            const selectedRate = button.data('selectedrate');

            // Clear previous selection
            $('input[name="ratingValue"]').prop('checked', false);

            // Preselect the radio if selectedRate exists
            if (selectedRate) {
                $('input[name="ratingValue"][value="' + selectedRate + '"]').prop('checked', true);
            }
        });


        $('#ratebtn').on('click', function () {
            const selectedRating = $('input[name="ratingValue"]:checked').val();

            if (!selectedRating) {
                alert('PleaseSelectRating');
                return;
            }

            if (!currentCourseId) {
                alert('ErrorOccurred');
                return;
            }

            $.ajax({
                url: '/Member/Course/DoRate',
                method: 'POST',
                data: {
                    ratingValue: selectedRating,
                    id: currentCourseId
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    $('#ratingModal').modal('hide');
                    location.reload();
                },
                error: function () {
                }
            });
        });


    </script>

    <style>
        .toast-success {
            background-color: #09b080 !important; /* purple */
            color: #fff !important;
        }
    </style>
    @if (ViewData["ShowToastrLoginSuccesfullyLoggedIn"] != null && (bool)ViewData["ShowToastrLoginSuccesfullyLoggedIn"] == true)
    {
        <script>
            // Toaster For you Logged In Succesfully
            function ShowToastrLoginSuccesfullyLoggedIn() {
              toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-center",
                "timeOut": "3000",

              };
              var textmessage ='@Html.Raw(Resource1.HelloYouloggedInSuccessfully)';

              toastr.success(textmessage);
            }
        </script>
    }

    @if (ViewData["ShowToastrLoginSuccesfullyLoggedIn"] == null || (bool)ViewData["ShowToastrLoginSuccesfullyLoggedIn"] == false)
    {
        <script>
            // Toaster For Not Logged In Now
            function ShowToastrLoginSuccesfullyLoggedIn() {
              console.log("No Toastr to show");
            }
        </script>
    }

} *@