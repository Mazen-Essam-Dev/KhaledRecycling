@model MemberVM
@using Domain.Resources

@{
    ViewData["Title"] = Resource2.MemberDetails ?? " ";
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link href="~/assets/css/reportlayout.css" rel="stylesheet" />
    <title>@ViewData["Title"]</title>
</head>



<body>
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap border-black  border-bottom p-3  mb-3">
            
            <div class="d-flex justify-content-end align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                </div>
            </div>

            <div class="flex-fill text-center">
                <center>
                    <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
                </center>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
                </div>
            </div>

        </div>


        <main class="main-margin" dir="rtl">
            <div class="text-center ">
                <h3 class="text-danger my-3 fw-bold">@ViewData["Title"]</h3>
                <p class="date" id="currentDate"></p>
            </div>

            <div class="report-content">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        @if (!string.IsNullOrEmpty(Model?.ProfileImagePath))
                        {
                            <div class="col-md-10 mg-2 mt-1 ms-3 m-4">
                                <div class="card shadow-sm">
                                    <div class="card-body text-center">
                                        <img src="~/@Model.ProfileImagePath" class="img-fluid rounded" style="max-height: 200px;" alt="@Resource2.Selfie" />
                                        <div class="text-muted small mt-2">@Resource2.MemberImage</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="  details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        <h5>@Resource2.Code</h5>
                        <span>@Model?.Code</span>
                    </div>
                </div>
            </div>

            <div class="report-content gx-3  ">
                <div class="  details ">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        <h5>@Resource1.MemberNameAr</h5>
                        <span>@Model?.FullNameAr</span>
                    </div>
                </div>
                <div class="  details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        <h5>@Resource1.MemberNameEn</h5>
                        <span>@Model?.FullNameEn</span>
                    </div>
                </div>
            </div>

            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.Nationality</h5>
                        <span>@Model?.Nationality?.NameAr</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        <h5>@Resource2.Gender</h5>
                        <span>
                            @((ViewBag.Genders as IEnumerable<SelectListItem>)?.FirstOrDefault(g => g.Value == Model?.GenderId.ToString())?.Text)
                        </span>
                    </div>
                </div>
            </div>

            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.DateOfBirth</h5>
                        <span>@Model?.DateOfBirth?.ToString("d")?.Replace("/","-")</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        <h5>@Resource2.Age</h5>
                        <span>@Model?.Age</span>
                    </div>
                </div>
            </div>

            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource1.PhoneNumber</h5>
                        <span>@Model?.PhoneNumber</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        <h5>@Resource2.City</h5>
                        <span>
                            @(Model?.CitiesList?.FirstOrDefault(c => c.Value == Model.CityId.ToString())?.Text)
                        </span>
                    </div>
                </div>
            </div>

            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        <h5>@Resource2.Profession</h5>
                        <span>@((ViewBag.Professions as IEnumerable<SelectListItem>)?.FirstOrDefault(g => g.Value == Model?.ProfessionId.ToString())?.Text)</span>
                    </div>
                </div>

                <div class="details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">

                        @if (Model != null && Model.ProfessionId.HasValue && Model.ProfessionId.Value == (int)Profession.Employee)
                        {
                            <h5>@Resource2.Profession</h5>
                            <span>@Model?.Profession</span>
                        }
                        else
                        {
                            <h5>@Resource1.FatherProfession</h5>
                            <span>@Model?.GuardianProfession</span>
                        }

                    </div>
                </div>
            </div>

            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.Address</h5>
                        <span>@Model?.Address</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.Email</h5>
                        <span>@Model?.Email</span>
                    </div>
                </div>
            </div>
            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.IdNumber</h5>
                        <span>@Model?.IdNumber</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.IdExpiryDate</h5>
                        <span>@Model?.IdExpiryDate?.ToString("d")?.Replace("/","-")</span>
                    </div>
                </div>
            </div>
            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.AcademicQualification</h5>
                        <span>@Model?.AcademicQualification</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.EducationInstitution</h5>
                        <span>@Model?.EducationInstitution</span>
                    </div>
                </div>
            </div>
            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.Hobby</h5>
                        <span>@Model?.Hobby</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.LanguagesYouSpeak</h5>
                        <span>@Model?.Languages</span>
                    </div>
                </div>
            </div>
            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.Facebook</h5>
                        <span>@Model?.Facebook</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.Xplatform</h5>
                        <span>@Model?.Xplatform</span>
                    </div>
                </div>
            </div>
            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.Instagram</h5>
                        <span>@Model?.Instagram</span>
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5 d-flex flex-column ">
                        <h5>@Resource2.HeardBy</h5>
                        <span>@((ViewBag.HeardBySources as IEnumerable<SelectListItem>)?.FirstOrDefault(g => g.Value == Model?.HeardBy.ToString())?.Text)</span>
                    </div>
                </div>
            </div>

            <div class="report-content gx-3">
                <div class="details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        @if (!string.IsNullOrEmpty(Model?.IdImagePath))
                        {
                            <div class="col-md-10 mg-2 mt-1 ms-3 m-4">
                                <div class="card shadow-sm">
                                    <div class="card-body text-center">
                                        <img src="~/@Model?.IdImagePath" class="img-fluid rounded" style="max-height: 200px;" alt="Upload one" />
                                        <div class="text-muted small mt-2">@Resource2.IdImage</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="details">
                    <div class="pt-3 pb-3 pe-5  d-flex flex-column ">
                        @if (!string.IsNullOrEmpty(Model?.PassportImagePath))
                        {
                            <div class="col-md-10 mg-2 mt-1 ms-3 m-4">
                                <div class="card shadow-sm">
                                    <div class="card-body text-center">
                                        <img src="~/@Model?.PassportImagePath" class="img-fluid rounded" style="max-height: 200px;" alt="Upload one" />
                                        <div class="text-muted small mt-2">@Resource2.PassportImage</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </main>
    </div>
    <script>

        // This Part Is Important
        window.addEventListener('load', () => {
            setTimeout(() => document.getElementById('loadingOverlay').style.display = 'none', 500);
            setTimeout(() => window.print(), 800);
        });
         // Close window after printing
            window.onafterprint = function() {
                setTimeout(function() {
                    window.close();
                }, 500);
            };


        // Get today's date
        const today = new Date();

        // Format date
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        const formattedDate = today.toLocaleDateString(undefined, options);

        // Display date
        document.getElementById('currentDate').textContent = formattedDate;

    </script>
</body>

</html>

