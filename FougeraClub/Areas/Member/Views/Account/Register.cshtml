    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const Arabic = {
                weekdays: {
                    shorthand: ['أحد', 'اثنين', 'ثلاثاء', 'أربعاء', 'خميس', 'جمعه', 'سبت'],
                    longhand: ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'],
                },
                months: {
                    shorthand: ['ينا', 'فبر', 'مار', 'أب', 'ماي', 'يون', 'يول', 'أغس', 'سبت', 'أكت', 'نوف', 'ديس'],
                    longhand: ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'],
                },
                firstDayOfWeek: 6,
                ordinal: function() { return ""; },
                rangeSeparator: ' إلى ',
                weekAbbreviation: 'أسبوع',
                scrollTitle: 'قم بالتمرير للتغيير',
                toggleTitle: 'انقر للتبديل',
                time_24hr: true
            };

            const datePickers = [];

            document.querySelectorAll('input[type="date"]').forEach(input => {

                input.setAttribute("placeholder", "YYYY-MM-DD");

                const instance = flatpickr(input, {
                    allowInput: true,
                    dateFormat: "Y-m-d",
                    locale: Arabic,
                    disableMobile: true,
                    onChange: function (selectedDates, dateStr, instance) {
                        input.classList.remove("is-empty");
                    },
                    onClose: function(selectedDates, dateStr, instance) {
                        if (!input.value) {
                            input.classList.add("is-empty");
                        }
                    }
                });

                datePickers.push(instance);
            });


            const btnClearFilters = document.getElementById("btnClearFilters");
            if (btnClearFilters) {
                btnClearFilters.addEventListener("click", () => {
                    datePickers.forEach(instance => {
                        const input = instance.input;
                        instance.clear();
                        input.classList.add("is-empty");
                    });
                });
            }
        });
    </script>


