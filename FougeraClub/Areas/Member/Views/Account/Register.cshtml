                                    @Resource2.PassportImage
                                </label>


                                <div class="input-group  d-flex align-items-center">
                                    <input type="file" class="form-control rounded-2 " accept=".jpg,.jpeg,.png" asp-for="PassportImage">

                                    <label class="upload-file-rtl  upload-file-ltr rounded-2  upload-file-hover  " asp-for="PassportImage"><i class="fa-solid fa-upload fa-xl"></i></label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.PassportImagePath))
                                {
                                    <div class="mt-2">
                                        <img src="~/@Model.PassportImagePath" alt="Uploaded image" style="max-width: 150px; border-radius: 8px;" />
