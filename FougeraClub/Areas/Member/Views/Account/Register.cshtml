                        <div class="col-md-12">
                            <label asp-for="Hobby" class="form-label asteriskRequired">@Resource2.Hobby</label>
                            <textarea asp-for="Hobby" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Hobby" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Languages" class="form-label asteriskRequired">@Resource2.LanguagesYouSpeak</label>
                            <textarea asp-for="Languages" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Languages" class="text-danger small"></span>
                        </div>
                    </div></div>


                  
                
                        <div class="row">
                            <div class="col-md-12 mt-3">
                                <div class="text-left sec-title">
                                    <div class="lg-title">
                                        <h1>@Resource2.SocialMedia</h1>
                                    </div>
                                    <div class="title-sep-left"></div>
                                    <div class="title-sep-sm-left"></div>
                                </div>
                            </div>
                        </div>
                        <div class="c-edit-form ">
                            <div class="row">

                        <div class="col-md-4">
                            <label asp-for="Facebook" class="form-label">@Resource2.Facebook</label>
                            <input asp-for="Facebook" class="form-control" />
                            <span asp-validation-for="Facebook" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Xplatform" class="form-label">@Resource2.Xplatform</label>
                            <input asp-for="Xplatform" class="form-control" />
                            <span asp-validation-for="Xplatform" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Instagram" class="form-label">@Resource2.Instagram</label>
                            <input asp-for="Instagram" class="form-control" />
                            <span asp-validation-for="Instagram" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="mb-2  me-2 form-label" style="margin-top:1rem;">@Resource2.HeardBy</label>
                            @foreach (var item in Html.GetEnumSelectList<HeardBySources>() ?? Enumerable.Empty<SelectListItem>())
                            {
                                <div class="form-check form-check-inline" style="margin-top:1rem;">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="HeardBy"
                                           id="heardby_@item.Value"
                                           value="@item.Value"
                                           @(Model.HeardBy?.ToString() == item.Value ? "checked" : "") />
                                    <label class="form-check-label" for="heardby_@item.Value">
                                        @item.Text
                                    </label>
                                </div>
                            }
                            <span asp-validation-for="HeardBy" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="mb-2  me-2 form-label asteriskRequired">@Resource2.LicensePhotographSocialMedia</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="radio"
                                       name="License"
                                       id="LicenseYes"
                                       value="true"
                                       @(Model.License == true ? "checked" : "") />
                                <label class="form-check-label" for="LicenseYes">@Resource2.Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="radio"
                                       name="License"
                                       id="LicenseNo"
                                       value="false"
                                       @(Model.License == false ? "checked" : "") />
                                <label class="form-check-label" for="LicenseNo">@Resource2.No</label>
                            </div>
                            <span asp-validation-for="License" class="text-danger small"></span>
                        </div>
                    </div></div>


              
                   
                        <div class="row">
                            <div class="col-md-12 mt-3">
                                <div class="text-left sec-title">
                                    <div class="lg-title">
                                        <h1>@Resource2.LoginData</h1>
                                    </div>
                                    <div class="title-sep-left"></div>
                                    <div class="title-sep-sm-left"></div>
                                </div>
                            </div>
                        </div>
                        <div class="c-edit-form ">
                            <div class="row">
                        <div class="col-md-12">
                            <label asp-for="Email" class="form-label asteriskRequired">@Resource2.Email</label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <div class="position-relative">
                                <label asp-for="Password" class="form-label asteriskRequired">@Resource2.Password &nbsp;&nbsp;</label>

                                <div class="input-group">
                                    <input asp-for="Password" class="form-control" type="password" id="Password" />
                                    <button type="button" class="btn btn-success h-36"
                                            onclick="togglePassword('Password', this)">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                                <span class="text-danger small" style="font-size:12.3px;">@Resource1.PasswordShouldBe3</span>
                                @* <span asp-validation-for="Password" class="text-danger small"></span> *@
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="position-relative">
                                <label asp-for="ConfirmPassword" class="form-label asteriskRequired">@Resource2.ConfirmPassword</label>

                                <div class="input-group">
                                    <input asp-for="ConfirmPassword" class="form-control" type="password" id="ConfirmPassword" />
                                    <button type="button" class="btn btn-success h-36"
                                            onclick="togglePassword('ConfirmPassword', this)">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                    </div>
                        </div>


                 
 
                            <div class="row">
                                <div class="col-md-12 mt-3">
                                    <div class="text-left sec-title">
                                        <div class="lg-title">
                                            <h1>@Resource2.AttachedFiles</h1>
                                        </div>
                                        <div class="title-sep-left"></div>
                                        <div class="title-sep-sm-left"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="c-edit-form ">
                                <div class="row">
                        <div class="col-md-4 col-12">
                            <div class="mb-3">
                                <label asp-for="ProfileImage" class="form-label asteriskRequired d-flex justify-content-between">
                                    @Resource2.Selfie
                                </label>


                                <div class="input-group  d-flex align-items-center">
                                    <input type="file" class="form-control rounded-2 " accept=".jpg,.jpeg,.png" asp-for="ProfileImage">

                                    <label class="upload-file-rtl upload-file-ltr rounded-2  upload-file-hover  " asp-for="ProfileImage"><i class="fa-solid fa-upload fa-xl"></i></label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                                {
                                    <div class="mt-2">
                                        <img src="~/@Model.ProfileImagePath" alt="Uploaded image" style="max-width: 150px; border-radius: 8px;" />
                                    </div>
                                }
                                else
                                {
                                    <span asp-validation-for="ProfileImage" class="text-danger small"></span>
                                }
                            </div>


                        </div>
                        <div class="col-md-4 col-12">
                            <div class="mb-3">
                                <label asp-for="IdImage" class="form-label asteriskRequired d-flex justify-content-between">
                                    @Resource2.IdImage
                                </label>

                                <div class="input-group  d-flex align-items-center">
                                    <input type="file" class="form-control rounded-2 " accept=".jpg,.jpeg,.png" asp-for="IdImage">

                                    <label class="upload-file-rtl  upload-file-ltr rounded-2  upload-file-hover  " asp-for="IdImage"><i class="fa-solid fa-upload fa-xl"></i></label>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.IdImagePath))
                                {
                                    <div class="mt-2">
                                        <img src="~/@Model.IdImagePath" alt="Uploaded image" style="max-width: 150px; border-radius: 8px;" />
                                    </div>
                                }
