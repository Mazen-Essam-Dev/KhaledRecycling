@model MemberRegisterVM
@{
    ViewData["Title"] = Resource2.CreateNewAccount;
    Layout = "_AuthLayout";
}

@{
    var lang = Context.Session.GetString("CurrentCulture") ?? "ar";
}
@if (lang == "ar")
{
    <link href="~/ar/assets/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/ar/assets/css/index-rtl.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>

}
else
{
    <link href="~/en/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/en/assets/css/index-ltr.css" rel="stylesheet" />
}
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<!-- jQuery (required for Select2) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<style>
    input[type="date"] {
        color: #000;
        -webkit-text-fill-color: #000;
    }


        input[type="date"].is-empty {
            color: #999 !important;
            -webkit-text-fill-color: #999 !important;
        }


    .flatpickr-day.selected, .flatpickr-day.startRange, .flatpickr-day.endRange, .flatpickr-day.selected.inRange, .flatpickr-day.startRange.inRange, .flatpickr-day.endRange.inRange, .flatpickr-day.selected:focus, .flatpickr-day.startRange:focus, .flatpickr-day.endRange:focus, .flatpickr-day.selected:hover, .flatpickr-day.startRange:hover, .flatpickr-day.endRange:hover, .flatpickr-day.selected.prevMonthDay, .flatpickr-day.startRange.prevMonthDay, .flatpickr-day.endRange.prevMonthDay, .flatpickr-day.selected.nextMonthDay, .flatpickr-day.startRange.nextMonthDay, .flatpickr-day.endRange.nextMonthDay {
        background: #47A644 !important;
        -webkit-box-shadow: none;
        box-shadow: none;
        color: #fff;
        border-color: #47A644 !important;
    }

    .bg-dangers {
        border: 1px solid #af1717;
        color: #fff;
        background: #af1717;
        right: -8px;
        top: -10px;
        position: absolute;
    }
    .btn-cancel-search {
        color: #fff;
        background: #A0D977;
        box-shadow: none;
        border: 1px solid #A0D977;
    }

        .btn-cancel-search:hover {
            color: #fff;
            background: var(--primary-dark) !important;
            box-shadow: none;
            border: 1px solid var(--primary-dark) !important;
        }
</style>
<section class="bg-bread">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="text-center">
                <h3 class="fw-bold text-center"> @Resource2.CreateNewAccount </h3>
                    <div class="h-decor"></div>
                    <h3 class=" fs-5 mr-1 mt-2">@Resource3.PersonalInformation</h3>
                </div>
            </div>
        </div>
    </div>
</section>
@* <div asp-validation-summary="All" class="text-danger"></div> *@
<form asp-action="Register" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="container">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <!-- Personal Info -->
            <div class="section">
           
            <div class="">
                <div class="row">
                    <div class="col-md-12 mt-3">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@Resource1.BasicData</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
                    </div>
                </div>
                <div class="c-edit-form ">
                    <div class="row">

                        @* <div class="col-md-6"> *@
                            @* <label asp-for="Code" class="form-label">@Resource2.Code</label> *@
                            <input asp-for="Code" readonly type="number" class="form-control" hidden/>
                            @* <span asp-validation-for="Code" class="text-danger small"></span> *@
                        @* </div> *@

                        <div class="col-md-4">
                            <label asp-for="FullNameAr" class="form-label asteriskRequired">@Resource1.MemberNameAr</label>
                            <input asp-for="FullNameAr" class="form-control" />
                            <span asp-validation-for="FullNameAr" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FullNameEn" class="form-label asteriskRequired">@Resource1.MemberNameEn</label>
                            <input asp-for="FullNameEn" class="form-control" />
                            <span asp-validation-for="FullNameEn" class="text-danger small"></span>
                        </div>

                        <div class="col-md-2">
                            <label class="mb-2 d-block form-label asteriskRequired">@Resource2.Gender</label>
                            @foreach (var item in Html.GetEnumSelectList<Gender>() ?? Enumerable.Empty<SelectListItem>())
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="GenderId"
                                           id="gender_@item.Value"
                                           value="@item.Value"
                                           @(Model.GenderId?.ToString() == item.Value ? "checked" : "") />
                                    <label class="form-check-label" for="gender_@item.Value">
                                        @item.Text
                                    </label>
                                </div>
                            }
                            <span asp-validation-for="GenderId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label class="mb-2 d-block form-label asteriskRequired">@Resource2.Type</label>
                            @foreach (var item in Html.GetEnumSelectList<MemberTypeEnum>() ?? Enumerable.Empty<SelectListItem>())
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="MemberTypeId"
                                           id="MemberType_@item.Value"
                                           value="@item.Value"
                                           @(Model.MemberTypeId?.ToString() == item.Value ? "checked" : "") />
                                    <label class="form-check-label" for="MemberType_@item.Value">
                                        @item.Text
                                    </label>
                                </div>
                            }
                            <span asp-validation-for="MemberTypeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NationalityId" class="form-label asteriskRequired">@Resource2.Nationality</label>
                            <select asp-for="NationalityId" id="NationalityId" name="NationalityId" class="form-select select2">
                                <option value="">@Resource2.SelectNationality</option>
                            </select>
                            <span asp-validation-for="NationalityId" class="text-danger small"></span>
                        </div>
                        <input hidden name="NationalityIdOld" id="NationalityIdOld" value="@Model.NationalityId" />
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label asteriskRequired">@Resource2.DateOfBirth</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                <input asp-for="DateOfBirth" type="date" class="form-control green-border form-control-sm filter-bordered" id="DateOfBirth" max="@AppDubaiTime.Now.AddDays(-1).ToString("yyyy-MM-dd")" />
                            </div>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Age" class="form-label" style="margin-top:.6rem;">@Resource2.Age</label>
                            <input asp-for="Age" type="number" class="form-control" id="Age" readonly />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PhoneNumber" class="form-label asteriskRequired">@Resource1.PhoneNumber</label>
                            <input asp-for="PhoneNumber" class="form-control only-integer" placeholder="@Resource1.PhonePlaceholder_10" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4" id="fatherPhoneWrapper" style="display: none;">
                            <label asp-for="FatherPhone" class="form-label asteriskRequired">@Resource2.FatherPhone</label>
                            <input asp-for="FatherPhone" class="form-control only-integer" placeholder="@Resource1.PhonePlaceholder_10" />
                            <span asp-validation-for="FatherPhone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4" id="motherPhoneWrapper" style="display: none;">
                            <label asp-for="MotherPhone" class="form-label asteriskRequired">@Resource2.MotherPhone</label>
                            <input asp-for="MotherPhone" class="form-control only-integer" placeholder="@Resource1.PhonePlaceholder_10" />
                            <span asp-validation-for="MotherPhone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CityId" class="form-label asteriskRequired">@Resource2.City</label>
                            @{ if (Model.CityId == null || Model.CityId == 0) { Model.CityId = 24; } }
                            <select asp-for="CityId" asp-items="Model.Cities" class="form-select">
                                <option value="">@Resource2.SelectCity</option>
                            </select>
                            <span asp-validation-for="CityId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="mb-2 d-block form-label asteriskRequired">@Resource2.Profession</label>
                            @foreach (var item in Html.GetEnumSelectList<Profession>() ?? Enumerable.Empty<SelectListItem>())
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="ProfessionId"
                                           id="profession_@item.Value"
                                           value="@item.Value"
                                           @(Model.ProfessionId?.ToString() == item.Value ? "checked" : "") />
                                    <label class="form-check-label" for="profession_@item.Value">
                                        @item.Text
                                    </label>
                                </div>
                            }
                            <span asp-validation-for="ProfessionId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4" id="professionWrapper" style="display: none;">
                            <label asp-for="Profession" class="form-label asteriskRequired">@Resource2.Profession</label>
                            <input asp-for="Profession" class="form-control" id="Profession" />
                            <span asp-validation-for="Profession" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4" id="ProfessionPlaceWrapper" style="display: none;">
                            <label asp-for="ProfessionPlace" class="form-label asteriskRequired">@Resource1.WorkLocation</label>
                            <input asp-for="ProfessionPlace" class="form-control" id="ProfessionPlace" />
                            <span asp-validation-for="ProfessionPlace" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4" id="guardianProfessionWrapper" style="display: none;">
                            <label asp-for="GuardianProfession" class="form-label asteriskRequired">@Resource1.FatherProfession</label>
                            <input asp-for="GuardianProfession" class="form-control" id="GuardianProfession" />
                            <span asp-validation-for="GuardianProfession" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label asteriskRequired">@Resource2.Address</label>
                            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                    </div>
                </div>


                 
            
                <div class="row">
                    <div class="col-md-12 mt-3">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@Resource2.IdInfo</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
                    </div>
                </div>
                <div class="c-edit-form ">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label asteriskRequired">@Resource1.IdNumber1</label>
                            <div class="d-flex gap-2">
                                <input id="g4" asp-for="g4" maxlength="1" dir="ltr" placeholder="X" class="custom-input text-center" style="max-width:50px" inputmode="numeric" />
                                <span>-</span>
                                <input id="g3" asp-for="g3" maxlength="7" dir="ltr" placeholder="XXXXXXX" class="custom-input text-center" style="max-width:130px" inputmode="numeric" />
                                <span>-</span>
                                <input id="g2" asp-for="g2" maxlength="4" dir="ltr" placeholder="XXXX" class="custom-input text-center" style="max-width:100px" inputmode="numeric" />
                                <span>-</span>
                                <input id="g1" asp-for="g1" maxlength="3" dir="ltr" placeholder="XXX" class="custom-input text-center" style="max-width:80px" inputmode="numeric" />
                            </div>
                            <input type="hidden" asp-for="IdNumber" id="IdNumber" />
                            <span asp-validation-for="IdNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdExpiryDate" class="form-label asteriskRequired">@Resource2.IdExpiryDate</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                <input asp-for="IdExpiryDate" type="date" class="form-control green-border form-control-sm filter-bordered" min="@AppDubaiTime.Now.AddDays(+1).ToString("yyyy-MM-dd")" />
                            </div>
                            <span asp-validation-for="IdExpiryDate" class="text-danger small"></span>
                        </div>
                    </div>
                    </div>

                
            
                        <div class="row">
                            <div class="col-md-12 mt-3">
                                <div class="text-left sec-title">
                                    <div class="lg-title">
                                        <h1>@Resource2.Qualifications</h1>
                                    </div>
                                    <div class="title-sep-left"></div>
                                    <div class="title-sep-sm-left"></div>
                                </div>
                            </div>
                        </div>
                        <div class="c-edit-form ">
                            <div class="row">
                        <div class="col-md-6">
                            <label asp-for="AcademicQualification" class="form-label asteriskRequired">@Resource2.AcademicQualification</label>
                            <input asp-for="AcademicQualification" class="form-control" />
                            <span asp-validation-for="AcademicQualification" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EducationInstitution" class="form-label asteriskRequired">@Resource2.EducationInstitution</label>
                            <input asp-for="EducationInstitution" class="form-control" />
                            <span asp-validation-for="EducationInstitution" class="text-danger small"></span>
