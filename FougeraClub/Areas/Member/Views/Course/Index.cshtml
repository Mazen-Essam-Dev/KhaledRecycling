@model List<CourseVM>
@{
    ViewData["Title"] = @Resource1.Courses;
    var dateOnlyNow = DateOnly.FromDateTime(AppDubaiTime.Now);

}
<style>
    .bg-lightgreen {
        background-color: #EAFDCB;
    }

</style>
<div class="content">


    <div class="content-inner">
        <div class="d-flex justify-content-end align-items-center gap-2 my-2 mx-1">
            <div>
                <span class="badge bg-lightgreen rounded-pill p-3 text-dark  border border-1 border-black">
                    @Resource3.Subscriber
                </span>
            </div>

        </div>
        <div class="data-part mt-0">
            <h3 class="home-second-title">@Resource1.Courses</h3>
            <div class="table-responsive" style="overflow-x:hidden">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">@Resource1.CourseDate</th>
                            <th scope="col">@Resource1.Department</th>
                            <th scope="col">@Resource1.Time</th>
                            <th scope="col">@Resource1.Location</th>
                            <th scope="col">@Resource1.CourseTitle</th>
                            <th scope="col">@Resource1.ControlTools</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="20" class="text-center p-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                        <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3">@Resource1.NoCourses</h5>
                                        <p class="mb-0">@Resource1.NoData</p>
                                    </div>
                                </td>
                            </tr>

                        }
                        else
                        {
                            string TRcolor;
                            string TDcolor;
                            foreach (var course in Model)
                            {
                                @if (course.Accepted.HasValue && course.Accepted.Value)
                                {
                                    TRcolor = "#EAFDCB";
                                    TDcolor = "#EAFDCB";
                                }
                                else
                                {
                                    TRcolor = "";
                                    TDcolor = "";
                                }
                                <tr style="background-color:@TRcolor;">
                                    <td>@course.StartDate?.ToString("d")?.Replace("/","-")</td>

                                    @if (SessionHelper.GetCurrentLanguage() == "ar")
                                    {
                                        <td>@course.Department?.NameAr</td>
                                        <td>@course.Time</td>
                                        <td>@course.Location</td>
                                        <td>@course.TitleAr</td>
                                    }
                                    else
                                    {
                                        <td>@course.Department?.NameEn</td>
                                        <td>@course.Time</td>
                                        <td>@course.Location</td>
                                        <td>@course.TitleEn</td>
                                    }

                                    <td>
                                        <div class="ms-3">

                                            <ul class="list-unstyled d-flex justify-content-start align-items-center">
                                                <!-- View Details -->
                                                <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                    data-bs-custom-class="custom-tooltip"
                                                    data-bs-title="@Resource1.Details2">
                                                    <div class="icon-bg show-course-btn" title="@Resource1.Details2" style="cursor: pointer;">
                                                        <i class="fa-solid fa-eye"
                                                           data-bs-toggle="modal"
                                                           data-course-id="@course.Id"
                                                           data-bs-target="#showCourseModal"></i>
                                                    </div>
                                                </li>

                                                <!-- Subscribe -->
                                                @if (course.Subscribed.HasValue && !course.Subscribed.Value && course.EndDate != null && course.EndDate >= DateOnly.FromDateTime(AppDubaiTime.Now.Date))
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.Subscribe_To_Course">
                                                        <a asp-controller="Course" asp-action="Subscribe" asp-route-id="@course.Id">
                                                            <div class="icon-bg" style="cursor: pointer;">
                                                                <i class="fa-solid fa-file-signature"></i>
                                                            </div>
                                                        </a>
                                                    </li>
                                                }
                                                else if (course.Accepted.HasValue && course.Accepted.Value)
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.youSubed">
                                                        <div>
                                                            <div class="icon-bg">
                                                                <i class="fa-solid fa-file-signature" style="color: #ccc!important;"></i>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                                else if (course.Accepted.HasValue && !course.Accepted.Value)
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.youRefuesd">
                                                        <div>
                                                            <div class="icon-bg">
                                                                <i class="fa-solid fa-file-signature" style="color: #ccc!important;"></i>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                                else if (course.Subscribed.HasValue && course.Subscribed.Value)
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.youWait">
                                                        <div>
                                                            <div class="icon-bg">
                                                                <i class="fa-solid fa-file-signature" style="color: #ccc!important;"></i>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                                else if (course.EndDate < DateOnly.FromDateTime(AppDubaiTime.Now.Date))
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.CourseCannotSubscribedExbired">
                                                        <div>
                                                            <div class="icon-bg">
                                                                <i class="fa-solid fa-file-signature" style="color: #ccc!important;"></i>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.CourseCannotSubscribed"> 
                                                        <div>
                                                            <div class="icon-bg">
                                                                <i class="fa-solid fa-file-signature" style="color: #ccc!important;"></i>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }

                                                <!-- Finished_course Ednded Time -->
                                                @if (dateOnlyNow > course.EndDate)
                                                {
                                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Finished_course">
                                                        <a class="icon-bg btn-control btn-icon btn-sm rounded-circle certificateBtn" style="cursor: pointer;background-color:@TDcolor;">
                                                            <i class="fa-solid fa-clipboard-check fs-6"></i>
                                                        </a>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource2.NotFinishedcourse">
                                                        <div class=" icon-bg disabled btn-control-dis  btn-control btn-icon rounded-circle certificateBtn">
                                                            <i class="fa-solid fa-clipboard-check fs-6" style="color: #ccc!important;"></i>
                                                        </div>
                                                    </span>
                                                }

                                                <!-- Rate -->
                                                @if (course.Subscribed.HasValue && course.Subscribed.Value /* && dateOnlyNow >= course.EndDate */)
                                                {
                                                    @if (course.Accepted.HasValue && course.Accepted.Value && course.Attendance.HasValue && course.Attendance.Value)
                                                    {
                                                        <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                            data-bs-custom-class="custom-tooltip"
                                                            data-bs-title="@Resource1.Rate2">
                                                            <a data-bs-toggle="modal"
                                                               data-bs-target="#ratingModal"
                                                               data-id="@course.Id"
                                                               data-rateid="@course.Id"
                                                               data-selectedrate="@course.selectedRate">
                                                                <div class="icon-bg" style="cursor: pointer;">
                                                                    <i class="fa-solid fa-star"></i>
                                                                </div>
                                                            </a>
                                                        </li>
                                                    }
                                                    else if (course.Accepted.HasValue && !course.Accepted.Value)
                                                    {
                                                        <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                            data-bs-custom-class="custom-tooltip"
                                                            data-bs-title="@Resource2.Rejected">
                                                            <a data-bs-target="#acceptanceModal"
                                                               class="open-acceptance-modal"
                                                               data-id="@course.Id"
                                                               data-acceptance="@course.Accepted"
                                                               data-notes="@course.RejectionNotes">
                                                                <div class="icon-bg" style="cursor: pointer;">
                                                                    <i class="fa-solid fa-close"></i>
                                                                </div>
                                                            </a>
                                                        </li>
                                                    }
                                                    else
                                                    {
                                                        <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                            data-bs-custom-class="custom-tooltip"
                                                            data-bs-title="@Resource1.Rate2">
                                                            <div> 
                                                                <div class="icon-bg">
                                                                    <i class="fa-solid fa-star" style="color: #ccc!important;"></i>
                                                                </div>
                                                            </div>
                                                        </li>
                                                    }
                                                }
                                                else
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.Rate2">
                                                        <div>
                                                            <div class="icon-bg">
                                                                <i class="fa-solid fa-star" style="color: #ccc!important;"></i>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                                
                                                <!-- Certificate and Finished Icons -->
                                                @if (course.selectedRate.HasValue && course.Attendance.HasValue && course.Attendance.Value && course.Accepted.HasValue && course.Accepted.Value @* && dateOnlyNow >= course.EndDate *@)
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.Certificate">
                                                        <a onclick="PrintCertificate(@course.SubscriptionId)">
                                                            <div class="icon-bg" style="cursor: pointer;">
                                                                <i class="fa-solid fa-certificate"></i>
                                                            </div>

                                                        </a>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li data-bs-toggle="tooltip" data-bs-placement="top"
                                                        data-bs-custom-class="custom-tooltip"
                                                        data-bs-title="@Resource1.Certificate">
                                                        <div class="disabled btn-control-dis ">
                                                            <div class="icon-bg">
                                                                <i class="fa-solid fa-certificate" style="color: #ccc!important;"></i>
                                                            </div>

                                                        </div>
                                                    </li>
                                                }

                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Acceptance Modal (View Only) -->
<div class="modal fade" id="acceptanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content rounded-3 shadow-lg">

            <!-- Header -->
            <div class="modal-header bg-light border-bottom-0">
                <h5 id="acceptanceModalLabel" class="modal-title fw-semibold">
                    @Resource2.SubscriptionStatus
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Resource2.Close"></button>
            </div>

            <!-- Body -->
            <div class="modal-body px-4 pb-3">
                <div class="mb-3 d-flex align-items-center">
                    <strong class="me-2">@Resource2.Status:</strong>
                    <span id="vAcceptance" class="badge px-3 py-2 fs-6"></span>
                </div>

                <div>
                    <strong class="d-block mb-1">@Resource2.Notes:</strong>
                    <div id="vNotes" class="text-muted small border rounded p-2 bg-light"></div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    @Resource2.Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Course Details Modal -->
<div class="modal fade" id="showCourseModal" tabindex="-1" aria-labelledby="showCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="showCourseModalLabel">@Resource1.Course_Data1</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editCourseForm">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">@Resource1.Specialization</label>
                            <input type="text" readonly class="form-control" id="department" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">@Resource1.CourseTitle</label>
                            <input type="text" readonly class="form-control" id="Title" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Resource1.StartDate</label>
                            <input type="text" readonly class="form-control" id="StartDate" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Resource1.EndDate</label>
                            <input type="text" readonly class="form-control" id="EndDate" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">@Resource1.Location</label>
                            <input type="text" readonly class="form-control" id="Location" required />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">@Resource1.Time</label>
                            <input type="text" readonly class="form-control" id="Time" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">@Resource1.Course_Data</label>
                            <textarea readonly class="form-control" id="Description" required></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-6">
                            <label class="form-label">@* @Resource1.CurrentAttachment *@ @Resource1.For_more_details_ClickHere</label>
                            <div class="">
                                <a class="btn btn-outline-secondary" id="attachmentPath" href="#" target="_blank">
                                    @Resource1.View_File1
                                </a>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button class="all-btn btn btn-secondary" data-bs-dismiss="modal">@Resource1.Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Rating Modal -->
<div class="modal fade" id="ratingModal" tabindex="-1" aria-labelledby="ratingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ratingModalLabel">@Resource1.CourseRate2</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <h4>@Resource2.PleaseSelectRating</h4>

                <div class="row">
                    <div class="col-md-3">
                        <label class="rate">
                            <input type="radio" name="ratingValue" value="5">
                            <div class="rate-card">
                                <img src="~/ar/assets/rate/very-happy-face.png" class="img-fluid">
                                <p>@Resource1.Excellent</p>
                            </div>
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label class="rate">
                            <input type="radio" name="ratingValue" value="4">
                            <div class="rate-card">
                                <img src="~/ar/assets/rate/happy-face.png" class="img-fluid">
                                <p>@Resource1.Good</p>
                            </div>
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label class="rate">
                            <input type="radio" name="ratingValue" value="3">
                            <div class="rate-card">
                                <img src="~/ar/assets/rate/smiling-face.png" class="img-fluid">
                                <p>@Resource1.Fair</p>
                            </div>
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label class="rate">
                            <input type="radio" name="ratingValue" value="2">
                            <div class="rate-card">
                                <img src="~/ar/assets/rate/sad-face.png" class="img-fluid">
                                <p>@Resource1.UnHappy</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="mt-4">
                    <button id="ratebtn" class="btn btn-success" type="button">
                        @Resource2.SubmitRating
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function (e) {
          const btn = e.target.closest('.open-acceptance-modal');
          if (!btn) return;

          e.preventDefault();

          const id = btn.dataset.id ?? '';
          const rawAcc = (btn.dataset.acceptance ?? '').toString().toLowerCase();
          const notes = btn.dataset.notes ?? '';

          // Normalize boolean / null values that might come as "True"/"False"/"".
          let isAccepted;
          if (rawAcc === 'true' || rawAcc === '1') isAccepted = true;
          else if (rawAcc === 'false' || rawAcc === '0') isAccepted = false;
          else isAccepted = null;

          const vAcceptance = document.getElementById('vAcceptance');
          if (isAccepted === false) {
            vAcceptance.textContent = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Resource2.Rejected))';
            vAcceptance.className = 'badge bg-danger';
          }

          document.getElementById('vNotes').textContent = notes || '—';

          // Show the modal programmatically
          const modalEl = document.getElementById('acceptanceModal');
          const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
          modal.show();
        });
    </script>

    <script>
        function PrintCertificate(subscriptionId) {
             const url = `/Member/Course/PrintCertificate?subscriptionId=${subscriptionId}`;
            //window.open(url, '_blank'); //old For open in newTab but this freeze main page
            // Open a standalone pop window (not a tab) so the original page doesn't freeze
            const printWindow = window.open(
                url,
                'printWindow',
                'width=1500,height=800,noopener,noreferrer'
            );
         }

        $(document).ready(function() {
            // Handle course details modal
            $('.show-course-btn').click(function() {
                var courseId = $(this).find('i').data('course-id');

                $.get('/Member/Course/GetCourse', { id: courseId }, function(data) {
                    $('#department').val(data.department);
                    $('#Title').val(data.title);
                    $('#StartDate').val(data.startDate);
                    $('#EndDate').val(data.endDate);
                    $('#Location').val(data.location);
                    $('#Time').val(data.time);
                    $('#Description').val(data.description);
                    if(data.attachmentPath !==null){
                        $('#attachmentPath').attr('href','../../'+data.attachmentPath);
                        $('#attachmentPath').attr('target','_blank');
                        $('#attachmentPath').removeClass('disabled');
                    }
                    else{
                        $('#attachmentPath').attr('href','#');
                        $('#attachmentPath').attr('target','_self');
                        $('#attachmentPath').addClass('disabled');
                    }
                });
            });

            // Handle rating submission
        let currentCourseId = null;

        $('#ratingModal').on('show.bs.modal', function(event) {
            const button = $(event.relatedTarget);
            currentCourseId = button.data('rateid');
            const selectedRate = button.data('selectedrate');

            // Clear previous selection
            $('input[name="ratingValue"]').prop('checked', false);

            // Preselect the radio if selectedDoRate exists
            if (selectedRate) {
                $('input[name="ratingValue"][value="' + selectedRate + '"]').prop('checked', true);
            }
        });


            $('#ratebtn').on('click', function() {
                const selectedRating = $('input[name="ratingValue"]:checked').val();

                if (!selectedRating) {
                    alert('PleaseSelectRating');
                    return;
                }

                if (!currentCourseId) {
                    alert('ErrorOccurred');
                    return;
                }

                $.ajax({
                    url: '/Member/Course/DoRate',
                    method: 'POST',
                    data: {
                        ratingValue: selectedRating,
                        id: currentCourseId
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        $('#ratingModal').modal('hide');
                        location.reload();
                    },
                    error: function() {
                    }
                });
            });
            });


    </script>
}