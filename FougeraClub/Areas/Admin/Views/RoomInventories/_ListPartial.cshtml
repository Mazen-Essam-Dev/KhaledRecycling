@model KhaledTeamRecycling.Areas.Admin.ViewModels.RoomInventory.RoomInventoryVM
@{
    var editPermission = PermissionScanner.ValidatePermission("RoomInventories", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("RoomInventories", "Delete");
}

<input type="hidden" id="NewCountRecords" value="@Model.TotalCount" />

<nav class="d-flex justify-content-end w-25 align-items-center gap-2 my-2" style="margin-right: auto !important;">
    <label for="pageSizeSelect" class="form-label mb-0" style="text-wrap-mode: nowrap;">Page Size:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width: 74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize ? "selected" : null)">@s</option>
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 80px;">No.</th>
                <th>Code</th>
                <th>Inventory</th>
                <th>Sub Waste</th>
                <th>اقصى كيلوات</th>
                <th>ممتليء (ك)</th>
                <th>محجوز (ك)</th>
                <th>فارغ (ك)</th>
                <th>فارغ (%)</th>
                <th>Description</th>
                <th style="width: 200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                var x = 0;
                foreach (var item in Model.Items)
                {
                    x++;
                    var maxKilo = item.MaxKilo ?? 0;
                    var filledKilo = item.FilledKilo ?? 0;
                    var reservedKilo = item.ReservedKilo ?? 0;

                    var Free = maxKilo - filledKilo - reservedKilo;

                    var FreePercentage = maxKilo > 0
                    ? (Free / maxKilo) * 100
                    : 100;

                    <tr>
                        <td>@x</td>
                        <td>@item.GenCode</td>
                        <td>@item.Inventory?.Name</td>
                        <td>@DisplayHelper.FormatMainSubName(item.SubWaste?.MainWaste?.NameAr, item.SubWaste?.MainWaste?.NameEn, item.SubWaste?.NameAr, item.SubWaste?.NameEn)</td>
                        <td>@item.MaxKilo?.ToString("F2")</td>
                        <td>@item.FilledKilo?.ToString("F2")</td>
                        <td>@item.ReservedKilo?.ToString("F2")</td>
                        <td>@((Free).ToString("F2")) </td>
                        <td>@((FreePercentage).ToString("F2")) %</td>
                        <td>@item.Description</td>
                        <td>
                            @if (editPermission)
                            {
                                <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                            }
                            @if (deletePermission)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-danger open-delete-modal"
                                        data-id="@item.Id"
                                        data-name="@(item.GenCode ?? "Item")">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center p-5">No data found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="@($"{Context.Request.Path}?page={Model.CurrentPage - 1}")" class="page-link ajax-page" data-page="@(Model.CurrentPage - 1)">Previous</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a href="@($"{Context.Request.Path}?page={i}")" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="@($"{Context.Request.Path}?page={Model.CurrentPage + 1}")" class="page-link ajax-page" data-page="@(Model.CurrentPage + 1)">Next</a>
        </li>
    </ul>
</nav>
