@model ExpenseAndReceiptVM
@{
    ViewData["Title pakage"] = @Resource2.FinancialManagement ?? " ";
    ViewData["Title Single"] = ((Model.Id == 0) ? @Resource2.AddExpenseAndReceipt : @Resource2.EditExpenseAndReceipt) ?? " ";
    ViewData["Title Single1E"] = ((Model.Id == 0) ? @Resource2.AddExpenseAndReceipt : @Resource2.EditExpense) ?? " ";
    ViewData["Title Single2R"] = ((Model.Id == 0) ? @Resource2.AddExpenseAndReceipt : @Resource2.EditReceipt) ?? " ";
    var isEdit = Model.Id != 0 ? true : false;
}

<style>
    #newAlignMaxbuttons {
        /* width: 40%; */
        /* align-items: center; */
        display: flex !important;
        justify-content: end !important;
        /* justify-content: center; */
        align-items: center !important;
        gap: 5px !important;
        margin-right: 20px !important;
    }
</style>

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <h4 class="ico-header-title">
            <i class="fa-solid fa-money-check-dollar me-1 text-ico"></i>
            @if (ViewBag.ItemType == ItemType.Expenses)
            {

@ViewData["Title Single1E"]

            }
            else if (ViewBag.ItemType == ItemType.Receipts)
            {

@ViewData["Title Single2R"]

            }
            else
            {

@ViewData["Title Single"]

            }
        </h4>
    </div>
    <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-end">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                @if (ViewBag.ItemType == ItemType.Expenses)
                {
                    <li class="breadcrumb-item">
                        <a href="/Admin/ExpenseAndReceipt/Expenses">@Resource2.ExpensesList</a>
                    </li>
                }
                else if (ViewBag.ItemType == ItemType.Receipts)
                {
                    <li class="breadcrumb-item">
                        <a href="/Admin/ExpenseAndReceipt/Receipts">@Resource2.ReceiptsList</a>
                    </li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a href="/Admin/ExpenseAndReceipt/Expenses">@Resource2.ExpensesList</a>
                    </li>
                }
                @if (ViewBag.ItemType == ItemType.Expenses)
                {
                    <li class="breadcrumb-item">
                        <a href="#">@ViewData["Title Single1E"]</a>
                    </li>
                }
                else if (ViewBag.ItemType == ItemType.Receipts)
                {
                    <li class="breadcrumb-item">
                        <a href="#">@ViewData["Title Single2R"]</a>
                    </li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a href="#">@ViewData["Title Single"]</a>
                    </li>
                }

            </ol>
        </nav>
    </div>
</div>
<div class="card border d-flex flex-wrap align-items-start p-3 c-pro ">
    <div class="container">
        <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ItemTypeId" />
            <input type="hidden" asp-for="Attachment_TempFilePath" />
            <input type="hidden" asp-for="Attachment_OldPath" />
            <div class="row d-flex justify-content-between align-items-center">
                <div class="col-md-2 mb-2">
                    <div class="d-flex pt-2 ">
                        <label class="form-label asteriskRequired"></label>
                        @if (isEdit)
                        {
                            @foreach (var item in Model.ItemTypesList)
                            {
                                if (item.Selected)
                                {
                                    <div class="form-check form-check-inline d-flex align-items-center" style="margin-top:.6rem;">
                                        <input class="form-check-input itemTypeRadio" disabled
                                               type="radio"
                                               name="ItemType"
                                               id="section_@item.Value"
                                               value="@item.Value"
                                               @(item.Selected ? "checked" : "") />
                                        <label class="form-check-label ms-1 fw-semibold" for="section_@item.Value">
                                            @item.Text
                                        </label>
                                    </div>
                                }
                            }
                            <input type="hidden" asp-for="ItemType" />
                        }
                        else
                        {
                            @foreach (var item in Model.ItemTypesList)
                            {
                                <div class="form-check form-check-inline d-flex align-items-center" style="margin-top:.6rem;">
                                    <input class="form-check-input itemTypeRadio"
                                           type="radio"
                                           name="ItemType"
                                           id="section_@item.Value"
                                           value="@item.Value"
                                           @(item.Selected ? "checked" : "") />
                                    <label class="form-check-label ms-1 fw-semibold" for="section_@item.Value">
                                        @item.Text
                                    </label>
                                </div>
                            }
                        }
                    </div>
                    <span id="ItemType22" class="text-danger"></span>
                </div>
                <div class="col-md-5 mb-2">
                    <label asp-for="ItemNumber" class="form-label asteriskRequired">@Resource2.ItemNumber </label>
                    <input asp-for="ItemNumber" class="form-control" />
                    <span asp-validation-for="ItemNumber" class="text-danger"></span>
                </div>
                <div class="col-md-5 mb-2">
                    <div class="filter-dropdown w-100">
                        <label asp-for="Date" class="form-label asteriskRequired">@Resource2.Date </label>
                        <div class="input-icon-left">
                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">

                            <input asp-for="Date" type="date" class="form-control green-border form-control-sm filter-bordered" min="2025-12-01">
                        </div>
                    </div>
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="col-md-12 BudgetItemDiv mb-2">
                    <label asp-for="BudgetItemId" class="form-label asteriskRequired">@Resource2.BudgetItem </label>
                <select asp-for="BudgetItemId" class="form-select select2" asp-items="Model?.BudgetItemsList">
                    <option value="">-- @Resource2.Select --</option>
                </select>
                <span asp-validation-for="BudgetItemId" class="text-danger"></span>
            </div>
                </div>
            <div class="row">
                <div class="col-md-6 ExpensesSectionDiv mb-2">
                    <label asp-for="ExpensesGateId" class="form-label asteriskRequired">@Resource2.ExpensesSection </label>
                    <select asp-for="ExpensesGateId" class="form-select" asp-items="Model?.ExpensesGateList">
                        <option value="">-- @Resource2.Select --</option>
                    </select>
                    <span asp-validation-for="ExpensesGateId" class="text-danger"></span>
                </div>

                <div class="col-md-6 ExpensesSourceDiv mb-2">
                    <label asp-for="ExpensesSourceId" class="form-label asteriskRequired">@Resource2.Source </label>
                    <select asp-for="ExpensesSourceId" class="form-select" asp-items="Model?.ExpensesSourcesList">
                        <option value="">-- @Resource2.Select --</option>
                    </select>
                    <span asp-validation-for="ExpensesSourceId" class="text-danger"></span>
                </div>

                <div class="col-md-6 SupplierDiv mb-2">
                    <label asp-for="SupplierId" class="form-label asteriskRequired">@Resource1.Destenation_Supplier </label>
                    <select asp-for="SupplierId" class="form-select select2" asp-items="Model?.SuppliersList" >
                        <option value="">-- @Resource2.Select --</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-2">
                    <label asp-for="Amount" class="form-label asteriskRequired">@Resource2.Amount </label>
                    <input asp-for="Amount" class="form-control" step="0.01" placeholder="0.00" min="0" type="number" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="col-md-12 VatDiv mb-2">
                    <label asp-for="Vat" class="form-label">VAT</label>
                    <input asp-for="Vat" class="form-control" step="0.01" placeholder="0.00" min="0" type="number" />
                    <span asp-validation-for="Vat" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-2">
                    <label asp-for="Notes" class="form-label asteriskRequired">@Resource1.Description </label>
                    <textarea asp-for="Notes" class="form-control" rows="3"  aria-required="true"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>


                <div class="col-md-12 ">
                    <div class="d-flex flex-column flex-lg-row">
                        <div style="width: 100%;">
                            <h5 class="form-label">@Resource2.UploadFile PDF</h5>

                            <div class="input-group mb-2  d-flex align-items-center">
                                <input type="file" class="form-control rounded-2 " accept=".pdf" asp-for="Attachment">
                                <label class="rounded-2 upload-file-rtl upload-file-hover upload-file-ltr " for="Attachment">
                                    <i class="fa-solid fa-upload fa-xl"></i>
                                </label>
                            </div>

                            @* Preview *@
                            @if (!string.IsNullOrEmpty(Model?.Attachment_TempFilePath))
                            {
                                @* <img src="~/@Model.Attachment_TempFilePath.Replace("wwwroot/", "")" class="img-thumbnail mt-2" style="max-height:140px;" /> *@
                                <a href="~/@Model.Attachment_TempFilePath.Replace("wwwroot/", "")" target="_blank" class="eye-ii">
                                    <i class="fa fa-eye"></i> @Resource3.ViewFile
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(Model?.Attachment_OldPath))
                            {
                                <a href="~/@Model.Attachment_OldPath" target="_blank" class="eye-ii">
                                    <i class="fa fa-eye"></i> @Resource3.ViewFile
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(Model?.AttachmentPath))
                            {
                                <a href="~/@Model.AttachmentPath" target="_blank" class="eye-ii">
                                    <i class="fa fa-eye"></i> @Resource3.ViewFile
                                </a>
                            }
                            <span class="text-danger small field-validation-valid" asp-validation-for="Attachment"></span>

                            <div class=""><span class="d-inline-block mt-0 text-red"> @Resource3.MaximumFileSize5MB </span></div>

                        </div>

                        <div class="mb-1 newAlignMaxbuttons" id="newAlignMaxbuttons">
                            @if (Model?.isSigned == true)
                            {
                                <button type="button" disabled class="btn-cancel-search btn btn-sm px-3">
                                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn-cancel-search btn btn-sm px-3">
                                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                                </button>
                            }


                            @if (ViewBag.ItemType == ItemType.Expenses)
                            {
                                <a asp-action="Expenses" class="btn btn-success btn-sm  px-3">
                                    <i class="fa-solid fa-arrow-left me-1"></i> @Resource2.Back
                                </a>
                            }
                            else
                            {
                                <a asp-action="Receipts" class="btn btn-success btn-sm  px-3">
                                    <i class="fa-solid fa-arrow-left me-1"></i> @Resource2.Back
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<style>
    .select2-container--default .select2-selection--single {
        min-height: calc(1.5em + 1rem);
        padding: .5rem .75rem;
    }

    .select2-selection__rendered {
        line-height: 1.8;
    }

</style>
@section Scripts {
    <script>
        $(document).ready(function () {
                    const minDate = "2025-12-01";
        const $dateInput = $('input[type="date"][name="Date"]');
        const $expensesSource = $('select[name="ExpensesSourceId"]');
        const miscId = '@((int)Domain.Enums.ExpensesSourceEnum.MiscellaneousExpenses)';

        function applyDateRule() {
            const selected = $expensesSource.val();
            if (selected && selected.toString() === miscId.toString()) {
                $dateInput.attr('min', minDate);
                if ($dateInput.val() && $dateInput.val() < minDate) {
                    $dateInput.val(minDate);
                }
            } else {
                $dateInput.removeAttr('min');
            }
        }

        // Apply on load
        applyDateRule();

        // Apply when source changes
        $expensesSource.on('change', function () {
            applyDateRule();
        });

            const $form = $('form');
            const $submitBtn = $form.find('button[type="submit"]');
            const $itemTypeRadios = $('.itemTypeRadio');
            const $itemTypeSpan = $('#ItemType22');
            const requiredtxt = "@Html.Raw(Resource1.RequredTypeExAnRe)";

            // Hide the error at the beginning
            $itemTypeSpan.hide();

            // When trying to send
            $form.on('submit', function (e) {
                const selected = $itemTypeRadios.filter(':checked').length > 0;

                if (!selected) {
                    e.preventDefault(); // Prevent transmission
                    $itemTypeSpan.text(requiredtxt).show(); // Display error
                    $submitBtn.prop('disabled', true); //  Disable button Submit
                }
            });

            

            // When the user selects a value
            $itemTypeRadios.on('change', function () {
                if ($itemTypeRadios.filter(':checked').length > 0) {
                    $itemTypeSpan.hide(); // Hide error
                    $submitBtn.prop('disabled', false); // Activate the button
                }
            });

            // if (@Model.Id == 0) {
            //     $('.itemTypeRadio').first().prop('checked', true);
            // }
            // Bind the change event first
            $(document).on('change', '.itemTypeRadio', function () {
                const selectedValue = $(this).val();
                $('#ItemTypeId').val(selectedValue);
                if (selectedValue == '@((int)ItemType.Receipts)') {
                    // For Receipts (مقبوضات): Show الجهة (Supplier), Hide المصدر (Expenses Source)
                    $('.BudgetItemDiv').hide();
                    $('.ExpensesSectionDiv').hide();
                    $('.VatDiv').hide();
                    $('.SupplierDiv').show();
                    // populate suppliers with category 2
                    populateSuppliers(2);
                } else {
                    // For Expenses: Show all
                    $('.BudgetItemDiv').show();
                    $('.ExpensesSectionDiv').show();
                    $('.ExpensesSourceDiv').show();
                    $('.VatDiv').show();
                    $('.SupplierDiv').show();
                    // populate all suppliers
                    populateSuppliers();
                }
            });

            var allSuppliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AllSuppliers ?? new List<object>()));
            var pageLang = '@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "ar" : "en")';

            // Now trigger it once for the pre-selected radio
            $('.itemTypeRadio:checked').trigger('change');

                function populateSuppliers(categoryId) {
                var list = allSuppliers || [];
                var filtered = list;
                if (categoryId !== undefined && categoryId !== null) {
                    filtered = list.filter(function (s) { return s.SupplierCategoryId == categoryId; });
                }
                var $select = $('select[asp-for="SupplierId"]');
                if ($select.length === 0) $select = $('#SupplierId');
                $select.empty();
                $select.append('<option value="">-- ' + '@Resource2.Select' + ' --</option>');
                var selectedId = '@Model.SupplierId';
                filtered.forEach(function (s) {
                    var text = (pageLang === 'ar') ? (s.SupplierNameAr || s.SupplierName) : (s.SupplierNameEn || s.SupplierName);
                    var sel = (s.Id == selectedId) ? ' selected' : '';
                    $select.append('<option value="' + s.Id + '"' + sel + '>' + text + '</option>');
                });
                    // If Select2 is applied, notify it that options changed
                    try {
                        if ($select.hasClass('select2') && jQuery.fn && jQuery.fn.select2) {
                            $select.trigger('change');
                        }
                    } catch (e) {
                        console.warn('Select2 update skipped', e);
                    }
            }
        });

    </script>
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script>
        (function initSelect2() {
            function doInit() {
                try {
                    var $sel = $('select.select2');
                    if ($sel.length && $.fn && $.fn.select2) {
                        $sel.each(function () { $(this).select2({ allowClear: false, width: '100%', dir: 'rtl' }); });
                    }
                } catch (e) {
                    console.warn('Select2 init failed', e);
                }
            }

            if (typeof jQuery === 'undefined') {
                console.warn('jQuery not found; skipping Select2 init');
                return;
            }

            if (jQuery.fn && jQuery.fn.select2) {
                doInit();
                return;
            }

            var script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
            script.onload = doInit;
            script.onerror = function () { console.error('Failed to load Select2 script'); };
            document.head.appendChild(script);
        })();
    </script>
}
