@model PaginatedList<ExpenseAndReceiptVM>
@{
    ViewData["Title"] = @Resource2.Expenses2 ?? " ";
    var receiptPermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Receipt");
    var editPermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("ExpenseAndReceipt", "Delete");
    var allIdsOfRecivingReciptsHasSignnedList = ViewBag.allIdsOfRecivingReciptsHasSignned as List<int>;
    if(allIdsOfRecivingReciptsHasSignnedList == null)
        allIdsOfRecivingReciptsHasSignnedList = new List<int>{ -1, -2 };
}
<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:7%;">@* @Resource2.ItemNumber *@ .No </th>
                <th>@Resource2.SpentAmount</th>
                <th style="width:7%;">VAT 5%</th>
                <th style="width:10%;">@Resource2.TotalAmount</th>
                <th>@Resource2.ExpenseNotes</th>
                <th>@Resource2.Item</th>
                <th style="width:8%;">المصدر</th>
                <th style="width:7%;">@Resource2.Date</th>
                <th>@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ItemNumber</td>
                        <td>@item.Amount</td>
                        <td>@item.Vat</td>
                        <td>@((item.Amount ?? 0) + (item.Vat ?? 0))</td>
                        <td>@(item.Notes ?? "-")</td>
                        <td>@item.BudgetItem?.ItemTitle</td>
                        @{ 
                            var expensesSources = ViewBag.ExpensesSourcesList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
                            string expenseSourceText = "-";
                            if (item.ExpensesSourceId.HasValue)
                            {
                                var found = expensesSources.FirstOrDefault(s => s.Value == item.ExpensesSourceId.Value.ToString());
                                expenseSourceText = found != null ? found.Text : item.ExpensesSourceId.Value.ToString();
                            }
                        }
                        <td>@expenseSourceText</td>
                        <td>@item.Date?.ToString("d")?.Replace("/","-")</td>
                        <td>
                            @* Preview attachment PDF (show disabled button when missing) *@
                            @if (!string.IsNullOrEmpty(item.AttachmentPath))
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource3.ViewFile">
                                    <a class="btn-control btn-icon btn-sm rounded-circle" href="~/@item.AttachmentPath" target="_blank" rel="noopener noreferrer">
                                        <i class="fa-solid fa-eye fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource3.ViewFile">
                                    <button type="button" disabled class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle" aria-disabled="true">
                                        <i class="fa-solid fa-eye fs-5"></i>
                                    </button>
                                </span>
                            }

                            @if (receiptPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="إيصال استلام">
                                    <a class="btn-control btn-icon btn-sm rounded-circle"
                                       asp-action="Receipt" asp-route-expenseId="@item.Id">
                                        <i class="fa-solid fa-file fs-5"></i>
                                    </a>
                                </span>
                            }
                            @if (editPermission /* && !allIdsOfRecivingReciptsHasSignnedList.Contains(item.Id) */) //inner To be AS ViewDetails 
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a class="btn-control btn-icon btn-sm rounded-circle"
                                       asp-action="AddEdit" asp-route-id="@item.Id" asp-route-itemType="@ItemType.Expenses">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            @if (deletePermission && !allIdsOfRecivingReciptsHasSignnedList.Contains(item.Id))
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" asp-route-itemType="@ItemType.Expenses" class="d-inline" method="post" data-swal="delete" data-message="@Resource2.Expense @item.ItemNumber">
                                    @Html.AntiForgeryToken()
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Delete">
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </span>
                                </form>
                            }
                            else
                            {
                                <form action="#" class="d-inline" method="post" data-swal="delete" data-message="@Resource2.Expense @item.ItemNumber">
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Delete">
                                        <button type="button" disabled class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </span>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
        @if (Model.Items.Count > 0)
        {
            <tfoot class="bg-grey" style="font-weight:700; font-size:calc(1em + 1px);">
                <tr>
                    <th> </th>
                    <th>@Model.Items[0].TotalAmount</th>
                    <th>@Model.Items[0].TotalVAT</th>
                    <th>@Model.Items[0].TotalAmountWithVAT</th>
                    <th colspan="5" style="color:red;">@Resource1.Totals</th>
                </tr>
            </tfoot>
        }
    </table>
</div>
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
