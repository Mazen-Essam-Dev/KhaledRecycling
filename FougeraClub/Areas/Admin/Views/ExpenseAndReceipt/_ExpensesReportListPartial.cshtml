
@using FougeraClub.Areas.Admin.ViewModels.ExpenseAndReceipts
@model ExpensesReportVM

@{
    ViewData["Title"] = @Resource2.Expenses2 ?? " ";
}
<input type="hidden" id="NewCountRecords" value="@Model?.PaginatedExpenses?.Count" />
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model?.PaginatedExpenses?.PageSize)">@s</option>
        }
        <option value="@Model?.PaginatedExpenses?.Count" selected="@(Model?.PaginatedExpenses?.PageSize == Model?.PaginatedExpenses?.Count)">@Resource2.All</option>
    </select>
</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:7%;">@* @Resource2.ItemNumber *@ .No</th>
                <th style="width:7%;">@Resource2.Date</th>
                <th>@Resource1.Description</th>
                <th>@Resource2.CompanyName</th>
                <th>@Resource2.ExpensesType</th>
                <th style="width:10%;">@Resource2.AmountWithoutVAT2</th>
                <th style="width:7%;">@Resource2.VAT2</th>
                <th>@Resource2.AmountWithVAT</th>
                <th>@Resource2.Balance</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.PaginatedExpenses == null || !Model.PaginatedExpenses.Items.Any())
            {
                <tr>
                    <td colspan="9" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.SelectYearAndMonthFirst</p>
                        </div>
                    </td>
                </tr>
            }
            else
                {
                <tr class="bg-grey">
                    <td></td>
                    <td></td>
                    <th>@Resource2.BeginningBalance</th>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <th>@(Model.BeginningBalance.ToString("F2"))</th>
                </tr>
    @if (!(Model == null || Model.PaginatedExpenses == null || !Model.PaginatedExpenses.Items.Any()))
    {
                foreach (var item in Model.PaginatedExpenses.Items)
                {
                    <tr>
                        <td>@item.ItemNumber</td>
                        <td>@item.Date.ToString("d")?.Replace("/","-")</td>
                        <td>@item.Notes</td>
                        <td>@item.SupplierName</td>
                        <td>@item.BudgetItem</td>
                        <td>@item.Amount.ToString("F2")</td>
                        <td>@item.Vat.ToString("F2")</td>
                        <td>@item.AmountWithVat.ToString("F2")</td>
                        <td>@item.Balance.ToString("F2")</td>
                    </tr>
                }
                <tr class="bg-grey">
                    <td></td>
                    <td></td>
                    <th>@Resource2.EndingBalance</th>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <th>@(Model.EndingBalance.ToString("F2"))</th>
                </tr>
            }
            }
        </tbody>
    </table>
</div>
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.PaginatedExpenses.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PaginatedExpenses.PageIndex - 1)">@Resource2.Previous</a>
        </li>
        @for (int i = 1; i <= Model.PaginatedExpenses.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PaginatedExpenses.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.PaginatedExpenses.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PaginatedExpenses.PageIndex + 1)">@Resource2.Next</a>
        </li>
    </ul>
</nav>
