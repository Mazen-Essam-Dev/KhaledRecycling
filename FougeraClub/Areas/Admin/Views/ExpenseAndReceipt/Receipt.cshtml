                        </center>
                    </div>
                    <div class="d-flex justify-content-end align-items-center flex-fill">
                        <div style="text-align:center">
                            <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                            <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                            <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                        </div>
                    </div>

                </div>
                <div class="d-flex justify-content-center">
                    <h1 class="text-center fs-3" style="color:#af1717; width:fit-content;font-size: 17px;font-weight: 700;">
                        ايصال
                        استلام</h1>
                </div>
                <div class="text-center">
                    <h3 class="fs-4"
                        style="color:#af1717; text-decoration: underline;text-decoration-color: #000;text-decoration-thickness: 1px;font-size: 17px;font-weight: 700;">
                        Receipt Voucher</h3>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <div class="w-50 text-start">
