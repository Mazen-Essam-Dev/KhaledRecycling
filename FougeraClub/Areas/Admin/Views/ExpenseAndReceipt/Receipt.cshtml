@model ReceivingReceiptVM
@using Application.Helpers
@{
    ViewData["Title"] = @Resource1.Receipt2 ?? " ";

    var boolSigned = (Model.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath));
}

<style>
    .form-label {
        margin-top: 5px;
    }

    .container {
        width: 100% !important;
        box-shadow: none !important;
        page-break-inside: avoid;
    }

    h5 {
        margin: 0;
        line-height: 1.4;
    }

    input {
        border: none;
        outline: none;
        background-color: transparent;
    }

    @@media print {

        #printArea {
            width: 800px !important;
            margin: 0 auto !important;
            padding: 0 !important;
        }

        body, html {
            width: 100%;
            overflow: visible !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            font-size: 13px;

        }

        body {
            background-image: none !important;
            box-shadow: none !important;
        }
        * {
            background: transparent !important;
            box-shadow: none !important;
            max-width: 100% !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    .print-none,
    .custom-navbar {
        display: none !important;
    }

    .row {
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .flex-fill {
        flex: 1 1 auto !important;
        min-width: 0 !important;
    }

    input {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        -webkit-appearance: none;
    }

    }
</style>

<script>
    function printDiv(divId) {
        window.print();
        document.body.innerHTML = originalPage;
        location.reload();
    }
</script>

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap print-none">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">وحدة إداره الماليات</a>
                </li>
                @{
                    var isFromReceipts = Model?.itemType == Domain.Enums.ItemType.Receipts;
                    var breadcrumbListLabel = isFromReceipts ? Resource2.ReceiptsList : Resource2.ExpensesList;
                    var breadcrumbListUrl = isFromReceipts ? Url.Action("Receipts", "ExpenseAndReceipt", new { area = "Admin" }) : Url.Action("Expenses", "ExpenseAndReceipt", new { area = "Admin" });
                }
                <li class="breadcrumb-item">
                    <a href="@breadcrumbListUrl">@breadcrumbListLabel</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@Resource2.AcknowledgmentReceipt2</a>
                </li>
            </ol>
        </nav>
    </div>
    <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-end gap-2 ">
            @if (Model.ManagerSignatureId == null || Model.ManagerSignatureId == 0)
            {
                <button type="submit" form="receiptForm" class="print-btn btn btn-success btn-sm">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                </button>
            }
            else
            {
                <button class="print-btn btn btn-success btn-sm" onclick="printDiv('printArea')"> <i
                        class="fa fa-print me-1"></i> @Resource2.Print</button>
            }
            <a href="@breadcrumbListUrl" class="btn btn-cancel-search btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> @Resource2.Back
            </a>
        </div>
    </div>

</div>


