                            class="w-100 border-dashed border-bottom border-1 border-black text-center"
                            style=" border-left:0; border-top:0; border-right:0" />
                    </div>
                    <div class="col-3 text-left fs-4 fw-normal" style="direction:ltr;">
                        <label asp-for="SumOfAmount" class="text-black">Sum Of Amount</label>
                    </div>
                </div>

                <!-- Being -->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-3 text-right fs-4 fw-normal">
                        <label asp-for="Being" class="text-black">وذلك عن</label>
                    </div>
                    <div class="col-6">
                        <input asp-for="Being" type="text" readonly="@(boolSigned ? "readonly" : null)"
                            class="w-100 border-dashed border-bottom border-1 border-black text-center"
                            style=" border-left:0; border-top:0; border-right:0; border-bottom:0;" />
                    </div>
                    <div class="col-3 text-left fs-4 fw-normal" style="direction:ltr;">
