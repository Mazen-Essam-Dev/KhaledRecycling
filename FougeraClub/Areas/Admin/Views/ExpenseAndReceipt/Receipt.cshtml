                        <span class="d-inline-block fs-5  border border-black">
                            <input asp-for="Date" readonly  type="date" class="fw-bold text-center border-0" />
                        </span>
                    </div>
                    <div class="w-50 text-end">
                        <span style="padding: 0 10px;font-size: 14px;font-weight: 700; min-width: 160px;"> رقم </span>
                        <span class="d-inline-block fs-5  border border-black">
                            <input asp-for="CodeSerial" readonly type="text" class="fw-bold text-center border-0"
                                style="color:#af1717 !important" />
                        </span>
                        @* <div class="mt-1">
                            <span style="padding: 0 10px;font-size: 13px;font-weight: 600;">@Resource2.ItemNumber</span>
                            <span class="d-inline-block fs-6  border border-black"> *@
                                <input asp-for="ItemNumber" readonly type="hidden" class="fw-bold text-center border-0" />
                        @*     </span>
                        </div> *@
                    </div>

                </div>
                <!-- Full Name -->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-3 text-right fs-4 fw-normal">
                        <label asp-for="Received" class="text-black" style="padding-top: 1px;">استلمنا من السيد</label>
                    </div>
                    <div class="col-6  border-dashed border-bottom border-1 border-black text-center">
                        <input asp-for="Received" readonly="@(boolSigned ? "readonly" : null)" type="text" class="w-100"
