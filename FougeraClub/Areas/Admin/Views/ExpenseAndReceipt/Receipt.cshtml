            <div style="display: flex; justify-content: center; align-items: start; gap: 200px; margin-top:15px; border-top:1px solid #000; padding-top:15px;">
                <div style="width: 20%; text-align: center; display: flex; flex-direction: column;">
                    <label class="form-label fw-semibold text-black">المستلم</label>
                    <label class="form-label fw-semibold text-black">receiver</label>
                </div>
                <div style="width: 20%; text-align: center; display: flex; flex-direction: column;">
                    <label class="form-label fw-semibold text-black">نادي الفجيرة العلمي</label>
                    <label class="form-label fw-semibold text-black">Fujairah Scientific Club</label>
                    <div class="small text-muted">
                        @if(Model.isSavedFull)
                        {
                            @if (Model.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath))
                            {
                                <img src="~/@Model.ManagerSignature.ImagePath" class="img-fluid" style="max-height: 100px;"
                                    alt="Manager Signature" />
                            }
                            else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager && await
                            PermissionScanner.CheckLoggedUserIfHasSignature())
                            {
