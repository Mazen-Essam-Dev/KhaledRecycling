@using FougeraClub.Areas.Admin.ViewModels.ArchivingDocument
@model PaginatedList<ArchivingDocumentVM>

@{
    ViewData["Title"] = @Resource1.ArchivingDocumentList ?? " ";
    ViewData["Title pakage"] = @Resource1.ArchivingDocumentManagement ?? " ";
    ViewData["Title Single"] = @Resource1.ArchivingDocumentList ?? " ";
    var addPermission = PermissionScanner.ValidatePermission("ArchivingDocument", "Add");
    var editPermission = PermissionScanner.ValidatePermission("ArchivingDocument", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("ArchivingDocument", "Delete");
}

<input type="hidden" id="NewCountRecords" value="@ViewBag.TotalCount" />


<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>

    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:6%">@* @Resource1.DocumentReferenceNumber *@ .No</th>
                <th>@Resource1.DocumentTitle1</th>
                <th style="width:11%">@Resource1.TypeDocument1</th>
                <th style="width:4%">@Resource1.Date</th>
                <th style="width:15%">@Resource1.DocumentAuthority</th>
                <th style="width:15%">التصنيف</th>
                <th style="width:9%">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr data-id="@item?.Id">
                        <td data-label="@Resource1.DocumentReferenceNumber">
                            <span class="fw-medium">@item?.DocumentReferenceNumber</span>
                        </td>
                        <td data-label="@Resource1.DocumentTitle1">
                            <span>@item?.Title</span>
                        </td>
                        <td data-label="@Resource1.TypeDocument1">
                            <span>@item?.TypeText</span>
                        </td>
                        <td data-label="@Resource1.Date">
                            <span>@item?.Date?.ToString("d")?.Replace("/","-")</span>
                        </td>
                        <td data-label="@Resource1.DocumentAuthority">
                            <span>@item?.Authority</span>
                        </td>
                        <td data-label="التصنيف">
                            <span>@item?.DocumentCategoryName</span>
                        </td>
                        <td data-label="@Resource2.Actions">
                            <!-- View File -->
                            @if (FileHelper.IsFileExist(item.PdfFilePath))
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.ViewDocumentFile">
                                    <a href="../../@item.PdfFilePath?.Replace("~", "")" target="_blank"
                                        class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-file fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.ViewDocumentFile">
                                    <a href="#" target="_self" class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-file fs-5"></i>
                                    </a>
                                </span>
                            }
                            <!-- Edit -->
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@item?.Id"
                                        class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            <!-- Delete -->
                            @if (deletePermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" asp-route-id="@item?.Id" data-swal="delete"
                                        data-message="@Resource1.ArchivingDocument1 @item?.Title" method="post" class="d-inline"
                                        onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                    <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>