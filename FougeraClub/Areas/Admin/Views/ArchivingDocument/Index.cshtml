@using FougeraClub.Areas.Admin.ViewModels.ArchivingDocument
@model PaginatedList<ArchivingDocumentVM>

@{
    ViewData["Title"] = @Resource1.ArchivingDocumentList ?? " ";
    ViewData["Title pakage"] = @Resource1.ArchivingDocumentManagement ?? " ";
    ViewData["Title Single"] = @Resource1.ArchivingDocumentList ?? " ";
    var addPermission = PermissionScanner.ValidatePermission("ArchivingDocument", "Add");
    var editPermission = PermissionScanner.ValidatePermission("ArchivingDocument", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("ArchivingDocument", "Delete");
}



<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count Display Column -->
    <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource1.RecordsCount:</span>
            <span id="recordsCount">@ViewBag.TotalCount</span>
        </div>

    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card">
            <!-- Header with actions + status badges -->
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title  my-1">
                            <i class="fa-solid fa-folder-open me-2 text-ico"></i> @Resource1.ArchivingDocumentList
                        </h4>
                    </div>
                </div>
                <!-- Right: actions -->
                <div class="d-flex align-items-center gap-2 flex-wrap" style="margin-left: 4px;">
                    @if (addPermission)
                    {
                        <a asp-action="AddEdit" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource2.CreateNew
                        </a>
                    }
                    <button type="button" class="btn btn-success btn-sm"
                        onclick="event.preventDefault(); openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>
                    <!-- Print Export As Excel -->
                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"
                            style="font-size:17px;"></i>@Resource1.createExcelReport_Download
                    </a>
                    <script>
                        function openPrintPage() {
                            const get = id => document.getElementById(id)?.value || '';
                            const searchTerm = encodeURIComponent(get('searchTermInput'));
                            const dateFrom = encodeURIComponent(get('dateFrom'));
                            const dateTo = encodeURIComponent(get('dateTo'));
                            const type = encodeURIComponent($('input[name="TypeSelected"]:checked').val() || '');
                            const category = encodeURIComponent(get('documentCategoryIdSelect'));
                            var countRecords = document.getElementById('recordsCount')?.textContent || '';
                            if (countRecords && parseInt(countRecords) > 3999) {
                                alert('Cannot print more than 3999 records.');
                            } else {
                                const url = `/Admin/ArchivingDocument/Print?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}&type=${type}&documentCategoryId=${category}`;
                                window.open(url, 'printWindow', 'width=1000,height=800,noopener,noreferrer');
                            }
                        }
                        function openExcelPage() {
                            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput')?.value || '');
                            const dateFrom = encodeURIComponent(document.getElementById('dateFrom')?.value || '');
                            const dateTo = encodeURIComponent(document.getElementById('dateTo')?.value || '');
                            const type = encodeURIComponent($('input[name="TypeSelected"]:checked').val() || '');
                            const category = encodeURIComponent(document.getElementById('documentCategoryIdSelect')?.value || '');
                            const url = `/Admin/ArchivingDocument/createExcelReport_Download?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}&type=${type}&documentCategoryId=${category}`;
                            window.open(url, '_self');
                        }
                    </script>
                </div>
            </div>

            <div class="rounded shadow-sm p-3">

                <!-- Search Panel -->
                <form class="filterImg rounded p-3" method="get" asp-action="Index">
                    <!-- ROW 1 : filters -->
                    <div class="row">
                        <div class="filter-dropdown col-md-3 mb-2">
                            <label for="searchTermInput" class="fw-bold mb-2">@Resource2.Search:</label>
                            <div class="search-box position-relative">
                                <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                <input type="text" name="searchTerm" id="searchTermInput" value="@Model.SearchTerm"
                                       class="form-control form-control-sm filter-bordered ps-4"
                                       placeholder="@Resource1.SearchbyDocumentTitleReferenceNumber" />
                            </div>
                        </div>

                        <div class="filter-dropdown col-md-3 mb-2">
                            <label for="dateFrom" class="fw-bold mb-2">@Resource1.DateFrom:</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" class="date-icon">
                                <input type="date" name="dateFrom" id="dateFrom"
                                       class="form-control form-control-sm filter-bordered"
                                       value="@Model.dateFrom" />
                            </div>
                        </div>

                        <div class="filter-dropdown col-md-3 mb-2">
                            <label for="dateTo" class="fw-bold mb-2">@Resource1.DateTo:</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" class="date-icon">
                                <input type="date" name="dateTo" id="dateTo"
                                       class="form-control form-control-sm filter-bordered"
                                       value="@Model.dateTo" />
                            </div>
                        </div>

                        <div class="filter-dropdown col-md-3 mb-2">
                            <label for="documentCategoryIdSelect" class="fw-bold mb-2">التصنيف</label>
                            @{
                                var selectedCat = ViewContext?.HttpContext?.Request?.Query["documentCategoryId"].FirstOrDefault() ?? "";
                            }
                            <select id="documentCategoryIdSelect" name="documentCategoryId"
                                    class="form-select form-select-sm filter-bordered">
                                <option value="">@Resource2.All</option>
                                @foreach (SelectListItem item in ViewBag.DocumentCategoryList ?? Enumerable.Empty<SelectListItem>())
                                {
                                    <option value="@item.Value" selected="@(item.Value == selectedCat)">
                                        @item.Text
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- ROW 2 : radios + buttons -->
                    <div class="row align-items-center mt-2">
                        <!-- Radios -->
                        <div class="col-md-9 d-flex align-items-center gap-4">
                            <!-- Main label -->
                            <label class="form-label fw-semibold mb-0">
                                @Resource2.Type
                            </label>

                            <!-- Radios -->
                            <div class="d-flex flex-wrap gap-4">
                                @foreach (var item in ViewBag.TypeEnumList ?? Enumerable.Empty<SelectListItem>())
                                {
                                    <div class="form-check mb-0">
                                        <input class="form-check-input typeradiobtn" type="radio"
                                               name="TypeSelected" id="TypeEnum_@item.Value"
                                               value="@item.Value" />
                                        <label class="form-check-label" for="TypeEnum_@item.Value">
                                            @item.Text
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>


                        <!-- Buttons -->
                        <div class="col-md-3 d-flex justify-content-end gap-3 mt-4 mt-md-0">
                            <button type="button" id="btnClearFilters" class="btn btn-cancel-search btn-sm">
                                <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                            </button>
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="ri-filter-line me-1"></i> @Resource1.Search
                            </button>
                        </div>
                    </div>

                </form>


                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ListPartial", Model)
                </div>
            </div>
        </div>
    </div>
</div>
                                
<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Resource1.DeleteMaintenance</h5>
                @Resource1.are_you_sure_Delete <strong id="itemName"></strong>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="itemId" />
                    <button type="button" class="btn btn-cancel-search"
                        data-bs-dismiss="modal">@Resource1.Cancel</button>
                    <button type="submit" class="btn btn-success">@Resource1.YesDelete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('itemId').value = id;
            document.getElementById('itemName').textContent = name;
        });
    </script>

    <script>
        $(document).on("click", ".show-delete-info", function () {
            var message = $(this).data("message"); // take message from data-attribute
            $("#deleteInfoMessage").text(message);

            var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
            modal.show();
        });

    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#dateFrom').val(filters.dateFrom);
                $('#dateTo').val(filters.dateTo);
                $('#pageSizeSelect').val(filters.pageSize);
                if (filters.type) {
                    $('input[name="TypeSelected"]').prop('checked', false);
                    $('input[name="TypeSelected"][value="' + filters.type + '"]').prop('checked', true);
                }
                $('#documentCategoryIdSelect').val(filters.documentCategoryId);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('input[name="TypeSelected"]').prop('checked', false);
                $('#searchTermInput').val('');
                $('#dateFrom').val('');
                $('#dateTo').val('');
                $('#documentCategoryIdSelect').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    dateFrom: $('#dateFrom').val(),
                    dateTo: $('#dateTo').val(),
                    type: $('input[name="TypeSelected"]:checked').val(),
                    documentCategoryId: $('#documentCategoryIdSelect').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var dateFrom = $('#dateFrom').val();
                var dateTo = $('#dateTo').val();
                var type = $('input[name="TypeSelected"]:checked').val();
                var documentCategoryId = $('#documentCategoryIdSelect').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/ArchivingDocument/Index',
                    type: 'GET',
                    data: { searchTerm, type, documentCategoryId, dateFrom, dateTo, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#recordsCount').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>
}