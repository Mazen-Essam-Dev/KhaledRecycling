@model CarServiceVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? Resource1.EditCarService : Resource1.CreateCarService;
    ViewData["Title pakage"] = @Resource1.CarsManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.CarsMaintenanceList ?? " ";
    ViewData["Title Single"] = (isEdit ? Resource1.EditCarService : Resource1.CreateCarService) ?? " ";

}

<style>
    #newAlignMaxbuttons {
        /* width: 40%; */
        /* align-items: center; */
        display: flex !important;
        justify-content: end !important;
        /* justify-content: center; */
        align-items: center !important;
        gap: 5px !important;
        margin-right: 20px !important;
    }
</style>

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <div class="d-flex align-items-center gap-2">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa fa-book me-2 text-ico"></span>
                @ViewData["Title"]
            </h4>
        </div>
    </div>
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-end" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item"><a href="/Admin/CarService/Index">@ViewData["Title ListIndex"]</a></li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
</div>
<div class="card all-borders p-3">
    <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" class="needs-validation" />
        <input type="hidden" asp-for="Attachment_TempFilePath" class="needs-validation" />
        <input type="hidden" asp-for="Attachment_OldPath" class="needs-validation" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CarId" class="form-label asteriskRequired">@Resource2.Car</label>
                @if (Model?.CarId != null && Model.CarId != 0)
                {
                    <input type="hidden" asp-for="CarId" />
                    <select asp-for="CarId" class="form-select" style="margin-top:4px;" asp-items="Model?.CarList" disabled>
                        <option value="">-- @Resource2.Select --</option>
                    </select>
                    <span asp-validation-for="CarId" class="text-danger small"></span>
                }
                else
                {
                    <select asp-for="CarId" class="form-select" style="margin-top:4px;"  asp-items="Model?.CarList">
                        <option value="">-- @Resource2.Select --</option>
                    </select>
                    <span asp-validation-for="CarId" class="text-danger small"></span>
                }
            </div>
            <div class="col-md-6 filter-dropdown">
                <label asp-for="Date" class="fw-medium asteriskRequired mb-2">@Resource2.Date</label>
                <div class="input-icon-left">
                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                    <input asp-for="Date" class="form-control green-border form-control-sm filter-bordered" type="date" />
                </div>
                <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Details" class="form-label asteriskRequired">@Resource1.MaintenanceDetails1</label>
                <textarea asp-for="Details" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Details" class="text-danger small"></span>
            </div>

            <div class="col-md-12 d-flex justify-content-end align-items-center my-2 gap-2 newAlignMaxbuttons" id="newAlignMaxbuttons">
                <button type="submit" class="btn-cancel-search btn btn-sm px-3">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                </button>
                <a asp-action="Index" class="btn btn-success btn-sm  px-3">
                    @Resource2.Back  <i class="fa-solid fa-arrow-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
