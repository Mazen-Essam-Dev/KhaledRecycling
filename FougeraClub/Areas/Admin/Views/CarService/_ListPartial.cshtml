@model PaginatedList<CarServiceVM>

@{
    var lang = SessionHelper.GetCurrentLanguage();
    ViewData["Title"] = Resource1.CarsMaintenanceList;
    ViewData["Title pakage"] = @Resource1.CarsManagement ?? " ";
    ViewData["Title Single"] = @Resource1.CarsMaintenanceList ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("CarService", "Add");
    var editPermission = PermissionScanner.ValidatePermission("CarService", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("CarService", "Delete");
}

<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>

    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:30%;">@Resource2.CarType</th>
                <th>@Resource1.MaintenanceDetails1</th>
                <th style="width:7%;">@Resource2.Date</th>

                @* <th style="width:10%;">@Resource2.CarNo</th>
                <th style="width:21%;">@Resource2.Model / @Resource2.Color</th>
                <th style="width:7%;">@Resource2.OwnershipExpiryDate</th> *@

                <th style="width:9%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr data-id="@item.Id">
                        <td data-label="@Resource2.CarType">@item?.Car?.Type</td>
                        <td data-label="@Resource1.MaintenanceDetails1">@item?.Details</td>
                        <td data-label="@Resource2.Date">@item?.Date?.ToString("d")?.Replace("/", "-")</td>

                        @* <td data-label="@Resource2.PlateNumber" class="fw-medium">@item?.Car?.PlateNumber</td>
                        <td data-label="@Resource2.Model">@item?.Car?.Model / @item?.Car?.Color</td>
                        <td data-label="@Resource2.OwnershipExpiryDate">
                            @(item?.Car?.OwnershipExpiryDate?.ToString("d")?.Replace("/","-"))</td> *@

                        <td data-label="@Resource2.Actions">
                            @* Attachment *@
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Attachments">
                                <button type="button"
                                    class="btn-control btn-icon btn-sm rounded-circle open-carservice-attachments-modal"
                                    data-carservice-id="@item.Id">
                                    <i class="fa-solid fa-paperclip fs-5"></i>
                                </button>
                            </span>

                            @* Edit Service *@
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@item.Id"
                                        class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }

                            @* Delete Service *@
                            @if (deletePermission)
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" data-swal="delete"
                                    data-message="@item?.Car?.Type">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoCars</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3 mb-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>