@model KhaledTeamRecycling.Areas.Admin.ViewModels.RoomGallery.RoomGalleryVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Room Gallery" : "Add Room Gallery";
}

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item"><a href="/Admin/RoomGalleries/Index">Room Galleries</a></li>
                <li class="breadcrumb-item"><a href="#">@ViewData["Title"]</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-6 d-flex justify-content-end align-items-center gap-2">
        <a asp-action="Index" class="btn btn-success btn-sm">
            Back <i class="fa-solid fa-arrow-left me-1"></i>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="d-flex justify-content-center c-pro border p-3 mb-3">
        <div class="flex-grow-1 d-flex justify-content-start align-items-center">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa fa-edit me-2 text-ico"></span>@ViewData["Title"]
            </h4>
        </div>
    </div>

    <div class="container">
        <form asp-action="AddEdit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="Id" />

            @* @if (Model.Id > 0)
            {
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <label class="form-label">Id</label>
                        <input type="text" class="form-control bg-light" value="@Model.Id" readonly disabled />
                    </div>
                </div>
            } *@

            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource1.BasicData</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="FkGallery">Gallery</label>
                        <select asp-for="FkGallery" class="form-select" asp-items="Model.GalleriesList">
                            <option value="">-- Select Gallery --</option>
                        </select>
                        <span asp-validation-for="FkGallery" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="FkSubProduct">Sub Waste</label>
                        <select asp-for="FkSubProduct" class="form-select" asp-items="Model.SubProductsList">
                            <option value="">-- Select Sub Waste --</option>
                        </select>
                        <span asp-validation-for="FkSubProduct" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="GenCode">Code</label>
                        <input asp-for="GenCode" class="form-control" />
                        <span asp-validation-for="GenCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="MaxUnits">Max Units</label>
                        <input asp-for="MaxUnits" type="number" step="any" placeholder="0" class="form-control " />
                        <span asp-validation-for="MaxUnits" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label" asp-for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-2 mb-4">
                <button type="submit" class="btn-cancel-search btn-sm btn">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
