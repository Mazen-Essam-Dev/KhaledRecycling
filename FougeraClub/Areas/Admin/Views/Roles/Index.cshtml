@using Infrastructure.Identity
@model IEnumerable<ApplicationRole>

@{
    ViewData["Title"] = Resource2.Roles;
    ViewData["Title pakage"] = "وحدة إدارة المستخدمين";
    ViewData["Title Single"] = Resource1.UserGroups ?? " ";
    var addPermission = PermissionScanner.ValidatePermission("Roles", "Create");
    var managePermission = PermissionScanner.ValidatePermission("Roles", "Manage");
    var deletePermission = PermissionScanner.ValidatePermission("Roles", "Delete");
    var filteredRoles = Model?.Where(r => !string.Equals(r?.Name, "Master", StringComparison.OrdinalIgnoreCase)).ToList() ??
    new List<ApplicationRole>();
    var filteredCount = filteredRoles.Count;
}

<!-- Breadcrumb & Record Count -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-6">
        <nav aria-label="breadcrumb" class="ms-2">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>

    <div class="col d-flex justify-content-end align-items-center text-nowrap me-3">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource1.RecordsCount:</span>
            <span>@filteredCount</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <i class="ri-shield-user-fill me-2 text-ico"></i> @Resource2.Roles
                        </h4>
                    </div>
                </div>
            </div>
            <div class="rounded shadow-sm p-3">
                @if (addPermission)
                {
                    <partial name="_CreateForm" model="new RoleFormVM()" />
                }
                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover table-striped">
                        <thead>
                            <tr>
                                <th style="width:90%;">@Resource2.RoleName</th>
                                <th>@Resource2.Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredRoles != null && filteredRoles.Any())
                            {
                                foreach (var role in filteredRoles)
                                {
                                    <tr>
                                        <td data-label="@Resource2.RoleName">
                                            <span class="fw-medium">@role.Name</span>
                                        </td>
                                        <td data-label="@Resource2.Actions">
                                            @* Manage Permissions *@
                                            @if (managePermission)
                                            {
                                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Permissions">
                                                    <a asp-action="Manage" asp-route-roleName="@role.Name"
                                                        class="btn-control btn-icon btn-sm rounded-circle">
                                                        <i class="ri-key-2-fill fs-5"></i>
                                                    </a>
                                                </span>
                                            }

                                            @* Edit Role Name*@
                                            @if (managePermission)
                                            {
                                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                                    <button type="button"
                                                        class="btn-control btn-icon btn-sm rounded-circle edit-role-btn"
                                                        data-bs-toggle="modal" data-bs-target="#editRoleModal"
                                                        data-rolename="@role.Name">
                                                        <i class="fa-solid fa-pen fs-5"></i>
                                                    </button>
                                                </span>
                                            }

                                            @* Delete *@
                                            @if (deletePermission && filteredCount > 1 && !(role.Name ==
                                                                                Role.SuperAdmin.ToString()) && (role.RoleNumber == (int)RoleNumber.NormalUser ||
                                                                                role.RoleNumber > (int)RoleNumber.Accountant)) // RoleNumber==1 or more than 4
                                            {
                                                <form asp-action="Delete" asp-route-roleName="@role.Name" class="d-inline"
                                                    method="post" data-swal="delete" data-message="@Resource1.TheRole @role.Name">
                                                    @Html.AntiForgeryToken()
                                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Delete">
                                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                                            <i class="fa-solid fa-trash fs-5"></i>
                                                        </button>
                                                    </span>
                                                </form>
                                            }
                                            else
                                            {
                                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                                    <button asp-action="#" disabled
                                                        class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                                        <i class="fa-solid fa-trash fs-5"></i>
                                                    </button>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center p-5">
                                        <div
                                            class="d-flex flex-column align-items-center justify-content-center text-muted">
                                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                            <h5 class="mt-3">@Resource1.NoRoles</h5>
                                            <p class="mb-0">@Resource1.NoRolesMessage</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* Edit Role Modal *@
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-white">
                <h5 class="modal-title" id="editRoleModalLabel">
                    <i class="fa-solid fa-pen me-2"></i>@Resource1.Editgroupname
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editRoleForm" method="post" action="@Url.Action("Manage", "Roles", new { area = "Admin" })">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editRole_roleName" name="roleName" />
                <input type="hidden" name="permissions" value="" />
                <div class="modal-body">
                    <div class="mb-2">
                        <label for="newRoleName" class="form-label">@Resource2.RoleName</label>
                        <input type="text" class="form-control" id="newRoleName" name="newRoleName" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel-search" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>@Resource2.Cancel
                    </button>
                    <button type="submit" class="btn btn-success ">
                        <i class="fa-solid fa-save me-1"></i>@Resource2.Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@* Delete Confirmation Modal *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@Resource2.ConfirmDelete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>@Resource2.ConfirmDelete</p>
                <p class="fw-bold" id="roleNameText"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel-search" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark me-1"></i>@Resource2.Cancel
                </button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="roleName" name="roleName" value="" />
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-trash me-1"></i>@Resource2.Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var roleName = button.getAttribute('data-rolename');
                deleteModal.querySelector('#roleNameText').textContent = '"' + roleName + '"';
                deleteModal.querySelector('#roleName').value = roleName;
            });
            var editRoleModal = document.getElementById('editRoleModal');
            var newRoleNameInput = document.getElementById('newRoleName');
            var roleNameHiddenInput = document.getElementById('editRole_roleName');

            editRoleModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var roleName = button.getAttribute('data-rolename');
                newRoleNameInput.value = roleName;
                roleNameHiddenInput.value = roleName;
            });
            $(document).on("click", ".show-delete-info", function () {
                var message = $(this).data("message");
                $("#deleteInfoMessage").text(message);
                var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
                modal.show();
            });
        });
    </script>
}