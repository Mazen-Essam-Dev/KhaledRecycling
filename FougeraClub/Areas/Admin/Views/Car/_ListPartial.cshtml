@model PaginatedList<CarVM>

@{
    ViewData["Title"] = Resource1.CarsList;
    ViewData["Title pakage"] = Resource1.CarsManagement ?? " ";
    ViewData["Title Single"] = Resource1.CarsList ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("Car", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Car", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Car", "Delete");

    var addServicePermission = PermissionScanner.ValidatePermission("CarService", "Add");
}

<input type="hidden" id="NewCountRecords" value="@Model.Count" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>@Resource2.CarType</th>
                <th style="width:22%;">@Resource2.DriverName</th>
                <th style="width:9%;">@Resource2.CarNo</th>
                <th style="width:20%;">@Resource2.Model / @Resource2.Color</th>
                <th style="width:13%;">@* @Resource2.OwnershipExpiryDate *@ @Resource2.OwnershipExpiryDate2</th>
                <th style="width:12%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var car in Model.Items)
                {
                    <tr data-id="@car.Id">
                        <td data-label="@Resource2.CarType">@car.Type</td>
                        <td data-label="@Resource2.DriverName">@car.DriverName</td>
                        <td data-label="@Resource2.PlateNumber" class="fw-medium">@car.PlateNumber</td>
                        <td data-label="@Resource2.Model">@car.Model / @car.Color</td>
                        <td data-label="@Resource2.OwnershipExpiryDate">
                            @(car.OwnershipExpiryDate?.ToString("d")?.Replace("/","-"))
                        </td>
                        <td data-label="@Resource2.Actions">

                            @* Add Service *@
                            @if (addServicePermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.AddService">
                                    <a asp-controller="CarService" asp-action="AddEdit" asp-route-carId="@car.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-car fs-5"></i>
                                    </a>
                                </span>
                            }

                            @* Attachment *@
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Attachments">
                                <button type="button" class="btn-control btn-icon btn-sm rounded-circle open-car-attachments-modal" data-car-id="@car.Id">
                                    <i class="fa-solid fa-paperclip fs-5"></i>
                                </button>
                            </span>

                            @* Edit Car *@
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.ModifyVehicleData">
                                    <a asp-action="AddEdit" asp-route-id="@car.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }

                            @* Delete Car *@
                            @if (deletePermission)
                            {
                                @if (car.inService.HasValue && car.inService.Value)
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.CarCantDelete">
                                        <button type="button" disabled
                                                class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle"
                                                data-message="@Resource1.CarCantDelete">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </span>
                                }
                                else
                                {
                                    <form asp-action="Delete" asp-route-id="@car.Id" method="post" class="d-inline"
                                          data-swal="delete" data-message="@car.Type">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoCars</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
