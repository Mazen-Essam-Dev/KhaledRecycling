@model CarVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? Resource2.EditCar : Resource2.CreateCar;
    ViewData["Title pakage"] = @Resource1.CarsManagement ?? " ";
    ViewData["Title Single"] = (isEdit ? Resource2.EditCar : Resource2.CreateCar) ?? " ";
    ViewData["Title ListIndex"] = @Resource1.CarsList ?? " ";

}

<style>
    #newAlignMaxbuttons {
        /* width: 40%; */
        /* align-items: center; */
        display: flex !important;
        justify-content: end !important;
        /* justify-content: center; */
        align-items: center !important;
        gap: 5px !important;
        margin-right: 20px !important;
    }
</style>

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <div class="d-flex align-items-center gap-2">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa fa-book me-2 text-ico"></span>
                @ViewData["Title"]
            </h4>
        </div>
    </div>
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-end" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item"><a href="/Admin/Car/Index">@ViewData["Title ListIndex"]</a></li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
</div>
<div class="card all-borders p-3">
    <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" class="needs-validation" />
        <input type="hidden" asp-for="Attachment_TempFilePath" />
        <input type="hidden" asp-for="Attachment_OldPath"  />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PlateNumber" class="form-label asteriskRequired">@Resource1.Licenseplatenumber</label>
                <input asp-for="PlateNumber" class="form-control" />
                <span asp-validation-for="PlateNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Type" class="form-label asteriskRequired">@Resource2.CarType</label>
                <input asp-for="Type" class="form-control" />
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DriverName" class="form-label asteriskRequired">@Resource2.DriverName</label>
                <input asp-for="DriverName" class="form-control" />
                <span asp-validation-for="DriverName" class="text-danger small"></span>
            </div>
            <div class="col-md-6 filter-dropdown">
                <label asp-for="OwnershipExpiryDate" class="fw-medium asteriskRequired mb-2">@Resource2.OwnershipExpiryDate</label>
                <div class="input-icon-left">
                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                    <input asp-for="OwnershipExpiryDate" class="form-control green-border form-control-sm filter-bordered" type="date" />
                </div>
                <span asp-validation-for="OwnershipExpiryDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Model" class="form-label asteriskRequired">@Resource2.Model</label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Color" class="form-label asteriskRequired">@Resource2.Color</label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label">@Resource2.Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>

            <div class="col-md-12 d-flex justify-content-end align-items-center my-2 gap-2 ">
                <button type="submit" class="btn-cancel-search btn btn-sm px-3">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                </button>
                <a asp-action="Index" class="btn btn-success btn-sm  px-3">
                    @Resource2.Back  <i class="fa-solid fa-arrow-left"></i>
                </a>
            </div>
        </div>

    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
