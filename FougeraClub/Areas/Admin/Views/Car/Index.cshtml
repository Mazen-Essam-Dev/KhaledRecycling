@model PaginatedList<CarVM>

@{
    ViewData["Title"] = Resource1.CarsList;
    ViewData["Title pakage"] = @Resource1.CarsManagement ?? " ";
    ViewData["Title Single"] = @Resource1.CarsList ?? " ";
    var addPermission = PermissionScanner.ValidatePermission("Car", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Car", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Car", "Delete");
    var addServicePermission = PermissionScanner.ValidatePermission("CarService", "Add");
    var editServicePermission = PermissionScanner.ValidatePermission("CarService", "Edit");
}
<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteCarModal" tabindex="-1" aria-labelledby="deleteCarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-danger-header">
                <h5 class="modal-title" id="deleteCarModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>@Resource2.ConfirmDelete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong class="modal1">@Resource2.ConfirmDelete:</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>@Resource2.Cancel
                </button>
                <form id="deleteCarForm" method="post" asp-action="Delete">
                    <input type="hidden" id="carIdToDelete" name="id" value="" />
                    <button type="submit" class="btn btn-cancel-search ">
                        <i class="fas fa-trash me-1"></i>@Resource2.Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Header with Title, Count, and Create Button -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb" class="ms-2">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>

    <!-- Records Count and Action Buttons -->
    <div class="col-md-6 d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource2.CarsCount:</span>
            <span id="countRecords">@Model.Count</span>
        </div>


    </div>

    <script>
        function openPrintPage() {
            const get = id => document.getElementById(id)?.value || '';
            const searchTerm = encodeURIComponent(get('searchTermInput'));
            const selectedType = encodeURIComponent(get('carTypeSelect'));
            const dateFrom = encodeURIComponent(get('dateFrom'));
            const dateTo = encodeURIComponent(get('dateTo'));
            const countRecords = document.getElementById('NewCountRecords')?.value;

            if (countRecords && countRecords > 3999) {
                showToastrCannotPrint();
            } else {
                const url = `/Admin/Car/Print?searchTerm=${searchTerm}&selectedType=${selectedType}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                window.open(url, 'printWindow', 'width=1000,height=800,noopener,noreferrer');
            }
        }

        function openExcelPage() {
            const get = id => document.getElementById(id)?.value || '';
            const searchTerm = encodeURIComponent(get('searchTermInput'));
            const selectedType = encodeURIComponent(get('carTypeSelect'));
            const dateFrom = encodeURIComponent(get('dateFrom'));
            const dateTo = encodeURIComponent(get('dateTo'));
            const url = `/Admin/Car/createExcelReport_Download?searchTerm=${searchTerm}&selectedType=${selectedType}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
            window.open(url, '_self');
        }
    </script>
</div>

<!-- Main Card -->
<div class="card">
    <!-- Card Header -->
    <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
        <!-- Page title section -->
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2">
                <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                    <span class="fa-solid fa-car me-2 text-ico"></span>
                    @Resource1.CarsList
                </h4>
            </div>
        </div>
        <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
            @if (addPermission)
            {
                <a asp-action="AddEdit" class="btn btn-outline-success btn-sm">
                    <i class="fa fa-plus me-1"></i> @Resource2.AddCar
                </a>
            }

            <!-- Print button -->
            <button type="button" class="btn btn-success btn-sm" onclick="event.preventDefault(); openPrintPage()">
                <i class="fa fa-print me-1"></i> @Resource2.PrintReport
            </button>

            <!-- Export to Excel -->
            <a class="btn btn-success Excelbtn btn-sm" onclick="openExcelPage();">
                <i class="fa-solid fa-file-excel me-2"></i>@Resource1.createExcelReport_Download
            </a>
        </div>
    </div>
    <!-- Filter Section -->
    <div class="rounded shadow-sm p-3">
        <form method="get" id="carFilterForm" class="filterImg rounded p-2">
            <!-- Row 1: From & To -->
            <div class="row ">
                <!-- Row 2: Search & Car Type -->

                <div class="col-md-3 mb-2">
                    <label for="searchTermInput" class="fw-medium mb-2">@Resource2.Search:</label>
                    <input type="text" name="searchTerm" id="searchTermInput" value="@Model.SearchTerm"
                        class="form-control green-border form-control-sm filter-bordered"
                        placeholder="@Resource2.PlateNumber @Resource2.Or @Resource2.Model ..." />
                </div>
                <div class="col-md-3 mb-2">
                    <label for="dateFrom" class="fw-medium mb-2">@Resource2.FromOwnershipExpiryDate:</label>
                    <div class="input-icon-left">
                        <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                            class="date-icon">
                        <input type="date" name="dateFrom" id="dateFrom"
                            class="form-control green-border form-control-sm filter-bordered"
                            value="@ViewBag.DateFrom" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <label for="dateTo" class="fw-medium mb-2">@Resource2.ToOwnershipExpiryDate:</label>
                    <div class="input-icon-left">
                        <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                            class="date-icon">
                        <input type="date" name="dateTo" id="dateTo"
                            class="form-control green-border form-control-sm filter-bordered" value="@ViewBag.DateTo" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <label for="carTypeSelect" class="fw-medium mb-2">@Resource2.CarType:</label>
                    <select class="form-select green-border form-select-sm filter-bordered" id="carTypeSelect"
                        name="selectedType">
                        <option value="">@Resource2.Car</option>
                        @foreach (var type in ViewBag?.CarTypes as List<string>)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
            </div>
            <!-- Row 3: Buttons -->
            <div class="row mb-1">
                <div class="col d-flex justify-content-end gap-2">
                    <button type="button" id="btnClearFilters" class="btn-cancel-search btn-sm btn">
                        <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                    </button>
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="ri-filter-line me-1"></i> @Resource1.Search
                    </button>
                </div>
            </div>
        </form>
        <div id="PartialNewListContainer">
            @await Html.PartialAsync("_ListPartial", Model)
        </div>
    </div>



    <!-- Table -->



</div>





<div class="modal fade" id="deleteInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Resource2.Sorry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="deleteInfoMessage" class="fw-bold text-center text-danger"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource2.Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Car Attachments Modal -->
<div class="modal fade" id="carAttachmentsModal" tabindex="-1" aria-labelledby="carAttachmentsModalLabel" aria-hidden="true">
</div>

@section Scripts {
    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Set the selected value for car type dropdown
        document.addEventListener('DOMContentLoaded', function () {
            const selectedType = '@ViewBag.SelectedType';
            if (selectedType) {
                document.getElementById('carTypeSelect').value = selectedType;
            }
        });
    </script>

    <script>
        $(document).on("click", ".show-delete-info", function () {
            var message = $(this).data("message"); // take message from data-attribute
            $("#deleteInfoMessage").text(message);

            var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
            modal.show();
        });

    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#dateFrom').val(filters.dateFrom);
                $('#dateTo').val(filters.dateTo);
                $('#carTypeSelect').val(filters.selectedType);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                $('#dateFrom').val('');
                $('#dateTo').val('');
                $('#carTypeSelect').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    dateFrom: $('#dateFrom').val(),
                    dateTo: $('#dateTo').val(),
                    selectedType: $('#carTypeSelect').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var dateFrom = $('#dateFrom').val();
                var dateTo = $('#dateTo').val();
                var selectedType = $('#carTypeSelect').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/Car/Index',
                    type: 'GET',
                    data: { searchTerm, selectedType, dateFrom, dateTo, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>

    <script>
        // Car Attachments Modal
        $(document).on('click', '.open-car-attachments-modal', function () {
            var carId = $(this).data('car-id');
            $.ajax({
                url: '/Admin/Car/GetCarAttachments',
                type: 'GET',
                data: { id: carId },
                success: function (data) {
                    $('#carAttachmentsModal').html(data);
                    var modal = new bootstrap.Modal(document.getElementById('carAttachmentsModal'));
                    modal.show();
                },
                error: function () {
                    alert('Error loading attachments');
                }
            });
        });
    </script>

}