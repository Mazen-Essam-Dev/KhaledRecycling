@using Domain.Resources
@{
    ViewData["Title"] = Resource2.KhaledTeamRecyclingManagementSystem;
}
<link href="~/css/premium-ui.css" rel="stylesheet" />
<section class="eco-dashboard-hero reveal reveal-up">
    <div>
        <span class="eco-dashboard-kicker">
            <i class="fa-solid fa-leaf"></i>
            Green Life Operations
        </span>
        <h1>لوحة تحكم إعادة التدوير</h1>
        <p>
            مساحة عمل حديثة لمتابعة النفايات والمنتجات والموظفين والتقارير من مكان واحد بتجربة سريعة وواضحة.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a href="/Admin/Statistics/Index" class="btn btn-light fw-bold">
                <i class="fa-solid fa-chart-simple me-1"></i>
                @Resource1.Statistics
            </a>
            <a href="/Admin/MainWastes/Index" class="btn btn-outline-light fw-bold">
                <i class="fa-solid fa-recycle me-1"></i>
                إدارة النفايات
            </a>
        </div>
    </div>

    <div class="eco-hero-panel">
        <div class="d-flex align-items-center justify-content-between gap-3">
            <div>
                <div class="fw-bold text-white-50">System Readiness</div>
                <h2 class="text-white my-1 fw-bold">Premium UI Active</h2>
            </div>
            <div class="eco-card-icon m-0">
                <i class="fa-solid fa-seedling"></i>
            </div>
        </div>
        <div class="progress my-4">
            <div class="progress-bar" role="progressbar" style="width: 86%;" aria-valuenow="86" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <p class="mb-0 text-white-50">
            واجهة محسنة للعرض، البحث، الجداول، النماذج، والتنقل الإداري.
        </p>
    </div>
</section>

<section class="eco-section-title reveal reveal-up">
    <div>
        <h2>مؤشرات العمل</h2>
        <span>نظرة سريعة على أهم وحدات النظام</span>
    </div>
</section>

<section class="eco-stat-grid">
    <article class="eco-stat-card reveal reveal-up">
        <div class="eco-card-icon">
            <i class="fa-solid fa-trash-can-arrow-up"></i>
        </div>
        <h3>Waste Flow</h3>
        <p>تنظيم أنواع النفايات الرئيسية والفرعية وربطها بعمليات إعادة التدوير.</p>
    </article>
    <article class="eco-stat-card reveal reveal-up">
        <div class="eco-card-icon">
            <i class="fa-solid fa-boxes-stacked"></i>
        </div>
        <h3>Products</h3>
        <p>إدارة المنتجات الناتجة ومتابعة تصنيفات المنتجات الرئيسية والفرعية.</p>
    </article>
    <article class="eco-stat-card reveal reveal-up">
        <div class="eco-card-icon">
            <i class="fa-solid fa-users-gear"></i>
        </div>
        <h3>Teams</h3>
        <p>إدارة الموظفين والمستخدمين والصلاحيات من تجربة Dashboard موحدة.</p>
    </article>
    <article class="eco-stat-card reveal reveal-up">
        <div class="eco-card-icon">
            <i class="fa-solid fa-chart-line"></i>
        </div>
        <h3>Reports</h3>
        <p>جداول وتقارير أكثر وضوحا مع دعم الطباعة والتصدير عند توفره.</p>
    </article>
</section>

<section class="eco-section-title reveal reveal-up">
    <div>
        <h2>اختصارات سريعة</h2>
        <span>انتقال مباشر إلى أكثر صفحات الإدارة استخداما</span>
    </div>
</section>

<section class="eco-action-grid">
    <a class="eco-action-card reveal reveal-up" href="/Admin/MainWastes/Index">
        <div class="eco-card-icon">
            <i class="fa-solid fa-recycle"></i>
        </div>
        <h3>إدارة النفايات</h3>
        <p>عرض وإضافة وتعديل تصنيفات النفايات داخل النظام.</p>
    </a>
    <a class="eco-action-card reveal reveal-up" href="/Admin/MainProducts/Index">
        <div class="eco-card-icon">
            <i class="fa-solid fa-cubes"></i>
        </div>
        <h3>إدارة المنتجات</h3>
        <p>متابعة المنتجات الرئيسية والفرعية الخاصة بعمليات التدوير.</p>
    </a>
    <a class="eco-action-card reveal reveal-up" href="/Admin/Employees/Index">
        <div class="eco-card-icon">
            <i class="fa-solid fa-user-tie"></i>
        </div>
        <h3>@Resource1.EmployeesManagement</h3>
        <p>إدارة بيانات الموظفين والملفات المرتبطة بهم.</p>
    </a>
</section>

<section class="eco-section-title reveal reveal-up">
    <div>
        <h2>مسار العمل</h2>
        <span>تجربة مرتبة من الإدخال إلى التقرير</span>
    </div>
</section>

<section class="eco-process-grid">
    <article class="eco-process-card reveal reveal-up">
        <div class="eco-card-icon">
            <i class="fa-solid fa-clipboard-list"></i>
        </div>
        <h3>1. تسجيل البيانات</h3>
        <p>إدخال وتصنيف البيانات من خلال النماذج الحالية بدون تغيير آلية الحفظ.</p>
    </article>
    <article class="eco-process-card reveal reveal-up">
        <div class="eco-card-icon">
            <i class="fa-solid fa-magnifying-glass-chart"></i>
        </div>
        <h3>2. المتابعة</h3>
        <p>جداول محسنة للقراءة والبحث والمراجعة مع تأثيرات تفاعلية خفيفة.</p>
    </article>
    <article class="eco-process-card reveal reveal-up">
        <div class="eco-card-icon">
            <i class="fa-solid fa-file-export"></i>
        </div>
        <h3>3. التقارير</h3>
        <p>واجهات أكثر نظافة لصفحات الإحصائيات والطباعة والتصدير.</p>
    </article>
</section>
