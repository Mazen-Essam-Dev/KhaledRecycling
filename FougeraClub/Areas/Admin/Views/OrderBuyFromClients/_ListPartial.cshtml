@model KhaledTeamRecycling.Areas.Admin.ViewModels.OrderBuyFromClient.OrderBuyFromClientVM
@{
    var addPermission = PermissionScanner.ValidatePermission("OrderBuyFromClients", "Add");
    var editPermission = PermissionScanner.ValidatePermission("OrderBuyFromClients", "Edit");
    var DetailsPermission = PermissionScanner.ValidatePermission("OrderBuyFromClients", "Details");
    var deletePermission = PermissionScanner.ValidatePermission("OrderBuyFromClients", "Delete");
}
<input type="hidden" id="NewCountRecords" value="@Model.TotalCount" />

<nav class="d-flex justify-content-end w-25 align-items-center gap-2 my-2" style="margin-right: auto !important;">
    <label for="pageSizeSelect" class="form-label mb-0" style="    text-wrap-mode: nowrap;">Page Size:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width: 74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize ? "selected" : null)">@s</option>
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 80px;">No.</th>
                <th>Main Waste</th>
                <th>Sub Waste</th>
                <th>Order Date</th>
                <th>Units</th>
                <th>Kilo</th>
                <th>Total</th>
                <th>Status</th>
                <th style="width: 200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                var x = 0;
                foreach (var item in Model.Items)
                {
                    x++;
                    <tr>
                        <td>@(x)</td>
                        <td>@(SessionHelper.GetCurrentLanguage() == "ar" ? item.SubWaste?.MainWaste?.NameAr : item.SubWaste?.MainWaste?.NameEn)</td>
                        <td>@(SessionHelper.GetCurrentLanguage() == "ar" ? item.SubWaste?.NameAr : item.SubWaste?.NameEn)</td>
                        <td>@(item.OrderDate?.ToString("yyyy-MM-dd"))</td>
                        <td>@(item.CountUnits?.ToString() ?? "-")</td>
                        <td>@(item.Kilo?.ToString() ?? "-")</td>
                        <td>@(item.Total?.ToString("F2") ?? "-")</td>
                        <td>@(SessionHelper.GetCurrentLanguage() == "ar" ? item.Status?.NameAr : item.Status?.NameEn)</td>
                        <td>
                            @if (DetailsPermission)
                            {
                                 <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                            }
                            @if (editPermission)
                            {
                                 <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                            }
                            @if (deletePermission)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-danger open-delete-modal"
                                        data-id="@item.Id"
                                        data-name="Order #@item.Id">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center p-5">No data found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.CurrentPage - 1)">Previous</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.CurrentPage + 1)">Next</a>
        </li>
    </ul>
</nav>
