@model KhaledTeamRecycling.Areas.Admin.ViewModels.OrderBuyFromClient.OrderBuyFromClientVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "تعديل طلب شراء من عميل" : "إضافة طلب شراء من عميل";
    var lang = SessionHelper.GetCurrentLanguage();
}

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item"><a href="/Admin/OrderBuyFromClients/Index">Order Buy From Clients</a></li>
                <li class="breadcrumb-item"><a href="#">@ViewData["Title"]</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-6 d-flex justify-content-end align-items-center gap-2">
        <a asp-action="Index" class="btn btn-success btn-sm">
            Back <i class="fa-solid fa-arrow-left me-1"></i>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="d-flex justify-content-center c-pro border p-3 mb-3">
        <div class="flex-grow-1 d-flex justify-content-start align-items-center">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa fa-edit me-2 text-ico"></span>@ViewData["Title"]
            </h4>
        </div>
    </div>

    <div class="container">
        <form asp-action="AddEdit" method="post" id="orderForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BuyPriceUnit" id="BuyPriceUnitHidden" />
            <input type="hidden" asp-for="BuyPriceKilo" id="BuyPriceKiloHidden" />
            <input type="hidden" asp-for="BuyPriceTon" id="BuyPriceTonHidden" />

            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource1.BasicData</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="FKMainWasteId">نفايات اساسي</label>
                        <select asp-for="FKMainWasteId" class="form-select" id="FKMainWasteId" asp-items="Model.MainWastesList">
                            <option value="">-- Select Main Waste --</option>
                        </select>
                        <span asp-validation-for="FKMainWasteId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="FKSubWasteId">نفاية فرعي</label>
                        <select asp-for="FKSubWasteId" class="form-select" id="FKSubWasteId" asp-items="Model.SubWastesList">
                            <option value="">-- Select Sub Waste --</option>
                        </select>
                        <span asp-validation-for="FKSubWasteId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="FKUserId">العميل (افراد)</label>
                        <select asp-for="FKUserId" class="form-select" asp-items="Model.UsersList">
                            <option value="">-- Select User --</option>
                        </select>
                        <span asp-validation-for="FKUserId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="StatusId">@Resource1.Status</label>
                        <select asp-for="StatusId" class="form-select" asp-items="Model.StatusesList">
                            <option value="">--</option>
                        </select>
                        <span asp-validation-for="StatusId" class="text-danger"></span>
                    </div>

                    <input asp-for="ApprovalDate" hidden type="date" class="form-control" />
                    <input asp-for="OrderDate" hidden type="date" class="form-control" />

                    @* <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="OrderDate">Order Date</label>
                        <input asp-for="OrderDate" type="date" class="form-control" />
                        <span asp-validation-for="OrderDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" asp-for="ApprovalDate">Approval Date</label>
                        <input asp-for="ApprovalDate" type="date" class="form-control" />
                        <span asp-validation-for="ApprovalDate" class="text-danger"></span>
                    </div> *@
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>Quantities & Prices</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div style="display:flex; gap:20px;">
                    <!-- Units Div -->
                    <div style="border:1px solid #ccc; padding:10px; flex:1;" id="unitsDiv">
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="IsUnitsSelected" asp-for="IsUnitsSelected" onchange="toggleDiv('units', this.checked)">
                            <label class="form-check-label" for="IsUnitsSelected">Units</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Quantity</label>
                            <input type="number" step="any" class="form-control quantity-input" id="UnitsValue" asp-for="UnitsValue" placeholder="Enter quantity" disabled>
                        </div>
                        <input type="hidden" id="UnitsPriceHidden" value="0">
                        <div class="text-muted small">Price per unit: <span id="UnitsPriceDisplay">0</span></div>
                    </div>

                    <!-- Kilos Div -->
                    <div style="border:1px solid #ccc; padding:10px; flex:1;" id="kilosDiv">
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="IsKilosSelected" asp-for="IsKilosSelected" onchange="toggleDiv('kilos', this.checked)">
                            <label class="form-check-label" for="IsKilosSelected">Kilos</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Quantity</label>
                            <input type="number" step="any" class="form-control quantity-input" id="KilosValue" asp-for="KilosValue" placeholder="Enter quantity" disabled>
                        </div>
                        <input type="hidden" id="KilosPriceHidden" value="0">
                        <div class="text-muted small">Price per kilo: <span id="KilosPriceDisplay">0</span></div>
                    </div>

                    <!-- Ton Div -->
                    <div style="border:1px solid #ccc; padding:10px; flex:1;" id="tonDiv">
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="IsTonSelected" asp-for="IsTonSelected" onchange="toggleDiv('ton', this.checked)">
                            <label class="form-check-label" for="IsTonSelected">Ton</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Quantity</label>
                            <input type="number" step="any" class="form-control quantity-input" id="TonValue" asp-for="TonValue" placeholder="Enter quantity" disabled>
                        </div>
                        <input type="hidden" id="TonPriceHidden" value="0">
                        <div class="text-muted small">Price per ton: <span id="TonPriceDisplay">0</span></div>
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="DiscountRatio">Discount Ratio (%)</label>
                        <input asp-for="DiscountRatio" type="number" step="any" placeholder="0" class="form-control" id="DiscountRatio" />
                        <span asp-validation-for="DiscountRatio" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="DiscountValue">Discount Value</label>
                        <input asp-for="DiscountValue" type="number" step="any" placeholder="0" class="form-control" id="DiscountValue" readonly />
                        <span asp-validation-for="DiscountValue" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Total</label>
                        <input type="text" class="form-control bg-light" id="TotalDisplay" value="0" readonly />
                        <input type="hidden" asp-for="Total" id="TotalHidden" />
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-2 mb-4">
                <button type="submit" class="btn-cancel-search btn-sm btn">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        var currentLang = '@lang';
        function toggleDiv(type, isChecked) {
            const div = document.getElementById(type + 'Div');
            const input = div.querySelector('.quantity-input');
            
            if (isChecked) {
                input.disabled = false;
                div.style.backgroundColor = '#f8f9fa';
            } else {
                input.disabled = true;
                input.value = '';
                div.style.backgroundColor = '';
            }
            calculateTotal();
        }

        function calculateTotal() {
            let total = 0;
            
            // Units
            if (document.getElementById('IsUnitsSelected').checked) {
                const quantity = parseFloat(document.getElementById('UnitsValue').value) || 0;
                const price = parseFloat(document.getElementById('UnitsPriceHidden').value) || 0;
                total += quantity * price;
            }
            
            // Kilos
            if (document.getElementById('IsKilosSelected').checked) {
                const quantity = parseFloat(document.getElementById('KilosValue').value) || 0;
                const price = parseFloat(document.getElementById('KilosPriceHidden').value) || 0;
                total += quantity * price;
            }
            
            // Ton
            if (document.getElementById('IsTonSelected').checked) {
                const quantity = parseFloat(document.getElementById('TonValue').value) || 0;
                const price = parseFloat(document.getElementById('TonPriceHidden').value) || 0;
                total += quantity * price;
            }
            
            // Apply discount ratio
            const discountRatio = parseFloat(document.getElementById('DiscountRatio').value) || 0;
            if (discountRatio > 0) {
                const discountValue = total * (discountRatio / 100);
                document.getElementById('DiscountValue').value = discountValue.toFixed(2);
                total -= discountValue;
            } else {
                document.getElementById('DiscountValue').value = '';
            }
            
            document.getElementById('TotalDisplay').value = total.toFixed(2);
            document.getElementById('TotalHidden').value = total.toFixed(2);
        }

        function updatePrices(prices) {
            document.getElementById('BuyPriceUnitHidden').value = prices.buyPriceUnit || 0;
            document.getElementById('BuyPriceKiloHidden').value = prices.buyPriceKilo || 0;
            document.getElementById('BuyPriceTonHidden').value = prices.buyPriceTon || 0;
            
            document.getElementById('UnitsPriceHidden').value = prices.buyPriceUnit || 0;
            document.getElementById('KilosPriceHidden').value = prices.buyPriceKilo || 0;
            document.getElementById('TonPriceHidden').value = prices.buyPriceTon || 0;
            
            document.getElementById('UnitsPriceDisplay').textContent = (prices.buyPriceUnit || 0).toFixed(2);
            document.getElementById('KilosPriceDisplay').textContent = (prices.buyPriceKilo || 0).toFixed(2);
            document.getElementById('TonPriceDisplay').textContent = (prices.buyPriceTon || 0).toFixed(2);
            
            calculateTotal();
        }

        $(document).ready(function () {
            // Initialize div states based on checkboxes
            if (document.getElementById('IsUnitsSelected').checked) {
                toggleDiv('units', true);
                // Set the value from the model
                const unitsValue = document.getElementById('UnitsValue').value;
                if (unitsValue) {
                    document.getElementById('UnitsValue').value = unitsValue;
                }
            }
            if (document.getElementById('IsKilosSelected').checked) {
                toggleDiv('kilos', true);
                // Set the value from the model
                const kilosValue = document.getElementById('KilosValue').value;
                if (kilosValue) {
                    document.getElementById('KilosValue').value = kilosValue;
                }
            }
            if (document.getElementById('IsTonSelected').checked) {
                toggleDiv('ton', true);
                // Set the value from the model
                const tonValue = document.getElementById('TonValue').value;
                if (tonValue) {
                    document.getElementById('TonValue').value = tonValue;
                }
            }

            // Load initial prices if subWaste is selected
            const subWasteId = document.getElementById('FKSubWasteId').value;
            if (subWasteId) {
                $.get('/Admin/OrderBuyFromClients/GetSubWastePrices?subWasteId=' + subWasteId, function(data) {
                    if (data.success) {
                        updatePrices(data);
                    }
                });
            }

            // Calculate total on page load if in edit mode
            const isEditMode = document.getElementById('Id').value > 0;
            if (isEditMode) {
                calculateTotal();
            }

            // Main Waste change - load sub wastes
            $('#FKMainWasteId').on('change', function () {
                const mainWasteId = $(this).val();
                if (mainWasteId) {
                    $.get('/Admin/OrderBuyFromClients/GetSubWastesByMainWaste?mainWasteId=' + mainWasteId, function(data) {
                        const subWasteSelect = $('#FKSubWasteId');
                        subWasteSelect.empty();
                        subWasteSelect.append('<option value="">-- Select Sub Waste --</option>');
                        
                        $.each(data, function (i, item) {
                            subWasteSelect.append('<option value="' + item.id + '">' + 
                                (currentLang === 'ar' ? item.nameAr : item.nameEn) + '</option>');
                        });
                    });
                } else {
                    $('#FKSubWasteId').empty().append('<option value="">-- Select Sub Waste --</option>');
                }
            });

            // Sub Waste change - load prices
            $('#FKSubWasteId').on('change', function () {
                const subWasteId = $(this).val();
                if (subWasteId) {
                    $.get('/Admin/OrderBuyFromClients/GetSubWastePrices?subWasteId=' + subWasteId, function(data) {
                        if (data.success) {
                            updatePrices(data);
                        }
                    });
                } else {
                    updatePrices({ buyPriceUnit: 0, buyPriceKilo: 0, buyPriceTon: 0 });
                }
            });

            // Quantity inputs change - recalculate total
            $('.quantity-input').on('input', calculateTotal);
            
            // Discount ratio change - recalculate total
            $('#DiscountRatio').on('input', calculateTotal);
        });
    </script>
}
