@using System.Globalization
@model PaginatedList<AbsenceVM>
@{
    ViewData["Title"] = @Resource1.InventoryList;
    ViewData["Title pakage"] = @Resource1.AnnualInventoryManagement ?? " ";
    ViewData["Title Single"] = @Resource1.InventoryList ?? " ";

    var lang = SessionHelper.GetCurrentLanguage();
}

<input type="hidden" id="NewCountRecords" value="@Model.Count" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>

    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>@Resource1.Name</th>
                <th style="width:30%;">@Resource1.Job</th>
                <th style="width:10%;">@Resource2.Month / @Resource2.Year</th>
                <th style="width:10%;">@Resource2.NoOfAbsences</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="4" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.PleaseSelectEmployeeFirst</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@(lang == "ar" ? item.FullNameAr : item.FullNameEn)</td>
                        <td>@item.JobTitle</td>
                        <td>@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.Month ?? 0) / @item.Year</td>
                        <td class="text-center">@(item.NoOfDays??0)</td>
                    </tr>
                }
                <tr class="bg-grey" style="font-weight:700; font-size:calc(1em + 1px);">
                    <th style="color:red;"><strong>@Resource2.TotalNumberOfAbsences:</strong></th>
                    <th style="color:red;"><strong>-</strong></th>
                    <th style="color:red;"><strong>-</strong></th>
                    <th style="color:red;" class="text-center"><strong>@ViewBag.TotalAbsencesDays</strong></th>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
