@model IQueryable<SalaryManagementVM>
@using Domain.DTOs.Admin.SalaryManagement
@using KhaledTeamRecycling.Areas.Admin.ViewModels.SalaryManagement
@using Microsoft.AspNetCore.Identity
@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null; // No layout for print view
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "Unknown User";
}
@{
    ViewData["Title"] = @Resource1.payrollReport;
    ViewData["Title pakage"] = @Resource1.SalaryManagementUnitManagement ?? " ";
    ViewData["Title Single"] = @Resource1.payrollReport ?? " ";

    var allyears = ViewBag.allYears as List<int>;

    var AllEmployeesNames = ViewBag.EmployeesNames as IEnumerable<EmployeesNameDTO>;


}


<head>
    <meta charset="utf-8">
    <title></title>
    @if (SessionHelper.GetCurrentLanguage() == "ar")
    {
        <link href="~/ar/assets/css/report-rtl.css" rel="stylesheet" />
    }
    else
    {
        <link href="~/ar/assets/css/report-ltr.css" rel="stylesheet" />
    }

    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/css/prints/report.css" rel="stylesheet">

    <style>
        .last-tr td {
            background-color: #ececec;
        }

        @@media print {
            .last-tr td {
                background-color: #ececec !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            #report thead th {
                background-color: #47A644!important;
                color: white!important;
                border-color: #c4c1c1 !important;
            }
        }

        @@page {
            size: A4 landscape;
            /* margin: 10mm; */
        }
    </style>
</head>
<div id="report">
    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@Resource1.Loading..</span>
        </div>
        <p class="loading-text">@Resource1.TheReportIsLoadingpleasewait..</p>
    </div>

    <!-- Official Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap border-black  border-bottom p-3  mb-3">
        <div class="d-flex justify-content-between align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
            </div>
        </div>
        <div class="flex-fill text-center">
            <center>
                <img src="/assets/images/logo.png" alt="نادى الفجيره العلمى" style="width:75px;">
            </center>
        </div>
        <div class="d-flex justify-content-end align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
            </div>
        </div>
    </div>

    <div class="header">
        @* <h2 class="text-danger">@Resource1.payrollReport</h2> *@
        <h2 class="text-danger">@ViewBag.PrintInnerTitle</h2>
        @* <p class="text-muted"> @AppDubaiTime.Now.ToString("HH:mm d", System.Globalization.CultureInfo.InvariantCulture)</p> *@
    </div>

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead style="background-color:#47A644; color: white;">
                <tr>
                    <th style="min-width: 200px !important;" colspan="3">@Resource1.Name</th>
                    <th style="min-width: 200px !important;" colspan="3">@Resource1.JobTitle1</th>
                    <th style="min-width: 40px !important;">@Resource1.BasicSalary</th>
                    <th style="min-width: 40px !important;">@Resource1.Allowances</th>
                    <th style="min-width: 40px !important;">@Resource1.TotalSalary</th>
                    <th style="min-width: 40px !important;">@Resource1.WorkDays</th>
                    <th style="min-width: 40px !important;">@Resource1.AbsentDays</th>
                    <th style="min-width: 40px !important;">@Resource1.SickLeaveDays</th>
                    <th style="min-width: 40px !important;">@Resource1.AnnualLeaveDays</th>
                    <th style="min-width: 40px !important;">@Resource1.TotalDeductions</th>
                    <th style="min-width: 40px !important;">@Resource1.BonusesAndMissions</th>
                    <th style="min-width: 40px !important;">@Resource1.NetSalary</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var lang = SessionHelper.GetCurrentLanguage();
                    foreach (var item in Model)
                    {
                        DateTime dateMonth = new DateTime(2025, item.Month, 1);
                        <tr>
                            <td colspan="3">@(lang == "ar" ? AllEmployeesNames?.Where(y => y.Id ==
                                                        item.EmployeeId)?.FirstOrDefault()?.FullNameAr : AllEmployeesNames?.Where(y => y.Id ==
                                                        item.EmployeeId)?.FirstOrDefault()?.FullNameEn)</td>
                            <td colspan="3">@item.JobTitle</td>
                            <td>@item.BasicSalary</td>
                            <td>@item.Allowances</td>
                            <td>@item.TotalSalary</td>
                            <td>@item.WorkDays</td>
                            <td>@item.AbsentDays</td>
                            <td>@item.SickLeaveDays</td>
                            <td>@item.AnnualLeaveDays</td>
                            <td>@item.TotalDeductions</td>
                            <td>@item.BonusesAndMissions</td>
                            <td>@item.NetSalary</td>
                        </tr>
                    }
                    <tr class=" last-tr">
                        <td colspan="3">@Resource1.Total1</td>
                        <td colspan="3"> </td>
                        <td>@Model.Sum(y => y.BasicSalary)</td>
                        <td>@Model.Sum(y => y.Allowances)</td>
                        <td>@Model.Sum(y => y.TotalSalary)</td>
                        <td>@Model.Sum(y => y.WorkDays)</td>
                        <td>@Model.Sum(y => y.AbsentDays)</td>
                        <td>@Model.Sum(y => y.SickLeaveDays)</td>
                        <td>@Model.Sum(y => y.AnnualLeaveDays)</td>
                        <td>@Model.Sum(y => y.TotalDeductions)</td>
                        <td>@Model.Sum(y => y.BonusesAndMissions)</td>
                        <td>@Model.Sum(y => y.NetSalary)</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="16" class="text-center p-5">
                            <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                <h5 class="mt-3">@Resource1.NoData</h5>
                                <p class="mb-0">@Resource2.GoToCreatePage</p>
                            </div>
                        </td>
                    </tr>

                }

            </tbody>



            <tfoot>
                <tr style="border: none;">
                    <td colspan="2" style="min-height:300px !important;border: none !important;">
                        <div class="footer-container" id="footer-container" style="color: rgba(0, 0, 0, 0) !important;">
                            <div class="footer-top" id="footer-top">
                                <div class="right">Time: </div>
                                <div class="center" style="color: rgba(0, 0, 0, 0) !important;">Date: </div>
                                <div class="left">Printed by: </div>
                            </div>

                            <div class="footer-bottom" id="footer-bottom">
                                @Resource1.FujairahPrintFooter © @AppDubaiTime.Now.ToString("yyyy")
                            </div>
                        </div>
                    </td>
                </tr>
            </tfoot>

        </table>

        <div class="print-footer">
            <div class="footer-top">
                <div class="right">Time: @AppDubaiTime.Now.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
                <div class="center">Date: @AppDubaiTime.Now.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                <div class="left">
                    Printed by:
                    @((currentUserName.IndexOf("@") > 1) ? currentUserName.Substring(0, currentUserName.IndexOf("@")) : currentUserName)
                </div>
            </div>
            <hr class="footer-line">
            <div class="footer-bottom">
                @Resource1.FujairahPrintFooter © @AppDubaiTime.Now.ToString("yyyy")
            </div>
        </div>


        <div class="text-center no-print mt-3">
            <button class="btn btn-primary" onclick="window.print()">طباعة التقرير</button>
            <button class="btn btn-danger ms-2" onclick="window.close()">إغلاق النافذة</button>
        </div>
</div>
    <script>

        // This Part Is Important
        window.addEventListener('load', () => {
            setTimeout(() => document.getElementById('loadingOverlay').style.display = 'none', 500);
            setTimeout(() => window.print(), 1200);
        });
        // Close window after printing
        window.onafterprint = function () {
            setTimeout(function () {
                window.close();
            }, 500);
        };
    </script>