@model PaginatedList<AbsenceVM>
@{
    ViewData["Title"] = @Resource2.AbsenceReport;
    ViewData["Title pakage"] = @Resource1.SalaryManagementUnitManagement ?? " ";
    ViewData["Title Single"] = @Resource2.AbsenceReport ?? " ";

    var Employees = ViewBag.Employees as IEnumerable<SelectListItem>;
    var Years = ViewBag.Years as List<int>;
    var Months = ViewBag.Months as List<SelectListItem>;
}




<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>

    <!-- Records Count + Actions -->
    <div class="col-md-6 d-flex align-items-center gap-2 flex-wrap justify-content-end">

        <!-- Record count -->
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource1.RecordsCount:</span>
            <span><label id="countRecords">@Model.Count </label></span>
        </div>



    </div>
</div>
        <div class="card">
        <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
            <!-- Page Title -->
            <div class="flex-grow-1">
                <div class="d-flex align-items-center">
                    <h4 class="ico-header-title">
                    <i class="fa-solid fa-list text-ico me-1"></i>
                        @ViewData["Title"]
                    </h4>
                </div>
            </div>
            <!-- Right Actions (Print / Excel) -->
            <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-end  gap-1">
                <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                    <i class="fa fa-print me-1"></i> @Resource2.Print
                </button>
                <script>
                    function removeEmpIdClass(){
                        $('#empId').removeClass('is-invalid');

                    }
                    function openPrintPage() {
                        const empId = document.getElementById('empId');
                        // ✅ Validate selected value, not element existence
                        if (!empId.value) {
                            $('#empId').addClass('is-invalid'); // highlight invalid select
                            showToastrCannotPrintPleseSelectFirst(); // Toaster Can't Print Please Select First
                            return;
                        } else {
                            $('#empId').removeClass('is-invalid'); // remove highlight
                        }
                        const fromYear = encodeURIComponent(document.getElementById('fromYear').value);
                        const toYear = encodeURIComponent(document.getElementById('toYear').value);
                        const fromMonth = encodeURIComponent(document.getElementById('fromMonth').value);
                        const toMonth = encodeURIComponent(document.getElementById('toMonth').value);
                        const countRecords = $('#countRecords').val();
                        if(countRecords && countRecords>3999){
                            showToastrCannotPrint(); // Toaster Can't Print more 3999 record
                        }
                        else{
                            const url = `/Admin/SalaryManagement/PrintAbsences?empId=${empId.value}&fromYear=${fromYear}&toYear=${toYear}&fromMonth=${fromMonth}&toMonth=${toMonth}`;
                            window.open(url, '_blank');
                        }

                    }
                     function showToastrCannotPrintPleseSelectFirst() {
                      toastr.options = {
                        "closeButton": true,
                        "progressBar": true,
                        "positionClass": "toast-top-center",
                        "timeOut": "3000"
                      };
                      var cantPrint2 ='@Html.Raw(Resource2.PleaseSelectEmployeeFirst)';

                      toastr.error(cantPrint2);
                    }
                </script>

                <!-- Print Export As Excel -->
                <a class="btn btn-success btn-sm"
                   onclick="openExcelPage();">
                    <i class="fa-solid fa-file-excel me-1"></i>@Resource1.createExcelReport_Download
                </a>
                <script>
                    function openExcelPage() {
                        const empId = document.getElementById('empId');
                        // ✅ Validate selected value, not element existence
                        if (!empId.value) {
                            $('#empId').addClass('is-invalid'); // highlight invalid select
                            showToastrCannotPrintPleseSelectFirst(); // Toaster Can't Print Please Select First
                            return;
                        } else {
                            $('#empId').removeClass('is-invalid'); // remove highlight
                        }
                        const fromYear = encodeURIComponent(document.getElementById('fromYear').value);
                        const toYear = encodeURIComponent(document.getElementById('toYear').value);
                        const fromMonth = encodeURIComponent(document.getElementById('fromMonth').value);
                        const toMonth = encodeURIComponent(document.getElementById('toMonth').value);
                        const url = `/Admin/SalaryManagement/DownloadAbsencesExcel?empId=${empId.value}&fromYear=${fromYear}&toYear=${toYear}&fromMonth=${fromMonth}&toMonth=${toMonth}`;
                        window.open(url, '_self');
                    }
                </script>

            </div>

        </div>
        <div class="p-3">
        <div class="gap-2">
            <form method="get" asp-action="Index" class="filterImg rounded p-2">
                <div class="row mb-2">
                    <div class="filter-dropdown col-md-12">
                        <label for="empId" class="fw-bold mb-1">@Resource1.Employee:</label>
                        <select class="form-select form-select-sm filter-bordered" id="empId" name="empId" @* required *@ onchange="removeEmpIdClass()">
                            <option value="" disabled selected>-- @Resource2.Select --</option>
                            @foreach (var emp in Employees ?? [])
                            {
                                if (emp.Value == ViewBag.empId)
                                {
                                    <option value="@emp.Value" selected>@emp.Text</option>
                                }
                                else
                                {
                                    <option value="@emp.Value">@emp.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row align-items-center mb-2">
                    <div class="col">
                        <div class="input-icon-left">
                            <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">
                            <select class="form-select form-select-sm filter-bordered" id="fromYear" name="fromYear">
                                <option value="">-- إختيار السنة --</option>
                                @foreach (var year in Years ?? [])
                                {
                                    <option value="@year" selected="@(year == ViewBag.fromYear)">@year</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col">
                        <div class="input-icon-left">
                            <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">
                            <select class="form-select form-select-sm filter-bordered" id="fromMonth" name="fromMonth">
                                <option value="">-- إختيار الشهر --</option>
                                @foreach (var month in Months ?? [])
                                {
                                    <option value="@month.Value" selected="@(month.Value == ViewBag.fromMonth?.ToString())">@month.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-auto fw-bold text-center px-2">إلى</div>

                    <div class="col">
                        <div class="input-icon-left">
                            <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">
                            <select class="form-select form-select-sm filter-bordered" id="toYear" name="toYear">
                                <option value="">-- إختيار السنة --</option>
                                @foreach (var year in Years ?? [])
                                {
                                    <option value="@year" selected="@(year == ViewBag.toYear)">@year</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col">
                        <div class="input-icon-left">
                            <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">
                            <select class="form-select form-select-sm filter-bordered" id="toMonth" name="toMonth">
                                <option value="">-- إختيار الشهر --</option>
                                @foreach (var month in Months ?? [])
                                {
                                    <option value="@month.Value" selected="@(month.Value == ViewBag.toMonth?.ToString())">@month.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row mb-1">
                <div class="col-md-12 d-flex flex-column justify-content-end">
                    <div class="d-flex justify-content-end">
                        <button type="button" id="btnClearFilters" class="btn-cancel-search btn btn-sm me-2">
                            <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                        </button>
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="ri-filter-line me-1"></i> @Resource1.Search
                        </button>
                    </div>
                </div>
                </div>
            </form>
    </div>
        </div>
    <div class="col-md-12 ps-3 pe-3 pb-3">
                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_AbsencesListPartial", Model)
                </div>
    </div>
       
        </div>
<!-- Attachments Modal (unchanged logic) -->
<div class="modal fade" id="uploadFilesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div id="attachmentsContent"></div>
    </div>
</div>


<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Resource1.DeleteInventory</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @Resource1.ConfirmDelete <strong id="itemName"></strong> ؟
            </div>
            <div class="modal-footer">
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="itemId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource1.Cancel</button>
                    <button type="submit" class="btn btn-danger">@Resource1.Yes_delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (ViewBag.ReopenModal != null && (bool)ViewBag.ReopenModal)
    {
        <script>
            var myModal = new bootstrap.Modal(document.getElementById('uploadFilesModal'));
            myModal.show();
        </script>
    }
    <script>
            $(document).on("click", ".show-delete-info", function () {
            var message = $(this).data("message"); // take message from data-attribute
            $("#deleteInfoMessage").text(message);

            var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
            modal.show();
        });

    </script>
    <script>

        // Expiry highlighting (kept your logic)
        $(document).ready(function () {
            $('.expiryDate').each(function () {
                const endDateStr = $(this).text().trim();
                if (!endDateStr) return;

                const expiryDate = new Date(endDateStr);
                if (isNaN(expiryDate.getTime())) return;

                const today = new Date();
                const in30Days = new Date();

                today.setHours(0, 0, 0, 0);
                in30Days.setDate(today.getDate() + 30);
                in30Days.setHours(0, 0, 0, 0);
                expiryDate.setHours(0, 0, 0, 0);

                if (expiryDate < today) {
                    $(this).closest('tr').addClass('badge-expired');
                } else if (expiryDate <= in30Days) {
                    $(this).closest('tr').addClass('badge-warning');
                }
            });
        });

    </script>

    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('itemId').value = id;
            document.getElementById('itemName').textContent = name;
        });
    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#empId').val(filters.searchTerm);
                $('#fromYear').val(filters.selectedYear);
                $('#fromMonth').val(filters.selectedYear);
                $('#toYear').val(filters.selectedYear);
                $('#toMonth').val(filters.selectedYear);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                const empId = document.getElementById('empId');
                // ✅ Validate selected value, not element existence
                if (!empId.value) {
                    //$('#empId').addClass('is-invalid'); // highlight invalid select
                    e.preventDefault();
                    showToastrCannotPrintPleseSelectFirst(); // Toaster Can't Print Please Select First
                    return;
                }
                else {
                    //$('#empId').removeClass('is-invalid'); // remove highlight

                    e.preventDefault();
                    saveFilters(1); // We store from the first page
                    loadNewPartialList(1);
                }
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#empId').val('');
                $('#fromYear').val('');
                $('#fromMonth').val('');
                $('#toYear').val('');
                $('#toMonth').val('');
                $('#empId').removeClass('is-invalid'); // remove highlight
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    empId: $('#empId').val(),
                    fromYear: $('#fromYear').val(),
                    fromMonth: $('#fromMonth').val(),
                    toYear: $('#toYear').val(),
                    toMonth: $('#toMonth').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var empId = $('#empId').val();
                var fromYear = $('#fromYear').val();
                var fromMonth = $('#fromMonth').val();
                var toYear = $('#toYear').val();
                var toMonth = $('#toMonth').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/SalaryManagement/Absences',
                    type: 'GET',
                    data: {
                        empId,
                        fromYear,
                        fromMonth,
                        toYear,
                        toMonth,
                        page,
                        pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);


                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>
}