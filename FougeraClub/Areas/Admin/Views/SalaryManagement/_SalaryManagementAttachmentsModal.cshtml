@model KhaledTeamRecycling.Areas.Admin.ViewModels.SalaryManagement.SalaryManagementAttachmentsVM
@using Domain.Resources

<div class="modal-dialog modal-lg">
    <div class="modal-content">
        <form asp-action="UploadSalaryManagementFiles" asp-controller="SalaryManagement" method="post" enctype="multipart/form-data" id="attachmentsForm">
            <div class="modal-header">
                <h5 class="modal-title">@Resource2.UploadAttachments</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <input type="hidden" id="SalaryManagementId" name="SalaryManagementId" value="@Model.SalaryManagementId" />


            <div class="modal-body text-center">

                <!-- Upload new attachment -->
                <div class="row justify-content-center align-items-center mb-3">
                    <div class="col-md-5">
                        <input id="fileNameInput" class="form-control" placeholder="@Resource2.FileName" />
                        <span id="fileNameSpan" class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <input id="fileInput" type="file" class="form-control text-center" accept=".pdf,.jpg,.jpeg,.png" />
                        <span id="fileInputSpan" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-success w-100" id="addFileBtn"><i class="fa-solid fa-plus me-1"></i>@Resource1.Add</button>
                    </div>
                </div>
                <hr />                <!-- Preview added attachments before saving -->
                <div id="attachmentsPreview" class="d-flex flex-wrap justify-content-center gap-3 mt-3">
                    @if (Model.Attachments != null && Model.Attachments.Any())
                    {
                        @for (int i = 0; i < Model.Attachments.Count; i++)
                        {
                            var path = Model.Attachments[i].Path;
                            var fileName = Model.Attachments[i].Name;
                            var extension = System.IO.Path.GetExtension(path)?.ToLower();

                            <div class="file-card text-center">
                                <input hidden name="Attachments[@i].Path" value="@Model.Attachments[i].Path" type="text" />
                                <input hidden name="Attachments[@i].Id" value="@Model.Attachments[i].Id" type="text" />
                                <input hidden name="Attachments[@i].Name" value="@Model.Attachments[i].Name" type="text" />
                                <button type="button" class="remove-btn" title="Remove">&times;</button>
                                <a href="~/@path" target="_blank">
                                    @if (extension == ".jpg" || extension == ".jpeg" || extension == ".png" || extension == ".gif" || extension == ".bmp" || extension == ".webp")
                                    {
                                        <img src="~/@path"
                                             alt="@fileName"
                                             class="img-thumbnail"
                                             style="width:90px;height:90px;object-fit:cover;border-radius:8px;" />
                                    }
                                    else if (extension == ".pdf")
                                    {
                                        <i class="fa-solid fa-file-pdf fa-5x"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-file fa-5x text-secondary"></i>
                                    }
                                </a>
                                <div class="fw-bold mt-2">@fileName</div>
                            </div>
                        }
                    }
                </div>

            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">@Resource1.Save</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">@Resource1.Cancel</button>
            </div>
        </form>
    </div>
</div>

<style>
    .file-card {
        position: relative;
        display: inline-block;
        padding: 5px;
        border-radius: 8px;
        transition: box-shadow 0.2s ease-in-out;
    }

        .file-card:hover {
            box-shadow: 0 0 6px rgba(0,0,0,0.15);
        }

    .remove-btn {
        position: absolute;
        top: 4px;
        right: 4px;
        background: #af1717;
        border: none;
        color: white;
        border-radius: 50%;
        width: 22px;
        height: 22px;
        cursor: pointer;
        font-size: 0.8rem;
        line-height: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease-in-out, transform 0.1s;
        z-index: 2;
    }

        .remove-btn:hover {
            background: #da4d62;
            transform: scale(1.1);
        }

</style>

<script>
    let attachmentIndex = @(Model.Attachments?.Count ?? 0);

    $(document).on('click', '#addFileBtn', function () {
        const file = $('#fileInput')[0].files[0];
        const fileName = $('#fileNameInput').val().trim();

        $('#fileInputSpan').text('');
        $('#fileNameSpan').text('');

        if (!fileName) {
            $('#fileNameSpan').text('الرجاء ادخال اسم الملف');
            return;
        }

        if (!file) {
            $('#fileInputSpan').text('الرجاء اختيار ملف');
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            const extension = file.name.split('.').pop().toLowerCase();
            let previewHtml = '';

            if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp'].includes(extension)) {
                previewHtml = `<img src="${e.target.result}" alt="${fileName}" class="img-thumbnail" style="width:90px;height:90px;object-fit:cover;border-radius:8px;" />`;
            } else if (extension === 'pdf') {
                previewHtml = `<i class="fa-solid fa-file-pdf fa-5x  text-danger"></i>`;
            } else {
                previewHtml = `<i class="fa-solid fa-file fa-5x text-secondary"></i>`;
            }

            const fileCard = `
                <div class="file-card text-center" data-index="${attachmentIndex}">
                    <input hidden name="Attachments[${attachmentIndex}].Name" value="${fileName}" type="text" />
                    <button type="button" class="remove-btn" title="Remove">&times;</button>
                    <a href="javascript:void(0)">
                        ${previewHtml}
                    </a>
                    <div class="fw-bold mt-2">${fileName}</div>
                </div>
            `;

            $('#attachmentsPreview').append(fileCard);

            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            const hiddenFileInput = document.createElement('input');
            hiddenFileInput.type = 'file';
            hiddenFileInput.name = `Attachments[${attachmentIndex}].File`;
            hiddenFileInput.files = dataTransfer.files;
            hiddenFileInput.style.display = 'none';
            $(`.file-card[data-index="${attachmentIndex}"]`).append(hiddenFileInput);

            attachmentIndex++;
            $('#fileInput').val('');
            $('#fileNameInput').val('');
        };

        reader.readAsDataURL(file);
    });

    $(document).on('click', '.remove-btn', function () {
        const card = $(this).closest('.file-card');
        card.remove();

        $('.file-card').each(function (newIdx) {
            $(this).attr('data-index', newIdx);
            $(this).find('input[name^="Attachments"]').each(function () {
                const newName = $(this).attr('name')
                    .replace(/Attachments\[\d+\]/, `Attachments[${newIdx}]`);
                $(this).attr('name', newName);
            });
        });

        attachmentIndex = $('.file-card').length;
    });

</script>

