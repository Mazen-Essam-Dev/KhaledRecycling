    <script>
        function openPrintpayrollReportPage() {
            const selectedYear = encodeURIComponent(document.getElementById('selectedYear').value);
            const selectedEmployee = encodeURIComponent(document.getElementById('selectedEmployee').value);
            const selectedMonth = encodeURIComponent(document.getElementById('selectedMonth').value);
            if(!selectedYear || !selectedMonth){
                showToastrCannotPrintPleseSelectFirst(); // Toaster Can't PrintpayrollReport
                return ;
            }

            var countRecords = document.getElementById('NewCountRecords').value;
            if(countRecords && countRecords>3999){
                showToastrCannotPrint(); // Toaster Can't PrintpayrollReport more 3999 record
            }
            else{
                const url = `/Admin/SalaryManagement/PrintpayrollReport?selectedMonth=${selectedMonth}&selectedYear=${selectedYear}&selectedEmployee=${selectedEmployee}`;

                //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                // Open a standalone pop window (not a tab) so the original page doesn't freeze
                const printWindow = window.open(
                    url,
                    'printWindow',
                    'width=1000,height=800,noopener,noreferrer'
                );
            }
        }
    </script>
