    <script>
        // SalaryManagement Attachments Modal
        $(document).on('click', '.open-salaryManagement-attachments-modal', function () {
            var salaryManagementId = $(this).data('entity-id');
            console.log('Opening attachments for SalaryManagement ID:', salaryManagementId);
            $.ajax({
                url: '/Admin/SalaryManagement/GetSalaryManagementAttachments',
                type: 'GET',
                data: { id: salaryManagementId },
                success: function (data) {
                    console.log('Attachments loaded successfully');
                    $('#salaryManagementAttachmentsModal').html(data).modal('show');
                },
                error: function (xhr, status, error) {
                    console.error('Error loading attachments:', xhr.responseText, status, error);
                    alert('Error loading attachments: ' + (xhr.responseText || error));
                }
            });
        });
    </script>
