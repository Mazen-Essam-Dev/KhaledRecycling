@model MembersCourseVM

@{
    ViewData["Title"] = Resource2.ParticipantsInCourse;
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.CoursesList;
    ViewData["Title Single"] = @Resource2.ParticipantsInCourse ?? " ";
    var lang = SessionHelper.GetCurrentLanguage();
    var AttendancePermission = PermissionScanner.ValidatePermission("Course", "Attendance");
}

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>

                <li class="breadcrumb-item"> <a href="/Admin/Course/Index">@ViewData["Title ListIndex"]</a> </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count & Actions -->
    <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-end">
        <!-- Records Count -->
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto px-2 py-1">
            <span>@Resource1.RecordsCount:</span>
            <span id="countRecords">
                @Model.Members_Paginated.Count
            </span>
        </div>
    </div>
</div>
<input type="hidden" id="courseId" value="@Model.Course?.Id"/>
<div class="row">
        <div class="card">
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title">
                        <i class="fa-solid fa-person-chalkboard me-1 text-ico"></i>
                        @Resource2.ParticipantsInCourse
                    </h4>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-center gap-2 flex-wrap justify-content-end">
                    @{
                        var countRecords = Model.Members_Paginated?.Count;
                    }
                    @if (countRecords != null && countRecords > 3999)
                    {
                        // Toaster Can't Print more 3999 record
                        <a onclick="showToastrCannotPrint();"
                           class="btn btn-success rounded-pill py-2 shadow-lg border-0 transition-all hover:scale-105 hover:bg-success hover:text-white">
                            <i class="fa fa-print me-1"></i> @Resource2.Print 
                        </a>
                    }
                    else
                    {
                        <a asp-action="PrintMembersCourse" asp-route-courseId="@Model?.Course?.Id" target="_blank" class="btn btn-success btn-sm">
                            <i class="fa fa-print me-1"></i> @Resource2.Print 
                        </a>
                    }
                    <!-- Print Export As Excel -->
                    <a class="btn btn-success Excelbtn"
                       asp-action="createExcelReport_Download_MembersupscriptiosToCourse" asp-route-courseId="@Model?.Course?.Id" target="_self">
                        <i class="fa-solid fa-file-excel me-2" style="font-size:17px;"></i>@Resource1.createExcelReport_Download 
                    </a>
                </div>
            </div>




            <div class="col-md-12 px-2">
                <div class="d-flex justify-content-between">
                    <div class="icon_box_all style_one shadow-sm rounded-3 flex-fill mx-1">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@Resource1.CourseTitle</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
                        <div>
                            <p class="fw-bold">@(lang == "ar" ? Model?.Course?.TitleAr : Model?.Course?.TitleEn)</p>
                        </div>
                        <div class="shape-decoration"></div>
                    </div>
                    <div class="icon_box_all style_one shadow-sm rounded-3 flex-fill mx-1">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@Resource1.Department</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
                        <div>
                            <p class="fw-bold">@(lang == "ar" ? Model?.Course?.Department?.NameAr : Model?.Course?.Department?.NameEn)</p>
                        </div>
                        <div class="shape-decoration"></div>
                    </div>
                    <div class="icon_box_all style_one shadow-sm rounded-3 flex-fill mx-1">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@Resource2.TrainerName</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
                        <div>
                            <p class="fw-bold">@(lang == "ar" ? Model?.Trainer?.FullNameAr : Model?.Trainer?.FullNameEn)</p>
                        </div>
                        <div class="shape-decoration"></div>
                    </div>

                    <div class="icon_box_all style_one shadow-sm rounded-3 flex-fill mx-1">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@Resource2.CourseStartDate</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
                        <div>
                            <p class="fw-bold">@Model?.Course?.StartDate?.ToString("d")?.Replace("/", "-")</p>
                        </div>
                        <div class="shape-decoration"></div>
                    </div>

                    <div class="icon_box_all style_one shadow-sm rounded-3 flex-fill mx-1">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@Resource2.CourseEndDate</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
                        <div>
                            <p class="fw-bold">@Model?.Course?.EndDate?.ToString("d")?.Replace("/", "-")</p>
                        </div>
                        <div class="shape-decoration"></div>
                    </div>
                </div>
            </div>
        <div class="col-md-12 px-2">
                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ListPartialMemberSubsInCourse", Model)
                </div>
            </div>


        </div>

</div>
<style>
    .d-flex.justify-content-between {
        align-items: stretch !important;
    }
    .icon_box_all {
        flex: 1 1 0 !important;
        height: 100% !important;
    }
</style>
@section Scripts {
    <script>
        $(document).on('change', '.attendance-checkbox', function () {
            const isChecked = $(this).is(':checked');
            const memberId = $(this).data('member-id');
            const courseId = $(this).data('course-id');

            $.ajax({
                url: '/Admin/Course/Attendance',
                type: 'POST',
                data: {
                    courseId: courseId,
                    memberId: memberId,
                    attendance: isChecked
                },
                success: function () {
                    console.log("Attendance updated");
                },
                error: function () {
                    console.log("Error updating attendance");
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    courseId : $('#courseId').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').length ? $('#pageSizeSelect').val() : "",
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var courseId = $('#courseId').val();
                var pageSize   = pageSizeOverride || $('#pageSizeSelect').length ? $('#pageSizeSelect').val() : "";

                $.ajax({
                    url: '/Admin/Course/MembersCourse',
                    type: 'GET',
                    data: { courseId,page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        const newCourseId = $('#NewCourseId').val();
                        $('#courseId').text(newCourseId);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>
}
