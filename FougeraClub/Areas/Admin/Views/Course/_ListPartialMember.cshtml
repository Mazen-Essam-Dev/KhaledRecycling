@using Domain.DTOs.Admin
@model SubscribedMemberCourseVMTrainer

@{
    ViewData["Title"] = Resource2.RegisteredCourses;

    var rejectedPermission = PermissionScanner.ValidatePermission("Course", "Accept");
    var ratePermission = PermissionScanner.ValidatePermission("Course", "Rate");
    var printCertificatePermission = PermissionScanner.ValidatePermission("Course", "PrintCertificate");
    var editMemberPermission = PermissionScanner.ValidatePermission("Member", "Edit");
    var deleteCoursePermission = PermissionScanner.ValidatePermission("Course", "Delete"); 
    var deleteSubscriptionPermission = PermissionScanner.ValidatePermission("Course", "DeleteSubscription");
    var editCoursePermission = PermissionScanner.ValidatePermission("Course", "Edit");
    var editSubscriptionPermission = PermissionScanner.ValidatePermission("Course", "UpdateSubscribe");
    
    var dateOnlyNow = DateOnly.FromDateTime(AppDubaiTime.Now);
    var lang = SessionHelper.GetCurrentLanguage();
}

<input type="hidden" id="NewCountRecords" value="@Model.paginated.Count" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.paginated.PageSize)">@s</option>
        }
    </select>
</nav>

<div class="table-responsive">
    <table id="dataTable" class="table table-bordered table-hover">
        <thead>
            <tr>
                @* @if (Model.UserIsTrainer)
                { *@
                    <th>CLS No</th>
                @* } *@
                <th>@Resource1.subscriberName</th>
                <th>@Resource2.Nationality</th>
                <th>@Resource1.Department</th>
                <th>@Resource2.CourseName</th>
                <th>@Resource2.SubscriptionDate</th>
                <th>@Resource2.Type</th>
                <th>@Resource2.Trainer</th>
                @if (!Model.UserIsTrainer)
                {
                    <th>@Resource2.Actions</th>
                }
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.paginated.Items.Any())
            {
                foreach (var item in Model.paginated.Items)
                {
                    <tr onclick="@( $"window.location.href='{Url.Action("MemberDetails", "Member", new { id = item.MemberId })}'")"
                        class="cursor-pointer">
                       @*  @if (Model.UserIsTrainer)
                        { *@
                            <td>@item.MemberCode</td>
                       @*  } *@
                        <td>@(lang == "ar" ? item.MemberFullNameAr : item.MemberFullNameEn)</td>
                        <td>@(lang == "ar" ? item.NationalityNameAr : item.NationalityNameEn)</td>
                        <td>@(lang == "ar" ? item.DepartmentNameAr : item.DepartmentNameEn)</td>
                        <td>@(lang == "ar" ? item.CourseTitleAr : item.CourseTitleEn)</td>
                        <td>@item.SubscriptionDate?.ToString("d")?.Replace("/","-")</td>
                        <td>@(lang == "ar" ? item.MemberTypeAr : item.MemberTypeEn)</td>
                        <td>
                            @(lang == "ar" ? item.TrainerFullNameAr : item.TrainerFullNameEn)
                            <input type="hidden" class="CourseStartDate"
                                   value="@(item.CourseStartDate?.ToString("d")?.Replace("/","-") ?? "")" />
                            <input type="hidden" class="CourseEndDate"
                                   value="@(item.CourseEndDate?.ToString("d")?.Replace("/","-") ?? "")" />
                            <input type="hidden" class="Acceptance" value="@(item.Acceptance == null ? 2 : item.Acceptance == true ? 1 : 0)" />
                        </td>

                        @if (!Model.UserIsTrainer)
                        {
                            <td onclick="event.stopPropagation();">

                                <!-- Accept / Reject -->
                                @if (rejectedPermission)
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource2.AcceptOrReject">
                                        <a data-subscription-id="@item.SubscriptionId"
                                           data-subscription-notes="@item.SubNotes"
                                           data-state="@(item.Acceptance?.ToString().ToLower() ?? "true")"
                                           data-is-active="@(item.Acceptance == true ? 0 : 1)"
                                           data-action-title-ac="@Resource2.Accept"
                                           data-action-title-re="@Resource2.Rejection"
                                           class="btn-control btn-icon btn-sm rounded-circle open-state-modal">
                                            <i class="fa-solid fa-circle-check fs-5"></i>
                                        </a>
                                    </span>
                                }
                                else
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource2.AcceptOrReject">
                                        <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-circle-check fs-5"></i>
                                        </button>
                                    </span>
                                }

                                <!-- Coures Ended Time Finished -->
                                @if (item.CourseEndDate.HasValue && item.CourseEndDate.Value < dateOnlyNow)
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Finished_course">
                                        <a class="btn-control btn-icon btn-sm rounded-circle certificateBtn">
                                            <i class="fa-solid fa-clipboard-check fs-5"></i>
                                        </a>
                                    </span>
                                }
                                else
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource2.NotFinishedcourse">
                                        <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-clipboard-check fs-5"></i>
                                        </button>
                                    </span>
                                }

                                <!-- Rate -->
                                @if (ratePermission && item.SelectedRate.HasValue && (item.CourseEndDate.HasValue && item.CourseEndDate.Value <= dateOnlyNow))
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Rate2">
                                        <a data-bs-toggle="modal" data-bs-target="#ratingModal" data-rateid="@item.SelectedRate"
                                           class="btn-control btn-icon btn-sm rounded-circle rateBtn">
                                            <i class="fa-solid fa-star fs-5"></i>
                                        </a>
                                    </span>
                                }
                                else
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Rate2">
                                        <button action="#" disabled class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-star fs-5"></i>
                                        </button>
                                    </span>
                                }

                                <!-- Certificate -->
                                @if (item.SelectedRate.HasValue @* && dateOnlyNow >= item.CourseEndDate *@)
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Certificate">
                                        <a onclick="PrintCertificate(@item.SubscriptionId)"
                                           class="btn-control btn-icon btn-sm rounded-circle certificateBtn">
                                            <i class="fa-solid fa-certificate fs-5"></i>
                                        </a>
                                    </span>

                                }
                                else
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Certificate">
                                        <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-certificate fs-5"></i>
                                        </button>
                                    </span>

                                }
                                
                                @* <!-- Edit Course -->
                                @if (editCoursePermission && item.CourseEndDate.HasValue && item.CourseEndDate.Value > dateOnlyNow)
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource2.EditCourse">
                                        <a asp-action="AddEdit" asp-route-id="@item.CourseID"
                                           class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-pen-to-square fs-5"></i>
                                        </a>
                                    </span>
                                }
                                else
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource2.EditCourse">
                                        <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-pen-to-square fs-5"></i>
                                        </button>
                                    </span>
                                } *@
                                <!-- Edit Subscription -->
                                @if (editSubscriptionPermission && item.CourseEndDate.HasValue && item.CourseEndDate.Value > dateOnlyNow)
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.UpdateSubscripe">
                                        <button class="btn-control btn-icon btn-sm rounded-circle" onclick="openUpdateSubscribeModal(@item.SubscriptionId)">
                                            <i class="fa-solid fa-pen-to-square fs-5"></i>
                                        </button>
                                    </span>
                                }
                                else
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.UpdateSubscripe">
                                        <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-pen-to-square fs-5"></i>
                                        </button>
                                    </span>
                                    
                                }
                                

                                @* <!-- Delete Course -->
                                @if (deleteCoursePermission && !item.isCoursehasAcceptedOrRejectedMember)
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.CourseDelete">
                                        <form asp-action="Delete" asp-route-id="@item.CourseID" method="post" data-swal="delete"
                                              data-message="@($"{Resource1.TheCourse} {item.CourseTitleAr}")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                                <i class="fa-solid fa-trash fs-5"></i>
                                            </button>
                                        </form>
                                    </span>
                                }
                                else
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource1.CourseDelete">
                                        <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </span>
                                } *@

                                <!-- Delete Subscription -->
                                @if (deleteSubscriptionPermission && item.Acceptance == null) // Not Accepted And Not Rejected
                                {
                                    <form asp-action="DeleteSubscription" asp-route-id="@item.SubscriptionId" class="d-inline" method="post" data-swal="delete" data-message="@Resource1.DeleteSubscription1 - @Resource1.TheCourse @(lang=="ar"?item.CourseTitleAr : item.CourseTitleEn) - @Resource1.TheMember @(lang=="ar"?item.MemberFullNameAr : item.MemberFullNameEn)">
                                        @Html.AntiForgeryToken()
                                        <span data-bs-toggle="tooltip" data-bs-title="@Resource2.DeleteSubscription">
                                            <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                                <i class="fa-solid fa-trash fs-5"></i>
                                            </button>
                                        </span>
                                    </form>
                                }
                                else
                                {
                                    <span data-bs-toggle="tooltip" data-bs-title="@Resource2.DeleteSubscription">
                                        <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </span>
                                }

                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size:3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.paginated.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.paginated.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>

        @for (int i = 1; i <= Model.paginated.TotalPages; i++)
        {
            <li class="page-item @(i == Model.paginated.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.paginated.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.paginated.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>