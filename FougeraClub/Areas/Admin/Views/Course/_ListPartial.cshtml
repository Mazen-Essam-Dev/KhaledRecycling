@model IndexCoursesVM
@{
    ViewData["Title"] = @Resource1.CoursesList;
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title Single"] = @Resource1.CoursesList;

    var MembersCoursePermission = PermissionScanner.ValidatePermission("Course", "MembersCourse");
    var EditPermission = PermissionScanner.ValidatePermission("Course", "Edit");
    var AddPermission = PermissionScanner.ValidatePermission("Course", "Add");
    var DeletePermission = PermissionScanner.ValidatePermission("Course", "Delete");
    var PrintIndexPermission = PermissionScanner.ValidatePermission("Course", "PrintIndex");
}

<input type="hidden" id="NewCountRecords" value="@Model?.CoursesVM_Paginated?.Count" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model?.CoursesVM_Paginated?.PageSize ? "selected" : null)">
                @s
            </option>
        }
    </select>
</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>@Resource1.CourseTitle</th>
                @if (Model?.UserIsTrainer != null && !Model.UserIsTrainer)
                {
                    <th>@Resource2.TainerName</th>
                }
                <th style=" width: 7%;">@Resource2.StartDate</th>
                <th style=" width: 7%;">@Resource2.EndDate</th>
                <th>@Resource1.Time</th>
                @if (Model?.UserIsTrainer != null && !Model.UserIsTrainer)
                {
                    <th>@Resource1.Specialization</th>
                }
                <th>@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.CoursesVM_Paginated?.Items?.Any() == true)
            {
                foreach (var course in Model.CoursesVM_Paginated.Items)
                {
                    <tr data-id="@course.Id">
                        <!-- Title -->
                        @if (SessionHelper.GetCurrentLanguage() == "ar")
                        {
                            <td data-label="@Resource1.CourseTitle">@course.TitleAr</td>
                        }
                        else
                        {
                            <td data-label="@Resource1.CourseTitle">@course.TitleEn</td>
                        }

                        <!-- Trainer Name -->
                        @if (Model?.UserIsTrainer != null && !Model.UserIsTrainer)
                        {
                            <td data-label="@Resource2.TainerName">
                                @(SessionHelper.GetCurrentLanguage() == "ar"
                                    ? Model.TrainersNameVM_List?.FirstOrDefault(x => x.Id == course.TrainerId)?.FullNameAr
                                    : Model.TrainersNameVM_List?.FirstOrDefault(x => x.Id == course.TrainerId)?.FullNameEn)
                            </td>
                        }

                        <!-- Dates -->
                        <td data-label="@Resource2.StartDate">@course.StartDate?.ToString("d")?.Replace("/","-")</td>
                        <td data-label="@Resource2.EndDate">@course.EndDate?.ToString("d")?.Replace("/","-")</td>
                        <td data-label="@Resource1.Time">@course.Time</td>

                        <!-- Specialization -->
                        @if (Model?.UserIsTrainer != null && !Model.UserIsTrainer)
                        {
                            <td data-label="@Resource1.Specialization">
                                @(SessionHelper.GetCurrentLanguage() == "ar"
                                    ? course.Department?.NameAr
                                    : course.Department?.NameEn)
                            </td>
                        }

                        <!-- Actions -->
                        <td data-label="@Resource2.Actions" class="text-center">
                            <!-- Members -->
                            @if (MembersCoursePermission && course.IsSubscribed)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.MembersCourse2">
                                    <a asp-action="MembersCourse"
                                       asp-route-courseId="@course.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-users fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.MembersCourse2">
                                    <button action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-users fs-5"></i>
                                    </button>
                                </span>
                            }

                            <!-- Edit -->
                            @if (EditPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.EditCourse">
                                    <a asp-action="AddEdit"
                                       asp-route-id="@course.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle @(course.IsSubscribed ? "disabled" : "")">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.EditCourse">
                                    <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </button>
                                </span>
                            }

                            <!-- Delete -->
                            @if (DeletePermission && !course.IsSubscribed)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.CourseDelete">
                                    <form asp-action="Delete"
                                          asp-route-id="@course.Id"
                                          data-swal="delete"
                                          data-message="@(SessionHelper.GetCurrentLanguage() == "ar" ? course.TitleAr : course.TitleEn)"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.CourseDelete">
                                    <button asp-action="#" disabled class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </button>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@(Model?.UserIsTrainer != null && !Model.UserIsTrainer ? 7 : 5)" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.CoursesVM_Paginated.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.CoursesVM_Paginated.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>

        @for (int i = 1; i <= Model.CoursesVM_Paginated.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CoursesVM_Paginated.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.CoursesVM_Paginated.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.CoursesVM_Paginated.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
