@model SubscribedMemberCourseVMTrainer
@using Domain.DTOs.Admin;
@{
    ViewData["Title"] = @Resource2.RegisteredCourses;
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title Single"] = @Resource2.RegisteredCourses ?? " ";

    var DeletePermission = PermissionScanner.ValidatePermission("Course", "DeleteSubscription");
    var RejectedPermission = PermissionScanner.ValidatePermission("Course", "Accept");
    var RatePermission = PermissionScanner.ValidatePermission("Course", "Rate");
    var EditDataForMember = PermissionScanner.ValidatePermission("Member", "Edit");
    var lang = SessionHelper.GetCurrentLanguage();
}

<!-- Breadcrumb & Record Count -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count + Status Badges -->
    <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">

        <!-- Status badges -->
        <span class="badge bg-light-success p-2">
            @Resource2.Approval
        </span>
        <span class="badge bg-light-warning p-2">
            @Resource2.InProgress
        </span>
        <span class="badge bg-light-info p-2">
            @Resource2.Expired
        </span>
        <span class="badge bg-light-danger p-2">
            @Resource2.Rejection
        </span>

        <!-- Record Count -->
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource2.ParticipationsNo:</span>
            <span id="countRecords">@Model.paginated.Count</span>
        </div>
    </div>
</div>

<!-- Main Card -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <!-- Card Header -->
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <!-- Title -->
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <i class="fa fa-book me-2 text-ico"></i>
                            @Resource2.RegisteredCourses
                        </h4>
                    </div>
                </div>

                <!-- Print & Excel Buttons -->
                <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
                    <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>
                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"></i>@Resource1.createExcelReport_Download
                    </a>
                </div>

                <script>
                    function openPrintPage() {
                        const get = id => document.getElementById(id)?.value || '';
                        const searchTerm = encodeURIComponent(get('searchTermInput'));
                        const dateFrom = encodeURIComponent(get('dateFrom'));
                        const dateTo = encodeURIComponent(get('dateTo'));
                        const selectedDept = encodeURIComponent(get('deptSelect'));
                        const selectedTrainer = encodeURIComponent(get('trainerSelect'));
                        const selectedNationality = encodeURIComponent(get('nationalitySelect'));
                        const selectedGender = document.querySelector('input[name="selectedGender"]:checked')?.value || '';
                        const countRecords = parseInt(document.getElementById('countRecords')?.textContent?.trim() || 0);

                        if (countRecords > 3999) {
                            showToastrCannotPrint();
                        } else {
                            const url = `/Admin/RegisteredCourses/Print?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}&selectedDept=${selectedDept}&selectedTrainer=${selectedTrainer}&selectedNationality=${selectedNationality}&selectedGender=${selectedGender}`;
                            window.open(url, 'printWindow', 'width=1000,height=800,noopener,noreferrer');
                        }
                    }

                    function openExcelPage() {
                        const get = id => document.getElementById(id)?.value || '';
                        const searchTerm = encodeURIComponent(get('searchTermInput'));
                        const dateFrom = encodeURIComponent(get('dateFrom'));
                        const dateTo = encodeURIComponent(get('dateTo'));
                        const selectedDept = encodeURIComponent(get('deptSelect'));
                        const selectedTrainer = encodeURIComponent(get('trainerSelect'));
                        const selectedNationality = encodeURIComponent(get('nationalitySelect'));
                        const selectedGender = document.querySelector('input[name="selectedGender"]:checked')?.value || '';

                        const url = `/Admin/RegisteredCourses/createExcelReport_Download?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}&selectedDept=${selectedDept}&selectedTrainer=${selectedTrainer}&selectedNationality=${selectedNationality}&selectedGender=${selectedGender}`;
                        window.open(url, '_self');
                    }
                </script>
            </div>

            <!-- Filter / Search Panel -->
            <div class="rounded shadow-sm p-3">
                <form method="get" id="studentFilterForm" class="filterImg rounded">
                    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 gap-md-4 w-100 p-2">
                        <!-- Left Column -->
                        <div class="d-flex flex-column w-100 w-md-50 gap-2">
                            <!-- Search Box -->
                            <div class="filter-dropdown">
                                <label for="searchTermInput" class="fw-medium mb-2">@Resource2.Search:</label>
                                <div class="search-box position-relative">
                                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                    <input type="text" name="searchTerm" id="searchTermInput"
                                           value="@Model.paginated?.SearchTerm"
                                           class="form-control green-border form-control-sm filter-bordered ps-4"
                                           placeholder="@Resource2.Name @Resource2.Or @Resource2.IdNumber ..." />
                                </div>
                            </div>

                            <!-- Date Filters -->
                            <div class="d-flex flex-column flex-md-row gap-3">
                                <div class="filter-dropdown w-100">
                                    <label for="dateFrom" class="fw-medium mb-2">
                                        @Resource2.From
                                        @Resource2.SubscriptionDate:
                                    </label>
                                    <div class="input-icon-left">
                                        <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">
                                        <input type="date" name="dateFrom" id="dateFrom"
                                               class="form-control green-border form-control-sm filter-bordered"
                                               value="@ViewBag.DateFrom" />
                                    </div>
                                </div>
                                <div class="filter-dropdown w-100">
                                    <label for="dateTo" class="fw-medium mb-2">
                                        @Resource2.To
                                        @Resource2.SubscriptionDate:
                                    </label>
                                    <div class="input-icon-left">
                                        <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">
                                        <input type="date" name="dateTo" id="dateTo"
                                               class="form-control green-border form-control-sm filter-bordered"
                                               value="@ViewBag.DateTo" />
                                    </div>
                                </div>
                            </div>

                            <!-- Nationality -->
                            <div class="filter-dropdown">
                                <label for="nationalitySelect" class="fw-medium mb-2">@Resource2.Nationality:</label>
                                <select class="form-select green-border form-select-sm filter-bordered"
                                        id="nationalitySelect" name="selectedNationality">
                                    <option value="">@Resource2.SelectNationality</option>
                                    @foreach (var nationality in ViewBag.Nationalities as IEnumerable<SelectListItem>)
                                    {
                                        <option value="@nationality.Value"
                                                selected="@(nationality.Value == (ViewBag.SelectedNationality?.ToString() ?? ""))">
                                            @nationality.Text
                                        </option>
                                    }
                                </select>
                                <link href="/css/select2-custom.css" rel="stylesheet" />
                                <script src="/js/select2-cdn-loader.js"></script>
                                <script>
                                    document.addEventListener('DOMContentLoaded', function () {
                                        function initSelect2() {
                                            if (window.jQuery && window.jQuery.fn && window.jQuery.fn.select2) {
                                                $('#nationalitySelect').select2({
                                                    placeholder: 'إختر الجنسية',
                                                    allowClear: false,
                                                    width: 'resolve',
                                                    minimumResultsForSearch: 0
                                                });
                                            } else {
                                                setTimeout(initSelect2, 100);
                                            }
                                        }
                                        initSelect2();
                                    });
                                </script>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="d-flex flex-column w-100 w-md-50 gap-2">
                            @if (!Model.UserIsTrainer)
                            {
                                <!-- Department Dropdown -->
                                <div class="filter-dropdown">
                                    <label for="deptSelect" class="fw-medium mb-2">@Resource2.Departments:</label>
                                    <select class="form-select green-border form-select-sm filter-bordered" id="deptSelect"
                                            name="selectedDept" onchange="GetTrainersInDept(this.value)">
                                        <option value="">@Resource2.Select</option>
                                        @foreach (var dept in ViewBag.Departments as IEnumerable<SelectListItem>)
                                        {
                                            <option value="@dept.Value"
                                                    selected="@(dept.Value == (ViewBag.SelectedDept?.ToString() ?? ""))">
                                                @dept.Text
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- Trainer Dropdown -->
                                <div class="filter-dropdown">
                                    <label for="trainerSelect" class="fw-medium mb-2">@Resource1.Trainer2:</label>
                                    <select class="form-select green-border form-select-sm filter-bordered"
                                            id="trainerSelect" name="selectedTrainer" asp-items="Model?.TrainersList">
                                        <option value="">@Resource2.Select</option>
                                    </select>
                                </div>
                            }
                                else
                                {
                                <!-- Department Dropdown -->
                                <div class="filter-dropdown">
                                    <label for="deptSelect" class="fw-medium mb-2">@Resource2.Departments:</label>
                                    <select class="form-select green-border form-select-sm filter-bordered"
                                            id="deptSelect"
                                            name="selectedDept" disabled>
                                        @foreach (var dept in ViewBag.Departments as IEnumerable<SelectListItem>)
                                        {
                                            @if (dept.Selected || dept.Value == (ViewBag.SelectedDept?.ToString() ?? ""))
                                            {
                                                <option value="@dept.Value" selected>@dept.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@dept.Value">@dept.Text</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <!-- Trainer Dropdown (ALWAYS DISABLED) -->
                                <div class="filter-dropdown">
                                    <label for="trainerSelect" class="fw-medium mb-2">@Resource1.Trainer2:</label>
                                    <select class="form-select green-border form-select-sm filter-bordered"
                                            id="trainerSelect" name="selectedTrainer" disabled>
                                        @if (Model?.TrainersList != null)
                                        {
                                            @foreach (var trainer in Model.TrainersList)
                                            {
                                                @if (trainer.Selected || trainer.Value == (ViewBag.SelectedTrainer?.ToString() ?? ""))
                                                {
                                                    <option value="@trainer.Value" selected>@trainer.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@trainer.Value">@trainer.Text</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>

                                }

                            <!-- Gender + Action Buttons (Side by Side) -->
                            <div class="filter-dropdown">

                                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between gap-3 rtl-actions">
                                    <!-- Gender Radio Buttons -->
                                    <div class="d-flex flex-wrap align-items-center gap-3">
                                        <label class="mb-1 d-block">@Resource2.Gender:</label>
                                        @{
                                            var selectedGender = ViewBag.SelectedGender?.ToString();
                                        }
                                        @foreach (var item in ViewBag.Genders ?? Enumerable.Empty<SelectListItem>())
                                        {
                                            <div class="form-check m-t13-b15">
                                                <input class="form-check-input typeradiobtn" type="radio"
                                                       name="selectedGender" id="TypeEnum_@item.Value" value="@item.Value"
                                                       @(selectedGender == item.Value ? "checked" : "") />
                                                <label class="form-check-label text-gray"
                                                       for="TypeEnum_@item.Value">@item.Text</label>
                                            </div>
                                        }

                                        <div class="form-check m-t13-b15">
                                            <input class="form-check-input typeradiobtn" type="radio"
                                                   name="selectedGender" id="TypeEnum_3" value="3"
                                                   @((string.IsNullOrEmpty(selectedGender) || selectedGender == "3") ?
                                                                                                      "checked" : "") />
                                            <label class="form-check-label text-gray"
                                                   for="TypeEnum_3">@Resource1.all2</label>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-3">
                                        <label class="mb-1 d-block">@Resource2.Type:</label>

                                        @{
                                            var selectedMemberType = ViewBag.SelectedMemberType?.ToString();
                                        }
                                        @foreach (var item in Html.GetEnumSelectList<MemberTypeEnum>() ?? Enumerable.Empty<SelectListItem>())
                                        {
                                            <div class="form-check m-t13-b15">
                                                <input class="form-check-input typeradiobtn" type="radio"
                                                       name="selectedMemberType" id="TypeMemberEnum_@item.Value" value="@item.Value"
                                                       @(selectedMemberType == item.Value ? "checked" : "") />
                                                <label class="form-check-label text-gray"
                                                       for="TypeMemberEnum_@item.Value">@item.Text</label>
                                            </div>
                                        }
                                        <div class="form-check m-t13-b15">
                                            <input class="form-check-input typeradiobtn " type="radio"
                                                   name="selectedMemberType" id="TypeMemberEnum_" value="33"
                                                   @((string.IsNullOrEmpty(selectedMemberType) || selectedMemberType == "33") ?
                                                                                                      "checked" : "") />
                                            <label class="form-check-label text-gray"
                                                   for="TypeMemberEnum_">@Resource1.all2</label>
                                        </div>
                                    </div>
                                    <!-- Action Buttons (matching btn-cancel-search style) -->
                                    <div class="d-flex gap-2 ms-auto mt-2 mt-md-0">
                                        <button type="button" id="btnClearFilters" class="btn-cancel-search btn-sm btn">
                                            <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                                        </button>
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="ri-filter-line me-1"></i> @Resource1.Search
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="col-12">
                    <div class="pl-2 pr-2 pt-2 ">
                        <!-- Table -->
                        <div id="PartialNewListContainer">
                            @await Html.PartialAsync("_ListPartialMember", Model)
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






