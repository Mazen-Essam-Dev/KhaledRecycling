<div id="updateSubscribeModalContainer"></div> @*modal Update Subscripe will here *@

@section Scripts {
    <script>


        // Fixed showAcceptanceModal function
        document.addEventListener("DOMContentLoaded", function () {

            const modalEl = document.getElementById('stateModal');
            const modal = new bootstrap.Modal(modalEl);
            const closeLikeBackdrop = document.querySelector("#closeLikeBackdrop");

            // Handle modal open
            document.querySelectorAll(".open-state-modal").forEach(btn => {
                btn.addEventListener("click", function () {
                    const subscriptionId = this.dataset.subscriptionId;
                    const notesDB = this.dataset.subscriptionNotes;
                    const state = this.dataset.state;
                    const isActive = this.dataset.isActive;

                    // Set form values
                    document.getElementById("SubscriptionId").value = subscriptionId;
                    document.getElementById("Notes").value = notesDB || "";

                    // Set selected radio button
                    const radioValue = state === "true" ? "1" : "2";
                    $(`input[name="selectedACRE"][value="${radioValue}"]`).prop('checked', true);

                    const isRejected = (state === "false" || state === "0") && state !== "null";

                    if (isRejected) {
                        $("#btn_save_modalRejectAcept").hide();
                        $("#Notes, #TypeACRE_1, #TypeACRE_2").prop("disabled", true);
                    } else if (isActive === "1") {
                        $("#btn_save_modalRejectAcept").show();
                        $("#Notes, #TypeACRE_1, #TypeACRE_2").prop("disabled", false);
                    } else if (isActive === "0") {
                        $("#btn_save_modalRejectAcept").hide();
                        $("#Notes, #TypeACRE_1, #TypeACRE_2").prop("disabled", true);
                    }

                    modal.show();
                });
            });

            // Close modal
            if (closeLikeBackdrop) {
                closeLikeBackdrop.addEventListener("click", () => modal.hide());
            }

            // Handle form submit (only once)
            const form = document.getElementById("stateForm");
            if (form && !form.hasSubmitHandler) {
                form.addEventListener("submit", function (e) {
                    e.preventDefault();

                    const data = {
                        SubscriptionId: document.getElementById("SubscriptionId").value,
                        State: $('input[name="selectedACRE"]:checked').val() === "1",
                        Notes: document.getElementById("Notes").value
                    };

                    fetch('@Url.Action("Accept", "Course")', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(data)
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            location.reload();
                        } else {
                            alert(res.message || "Something went wrong");
                        }
                    })
                    .catch(err => {
                        console.error("Fetch error:", err);
                        alert("Network error occurred");
                    });
                });

                form.hasSubmitHandler = true;
            }

        });
    </script>



    @if (!Model.UserIsTrainer) // User Is Not Trainer
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var deptId = $('#deptSelect').val();
                var trainerId = $('#TrainerIdValue').val();
                if (deptId) {
                    GetTrainersInDept(deptId, trainerId);
                }
            });

            function GetTrainersInDept(deptId, trainerId) {
                $.ajax({
                    url: '@Url.Action("GetTrainersInDept", "Course")',
                    type: 'GET',
                    data: { deptId, trainerId },
                    success: function (data) {
                        var trainerSelect = $('select[name="selectedTrainer"]').empty()
                            .append('<option value="">-- @Resource2.Select --</option>');
                        $.each(data.trainers, function (i, trainer) {
                            trainerSelect.append(
                                `<option value="${trainer.text}" ${trainer.selected ? 'selected' : ''}>${trainer.text}</option>`
                            );
                        });
                    }
                });
            }

        </script>
    }

    <script>
        function AcceptSubscription(subscriptionId, acceptance) {
            $.ajax({
                url: '/Admin/Course/Accept',
                type: 'POST',
                data: {
                    id: subscriptionId,
                    acceptance: acceptance
                },
                success: function (response) {
                    if (response.success) {
                        location.reload(); // or update part of the UI instead of reloading
                    } else {
                        alert(response.message || 'Update failed.');
                    }
                },
                error: function () {
                    alert('An error occurred while processing your request.');
                }
            });
        }

        $(document).ready(function () {

            $('#ratingModal').on('show.bs.modal', function (event) {
                const button = $(event.relatedTarget);
                const selectedRate = button.attr("data-rateid"); // safer than .data()

                // Clear previous selection
                $('input[name="ratingValue"]').prop('checked', false);

                // Preselect if a rate exists
                if (selectedRate !== undefined && selectedRate !== "") {
                    $('input[name="ratingValue"][value="' + selectedRate + '"]').prop('checked', true);
                }
            });

            colorizeRows();
        });



        function PrintCertificate(subscriptionId) {
            const url = `/Admin/Course/PrintCertificate?subscriptionId=${subscriptionId}`;
