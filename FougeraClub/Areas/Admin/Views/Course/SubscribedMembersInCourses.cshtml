    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // retrieve stored filters when the page is opened
            // if (sessionstorage.getitem(pagekey)) {
            //     let filters = json.parse(sessionstorage.getitem(pagekey));
            //     $('#searchterminput').val(filters.searchterm || "");
            //     $('#datefrom').val(filters.datefrom || "");
            //     $('#dateto').val(filters.dateto || "");
            //     $('#pagesizeselect').val(filters.pagesize || "");
            //     $('#nationalityselect').val(filters.selectednationality || "");
            //     $('input[name="selectedgender"]:checked').val(filters.selectedgender);
            //     $('#deptselect').val(filters.selecteddept || "");
            //     $('#trainerselect').val(filters.selectedtrainer || "");

            //     // load the list again with the old parameters
            //     loadnewpartiallist(filters.page, filters.pagesize);
            // }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                $('#dateFrom').val('');
                $('#dateTo').val('');
                $('#nationalitySelect').val('');
                $('input[name="selectedGender"]').prop('checked', false);
                $("input[name='selectedMemberType']").prop('checked', false);
                $("input[name='selectedMemberType'][value='33']").prop('checked', true); // All
                $('#deptSelect').val('');
                $('#trainerSelect').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var selectedMemberTypeVal = $("input[name='selectedMemberType']:checked").val();
                if (selectedMemberTypeVal === "33") selectedMemberTypeVal = "";
                var filters = {
                    searchTerm: $('#searchTermInput').length ? $('#searchTermInput').val() : "",
                    dateFrom: $('#dateFrom').length ? $('#dateFrom').val() : "",
                    dateTo: $('#dateTo').length ? $('#dateTo').val() : "",
                    selectedNationality: $('#nationalitySelect').length ? $('#nationalitySelect').val() : "",
                    selectedGender: $('input[name="selectedGender"]:checked').length ? $('input[name="selectedGender"]:checked').val() : "",
                    selectedMemberType: selectedMemberTypeVal,
                    selectedDept: $('#deptSelect').length ? $('#deptSelect').val() : "",
                    selectedTrainer: $('#trainerSelect').length ? $('#trainerSelect').val() : "",
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').length ? $('#pageSizeSelect').val() : "",
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').length ? $('#searchTermInput').val() : "";
                var dateFrom = $('#dateFrom').length ? $('#dateFrom').val() : "";
                var dateTo = $('#dateTo').length ? $('#dateTo').val() : "";
                var selectedNationality = $('#nationalitySelect').length ? $('#nationalitySelect').val() : "";
                var selectedGender = $('input[name="selectedGender"]:checked').length ? $('input[name="selectedGender"]:checked').val() : "";
                var selectedDept = $('#deptSelect').length ? $('#deptSelect').val() : "";
                var selectedTrainer = $('#trainerSelect').length ? $('#trainerSelect').val() : "";
                var pageSize = pageSizeOverride || $('#pageSizeSelect').length ? $('#pageSizeSelect').val() : "";
                var selectedMemberType = $("input[name='selectedMemberType']:checked").val();
                if (selectedMemberType === "33") selectedMemberType = "";

                $.ajax({
                    url: '/Admin/Course/SubscribedMembersInCourses',
                    type: 'GET',
                    data: { searchTerm, selectedNationality, selectedMemberType, selectedTrainer, selectedGender, selectedDept, dateFrom, dateTo, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        colorizeRows();
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
        function openPrintPage() {
            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
            const nationality = encodeURIComponent(document.getElementById('nationalitySelect').value);
            const gender = encodeURIComponent($('input[name="selectedGender"]:checked').val() || '');
            const selectedMemberType = $("input[name='selectedMemberType']:checked").val();
            const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
            const dateTo = encodeURIComponent(document.getElementById('dateTo').value);

            @if (!Model.UserIsTrainer)
            {
                    <text>
                        const dept = encodeURIComponent(document.getElementById('deptSelect').value);
                        const selectedTrainer = encodeURIComponent(document.getElementById('trainerSelect').value);
                    </text>
            }
            else
            {
                    <text>
                        const dept = "";
                        const selectedTrainer = "";
                    </text>
            }

            var countRecords = document.getElementById('NewCountRecords').value;
            if (countRecords && countRecords > 3999) {
                showToastrCannotPrint(); // Toaster Can't Print more 3999 record
            }
            else {
                const url = `/Admin/Course/PrintSubscribedMembersInCourses?searchTerm=${searchTerm}&selectedMemberType=${selectedMemberType}&selectedNationality=${nationality}&selectedGender=${gender}&selectedDept=${dept}&selectedTrainer=${selectedTrainer}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                // Open a standalone pop window (not a tab) so the original page doesn't freeze
                const printWindow = window.open(
                    url,
                    'printWindow',
                    'width=1000,height=800,noopener,noreferrer'
                );
            }
        }

        function openExcelPage() {
            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
            const nationality = encodeURIComponent(document.getElementById('nationalitySelect').value);
            const gender = encodeURIComponent($('input[name="selectedGender"]:checked').val() || '');
            const selectedMemberType = $("input[name='selectedMemberType']:checked").val();
            const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
            const dateTo = encodeURIComponent(document.getElementById('dateTo').value);

            @if (!Model.UserIsTrainer)
                {
                                    <text>
                                        const dept = encodeURIComponent(document.getElementById('deptSelect').value);
                                        const selectedTrainer = encodeURIComponent(document.getElementById('trainerSelect').value);
                                    </text>
            }
                else
                {
                                    <text>
                                        const dept = "";
                                        const selectedTrainer = "";
                                    </text>
            }

                        const url = `/Admin/Course/createExcelReport_Download_SubscripeMember?searchTerm=${searchTerm}&selectedMemberType=${selectedMemberType}&selectedNationality=${nationality}&selectedGender=${gender}&selectedDept=${dept}&selectedTrainer=${selectedTrainer}&dateFrom=${dateFrom}&dateTo=${dateTo}`;

