    <script>
        function openUpdateSubscribeModal(courseId) {
            const url = '/Admin/Course/UpdateSubscribe?id=' + courseId;

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    const container = document.getElementById('updateSubscribeModalContainer');
                    container.innerHTML = html;

                    // Show Bootstrap modal
                    const modalEl = container.querySelector('.modal');
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                })
                .catch(err => console.error('Error loading modal:', err));
        }
    </script>
