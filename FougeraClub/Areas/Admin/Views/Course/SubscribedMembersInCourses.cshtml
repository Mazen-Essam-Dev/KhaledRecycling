            // colorizeRows_Admin
            function colorizeRows() {
                $('#dataTable tr').each(function () {
                    var acceptanceValue = $(this).find('input.Acceptance').val();
                    var startDateStr = $(this).find('input.CourseStartDate').val();
                    var endDateStr = $(this).find('input.CourseEndDate').val();

                    // Ensure endDateStr is in d format
                    var startDate = new Date(startDateStr);
                    var endDate = new Date(endDateStr);
                    var today = new Date();

                    // Zero out time for accurate comparison
                    today.setHours(0, 0, 0, 0);
                    endDate.setHours(0, 0, 0, 0);

                    // Apply class based on logic
                    if (acceptanceValue === "0") {
                        $(this).addClass('bg-light-danger'); // Rejected
                    } else if (today > endDate) {
                        $(this).addClass('bg-light-info'); // Finished course
                    } else if (startDate <= today && endDate > today) {
                        $(this).addClass('bg-light-warning'); // In progress course
                    }  else if (acceptanceValue === "1") {
                        $(this).addClass('bg-light-success'); // Accepted
                    }
                });
            }
        </script>
    }
