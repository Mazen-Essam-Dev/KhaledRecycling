@model CourseSubVM

<div class="modal fade" id="updateSubscribeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Resource1.UpdateSubscripe</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form asp-action="UpdateSubscribe" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Event Dates -->
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">@Resource2.DateFrom</label>
                            <input asp-for="StartDate" type="date" class="form-control" hidden readonly />
                            <input value="@Model.StartDate?.ToString("d")?.Replace("/","-")" type="text" class="form-control" readonly />
                            
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label">@Resource2.DateTo</label>
                            <input asp-for="EndDate" type="date" class="form-control" hidden readonly />
                            <input value="@Model.EndDate?.ToString("d")?.Replace("/","-")" type="text" class="form-control" readonly />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Course Title -->
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <label asp-for="Title" class="form-label">@Resource1.CourseTitle</label>
                            <input asp-for="Title" type="text" class="form-control" readonly />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Hidden fields -->
                    <input type="hidden" asp-for="IdImagePath" />
                    <input type="hidden" asp-for="PassportImagePath" />
                    <input type="hidden" asp-for="isHasIDCard" />
                    <input type="hidden" asp-for="isHasPassport" />
                    <input type="hidden" asp-for="isNotExpired" />
                    <input type="hidden" asp-for="memberId" />
                    <input type="hidden" asp-for="SubscriptionId" />

                    <!-- File Uploads -->
                    <div class="row mb-2">

                        <div class="col-md-6">
                            <label asp-for="IdImage" class="form-label d-flex justify-content-between">
                                @Resource2.IdImage
                                @if (!string.IsNullOrEmpty(Model?.IdImagePath) && FileHelper.IsFileExist(Model?.IdImagePath))
                                {
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#idImageModal" class="eye-ii">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                }
                            </label>
                            <input asp-for="IdImage" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                            <span asp-validation-for="IdImage" class="text-danger small"></span>
                        </div>

                        <!-- Profile Image Section -->
                        <div class="col-md-6">
                            <label asp-for="PassportImage" class="form-label d-flex justify-content-between">
                                @Resource2.PassportImage
                                @if (!string.IsNullOrEmpty(Model?.PassportImagePath) && FileHelper.IsFileExist(Model?.PassportImagePath))
                                {
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#passportImageModal" class="eye-ii">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                }
                            </label>
                            <input asp-for="PassportImage" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                            <span asp-validation-for="PassportImage" class="text-danger small"></span>
                        </div>                        
                    </div>

                    @* <!-- Terms & Conditions -->
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="agreeCheck" required />
                            <label class="form-check-label" for="agreeCheck">
                                @Resource1.I_have_read_and_agree_to_terms_and_conditions
                            </label>
                        </div>
                    </div> *@

            <div class="modal-footer">
                <button type="submit" id="submitBtn" class="btn btn-primary">@Resource1.Save</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Resource2.Close</button>
            </div>
            </form>
        </div>
    </div>
</div>

</div>

@if (!string.IsNullOrEmpty(Model?.IdImagePath) && FileHelper.IsFileExist(Model?.IdImagePath))
{
    <div class="modal fade" id="idImageModal" tabindex="-1" aria-labelledby="idImageLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Resource2.IdImage</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Resource1.Close1"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="../../@Model.IdImagePath" class="img-fluid" alt="@Resource1.photo_identification_ID" />
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model?.PassportImagePath) && FileHelper.IsFileExist(Model?.PassportImagePath))
{
    <div class="modal fade" id="passportImageModal" tabindex="-1" aria-labelledby="passportImageLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Resource2.PassportImage</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Resource1.Close1"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="../../@Model.PassportImagePath" class="img-fluid" alt="@Resource1.passport_picture" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const checkbox = document.getElementById("agreeCheck");
        const submitBtn = document.getElementById("submitBtn");
        if(checkbox){
            checkbox.addEventListener("change", function () {
                submitBtn.disabled = !this.checked;
            });
        }
    </script>
}