@model IndexCoursesVM
@{
    ViewData["Title"] = @Resource1.Courses;
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title Single"] = @Resource1.CoursesList;
    var MembersCoursePermission = PermissionScanner.ValidatePermission("Course", "MembersCourse");
    var EditPermission = PermissionScanner.ValidatePermission("Course", "Edit");
    var AddPermission = PermissionScanner.ValidatePermission("Course", "Add");
    var DeletePermission = PermissionScanner.ValidatePermission("Course", "Delete");
}

<!-- Header with Title, Count, and Create Button -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>

    <!-- Records Count + Actions -->
    <div class="col-md-6 d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <!-- Record count -->
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource2.CoursesNo:</span>
            <span id="countRecords">@Model?.CoursesVM_Paginated?.Count</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <!-- Main Card -->
        <div class="card">
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <!-- Page Title -->
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <i class="fa-solid fa-person-chalkboard me-2 text-ico"></i>
                            @Resource1.Courses
                        </h4>
                    </div>
                </div>

                <!-- Right Actions (Print / Excel) -->
                <div class="col-md-6 d-flex align-items-center gap-2 flex-wrap justify-content-end">
                    <!-- Create New button -->
                    @if (AddPermission)
                    {
                        <a asp-action="AddEdit" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource2.AddNewCourse
                        </a>
                    }
                    <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>

                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"></i>@Resource1.createExcelReport_Download
                    </a>

                </div>

                <script>
                    function openPrintPage() {
                        const get = id => document.getElementById(id)?.value || '';
                        const searchTerm = encodeURIComponent(get('searchTermInput'));
                        const dateFrom = encodeURIComponent(get('dateFrom'));
                        const dateTo = encodeURIComponent(get('dateTo'));
                        const selectedDept = encodeURIComponent(get('deptSelect'));
                        const selectedTrainer = encodeURIComponent(get('trainerSelect'));
                        var countRecords = document.getElementById('countRecords')?.textContent?.trim() || 0;

                        if (countRecords > 3999) {
                            showToastrCannotPrint();
                        } else {
                            const url = `/Admin/Course/Print?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}&selectedDept=${selectedDept}&selectedTrainer=${selectedTrainer}`;
                            window.open(url, 'printWindow', 'width=1000,height=800,noopener,noreferrer');
                        }
                    }

                    function openExcelPage() {
                        const searchTerm = encodeURIComponent(document.getElementById('searchTermInput')?.value || '');
                        const dateFrom = encodeURIComponent(document.getElementById('dateFrom')?.value || '');
                        const dateTo = encodeURIComponent(document.getElementById('dateTo')?.value || '');
                        const selectedDept = encodeURIComponent(document.getElementById('deptSelect')?.value || '');
                        const selectedTrainer = encodeURIComponent(document.getElementById('trainerSelect')?.value || '');
                        const url = `/Admin/Course/createExcelReport_Download?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}&selectedDept=${selectedDept}&selectedTrainer=${selectedTrainer}`;
                        window.open(url, '_self');
                    }
                </script>
            </div>

            <!-- Filter/Search Section -->
            <div class="rounded shadow-sm p-3">
                <form method="get" id="courseFilterForm" class="filterImg rounded">
                    @if (Model.UserIsTrainer)
                    {
                        <!-- Trainer View: Single Row Layout -->
                        <div class="d-flex flex-wrap gap-2 p-2 align-items-end">
                            <!-- Search Box -->
                            <div class="filter-dropdown flex-grow-1" style="min-width: 250px;">
                                <label for="searchTermInput" class="fw-medium mb-1 small">@Resource2.Search:</label>
                                <div class="search-box position-relative">
                                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                    <input type="text" name="searchTerm" id="searchTermInput"
                                           value="@Model?.CoursesVM_Paginated?.SearchTerm"
                                           class="form-control green-border form-control-sm filter-bordered ps-4"
                                           placeholder="@Resource1.SearchByCourseTitle ..." />
                                </div>
                            </div>

                            <!-- Date From -->
                            <div class="filter-dropdown" style="min-width: 160px;">
                                <label for="dateFrom" class="fw-medium mb-1 small">@Resource2.DateFrom:</label>
                                <div class="input-icon-left">
                                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                    <input type="date" name="dateFrom" id="dateFrom"
                                           class="form-control green-border form-control-sm filter-bordered"
                                           value="@ViewBag.DateFrom" />
                                </div>
                            </div>

                            <!-- Date To -->
                            <div class="filter-dropdown" style="min-width: 160px;">
                                <label for="dateTo" class="fw-medium mb-1 small">@Resource2.DateTo:</label>
                                <div class="input-icon-left">
                                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                    <input type="date" name="dateTo" id="dateTo"
                                           class="form-control green-border form-control-sm filter-bordered"
                                           value="@ViewBag.DateTo" />
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Admin View: Two Column Layout -->
                        <div class="d-flex flex-column flex-md-row justify-content-between gap-3 gap-md-4 w-100 p-2">
                            <!-- Left Column -->
                            <div class="d-flex flex-column w-100 w-md-50 gap-2">
                                <!-- Search Box -->
                                <div class="filter-dropdown">
                                    <label for="searchTermInput" class="fw-medium mb-2">@Resource2.Search:</label>
                                    <div class="search-box position-relative">
                                        <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                        <input type="text" name="searchTerm" id="searchTermInput"
                                               value="@Model?.CoursesVM_Paginated?.SearchTerm"
                                               class="form-control green-border form-control-sm filter-bordered ps-4"
                                               placeholder="@Resource1.SearchByCourseTitle ..." />
                                    </div>
                                </div>

                                <!-- Date Filters -->
                                <div class="d-flex flex-column flex-md-row gap-3">
                                    <!-- Date From -->
                                    <div class="filter-dropdown w-100">
                                        <label for="dateFrom" class="fw-medium mb-2">@Resource2.DateFrom:</label>
                                        <div class="input-icon-left">
                                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                            <input type="date" name="dateFrom" id="dateFrom"
                                                   class="form-control green-border form-control-sm filter-bordered"
                                                   value="@ViewBag.DateFrom" />
                                        </div>
                                    </div>

                                    <!-- Date To -->
                                    <div class="filter-dropdown w-100">
                                        <label for="dateTo" class="fw-medium mb-2">@Resource2.DateTo:</label>
                                        <div class="input-icon-left">
                                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                            <input type="date" name="dateTo" id="dateTo"
                                                   class="form-control green-border form-control-sm filter-bordered"
                                                   value="@ViewBag.DateTo" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="d-flex flex-column w-100 w-md-50 gap-2">
                                <!-- Department Dropdown -->
                                <div class="filter-dropdown">
                                    <label for="deptSelect" class="fw-medium mb-2">@Resource2.Departments:</label>
                                    <select class="form-select green-border form-select-sm filter-bordered"
                                            id="deptSelect" name="selectedDept" onchange="GetTrainersInDept(this.value)">
                                        <option value="">-- @Resource2.Select --</option>
                                        @foreach (var dept in ViewBag.Departments as IEnumerable<SelectListItem>)
                                        {
                                            <option value="@dept.Value" selected="@(dept.Value == (ViewBag.SelectedDept?.ToString() ?? ""))">
                                                @dept.Text
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- Trainer Dropdown -->
                                <div class="filter-dropdown">
                                    <label for="trainerSelect" class="fw-medium mb-2">@Resource1.Trainer2:</label>
                                    <select class="form-select green-border form-select-sm filter-bordered"
                                            id="trainerSelect" name="selectedTrainer" asp-items="Model?.TrainersList">
                                        <option value="">-- @Resource2.Select --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end align-items-center p-2 gap-2 flex-wrap">
                        <button type="button" id="btnClearFilters" class="btn-cancel-search btn btn-sm">
                            <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                        </button>
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="ri-filter-line me-1"></i> @Resource1.Search
                        </button>

                    </div>
                </form>
                <div class="col-12">
                    <div class ="pr-3 pl-3 pt-1">
                        <!-- Table -->
                        <div id="PartialNewListContainer">
                            @await Html.PartialAsync("_ListPartial", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteCarModal" tabindex="-1" aria-labelledby="deleteCarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-danger-header">
                <h5 class="modal-title" id="deleteCarModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>@Resource2.ConfirmDelete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong class="modal1">@Resource2.ConfirmDelete:</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>@Resource2.Cancel
                </button>
                <form id="deleteCourseForm" method="post" asp-action="Delete">
                    <input type="hidden" id="carIdToDelete" name="id" value="" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>@Resource2.Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!Model.UserIsTrainer) // User Is Not Trainer
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var deptId = $('#deptSelect').val();
                var trainerId = $('#TrainerIdValue').val();
                if (deptId) {
                    GetTrainersInDept(deptId, trainerId);
                }
            });

            function GetTrainersInDept(deptId, trainerId) {
                $.ajax({
                    url: '@Url.Action("GetTrainersInDept", "Course")',
                    type: 'GET',
                    data: { deptId, trainerId },
                    success: function (data) {
                        var trainerSelect = $('select[name="selectedTrainer"]').empty()
                            .append('<option value="">-- @Resource2.Select --</option>');
                        $.each(data.trainers, function (i, trainer) {
                            trainerSelect.append(
                                `<option value="${trainer.value}" ${trainer.selected ? 'selected' : ''}>${trainer.text}</option>`
                            );
                        });
                    }
                });
            }

            function setupDeleteModal(carId, plateNumber) {
                document.getElementById('carIdToDelete').value = carId;
                const modalLabel = document.getElementById('deleteCarModalLabel');
                modalLabel.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i>${@Json.Serialize(Resource2.ConfirmDelete)} - ${plateNumber}`;

                const modalBody = document.querySelector('#deleteCarModal .modal-body .modal1');
                modalBody.textContent = `${@Json.Serialize(Resource2.ConfirmDelete)} "${plateNumber}"؟`;

                new bootstrap.Modal(document.getElementById('deleteCarModal')).show();
            }
        </script>
    }

    @if (Model.UserIsTrainer) // User Is Trainer
    {

        <script>
            function openPrintPage() {
                const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
                const selectedDept ="";
                const selectedTrainer ="";
                const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
                const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
                var countRecords = document.getElementById('NewCountRecords').value;
                if(countRecords && countRecords>3999){
                    showToastrCannotPrint(); // Toaster Can't Print more 3999 record
                }
                else{
                    const url = `/Admin/Course/PrintIndex?searchTerm=${searchTerm}&selectedDept=${selectedDept}&selectedTrainer=${selectedTrainer}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                    //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                    // Open a standalone pop window (not a tab) so the original page doesn't freeze
                    const printWindow = window.open(
                        url,
                        'printWindow',
                        'width=1000,height=800,noopener,noreferrer'
                    );
                }
            }
        </script>
        <script>
            function openExcelPage() {
                const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
                const selectedDept ="";
                const selectedTrainer ="";
                const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
                const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
                const url = `/Admin/Course/createExcelReport_Download?searchTerm=${searchTerm}&selectedDept=${selectedDept}&selectedTrainer=${selectedTrainer}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                window.open(url, '_self');
            }
        </script>
    }
    @if (!Model.UserIsTrainer) // User Is Not Trainer
    {
        <script>
            function openPrintPage() {
                const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
                const selectedDept = encodeURIComponent(document.getElementById('deptSelect').value);
                const selectedTrainer = encodeURIComponent(document.getElementById('trainerSelect').value);
                const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
                const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
                var countRecords = document.getElementById('NewCountRecords').value;
                if(countRecords && countRecords>3999){
                    showToastrCannotPrint(); // Toaster Can't Print more 3999 record
                }
                else{
                    const url = `/Admin/Course/PrintIndex?searchTerm=${searchTerm}&selectedDept=${selectedDept}&selectedTrainer=${selectedTrainer}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                    //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                    // Open a standalone pop window (not a tab) so the original page doesn't freeze
                    const printWindow = window.open(
                        url,
                        'printWindow',
                        'width=1000,height=800,noopener,noreferrer'
                    );
                }
            }
        </script>

        <script>
            function openExcelPage() {
                const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
                const selectedDept = encodeURIComponent(document.getElementById('deptSelect').value);
                const selectedTrainer = encodeURIComponent(document.getElementById('trainerSelect').value);
                const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
                const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
                const url = `/Admin/Course/createExcelReport_Download?searchTerm=${searchTerm}&selectedDept=${selectedDept}&selectedTrainer=${selectedTrainer}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                window.open(url, '_self');
            }
        </script>
    }

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#dateFrom').val(filters.dateFrom);
                $('#dateTo').val(filters.dateTo);
                $('#deptSelect').val(filters.selectedDept || "");
                $('#trainerSelect').val(filters.selectedTrainer || "");
                $('#pageSizeSelect').val(filters.pageSize);


                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                $('#dateFrom').val('');
                $('#dateTo').val('');
                $('#deptSelect').val('');
                $('#trainerSelect').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    dateFrom: $('#dateFrom').val(),
                    dateTo: $('#dateTo').val(),
                    selectedDept : $('#deptSelect').length ? $('#deptSelect').val() : "",
                    selectedTrainer : $('#trainerSelect').length ? $('#trainerSelect').val() : "",
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var dateFrom = $('#dateFrom').val();
                var dateTo = $('#dateTo').val();
                var selectedDept = $('#deptSelect').length ? $('#deptSelect').val() : "";
                var selectedTrainer = $('#trainerSelect').length ? $('#trainerSelect').val() : "";

                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/Course/Index',
                    type: 'GET',
                    data: { searchTerm,selectedDept,selectedTrainer, dateFrom, dateTo, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>

}

