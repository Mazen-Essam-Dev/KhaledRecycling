@using FougeraClub.Areas.Admin.ViewModels.MonthlyAdministrativeReport
@model MonthlyAdministrativeReportVM

@{
    ViewData["Title"] = Resource2.MonthlyAdministrativeReport;
    ViewData["Title pakage"] = @Resource1.ExternalWorkMissionManagement;
    ViewData["Title ListIndex"] = @Resource1.MonthlyAdministrativeReportList ?? " ";
    ViewData["Title Single"] = @Resource2.MonthlyAdministrativeReport;
}
<style>
    label { color: #fff !important; font-weight: 600; }
    .overflow-table { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .container { width: 100% !important; box-shadow: none !important; page-break-inside: avoid; }
    th, td { box-shadow: none; border: 1px #000 solid !important; }
    .form-control:disabled { border: 0; font-size: 15px; color: #000; }

    @@media print {
        html, body { width: 100%; overflow: visible !important; }
        .container { max-width: 100% !important; }
        img { max-width: 100% !important; }
        * { border: 0 !important; box-shadow: none !important; }
        .overflow-table { width: 100%; overflow-x: hidden; }
        .print-none, .custom-navbar { display: none !important; }
        body { background: #fff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; font-size: 12px; margin: 0 !important; padding: 0 !important; }
        #printArea { width: 800px !important; margin: 0 auto !important; padding: 0 !important; }
        .row { margin-left: 0 !important; margin-right: 0 !important; }
        .flex-fill { flex: 1 1 auto !important; min-width: 0 !important; }
        table { outline: none !important; width: 100% !important; max-width: 100% !important; table-layout: fixed !important; box-shadow: none !important; border-collapse: collapse !important; }
        th, td { border: 1px solid #000 !important; padding: 1px !important; }
        input { border: none !important; box-shadow: none !important; background: transparent !important; -webkit-appearance: none; }
    }
</style>
<!-- Breadcrumb Navigation Column -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap print-none">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-6">
        <nav aria-label="breadcrumb" class="ms-2">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>

                <li class="breadcrumb-item"> <a href="/Admin/MonthlyAdministrativeReport/Index">@ViewData["Title ListIndex"]</a> </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <div class="col-md-6 d-flex justify-content-end gap-2 flex-wrap">
        @if(Model.ManagerSignature !=null && Model.TrainerSignature != null)
        {
            <button type="button" onclick="printDiv('printArea')" class="print-btn btn btn-success btn-sm">
                <i class="fa-solid fa-print me-1"></i> @Resource1.Print
            </button>
        }
        <a asp-action="Index" class="btn btn-cancel-search btn-sm back-btn">
            @Resource2.Back <i class="fa-solid fa-arrow-left me-1"></i>
        </a>
    </div>
</div>
<div class="card">
    <div class="container mb-3" id="printArea">
        <div class="d-flex justify-content-between align-items-center flex-wrap border-black  border-bottom py-3  mb-3">
            <div class="d-flex justify-content-between align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
                </div>
            </div>
            <div class="flex-fill text-center">
                <center>
                    <img src="~/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
                </center>
            </div>
            <div class="d-flex justify-content-end align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                </div>
            </div>
        </div>
        <div class="overflow-table">
        <table style="width:100%;  text-align:center;border-collapse:collapse;" cellspacing="0" cellpadding="5">
            @{
                var date = Model?.Date;
                var arabicCulture = System.Globalization.CultureInfo.GetCultureInfo("ar-AE");
                var monthYear = date != null ? date.Value.ToString("MMMM yyyy", arabicCulture) : string.Empty;
                var headerTitle = string.IsNullOrWhiteSpace(monthYear) ? "التقرير الإداري" : $"التقرير الإداري شهر {monthYear}";
            }
                <caption style="color:#af1717; font-weight:bold; font-size:17px;" class="text-center mb-2">@headerTitle</caption>
            <tr>
                <td style="width:25%; background:#eee; font-weight:bold; color: #000 !important;">
                    <label class="form-label text-black">@Resource2.Date</label>
                </td>
                <td style="width:75%;">
                        <input asp-for="Date" hidden disabled readonly class="form-control" style="border:0" />
                        <input id="d" name="d" value="@Model.Date?.ToString("d")?.Replace("/","-")" disabled readonly class="form-control" style="border:0" />
                    </td>
            </tr>
            <tr>
                <td style="width:25%; background:#eee; font-weight:bold; color: #000 !important;">
                        <label class="form-label text-black">القسم / الإدارة</label>
                    </td>
                <td style="width:75%;">
                    <input asp-for="AdministrativeDepartment" disabled readonly class="form-control" style="border:0" />
                </td>
            </tr>

            </table>
              </div>


 <div class="overflow-table">
            <table style="
    width:100%;
    text-align:center;
    border-collapse:collapse;
    table-layout:fixed;
" cellspacing="0" cellpadding="5">

                <colgroup>
                    <col style="width:45%;">
                    <col style="width:10%;">
                    <col style="width:45%;">
                </colgroup>

                <tr>
                    <td colspan="3" style="background:#eee;color:#000;font-weight:bold;">
                        @Resource1.ActivityName
                    </td>
                </tr>

                <tr>
                    <th style="width:45%;background:#f5f5f5;color:#000;
                   word-break:break-word;overflow-wrap:anywhere;
                   white-space:normal;overflow:hidden;">
                        @Resource1.ActivityName
                    </th>

                    <th style="width:10%;background:#f5f5f5;color:#000;
                   word-break:break-word;overflow-wrap:anywhere;
                   white-space:normal;overflow:hidden;">
                        @Resource2.NumberOfParticipants
                    </th>

                    <th style="width:45%;background:#f5f5f5;color:#000;
                   word-break:break-word;overflow-wrap:anywhere;
                   white-space:normal;overflow:hidden;">
                        @Resource1.ActivityReason1
                    </th>
                </tr>

                @if (Model?.Details != null)
                {
                    foreach (var detail in Model.Details)
                    {
                        <tr>
                            <td style="word-break:break-word;overflow-wrap:anywhere;
                                   white-space:normal;overflow:hidden;">
                                @detail.ActivityName
                            </td>

                            <td style="word-break:break-word;overflow-wrap:anywhere;
                                   white-space:normal;overflow:hidden;">
                                @detail.NumberOfParticipants
                            </td>

                            <td style="word-break:break-word;overflow-wrap:anywhere;
                                   white-space:normal;overflow:hidden;">
                                @detail.Reason
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" style="text-align:center;color:#999;">
                            @Resource2.NoRecordsFound
                        </td>
                    </tr>
                }
            </table>

            </div>

             @if (!string.IsNullOrEmpty(@Model.Notes)){
        <div class="overflow-table">
            <table style="width:100%;  text-align:center;border-collapse:collapse;" cellspacing="0" cellpadding="3">
                <tr>
                    <td colspan="3" style="background:#eee; color:#000;width:100%; font-weight:bold">@Resource1.GeneralNotes</td>
                </tr>
                @* <tr>
                    <td colspan="3" style="width:45%;background:#f5f5f5; color:#000; ">@Resource1.GeneralNotes</td>
                </tr> *@
               
                <tr>
                    <td colspan="3" class="text-center text-muted" style="white-space:pre-wrap; word-wrap:break-word; overflow-wrap:break-word; hyphens:auto;">@Model?.Notes</td>
                </tr>
                
            </table>
        </div>
        }

        @{
            var images = new List<string>();
            if (!string.IsNullOrEmpty(Model?.Image1Path)) images.Add(Model.Image1Path);
            if (!string.IsNullOrEmpty(Model?.Image2Path)) images.Add(Model.Image2Path);
            if (!string.IsNullOrEmpty(Model?.Image3Path)) images.Add(Model.Image3Path);
            if (!string.IsNullOrEmpty(Model?.Image4Path)) images.Add(Model.Image4Path);
            if (!string.IsNullOrEmpty(Model?.Image5Path)) images.Add(Model.Image5Path);
            if (!string.IsNullOrEmpty(Model?.Image6Path)) images.Add(Model.Image6Path);
        }

        
@if (images.Any())
        {
            <div class="overflow-table mb-3">

                <table style="width:100%;  text-align:center;border-collapse:collapse;" cellspacing="0" cellpadding="5">
                    <tr>
                        <td colspan="3" style="background:#eee; color:#000;width:100%; font-weight:bold">
                            @Resource2.ParticipationImages
                        </td>
                    </tr>

                    @for (int i = 0; i < images.Count; i += 3)
                    {
                        <tr>
                            <!-- Image 1 -->
                            <td style="padding:5px;width:33.5%">
                                <img src="~/@images[i]"
                                class="img-fluid rounded"
                                style="max-width: 100%!important; height:200px!important; object-fit:contain; padding:10px;" alt="Image"/>
                            </td>

                            <!-- Image 2 (if exists) -->
                            <td  style="padding:5px; width:33%">
                                @if (i + 1 < images.Count)
                                {
                                    <img src="~/@images[i + 1]"
                                    class="img-fluid rounded"
                                    style="max-width: 100%!important; height:200px!important; object-fit:contain; padding:10px;" alt="Image"/>
                                }
                            </td>
                            <!-- Image 3 (if exists) -->
                            <td style="padding:5px; width:33.5%">
                                @if (i + 2 < images.Count)
                                {
                                    <img src="~/@images[i + 2]"
                                         class="img-fluid rounded"
                                         style="max-width: 100%!important; height:200px!important; object-fit:contain; padding:10px;" alt="Image" />
                                }
                            </td>
                        </tr>
                    }
                </table>
            </div>
            }
        <div class="d-flex justify-content-end border-black border-top" style="padding-top: 20px;">
            <div class="d-flex justify-content-between w-100">
                <div class="d-flex align-items-center flex-column text-center" style="width:50%;">
                    <label class="form-label fw-bold text-black">@Resource1.SignatureActivitiesMembershipSupervisor : @Model.SupervisorFullName</label>
                <div class="small text-muted">
                    @if (Model?.TrainerSignature != null && !string.IsNullOrEmpty(Model.TrainerSignature.ImagePath))
                    {
                        <img src="~/@Model.TrainerSignature.ImagePath" class="img-fluid" style="height: 70px;" alt="Trainer Signature" />
                      
                    }
                    else if (PermissionScanner.ValidateRoleNumber()==RoleNumber.ActivitiesSupervisor && await PermissionScanner.CheckLoggedUserIfHasSignature())
                    {
                        <div id="trainerSignatureSection" class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                                <span>إضغط هنا للتوقيع</span>
                        </div>
                    }
                </div>
            </div>
                <div class="d-flex align-items-center flex-column text-center" style="width:50%;">
                    <label class="form-label fw-bold text-black">@Resource1.SignatureManager : @Model.ManagerFullName</label>
                <div class="small text-muted">
                    @if (Model?.TrainerSignature != null && !string.IsNullOrEmpty(Model.TrainerSignature.ImagePath))
                    {
                        @if (Model?.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath))
                        {
                            <img src="~/@Model.ManagerSignature.ImagePath" class="img-fluid" style="height: 70px;" alt="Manager Signature" />
                         
                        }
                        else if (PermissionScanner.ValidateRoleNumber()==RoleNumber.Manager && await PermissionScanner.CheckLoggedUserIfHasSignature())
                        {
                            <div id="managerSignatureSection" class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                                    <span>إضغط هنا للتوقيع</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        </div>



        <!-- OTP Modal: shared for both roles -->
        <div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="otpModalLabel">@Resource2.EnterOTP</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="otpForm">
                        <input type="hidden" id="otpEntityId" name="id" value="@Model.Id" />
                        <input type="hidden" id="otpRole" name="role" value="" />
                        <div class="modal-body text-center">
                            <p>@Resource2.PleaseEnterOTPToConfirmSignature</p>
                            <div class="d-flex justify-content-center gap-2">
                                @for (int i = 0; i < 4; i++)
                                {
                                    <input inputmode="numeric" maxlength="1" class="form-control otp-digit text-center fs-4" style="width:60px;" />
                                }
                            </div>
                            <div class="invalid-feedback text-center mt-2" style="display:none;">@Resource2.EnterValidDigitsCode</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-cancel-search btn" data-bs-dismiss="modal">@Resource2.Close</button>
                            <button type="submit" class="btn btn-success">@Resource2.Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function printDiv(divId) {
            window.print();
            document.body.innerHTML = originalPage;
            location.reload();
        }
    </script>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
            const otpInputs = Array.from(document.querySelectorAll("#otpModal .otp-digit")).reverse(); // reverse order for RTL
            const otpModal = document.getElementById("otpModal");
            const invalidFeedback = document.querySelector("#otpModal .invalid-feedback");

            otpInputs.forEach((input, index) => {
                input.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ""); // only digits
                    if (e.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus(); // move left (since reversed)
                    }
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });

            otpModal.addEventListener("shown.bs.modal", () => {
                otpInputs.forEach(i => i.value = "");
                otpInputs[0].focus();
                invalidFeedback.style.display = "none";
            });

            document.getElementById("otpForm").addEventListener("submit", function (e) {
                const otpValue = otpInputs.map(i => i.value).reverse().join(""); // restore normal order
                if (otpValue.length < 4) {
                    e.preventDefault();
                    invalidFeedback.style.display = "block";
                    return false;
                }
                invalidFeedback.style.display = "none";
                console.log("OTP entered:", otpValue);
            });
        });
    </script>


    <script>
        $(document).ready(function () {
            function openOtpModal(role) {
                $('#otpRole').val(role);
                // Send OTP
                $.ajax({
                    url: '/Admin/MonthlyAdministrativeReport/SendOtp',
                    type: 'POST',
                    data: { id: $('#otpEntityId').val(), role: role },
                    success: function (response) {
                        if (response.success) {
                            const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
                            otpModal.show();
                        } else {
                            alert('Failed to send OTP.');
                        }
                    },
                    error: function () {
                        alert('Error sending OTP.');
                    }
                });
            }
            $('#trainerSignatureSection').on('click', function () { openOtpModal('trainer'); });
            $('#managerSignatureSection').on('click', function () { openOtpModal('manager'); });

            // OTP form logic
            const otpModalEl = document.getElementById('otpModal');
            if (!otpModalEl) return;
            const otpModal = new bootstrap.Modal(otpModalEl, { backdrop: 'static', keyboard: false });
            const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit'));
            const otpForm = document.getElementById('otpForm');
            const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

            otpForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const code = otpDigits.map(d => d.value.trim()).join('');
                const id = document.getElementById('otpEntityId')?.value;
                const role = document.getElementById('otpRole')?.value;

                if (!/^\d{4}$/.test(code)) {
                    otpDigits.forEach(d => d.classList.add('is-invalid'));
                    otpInvalid.style.display = 'block';
                    return;
                }

                otpDigits.forEach(d => d.classList.remove('is-invalid'));
                otpInvalid.style.display = 'none';

                try {
                    const response = await fetch('/Admin/MonthlyAdministrativeReport/ValidateOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: id, code: code, role: role })
                    });
                    const result = await response.json();

                    if (result.success) {
                        otpModal.hide();
                        // Optionally reload page or update signature section
                        location.reload();
                    } else {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.textContent = result.message || "Invalid OTP.";
                        otpInvalid.style.display = 'block';
                    }
                } catch (err) {
                    alert('OTP validation failed.');
                }
            });
        });
    </script>
}
