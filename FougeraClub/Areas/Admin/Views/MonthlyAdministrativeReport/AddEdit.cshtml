@using FougeraClub.Areas.Admin.ViewModels.MonthlyAdministrativeReport
@model MonthlyAdministrativeReportVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? Resource2.EditMonthlyAdministrativeReport : Resource2.CreateMonthlyAdministrativeReport;
    ViewData["Title pakage"] = @Resource1.ExternalWorkMissionManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.MonthlyAdministrativeReportList ?? " ";
    ViewData["Title Single"] = ((Model?.Id == 0) ? @Resource2.CreateMonthlyAdministrativeReport : @Resource2.EditMonthlyAdministrativeReport) ?? " ";
}
<!-- Breadcrumb Navigation Column -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">

        <div class="d-flex align-items-center gap-2">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa-solid fa-file text-ico me-1 text-ico"></span>
                @ViewData["Title"]
            </h4>
        </div>
    </div>
    <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>

                <li class="breadcrumb-item"> <a href="/Admin/MonthlyAdministrativeReport/Index">@ViewData["Title ListIndex"]</a> </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
</div>
<div class="card">
    <div class="p-3 container-fluid">
        <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TempFile1_Path" />
            <input type="hidden" asp-for="TempFile2_Path" />
            <input type="hidden" asp-for="TempFile3_Path" />
            <input type="hidden" asp-for="TempFile4_Path" />
            <input type="hidden" asp-for="TempFile5_Path" />
            <input type="hidden" asp-for="TempFile6_Path" />
            <input type="hidden" asp-for="Old1_Path" />
            <input type="hidden" asp-for="Old2_Path" />
            <input type="hidden" asp-for="Old3_Path" />
            <input type="hidden" asp-for="Old4_Path" />
            <input type="hidden" asp-for="Old5_Path" />
            <input type="hidden" asp-for="Old6_Path" />
            <input hidden id="idPage" name="idPage" value="@Model?.Id" />

            <div class="row ">
                <!-- Date -->
                <div class="col-md-10 mb-2">
                    <label asp-for="Date" class="form-label asteriskRequired fw-semibold">@Resource2.Date</label>
                    <div class="input-icon-left">
                        <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                        <input asp-for="Date" class="form-control green-border form-control-sm filter-bordered" type="date" id="DateInput" />
                    </div>
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <!-- Type -->
                <div class="col-md-2 mb-2">
                    <label class="form-label fw-semibold asteriskRequired d-block">@Resource2.Type</label>
                    <div class="d-flex flex-wrap gap-3 mt-3">
                        @foreach (var item in Model?.TypeEnumList ?? Enumerable.Empty<SelectListItem>())
                        {
                            <div class="form-check">
                                <input class="form-check-input typeradiobtn"
                                       type="radio"
                                       asp-for="Type"
                                       id="TypeEnum_@item.Value"
                                       value="@item.Value"
                                       checked="@(Model?.Type.HasValue == true ? Model?.Type.Value.ToString() == item.Value : false)" />
                                <label class="form-check-label" for="TypeEnum_@item.Value">@item.Text</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Type" id="typeValidVM" class="text-danger small"></span>
                    <span id="TypeCheckResult" class="small"></span>
                </div>
                <!-- Administrative Department -->
                <div class="col-md-6 mb-3">
                    <label asp-for="AdministrativeDepartment" class="form-label asteriskRequired fw-semibold">@Resource2.AdministrativeDepartment</label>
                    <input asp-for="AdministrativeDepartment" class="form-control" placeholder="@Resource2.AdministrativeDepartment" />
                    <span asp-validation-for="AdministrativeDepartment" class="text-danger small"></span>
                </div>

                <!-- Report Title -->
                <div class="col-md-6 mb-3">
                    <label asp-for="ReportTitle" class="form-label asteriskRequired fw-semibold">@Resource2.ReportTitle</label>
                    <input asp-for="ReportTitle" class="form-control" placeholder="@Resource2.ReportTitle" />
                    <span asp-validation-for="ReportTitle" class="text-danger small"></span>
                </div>
            </div>
            <!-- Activities -->
            <div class="row ">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.AddActivities</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>
            <div class="c-edit-form mb-3">
                <div class="row">
                    <div class="col-md-12 mb-2">
                        <label for="ActivityName" class="form-label asteriskRequired fw-semibold">@Resource1.ActivityName</label>
                        <input id="ActivityName" class="form-control" type="text" />
                        <span id="ActivityNameResult" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label for="ActivityStartDate" class="form-label asteriskRequired fw-semibold">@Resource2.ActivityStartDate</label>
                        <div class="input-icon-left">
                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                            <input id="ActivityStartDate" class="form-control green-border form-control-sm filter-bordered" type="date" />
                        </div>
                        <span id="ActivityStartDateResult" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label for="ActivityEndDate" class="form-label asteriskRequired fw-semibold">@Resource2.ActivityEndDate</label>
                        <div class="input-icon-left">
                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                            <input id="ActivityEndDate" class="form-control green-border form-control-sm filter-bordered" type="date" />
                        </div>
                        <span id="ActivityEndDateResult" class="text-danger small"></span>

                    </div>
                    <div class="col-md-6 mb-2">
                        <label for="NumberOfParticipants" class="form-label asteriskRequired fw-semibold">@Resource2.NumberOfParticipants</label>
                        <input id="NumberOfParticipants" class="form-control" type="number" />
                        <span id="NumberOfParticipantsResult" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label for="Reason" class="form-label asteriskRequired fw-semibold">@Resource1.ActivityReason1</label>
                        <input id="Reason" class="form-control" type="text" />
                        <span id="reasonResult" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12 d-flex justify-content-end mt-3 mb-2">
                        <button type="button" class="btn btn-success px-4" onclick="addRow()">
                            <i class="fa-solid fa fa-plus-square me-2"></i> @Resource2.Add
                        </button>
                    </div>
                </div>

                <!-- Table -->
                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover align-middle table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>@Resource1.ActivityName</th>
                                <th>@Resource2.NumberOfParticipants</th>
                                <th>@Resource2.ActivityStartDate</th>
                                <th>@Resource2.ActivityEndDate</th>
                                <th>@Resource1.ActivityReason1</th>
                                <th>@Resource2.Actions</th>
                            </tr>
                        </thead>
                        <tbody id="Details">
                            @if (Model?.Details != null)
                            {
                                var index = 0;
                                @if (Model.Id > 0)
                                { //Edit --> text to Date in Type To Work
                                    foreach (var detail in Model.Details)
                                    {
                                        <tr>
                                            <td><input class="form-control" name="Details[@index].ActivityName" value="@detail.ActivityName" readonly /></td>
                                            <td><input class="form-control" type="number" name="Details[@index].NumberOfParticipants" value="@detail.NumberOfParticipants" readonly /></td>
                                            <td><input class="form-control" type="text" name="Details[@index].ActivityStartDate" value="@detail.ActivityStartDate?.ToString("yyyy-MM-dd")" readonly /></td>
                                            <td><input class="form-control" type="text" name="Details[@index].ActivityEndDate" value="@detail.ActivityEndDate?.ToString("yyyy-MM-dd")" readonly /></td>
                                            <td><input class="form-control" name="Details[@index].Reason" value="@detail.Reason" readonly /></td>
                                            <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
                                        </tr>
                                        index++;
                                    }
                                }
                                else
                                {//Add Readonly
                                    foreach (var detail in Model.Details)
                                    {
                                        <tr>
                                            <td><input class="form-control" name="Details[@index].ActivityName" value="@detail.ActivityName" readonly /></td>
                                            <td><input class="form-control" type="number" name="Details[@index].NumberOfParticipants" value="@detail.NumberOfParticipants" readonly /></td>
                                            <td><input class="form-control" type="text" name="Details[@index].ActivityStartDate" value="@detail.ActivityStartDate?.ToString("yyyy-MM-dd")" readonly /></td>
                                            <td><input class="form-control"  type="text" name="Details[@index].ActivityEndDate" value="@detail.ActivityEndDate?.ToString("yyyy-MM-dd")" readonly /></td>
                                            <td><input class="form-control" name="Details[@index].Reason" value="@detail.Reason" readonly /></td>
                                            <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
                                        </tr>
                                        index++;
                                    }
                                }

                            }
                            else
                            {
                                <tr>
                                    <td colspan="20" class="text-center p-5">
                                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                            <h5 class="mt-3">@Resource1.NoData</h5>
                                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                                        </div>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>

