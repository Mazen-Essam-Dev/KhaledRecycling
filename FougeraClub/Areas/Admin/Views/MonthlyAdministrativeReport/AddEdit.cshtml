@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let id = document.getElementById("Id").value;
            let selectedType = $(this).val();
            let selectedDate = document.getElementById("DateInput").value;
            // let msgValid = "@Html.Raw(Resource1.Dateisvalid)";
            let msgValid = " ";
            let msgInvalid = "@Html.Raw(@Resource2.ReportIsExist)";
            validateReportDate(id,selectedType,selectedDate,msgValid,msgInvalid);
        });
    </script>

    <script>

        $(document).ready(function () {

            function triggerValidation() {
                let id = document.getElementById("Id")?.value;
                let selectedType = $('.typeradiobtn:checked').val();
                let selectedDate = document.getElementById("DateInput")?.value;

                // const msgValid = "@Html.Raw(Resource1.Dateisvalid)";
                const msgValid = " ";
                const msgInvalid = "@Html.Raw(@Resource2.ReportIsExist)";

                if (selectedType && selectedDate) {
                    validateReportDate(id, selectedType, selectedDate, msgValid, msgInvalid);
                }
            }

            // 1 تشغيل بعد تحميل الصفحة
            triggerValidation();

            // 2 تشغيل عند التغيير
            $('.typeradiobtn, #DateInput').on('change', function () {
                triggerValidation();
            });

        });


        function validateReportDate(id,selectedType,selectedDate,msgValid,msgInvalid){
            $.ajax({
                url: '@Url.Action("CheckDate", "MonthlyAdministrativeReport", new { area = "Admin" })',
                type: 'POST',
                data: {id :id, date: selectedDate , type :selectedType},
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    $("#typeValidVM").text("");
                    if (result === false) {
                        $("#TypeCheckResult").text(msgValid)
                        .removeClass("text-danger").addClass("text-success");
                    } else {
                        $("#TypeCheckResult").text(msgInvalid)
                        .removeClass("text-success").addClass("text-danger");
                    }
                },
                error: function () {
                    $("#TypeCheckResult").text("⚠ Error checking date")
                        .removeClass("text-success").addClass("text-warning");
                }
            });
        }
    </script>

    <script>
        let rowIndex = @Model?.Details?.Count() ?? 0;

        function addRow() {
            const idPage = document.getElementById("idPage").value;
            const startMustBeInSameMonth = "@Html.Raw(Resource2.TheStartDateMustBeInSameMonth)";
            const startMustBeInSameYear = "@Html.Raw(Resource1.TheStartDate_mustSameyear)";
            const endMustBeInSameMonth = "@Html.Raw(Resource2.TheEndDateMustBeInSameMonth)";
            const endMustBeInSameYear = "@Html.Raw(Resource2.TheEndDateMustBeInSameYear)";
            const name = document.getElementById("ActivityName").value;
            const participants = document.getElementById("NumberOfParticipants").value;
            const start = document.getElementById("ActivityStartDate").value;
            const end = document.getElementById("ActivityEndDate").value;
            const reason = document.getElementById("Reason").value;

            var dateInput = document.getElementById("DateInput").value;
            var dateInputMonth = new Date(dateInput).getMonth() + 1; // Months are zero-based
            var dateInputYear = new Date(dateInput).getYear() + 1; // Years are zero-based

            // Convert to Date objects
            var startDate = new Date(start);
            var endDate = new Date(end);

        // Validate both start & end
        let flag = false;


        if (!name) {
            $("#ActivityNameResult").text("@Html.Raw(Resource1.Required)");
            flag = true;
        }else{
            $("#ActivityNameResult").text("");
        }

        if (!start) {
            $("#ActivityStartDateResult").text("@Html.Raw(Resource1.Required)");
            flag = true;
        }else if (startDate.getMonth() + 1 !== dateInputMonth){
            document.getElementById("ActivityStartDateResult").innerText =startMustBeInSameMonth;
            flag = true;
        }
        else if(startDate.getYear() + 1 !== dateInputYear) {
            document.getElementById("ActivityStartDateResult").innerText =startMustBeInSameYear;
            flag = true;
        }        
        else{
            $("#ActivityStartDateResult").text("");
        }

        if (!end) {
            $("#ActivityEndDateResult").text("@Html.Raw(Resource1.Required)");
            flag = true;
        }else if (endDate.getMonth() + 1 !== dateInputMonth) {
            document.getElementById("ActivityEndDateResult").innerText = endMustBeInSameMonth;
            flag = true;
        }else if (endDate.getYear() + 1 !== dateInputYear) {
            document.getElementById("ActivityEndDateResult").innerText = endMustBeInSameYear;
            flag = true;
        }else if (end < start) {
            $("#ActivityEndDateResult").text("@Html.Raw(Resource1.EndDateMustAfterStartDate)");
            flag = true;
        }else{
            $("#ActivityEndDateResult").text("");
        }

        if (!participants) {
            $("#NumberOfParticipantsResult").text("@Html.Raw(Resource1.Required)");
            flag = true;
        }else{
            $("#NumberOfParticipantsResult").text("");
        }
        if (!reason) {
            $("#reasonResult").text("@Html.Raw(Resource1.Required)");
            flag = true;
        }else{
            $("#reasonResult").text("");
        }

       

        
        if(flag){
            return;
        }

            const tbody = document.getElementById("Details");

            const row = document.createElement("tr");

            if(idPage > 0)
            { // Edit
                row.innerHTML = `
                    <td><input class="form-control" name="Details[${rowIndex}].ActivityName" value="${name}" readonly/></td>
                    <td><input class="form-control" type="number" name="Details[${rowIndex}].NumberOfParticipants" value="${participants}"readonly /></td>
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityStartDate" value="${start}"readonly /></td>
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityEndDate" value="${end}"readonly /></td>
                    <td><input class="form-control" name="Details[${rowIndex}].Reason" value="${reason}"readonly /></td>
                    <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
                `;
            }else{ // add ReadOnly
                row.innerHTML = `
                    <td><input class="form-control" name="Details[${rowIndex}].ActivityName" value="${name}" readonly /></td>
                    <td><input class="form-control" type="number" name="Details[${rowIndex}].NumberOfParticipants" value="${participants}" readonly /></td>
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityStartDate" value="${start}" readonly /></td>
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityEndDate" value="${end}" readonly /></td>
                    <td><input class="form-control" name="Details[${rowIndex}].Reason" value="${reason}" readonly /></td>
                    <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
                `;
            }
            tbody.appendChild(row);
            rowIndex++;

            // Clear inputs
            document.getElementById("ActivityName").value = "";
            document.getElementById("NumberOfParticipants").value = "";
            document.getElementById("ActivityStartDate").value = "";
            document.getElementById("ActivityEndDate").value = "";
            document.getElementById("Reason").value = "";
        }

        // Store the row to be deleted
        let rowToDelete = null;
        function removeRow(button) {
            rowToDelete = button.closest("tr");
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        function confirmDeleteRow() {
            if (rowToDelete) {
                rowToDelete.remove();
                // Reindex all rows
                const rows = document.querySelectorAll("#Details tr");
                rows.forEach((row, i) => {
                    const inputs = row.querySelectorAll("input");
                    inputs.forEach(input => {
                        const name = input.getAttribute("name");
                        if (name) {
                            input.setAttribute("name", name.replace(/\[\d+\]/, `[${i}]`));
                        }
                    });
                });
                rowIndex = rows.length;
                rowToDelete = null;
            }
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            if (modal) modal.hide();
        }
    </script>

    <!-- Delete Modal (matches other admin pages) -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Resource2.ConfirmDelete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>هل أنت متأكد من أنك تريد حذف هذا العنصر؟ هذا الإجراء لا يمكن التراجع عنه.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel-search" data-bs-dismiss="modal">@Resource2.Cancel</button>
                    <button type="button" class="btn btn-success" onclick="confirmDeleteRow()">@Resource2.Delete</button>
                </div>
            </div>
        </div>
    </div>


}
