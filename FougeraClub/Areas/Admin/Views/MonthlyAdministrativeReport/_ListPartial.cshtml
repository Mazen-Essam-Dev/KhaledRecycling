@using FougeraClub.Areas.Admin.ViewModels.MonthlyAdministrativeReport
@model PaginatedList<MonthlyAdministrativeReportVM>

@{
    var lang = SessionHelper.GetCurrentLanguage();

    ViewData["Title pakage"] = @Resource1.ExternalWorkMissionManagement ?? " ";
    ViewData["Title Single"] = @Resource2.MonthlyAdministrativeReportList ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("MonthlyAdministrativeReport", "Add");
    var editPermission = PermissionScanner.ValidatePermission("MonthlyAdministrativeReport", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("MonthlyAdministrativeReport", "Delete");
}


<input type="hidden" id="NewCountRecords" value="@Model.Count" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize)">@s</option>
        }
    </select>

</nav>

<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:5%;">@Resource2.Year</th>
                <th style="width:7%;">@Resource2.Month</th>
                <th style="width:15%;">@Resource2.Type</th>
                <th style="width:72%;">@Resource1.ControlTools</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    var boolManagerSignature = item.ManagerSignature != null && !string.IsNullOrEmpty(item.ManagerSignature.ImagePath);
                    var boolActivitySupervisorSignature = item.TrainerSignature != null && !string.IsNullOrEmpty(item.TrainerSignature.ImagePath);
                    var bool2And = (boolActivitySupervisorSignature && boolManagerSignature);
                    var MakeEditOpen = (!boolActivitySupervisorSignature || (!bool2And && Model.IsUserLogedInISManager));
                    var NoEdit = !MakeEditOpen;
                    <tr>
                        <td>@(item.Date.HasValue? item.Date.Value.ToString("yyyy") : "")</td>

                        <td>@(item.Date.HasValue? item.Date.Value.ToString("MMMM").ToString() : "")</td>

                        <td>@item.TypeText</td>

                        <td data-label="@Resource2.Actions">
                            <!-- Edit MonthlyAdministrativeReport -->
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Details">
                                <a class="btn-control btn-icon btn-sm rounded-circle"
                                   asp-action="Details" asp-route-id="@item.Id">
                                    <i class="fa-solid fs-5 fa-eye"></i>
                                </a>
                            </span>
                            @* @if (item.ManagerSignitureId != null && item.TrainerSignitureId != null)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Print">
                                    <a asp-action="PrintDetails"
                                       asp-route-id="@item?.Id" target="_blank"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fs-5 fa-print"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Print">
                                    <a asp-action="#"
                                       class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fs-5 fa-print"></i>
                                    </a>
                                </span>
                            } *@
                            @if (editPermission@*  && item?.TrainerSignitureId == null *@ && MakeEditOpen)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit"
                                       asp-route-id="@item?.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fs-5 fa-pen-to-square"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a action="#"
                                       class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fs-5 fa-pen-to-square"></i>
                                    </a>
                                </span>
                            }
                           
                            <!-- Delete MonthlyAdministrativeReport -->
                            @if (deletePermission && item?.TrainerSignitureId == null)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" data-swal="delete" data-message="@item?.ReportTitle"
                                          asp-route-id="@item?.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit"
                                                class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fs-5 fa-trash"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <a asp-action="#"
                                       class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fs-5 fa-trash"></i>
                                    </a>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
