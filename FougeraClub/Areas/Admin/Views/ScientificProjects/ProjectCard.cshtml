<!-- OTP Modal -->
<div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="otpModalLabel">@Resource2.EnterOTP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="otpForm">
                <input type="hidden" id="otpEntityId" name="id" value="@Model?.Id" />
                <input type="hidden" id="otpRole" name="role" value="" />
                <div class="modal-body text-center">
                    <p>@Resource2.PleaseEnterOTPToConfirmSignature</p>
                    <div class="d-flex justify-content-center gap-2">
                        @for (int i = 0; i < 4; i++)
                        {
                            <input inputmode="numeric" maxlength="1" class="form-control otp-digit text-center fs-4"
                                   style="width:60px;" />
                        }
                    </div>
                    <div class="invalid-feedback text-center mt-2" style="display:none;">Enter a valid 4-digit code.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource2.Back</button>
                    <button type="submit" class="btn btn-success">@Resource2.Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Function to handle OTP input focus
            const otpInputs = Array.from(document.querySelectorAll("#otpModal .otp-digit")).reverse(); // reverse order for RTL
            const otpModalEl = document.getElementById("otpModal");
            const invalidFeedback = document.querySelector("#otpModal .invalid-feedback");

            otpInputs.forEach((input, index) => {
                input.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ""); // only digits
                    if (e.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus(); // move to next
                    }
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });

            otpModalEl.addEventListener("shown.bs.modal", () => {
                otpInputs.forEach(i => i.value = "");
                otpInputs[0].focus();
                invalidFeedback.style.display = "none";
            });

            // Handle Signature Clicks
            $('.signature-trigger').on('click', function () {
                const triggerId = $(this).attr('id');
                let role = "";
                if (triggerId === 'TrainerSignatureSection') role = "Trainer";
                else if (triggerId === 'activityMonitorSignatureSection') role = "activityMonitor";
                else if (triggerId === 'managerSignatureSection') role = "manager";

                if (!role) return;

                const id = $('#otpEntityId').val();
                $('#otpRole').val(role);

                $.ajax({
                    url: '/Admin/ScientificProjects/SendOtp',
                    type: 'POST',
                    data: { id: id, role: role },
                    success: function (response) {
                        if (response.success) {
                            bootstrap.Modal.getOrCreateInstance(otpModalEl).show();
                        } else {
                            alert('Failed to send OTP. Please try again.');
                        }
                    },
                    error: function () {
                        alert('Error connecting to server.');
                    }
                });
            });

            // Handle OTP Submission
            $('#otpForm').on('submit', async function (e) {
                e.preventDefault();
                const code = otpInputs.map(i => i.value).reverse().join(""); // restore normal order
                const id = $('#otpEntityId').val();
                const role = $('#otpRole').val();

                if (code.length < 4) {
                    invalidFeedback.style.display = "block";
                    return;
                }

                try {
                    const response = await fetch('/Admin/ScientificProjects/ValidateOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: id, code: code, role: role })
                    });
                    const result = await response.json();

                    if (result.success) {
                        bootstrap.Modal.getOrCreateInstance(otpModalEl).hide();
                        location.reload();
                    } else {
                        invalidFeedback.textContent = result.message || "Invalid OTP.";
                        invalidFeedback.style.display = 'block';
                    }
                } catch (err) {
                    console.error('OTP validation failed:', err);
                }
            });
        });
    </script>
}
