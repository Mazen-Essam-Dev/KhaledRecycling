@model ScientificProjectsVM

@{
    ViewData["Title"] = @Resource1.ProjectCard2;
    ViewData["Title pakage"] = @Resource1.ScientificProjectsManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.ScientificProjectsList ?? " ";
    ViewData["Title Single"] = @Resource1.ProjectCard2 ?? " ";

    var printProjectCardPermission = PermissionScanner.ValidatePermission("ScientificProjects", "PrintProjectCard");

    var boolManagerSignature = Model.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath);
    var boolActivityMonitorSigniture = Model.ActivityMonitorSigniture != null && !string.IsNullOrEmpty(Model.ActivityMonitorSigniture.ImagePath);
    var boolTrainerSigniture = Model.Trainer1Signiture != null && !string.IsNullOrEmpty(Model.Trainer1Signiture.ImagePath);

    decimal MoneyCost = (decimal)(Model.ExpectedCost ?? 0);
    var arTafqeet = TafqeetHelper.Tafqeet(MoneyCost, CurrencyHelper.AED_Main_Ar, CurrencyHelper.AED_Sub_Ar);
    var enTafqeet = TafqeetHelper.Tafqeet(MoneyCost, CurrencyHelper.AED_Main_En, CurrencyHelper.AED_Sub_En);
}
<script>
    function printDiv(divId) {
      window.print();
      document.body.innerHTML = originalPage;
