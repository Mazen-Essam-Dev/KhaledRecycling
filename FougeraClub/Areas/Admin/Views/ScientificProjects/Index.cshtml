@model ScientificProjectsVM

@{
    var lang = SessionHelper.GetCurrentLanguage();
    ViewData["Title"] = Resource1.ScientificProjectsList;
    ViewData["Title pakage"] = @Resource1.ScientificProjectsManagement ?? " ";
    ViewData["Title Single"] = @Resource1.ScientificProjectsList ?? " ";

    var editPermission = PermissionScanner.ValidatePermission("ScientificProjects", "Edit");
    var projectCardPermission = PermissionScanner.ValidatePermission("ScientificProjects", "ProjectCard");
    var deletePermission = PermissionScanner.ValidatePermission("ScientificProjects", "Delete");
}


<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count Display Column -->
    <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource1.RecordsCount:</span>
            <span id="recordsCount">@Model.TotalCount</span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <h4 class="ico-header-title my-1">
                        <i class="fa-solid fa-list-check text-ico me-1"></i>
                        @Resource1.ScientificProjects
                    </h4>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (PermissionScanner.ValidatePermission("ScientificProjects", "Create"))
                    {
                        <a asp-action="Create" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource1.Add_New_ScientificProjects1
                        </a>
                    }
                    <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>
                    <!-- Print Export As Excel -->
                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"
                            style="font-size:17px;"></i>@Resource1.createExcelReport_Download
                    </a>
                </div>
            </div>

            <div class="rounded shadow-sm p-3">
                <!-- Search Panel -->
                <form method="get" id="projectFilterForm" class="filterImg rounded p-3">
                    <div class="row">
                        <div class=" col-md-4">
                            <label for="searchTermInput" class="fw-semibold mb-1">@Resource2.Search:</label>
                            <div class="search-box position-relative">
                                <i
                                    class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                <input type="text" name="searchTerm" id="searchTermInput" value="@Model.SearchString"
                                    class="form-control form-control-sm filter-bordered ps-4"
                                    placeholder="@Resource1.Search_by_ProjectName_or_Department" />
                            </div>
                        </div>



                        <div class="filter-dropdown col-md-4">
                            <label for="dateFrom" class="fw-semibold mb-1">@Resource1.DateFrom:</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                                    class="date-icon">
                                <input type="date" name="dateFrom" id="dateFrom"
                                    class="form-control form-control-sm filter-bordered"
                                    value="@(Model.StartDate.HasValue? Model.StartDate.Value.ToString("d")?.Replace("/","-") : "")" />
                            </div>
                        </div>



                        <div class="filter-dropdown col-md-4">
                            <label for="dateTo" class="fw-semibold mb-1">@Resource1.DateTo:</label>


                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                                    class="date-icon">
                                <input type="date" name="dateTo" id="dateTo"
                                    class="form-control green-border form-control-sm filter-bordered"
                                    value="@(Model.EndDate.HasValue? Model.EndDate.Value.ToString("d")?.Replace("/","-") : "")" />

                            </div>



                        </div>



                        <!-- Filter Action Buttons -->
                        <div class="d-flex justify-content-end align-items-center  gap-2 flex-wrap mt-3">
                            <button type="button" id="btnClearFilters" class="btn btn-cancel-search btn-sm">
                                <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                            </button>
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="ri-filter-line me-1"></i> @Resource1.Search
                            </button>
                        </div>
                    </div>
                </form>


                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ListPartial", Model)
                </div>

            </div>
        </div>
    </div>
</div>


<!-- OTP Modal: shared for both roles -->
<div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="otpModalLabel">@Resource2.EnterOTP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="otpForm">
                <input type="hidden" id="otpEntityId" name="id" value="@Model.Id" />
                <input type="hidden" id="otpRole" name="role" value="" />

                <textarea id="otpNotes" name="Notes" placeholder="@Resource1.Notes"
                    class="form-control otp-digit text-center fs-4" value="" rows="3"></textarea>
                <div class="modal-body text-center">
                    <p>@Resource2.PleaseEnterOTPToConfirmSignature</p>
                    <div class="d-flex justify-content-center gap-2">
                        @for (int i = 0; i < 4; i++)
                        {
                            <input inputmode="numeric" maxlength="1" class="form-control otp-digit text-center fs-4"
                                style="width:60px;" />
                        }
                    </div>
                    <div class="invalid-feedback text-center mt-2" style="display:none;">Enter a valid 4-digit code.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel-search" data-bs-dismiss="modal">@Resource2.Back ??
                        "Close"</button>
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Resource1.Delete_Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Resource1.Close"></button>
            </div>
            <div class="modal-body">
                <p>@Resource1.are_you_sure_Delete <strong id="projName"></strong>؟</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="projId" />
                    <button type="button" class="btn btn-cancel-search"
                        data-bs-dismiss="modal">@Resource1.Cancel</button>
                    <button type="submit" class="btn btn-success">@Resource1.Yes_delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Resource2.Sorry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="deleteInfoMessage" class=" text-center"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-cancel-search" data-bs-dismiss="modal">@Resource1.Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPrintPage() {
            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
            const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
            const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
            var countRecords = document.getElementById('NewCountRecords').value;
            if (countRecords && countRecords > 3999) {
                showToastrCannotPrint(); // Toaster Can't Print more 3999 record
            }
            else {
                const url = `/Admin/ScientificProjects/Print?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                // Open a standalone pop window (not a tab) so the original page doesn't freeze
                const printWindow = window.open(
                    url,
                    'printWindow',
                    'width=1000,height=800,noopener,noreferrer'
                );
            }
        }


    </script>
    <script>
        function openExcelPage() {
            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
            const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
            const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
            const url = `/Admin/ScientificProjects/createExcelReport_Download?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
            window.open(url, '_self');
        }


    </script>
