@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deptId = $('#DepartmentId').val();
            var trainerId = $('#TrainerIdValue').val();
            console.log({deptId});
            if (deptId) {
                GetTrainersInDept(deptId, trainerId);
            }
        });

        function GetTrainersInDept(deptId, trainerId) {
            $.ajax({
                url: '@Url.Action("GetTrainersInDept", "Course")',
                type: 'GET',
                data: { deptId, trainerId },
                success: function (data) {
                    var trainerSelect = $('select[name="TrainerId"]').empty()
                        .append('<option value="">-- @Resource2.Select --</option>');
                    $.each(data.trainers, function (i, trainer) {
                        trainerSelect.append(
                            `<option value="${trainer.value}" ${trainer.selected ? 'selected' : ''}>${trainer.text}</option>`
                        );
                    });
                }
            });
        }

    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const projectDateInput = document.querySelector('[name="DateByCalander"]');
            const closedDateInput = document.querySelector('[name="ClosedDate"]');
            const form = projectDateInput.closest("form");

            const projectError = projectDateInput.parentElement.parentElement.querySelector("span");
            const closedError = closedDateInput.parentElement.parentElement.querySelector("span");

            function validateDates() {

                let isValid = true;

                const projectDate = projectDateInput.value;
                const closedDate = closedDateInput.value;

                // Reset messages
                projectError.textContent = "";
                closedError.textContent = "";

                // 1️ تاريخ المشروع إجباري
                if (!projectDate) {
                    projectError.textContent = "يجب اختيار تاريخ المشروع";
                    isValid = false;
                }

                // 2️ (validation for closed date comparison removed)

                return isValid;
            }

            // يتحقق عند أي تغيير
            projectDateInput.addEventListener("change", validateDates);
            closedDateInput.addEventListener("change", validateDates);

            // يمنع الإرسال لو فيه خطأ
            form.addEventListener("submit", function (e) {
                if (!validateDates()) {
                    e.preventDefault();
                }
            });

        });
    </script>
}
