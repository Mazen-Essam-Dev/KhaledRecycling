                                user.imagePath : '/' + user.imagePath;
                            profileAvatar.classList.remove('loading');
                            if (avatarContainer) avatarContainer.classList.add('has-image');
                        };
                        img.onerror = function() {
                            profileAvatar.classList.remove('loading');
                        };
