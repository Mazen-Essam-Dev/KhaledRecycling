        if (!$el.length) return;

        if ($el.hasClass("select2-hidden-accessible")) {
            // Select2 initialized
            $el.val(null).trigger('change');
        } else {
            // fallback للـ select العادي
            $el.val('');
        }
    }
</script>
<script>
        $(document).ready(function () {
        // مزامنة حالة التحقق من الصحة مع Select2
        function syncSelect2Validation(selectElement) {
            var $select = $(selectElement);
            var $select2Container = $select.next('.select2-container');

            if ($select.hasClass('input-validation-error')) {
                // إضافة الإطار الأحمر
                $select2Container.find('.select2-selection').addClass('is-invalid-select2');
                $select.removeClass('is-valid').addClass('is-invalid');
            } else if ($select.val() && $select.val().toString().trim() !== '') {
                // إزالة الإطار الأحمر عند وجود قيمة
                $select2Container.find('.select2-selection').removeClass('is-invalid-select2');
                $select.removeClass('is-invalid').addClass('is-valid');
            } else {
                // إزالة جميع الكلاسات عند عدم وجود قيمة
                $select2Container.find('.select2-selection').removeClass('is-invalid-select2');
                $select.removeClass('is-invalid is-valid');
            }
        }

        // استمع لحدث submit لتطبيق الإطار الأحمر بعد فشل الـ Validation
        $(document).on('submit', 'form', function () {
            setTimeout(function () {
                $('form').find('select').each(function () {
                    syncSelect2Validation(this);
                });
            }, 10);
        });

        $(document).on('change', 'select', function () {
            // Force validation FIRST so unobtrusive validation updates its classes
            try {
                if (typeof $(this).valid === 'function' && $(this).closest('form').data('validator')) {
                    $(this).valid();
                }
            } catch (e) {
                console.log("Validation skip: ", e);
            }

            // Then sync the Select2 UI with the newly updated validation state
            var $select = $(this);
            if ($select.val() && $select.val().toString().trim() !== '') {
                // Forcefully remove error classes if a value is selected
                $select.removeClass('input-validation-error is-invalid');
                var name = $select.attr('name');
                if (name) {
                    // Hide MVC text error message if any
                    $('span[data-valmsg-for="' + name + '"]').removeClass('field-validation-error').addClass('field-validation-valid').empty();
                }
            }
            syncSelect2Validation(this);
        });

        // Make sure jQuery Validation does not ignore hidden select2 fields
        if (typeof $.validator !== "undefined") {
            $.validator.setDefaults({ ignore: "" });
        }

        // Also wait for AJAX loaded scripts in case validator is loaded later
        $(document).ajaxComplete(function () {
            if (typeof $.validator !== "undefined") {
                $.validator.setDefaults({ ignore: "" });
            }
        });
    });
</script>