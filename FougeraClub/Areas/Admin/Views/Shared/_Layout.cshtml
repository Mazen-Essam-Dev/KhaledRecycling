<link href="/css/select2-custom.css" rel="stylesheet" />
<script src="/js/select2-cdn-loader.js"></script>
<script>
    window.addEventListener('load', function () {
        function checkSelect2AndInit() {
            if (typeof jQuery !== 'undefined' && jQuery.fn && jQuery.fn.select2) {

                function InitSelect2OnElement(el) {
                    var $this = $(el);

                    // ✅ لو Hidden Select → اخفيه واطلع من الفنكشن
                    if ($this.hasClass("hiddenSelect")) {
                        $this.hide(); // أو addClass d-none
                        return;
                    }

                    if ($this.hasClass("no-select2") || $this.hasClass("select2-hidden-accessible") || $this.hasClass("flatpickr-monthDropdown-months") || $this.closest('.flatpickr-calendar').length) {
                        return;
                    }

                    if ($this.closest('.ui-datepicker').length) {
                        return;
                    }

                    var id = $this.attr('id') || '';
                    var name = $this.attr('name') || '';
                    var idAndName = (id + ' ' + name).toLowerCase();

                    var disableSearch = $this.hasClass('no-search') ||
                                        idAndName.indexOf('year') > -1 ||
                                        $this.hasClass('swal2-select');

                    var hiddenSelect = $this.hasClass('swal2-select');

                    // ✅ لو Hidden Select → اخفيه واطلع من الفنكشن
                    if (hiddenSelect) {
                        $this.hide(); // أو addClass d-none
                        return;
                    }

                    var emptyOptionText = $this.find('option[value=""], option:not([value])').first().text().trim();
                    var placeholderText = $this.attr('data-placeholder') || emptyOptionText || '-- اختر --';

                    var isPageSize = id === "pageSizeSelect";

                    if (!$this.find('option[value=""]').length && !isPageSize) {
                        $this.prepend('<option value="" disabled>' + placeholderText + '</option>');
                        if (!$this.val()) {
                            $this.val("");
                        }
                    }

                    $this.select2({
                        placeholder: isPageSize ? '' : placeholderText,
                        allowClear: false,
                        width: isPageSize ? 'style' : '100%',
                        minimumResultsForSearch: (disableSearch || isPageSize) ? Infinity : 0,
                        language: {
                            noResults: function () { return "لا يوجد نتائج"; },
                            searching: function () { return "جاري البحث..."; }
                        }
                    });
                }

                // 1. Initialize existing selects on initial load
                $('select').each(function () {
                    InitSelect2OnElement(this);
                });

                // 2. Set up MutationObserver to automatically initialize new selects added via AJAX (Partial Views)
                var observer = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        mutation.addedNodes.forEach(function(node) {
                            if (node.nodeType === 1) { // ELEMENT_NODE
                                if (node.tagName === 'SELECT') {
                                    InitSelect2OnElement(node);
                                }
                                $(node).find('select').each(function() {
                                    InitSelect2OnElement(this);
                                });
                            }
                        });
                    });
                });

                observer.observe(document.body, { childList: true, subtree: true });

                // Expose globally just in case
                window.InitGlobalSelect2 = function() {
                    $('select').each(function () { InitSelect2OnElement(this); });
                };
            } else {
                // If Select2 is not ready yet, wait 50ms and try again
                setTimeout(checkSelect2AndInit, 50);
            }
        }

        checkSelect2AndInit();
    });
</script>


