@using System.Security.Claims
@model PaginatedList<AdminVM>

@{
    ViewData["Title"] = @Resource1.UsersList;
    ViewData["Title pakage"] = "وحدة إدارة المستخدمين";
    ViewData["Title Single"] = @Resource1.UsersList;
    var loggedInUserId = @User.FindFirstValue(ClaimTypes.NameIdentifier);
    var EditPermission = PermissionScanner.ValidatePermission("Account", "Edit");
    var DeletePermission = PermissionScanner.ValidatePermission("Account", "Delete");
    var ResetPermission = PermissionScanner.ValidatePermission("Account", "ResetPassword");
}
<!-- Header with Title, Count, and Create Button -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-6">
        <nav aria-label="breadcrumb" class="ms-2">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count Display Column -->
    <div class="col d-flex justify-content-end align-items-center text-nowrap me-3">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource1.RecordsCount:</span>
            <span><label id="countRecords">@Model.Count </label></span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <i class="fa-solid fa-users me-1 text-ico"></i>
                            @Resource2.Users
                        </h4>
                    </div>
                </div>
                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    @if (PermissionScanner.ValidatePermission("Account", "Add"))
                    {
                        <a asp-action="AddEdit" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource2.CreateNewAccount
                        </a>

                    }
                    <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>
                    <!-- Print Export As Excel -->
                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"
                            style="font-size:17px;"></i>@Resource1.createExcelReport_Download
                    </a>
                </div>

                <script>
                    function openPrintPage() {
                        const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
                        var countRecords = document.getElementById('NewCountRecords').value;
                        if (countRecords && countRecords > 3999) {
                            showToastrCannotPrint(); // Toaster Can't Print more 3999 record
                        }
                        else {
                            const url = `/Admin/Account/Print?searchTerm=${searchTerm}`;
                            //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                            // Open a standalone pop window (not a tab) so the original page doesn't freeze
                            const printWindow = window.open(url, 'printWindow', 'width=1000,height=800,noopener,noreferrer');
                        }
                    }
                </script>
                <script>
                    function openExcelPage() {
                        const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
                        const url = `/Admin/Account/createExcelReport_Download?searchTerm=${searchTerm}`;
                        window.open(url, '_self');

                    }
                </script>
            </div>

            <div class="rounded shadow-sm p-3">
                <!-- Search Panel -->
                <form method="get" class="filterImg rounded">
                    <div class="row p-3">
                        <!-- Search Box -->
                        <div class="filter-dropdown col-md-10">
                            <label for="searchTermInput" class="fw-bold mb-1">@Resource2.Search:</label>
                            <div class="search-box position-relative">
                                <i
                                    class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                <input type="text" name="searchTerm" id="searchTermInput" value="@Model.SearchTerm"
                                    class="form-control form-control-sm filter-bordered ps-4"
                                    placeholder="@Resource2.Name @Resource2.Or @Resource2.PhoneNumber @Resource2.Or @Resource2.Email ..." />
                            </div>
                        </div>
                   
                    <div class="col-md-2 gap-1 d-flex justify-content-end align-items-end">
                        <button type="button" id="btnClearFilters" class="btn btn-cancel-search btn-sm coustom-min-w me-1">
                            <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                        </button>
                        <button type="submit" class="btn btn-success btn-sm coustom-min-w">
                            <i class="ri-filter-line me-1"></i> @Resource1.Search
                        </button>
                    </div>
                    </div>
                </form>

                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ListPartial", Model)
                </div>

            </div>

        </div>
    </div>
</div>



<div class="modal fade" id="deleteInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Resource2.Sorry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="deleteInfoMessage" class="fw-bold text-center text-danger"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">@Resource2.Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on("click", ".show-delete-info", function () {
            var message = $(this).data("message"); // take message from data-attribute
            $("#deleteInfoMessage").text(message);

            var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
            modal.show();
        });

    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                console.log('Submitting form via AJAX');
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/Account/Index',
                    type: 'GET',
                    data: { searchTerm, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>
}