@model FougeraClub.Areas.Admin.ViewModels.BudgetItem.BudgetItemVM
@{
    ViewData["Title pakage"] = @Resource2.FinancialManagement ?? " ";
    ViewData["Title Single"] = ((Model.Id == 0) ? @Resource2.AddBudgetItem : @Resource2.EditBudgetItem) ?? " ";
    ViewData["Title ListIndex"] = @Resource2.BudgetItems ?? " ";

}
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <h4 class="ico-header-title">
            <i class="fa-solid fa-money-check-dollar me-1 text-ico"></i>
            @((Model.Id == 0) ? @Resource2.AddBudgetItem : @Resource2.EditBudgetItem)
        </h4>
    </div>
    <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-end">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                    <li class="breadcrumb-item">
                        <a href="#">@ViewData["Title pakage"]</a>
                    </li>
                <li class="breadcrumb-item"><a href="/Admin/BudgetItem/Index">@ViewData["Title ListIndex"]</a></li>

                    <li class="breadcrumb-item">
                        <a href="#">@ViewData["Title Single"]</a>
                    </li>
                </ol>
            </nav>
    </div>
</div>
<div class="card border shadow-sm rounded-3 p-3 mb-3 c-pro">
        <form asp-action="AddEdit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-md-6" style="margin-top:.7rem;">
                    <label asp-for="ItemNumber" class="form-label">@Resource2.BudgetItemNo</label>
                    <input asp-for="ItemNumber" readonly class="form-control dimmed" />
                    <span asp-validation-for="ItemNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                <label asp-for="ItemTitle" class="form-label asteriskRequired">@Resource2.BudgetItem1</label>
                    <input asp-for="ItemTitle" class="form-control" />
                    <span asp-validation-for="ItemTitle" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-success me-2">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                </button>
            <a asp-action="Index" class="btn-cancel-search btn-sm btn">
                @Resource2.Back <i class="fa-solid fa-arrow-left me-1"></i>
                </a>
            </div>
        </form>
</div>