
@model PaginatedList<BudgetItemVM>
@{
    ViewData["Title"] = @Resource2.BudgetItem ?? " ";
    var editPermission = PermissionScanner.ValidatePermission("BudgetItem", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("BudgetItem", "Delete");
}
<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize)">
                @s
            </option>
        }
    </select>

</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:7%;">@Resource2.BudgetItemNo</th>
                <th >@Resource2.ItemTitle</th>
                <th style="width:8%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr data-id="@item?.Id">
                        <td data-label="@Resource2.BudgetItemNo">
                            <span class="fw-medium">@item?.ItemNumber</span>
                        </td>
                        <td data-label="@Resource2.ItemTitle">
                            <span class="text-decoration-underline">@item?.ItemTitle</span>
                        </td>
                        <td data-label="@Resource2.Actions">
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@item?.Id" class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            @if (deletePermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" asp-route-id="@item?.Id" class="d-inline" method="post" data-swal="delete" data-message="@Resource2.BudgetItem @item?.ItemTitle" onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">@Resource2.Previous</a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">@Resource2.Next</a>
        </li>
    </ul>
</nav>
