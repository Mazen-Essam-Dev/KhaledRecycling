                                <span>إضغط هنا للتوقيع</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="flex-column align-items-center flex-column text-center" style="width:50%;">
                    <label class="form-label fw-bold text-black">
                        <span>@Resource1.SignatureManager : @Model.ManagerFullName </span>
                    </label>

                    <div class="small text-muted">
                        @if (Model.TrainerSignature != null && !string.IsNullOrEmpty(Model.TrainerSignature.ImagePath))
                        {
                            @if (Model?.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath))
                            {
                                <img src="~/@Model.ManagerSignature.ImagePath" class="img-fluid"
                                style="height:70px;"/>

                            }
                            else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager
                            && await PermissionScanner.CheckLoggedUserIfHasSignature())
                            {
                                <div id="managerSignatureSection" class="signature-trigger" role="button" tabindex="0"
                                style="cursor:pointer;">
                                    <span>إضغط هنا للتوقيع</span>
                                </div>
                            }
