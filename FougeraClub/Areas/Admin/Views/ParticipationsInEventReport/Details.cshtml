                    </tr>
                }
            </tbody>
        </table>
        <div class="overflow-table">
            <table style="width:100%;  text-align:center; border-collapse:collapse;" cellspacing="0" cellpadding="5"
                class="mb-3">
                @{
                    var images2 = new List<string>();

                    if (!string.IsNullOrEmpty(Model?.Image1Path)) images2.Add(Model.Image1Path);
                    if (!string.IsNullOrEmpty(Model?.Image2Path)) images2.Add(Model.Image2Path);
                    if (!string.IsNullOrEmpty(Model?.Image3Path)) images2.Add(Model.Image3Path);
                    if (!string.IsNullOrEmpty(Model?.Image4Path)) images2.Add(Model.Image4Path);

                    if (images2.Any()) // check if at least one image exists
                    {
                        <tr>
                            <td colspan="2" style="height:30px; background:#eee; font-weight:bold; color:#000;">
                                صور من واقع التقرير
                            </td>
                        </tr>
                    }
                }

                @{
                    var images = new List<string>();
                    if (!string.IsNullOrEmpty(Model?.Image1Path)) images.Add(Model.Image1Path);
                    if (!string.IsNullOrEmpty(Model?.Image2Path)) images.Add(Model.Image2Path);
                    if (!string.IsNullOrEmpty(Model?.Image3Path)) images.Add(Model.Image3Path);
                    if (!string.IsNullOrEmpty(Model?.Image4Path)) images.Add(Model.Image4Path);
                }

                @for (int i = 0; i < images.Count; i += 2)
                {
                    <tr>
                        <td colspan="1" style=" text-align:center;padding:5px;width: 50%;">
                            <img src="@Url.Content("~/" + images[i])" style=" padding: 10px; max-width: 100% !important;
        height: 200px !important;
        object-fit:contain;" />
                        </td>
                        <td colspan="1" style="text-align:center; padding:5px; width: 50%;">
                            @if (i + 1 < images.Count)
                            {
                                <img src="@Url.Content("~/" + images[i + 1])" style="padding: 10px; max-width: 100% !important;
                     height: 200px !important;
                     object-fit:contain;"   />
                            }
                        </td>
                    </tr>
                }
            </table>
        </div>
        <div class="d-flex justify-content-end border-black border-top" style="padding-top: 20px;">
