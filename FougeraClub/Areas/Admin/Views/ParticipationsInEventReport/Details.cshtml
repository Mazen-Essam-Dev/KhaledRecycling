                                style="height:70px;" />
                        }
                        else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.ActivitiesSupervisor
                        && await PermissionScanner.CheckLoggedUserIfHasSignature())
                        {
                            <div id="trainerSignatureSection" class="signature-trigger" role="button" tabindex="0"
