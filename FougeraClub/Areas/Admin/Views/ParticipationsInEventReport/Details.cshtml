                </center>
            </div>
            <div class="d-flex justify-content-end align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                </div>
            </div>
        </div>
        <div class="overflow-table">
            <table style="width:100%;  text-align:center;border-collapse:collapse;" cellspacing="0" cellpadding="5"
                class="mb-3">
                <caption style="color:#af1717;font-weight:bold; font-size:18px;" class="text-center mb-2">
                    @Model.ReportTitle</caption>
                <tr>
                    <td style="width:25%; background:#af1717; color:#fff; font-weight:bold;"> <label
                            class="form-label">@Resource1.Date</label></td>
                    <td style="width:75%;text-align:right;padding: 0 0 ;">
                        <input asp-for="Date" hidden disabled readonly class="form-control" />
                        <input id="d" name="d" value="@Model?.Date?.ToString("d")?.Replace("/", "-")" disabled readonly class="form-control" />
                    </td>
                </tr>
                <tr>
                    <td style="width:25%; background:#af1717; color:#fff; font-weight:bold;"> <label
                            class="form-label">@Resource1.DepartManage</label></td>
                    <td style="width:75%;"><input asp-for="AdministrativeDepartment" disabled readonly class="form-control" /></td>
                </tr>
            </table>
        </div>
        <div style=" background:#eee;
    font-weight:bold;
    color:#000;
    border-left: 1px solid #000 !important;
    border-right: 1px solid #000!important;
    border-top: 1px solid #000!important;
    text-align: center;
    display: flex;
    justify-content: center; 
    align-items: center;       
    height: 30px;">
              @Title_h
        </div>
        <table style="width:100%;  text-align:center;  table-layout: fixed !important;" cellspacing="0" cellpadding="5"
            class="mb-3 table table-bordered align-middle">
            <thead>
                <tr>
                    <th style="width:40%; background-color:#f5f5f5; color:#000 !important;">@Resource1.ActivityName</th>
                    <th style="width:20%; background-color:#f5f5f5; color:#000!important;">@Resource1.ActivityAction
                    </th>
                    <th style="width:40%; background-color:#f5f5f5; color:#000 !important;">@Resource1.ActivityReason1
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Details != null)
                {
                    foreach (var detail in Model.Details)
                    {
                        <tr>
                            <td>@detail.ActivityName</td>
                            <td>@detail.ActivityAction</td>
                            <td>@detail.ActivityReason</td>
                        </tr>
