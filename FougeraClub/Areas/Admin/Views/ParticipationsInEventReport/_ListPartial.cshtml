@using Domain.DTOs.Admin.SalaryManagement
@using FougeraClub.Areas.Admin.ViewModels.ParticipationsInEventReport
@model PaginatedList<ParticipationsInEventReportVM>

@{
    ViewData["Title"] = Resource1.ParticipationsInEventList;
    ViewData["Title pakage"] = @Resource1.ExternalWorkMissionManagement ?? " ";
    ViewData["Title Single"] = @Resource1.ParticipationsInEventList ?? " ";
    var addPermission = PermissionScanner.ValidatePermission("ParticipationsInEventReport", "Add");
    var editPermission = PermissionScanner.ValidatePermission("ParticipationsInEventReport", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("ParticipationsInEventReport", "Delete");
    var lang = SessionHelper.GetCurrentLanguage();
    var AllEmployeesNames = ViewBag.EmployeesNames as IEnumerable<EmployeesNameDTO>;

}


<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize)">@s</option>
        }
    </select>

</nav>



<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>@Resource1.ParticipatingTitle</th>
                <th style="width:35%;">@Resource1.DepartManage</th>
                <th style="width:7%;">@Resource1.Date</th>
                <th style="width:9%;">@Resource1.ControlTools</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var single in Model.Items)
                {
                    var boolManagerSignature = single.ManagerSignature != null && !string.IsNullOrEmpty(single.ManagerSignature.ImagePath);
                    var boolActivitySupervisorSignature = single.TrainerSignature != null && !string.IsNullOrEmpty(single.TrainerSignature.ImagePath);
                    var bool2And = (boolActivitySupervisorSignature && boolManagerSignature);
                    var MakeEditOpen = (!boolActivitySupervisorSignature || (!bool2And && Model.IsUserLogedInISManager));
                    var NoEdit = !MakeEditOpen;

                    <tr data-id="@single.Id">
                        <td data-label="@Resource1.ParticipatingTitle">
                            <span class="fw-medium">@single.ReportTitle</span>
                        </td>
                        <td data-label="@Resource1.DepartManage">
                            <span class="fw-medium">@single.AdministrativeDepartment</span>
                        </td>
                        <td data-label="@Resource1.Date">
                            <span>@(single.Date?.ToString("d")?.Replace("/","-"))</span>
                        </td>
                        <td data-label="@Resource1.Actions">
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource1.ViewDetails">
                                <a asp-action="Details"
                                   asp-route-id="@single.Id"
                                   class="btn-control btn-icon btn-sm rounded-circle">
                                    <i class="fa-solid fa-eye fs-5"></i>
                                </a>
                            </span>
                            @if (editPermission @* && single.TrainerSignitureId == null && single.ManagerSignitureId == null *@ && MakeEditOpen)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.EditData">
                                    <a asp-action="AddEdit"
                                       asp-route-id="@single.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.EditData">
                                    <a action="#" disabled
                                       class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            @if (deletePermission && single.TrainerSignitureId == null && single.ManagerSignitureId == null)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Delete">
                                    <form asp-action="Delete" asp-route-id="@single.Id" class="d-inline" method="post" data-swal="delete" data-message="@single.ReportTitle">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Delete">
                                    <form action="#" class="d-inline" method="post" data-swal="delete" data-message="@single.ReportTitle">
                                        <button type="button" disabled class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>