    ViewData["Title"] = isEdit ? (Resource1.Edit + " " + Resource1.ParticipationsInEventReport) : (Resource1.Add + " " + Resource1.ParticipationsInEventReport);
    ViewData["Title pakage"] = @Resource1.MissionsManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.ParticipationsInEventList ?? " ";
    ViewData["Title Single"] = (isEdit ? (Resource1.Edit + " " + Resource1.ParticipationsInEventReport) : (Resource1.Add + " " + Resource1.ParticipationsInEventReport)) ?? " ";

