@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let rowIndex = @Model?.Details?.Count() ?? 0;

        function addRow() {
            const idPage = document.getElementById("idPage").value;
            const name = document.getElementById("ActivityName").value;
            const participants = document.getElementById("ActivityAction").value;
            const start = document.getElementById("ActivityReason").value;

        if(!name || !participants || !start )
        {
            $("#ActivityReasonSpan").text("");
            $("#ActivityActionSpan").text("");
            $("#ActivityNameSpan").text("");
            if (!name) {
                $("#ActivityNameSpan").text("@Html.Raw(Resource1.Required)");
            }
            if (!participants) {
                $("#ActivityActionSpan").text("@Html.Raw(Resource1.Required)");
            }
            if (!start ) {
                $("#ActivityReasonSpan").text("@Html.Raw(Resource1.Required)");           
            }
        return;
        }
        $("#ActivityReasonSpan").text("");
        $("#ActivityActionSpan").text("");
        $("#ActivityNameSpan").text("");

            const tbody = document.getElementById("Details");

            const row = document.createElement("tr");
            if(idPage > 0)
            { // Edit
                row.innerHTML = `
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityName" value="${name}"  /></td>
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityAction" value="${participants}"  /></td>
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityReason" value="${start}"  /></td>
                    <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
                `;
            }else{ // add 
                row.innerHTML = `
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityName" value="${name}"  /></td>
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityAction" value="${participants}"  /></td>
                    <td><input class="form-control" type="text" name="Details[${rowIndex}].ActivityReason" value="${start}"  /></td>
                    <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
                `;
            }

            tbody.appendChild(row);
            rowIndex++;

            // Clear inputs
            document.getElementById("ActivityName").value = "";
            document.getElementById("ActivityAction").value = "";
            document.getElementById("ActivityReason").value = "";
        }

        // Store the row to be deleted
        let rowToDelete = null;
        function removeRow(button) {
            rowToDelete = button.closest("tr");
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        function confirmDeleteRow() {
            if (rowToDelete) {
                rowToDelete.remove();
                // Reindex all rows
                const rows = document.querySelectorAll("#Details tr");
                rows.forEach((row, i) => {
                    const inputs = row.querySelectorAll("input");
                    inputs.forEach(input => {
                        const name = input.getAttribute("name");
                        if (name) {
                            input.setAttribute("name", name.replace(/\[\d+\]/, `[${i}]`));
                        }
                    });
                });
                rowIndex = rows.length;
                rowToDelete = null;
            }
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            if (modal) modal.hide();
        }
    </script>

    <!-- Delete Modal (matches other admin pages) -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Resource2.ConfirmDelete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>هل أنت متأكد من أنك تريد حذف هذا العنصر؟ هذا الإجراء لا يمكن التراجع عنه.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel-search btn" data-bs-dismiss="modal">@Resource2.Cancel</button>
                    <button type="button" class="btn btn-success" onclick="confirmDeleteRow()">@Resource2.Delete</button>
                </div>
            </div>
        </div>
    </div>


}
