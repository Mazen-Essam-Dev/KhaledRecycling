@model MaintenanceClubVM
@using Domain.Resources
@using FougeraClub.Areas.Admin.ViewModels.MaintenanceClub
@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = @Resource1.MaintenanceClub;
    Layout = null; // No layout for print view
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "Unknown User";
}


<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" rel="stylesheet" />

    <title>@ViewData["Title"] </title>

    <style>
        html, body {
            width: 100%;
            overflow: visible !important;
            font-family: "Tajawal", sans-serif;
            font-size: 13px;
            background: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            margin: 0 !important;
            padding: 0 !important;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 14px;
        }

        .PrintedBy span {
            font-weight: bold;
        }

        .printArea {
            width: 800px !important;
            margin: 0 auto !important;
            padding: 0 !important;
        }

        .container {
            max-width: 100% !important;
            width: 100% !important;
            box-shadow: none !important;
            page-break-inside: avoid;
        }

        th, td {
            border: 1px solid #000 !important;
            padding: 3px !important;
            box-shadow: none;
        }

        img {
            max-width: 100% !important;
        }

        table {
            outline: none !important;
            width: 100% !important;
            max-width: 100% !important;
            table-layout: fixed !important;
            box-shadow: none !important;
            border-collapse: collapse !important;
        }

        td img {
            max-width: 100% !important;
            object-fit: contain;
        }

        @@media print {
            @@page {
                size: A4;
                margin: 10mm;
            }

            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            * {
                max-width: 100% !important;
                box-sizing: border-box !important;
            }
            .footer {
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100%;
                text-align: center;
                background: #fff;
                padding: 5px 0;
                font-size: 14px;
            }
            
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="printArea">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center flex-wrap border-black border-bottom py-3 mb-3">
                <div class="d-flex justify-content-between align-items-center flex-fill">
                    <div style="text-align:center">
                        <h5 style="color:#6d6058; font-size: 16px;font-weight:700;">الإمارات العربية المتحدة</h5>
                        <h5 style="color:#6d6058; font-size: 16px;font-weight:700;">حكومة الفجيرة</h5>
                        <h5 style="color:#000000; font-size: 16px;font-weight:700;">نادي الفجيرة العلمي</h5>
                    </div>
                </div>

                <div class="flex-fill text-center">
                    <img src="/assets/images/logo.png" alt="نادي الفجيرة العلمي" style="width:75px;">
                </div>

                <div class="d-flex justify-content-end align-items-center flex-fill">
                    <div style="text-align:center">
                        <h5 style="color:#6d6058; font-size: 16px;font-weight:700;">UNITED ARAB EMIRATES</h5>
                        <h5 style="color:#6d6058; font-size: 16px;font-weight:700;">GOVT. OF FUJAIRAH</h5>
                        <h5 style="color:#000000; font-size: 16px;font-weight:700;">FUJAIRAH SCIENCE CLUB</h5>
                    </div>
                </div>
            </div>

            <!-- TITLE + DATE + PHOTO + MEMBER CODE -->
            <div style="display: flex; justify-content: space-between; align-items: center; width:100%;margin-bottom: 15px;">

                

            </div>

            <!-- BASIC INFO TABLE -->
            <table class="mb-3" cellspacing="0" cellpadding="0">
                <tr><th colspan="4"> @ViewData["Title"]</th></tr>

                <tr>
                    <td>@Resource1.MaintenanceTitle</td>
                    <td>@Model?.Title</td>
                    <td>@Resource1.MaintenanceDate</td>
                    <td>@Model?.Date?.ToString("d")?.Replace("/","-")</td>
                </tr>

                <tr>
                    <td>@Resource1.MaintenanceTime</td>
                    <td>@Model?.Time</td>
                    <td>@Resource1.MaintenanceDescription</td>
                    <td>@Model?.Details</td>
                </tr>

                
            </table>

            
        </div>
    </div>
    <!-- FOOTER -->
    <div class="footer">
        <p class="PrintedBy">Printed by : <span> @(currentUserName)  |  @AppDubaiTime.Now.ToString("dd/MM/yyyy, HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span> </p>
    </div>

</body>
</html>
<script>

    //This Part Is Important
      window.addEventListener('load', () => {
         setTimeout(() => document.getElementById('loadingOverlay').style.display = 'none', 500);
         setTimeout(() => window.print(), 800);
     });
     //Close window after printing
         window.onafterprint = function() {
             setTimeout(function() {
                 window.close();
             }, 500);
         };
</script>