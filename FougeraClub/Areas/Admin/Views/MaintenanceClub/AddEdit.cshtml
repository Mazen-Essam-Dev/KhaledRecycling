@using FougeraClub.Areas.Admin.ViewModels.MaintenanceClub
@model MaintenanceClubVM
@{
    ViewData["Title pakage"] = @Resource1.ClubMaintenanceManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.ClubMaintenanceManagementList ?? " ";
    ViewData["Title Single"] = ((Model.Id == 0) ? @Resource1.AddMaintenanceData : @Resource1.EditClubMaintenance1) ?? " ";
}

<style>
    #newAlignMaxbuttons {
        /* width: 40%; */
        /* align-items: center; */
        display: flex !important;
        justify-content: end !important;
        /* justify-content: center; */
        align-items: center !important;
        gap: 5px !important;
        margin-right: 20px !important;
    }
</style>

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <div class="d-flex align-items-center gap-2">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa fa-book me-2 text-ico"></span>
                @((Model.Id == 0) ? @Resource1.AddMaintenanceData : @Resource1.EditClubMaintenance1)
            </h4>
        </div>
    </div>
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-end" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>

                <li class="breadcrumb-item"> <a href="/Admin/MaintenanceClub/Index">@ViewData["Title ListIndex"]</a> </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
</div>
<div class="card all-borders p-3">
    <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" class="needs-validation" />
        <input type="hidden" asp-for="Attachment_TempFilePath" class="needs-validation" />
        <input type="hidden" asp-for="Attachment_OldPath" class="needs-validation" />
        <div class="row g-3">
            <div class="col-md-12">
                <label for="Title" class="form-label asteriskRequired">@Resource1.MaintenanceTitle</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6 filter-dropdown">
                <label for="Date" class="fw-medium asteriskRequired mb-2">@Resource1.MaintenanceDate</label>
                <div class="input-icon-left">
                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                    <input asp-for="Date" class="form-control green-border form-control-sm filter-bordered" type="date" />
                </div>
                <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label for="Time" class="form-label asteriskRequired mb-2">@Resource1.MaintenanceTime</label>
                <input asp-for="Time" type="time" class="form-control" />
                <span asp-validation-for="Time" class="text-danger small"></span>
            </div>
            <div class="col-md-12">
                <label for="Location" class="form-label asteriskRequired">@Resource1.MaintenanceLocation</label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label for="Details" class="form-label">@Resource1.MaintenanceDetails</label>
                <textarea asp-for="Details" class="form-control"></textarea>
                <span asp-validation-for="Details" class="text-danger small"></span>
            </div>
            
            <div class="col-md-12 ">
                <div class="d-flex flex-column flex-lg-row">
                    <div style="width: 100%;">
                        <h5 class="form-label">@Resource1.PdfFile</h5>
                        <div class="input-group mb-2  d-flex align-items-center">
                            <input asp-for="PdfFile" type="file" class="form-control rounded-2 " accept=".pdf" id="pdfFile">
                            <label class="rounded-2 upload-file-ltr upload-file-rtl upload-file-hover" for="pdfFile"><i class="fa-solid fa-upload fa-xl"></i></label>
                        </div>
                        @* Preview *@
                        @if (!string.IsNullOrEmpty(Model.Attachment_TempFilePath))
                        {
                            @* <img src="~/@Model.Attachment_TempFilePath.Replace("wwwroot/", "")" class="img-thumbnail mt-2" style="max-height:140px;" /> *@
                            <a href="~/@Model.Attachment_TempFilePath.Replace("wwwroot/", "")" target="_blank" class="eye-ii">
                                <i class="fa fa-eye"></i> @Resource3.ViewFile
                            </a>
                        }
                        else if (!string.IsNullOrEmpty(Model?.Attachment_OldPath))
                        {
                            <a href="~/@Model.Attachment_OldPath" target="_blank" class="eye-ii">
                                <i class="fa fa-eye"></i> @Resource3.ViewFile
                            </a>
                        }
                        else if (!string.IsNullOrEmpty(Model?.PdfFilePath))
                        {
                            <a href="~/@Model.PdfFilePath" target="_blank" class="eye-ii">
                                <i class="fa fa-eye"></i> @Resource3.ViewFile
                            </a>
                        }
                        <span asp-validation-for="PdfFilePath" class="text-danger small"></span>

                        <div class=""><span class="d-inline-block mt-0 text-red"> @Resource3.MaximumFileSize5MB </span></div>

                    </div>

                    <div class="mb-1 newAlignMaxbuttons" id="newAlignMaxbuttons">
                        <button type="submit" class="btn-cancel-search btn btn-sm px-3">
                            <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                        </button>
                        <a asp-action="Index" class="btn btn-success btn-sm  px-3">
                            @Resource2.Back  <i class="fa-solid fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </div>

    </form>
</div>

