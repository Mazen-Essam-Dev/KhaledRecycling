@model PaginatedList<ActivityVM>

@{
    var addPermission = PermissionScanner.ValidatePermission("Activity", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Activity", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Activity", "Delete");
    var membersActivityPermission = PermissionScanner.ValidatePermission("Activity", "MembersActivity");

    var dateOnlyNow = DateOnly.FromDateTime(AppDubaiTime.Now);
}

<input type="hidden" id="NewCountRecords" value="@ViewBag.CountRecords" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 ms-2 mb-3">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>

    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width: 74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model?.PageSize)
            {
                <option value="@s" selected>@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>

</nav>

<!-- Table -->
<div class="table-responsive ">
    <table class="table table-bordered table-hover align-middle table-striped">
        <thead>
            <tr>
                <th >@Resource1.ActivityTitle</th>
                <th style="width:9%;">@Resource1.StartDate</th>
                <th style="width:15%;">@Resource1.Location</th>
                <th style="width:9%;">@Resource1.ActivityDuration</th>
                <th style="width:10%;">@Resource1.Ages</th>
                <th style="width: 10%;">@Resource1.SubscriptionCount</th>
                <th style="width:15%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var Activity in Model.Items)
                {
                    <tr data-id="@Activity.Id">
                        <td data-label="@Resource1.ActivityTitle">
                            <span class="fw-medium">
                                @(SessionHelper.GetCurrentLanguage() == "ar" ? Activity.TitleAr : Activity.TitleEn)
                            </span>
                        </td>
                        <td data-label="@Resource1.StartDate">@Activity.StartDate?.ToString("d")?.Replace("/","-")</td>
                        <td data-label="@Resource1.Location">@Activity.Location</td>
                        <td data-label="@Resource1.ActivityDuration">@Activity.ActivityDuration</td>
                        @* <td data-label="@Resource1.Ages">@($"{Resource2.Above} {Activity.MinimumAge} {Resource1.Year1}")</td> *@
                        <td data-label="@Resource1.Ages">@(Activity.MinimumAge)</td>
                        <td data-label="@Resource1.SubscriptionCount">@Activity.SubscriptionCount</td>

                        <td data-label="@Resource2.Actions">
                            <!-- Members Activity -->
                            @if (Activity.SubscriptionCount > 0 && membersActivityPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.MembersActivity2">
                                    <a asp-action="MembersActivity"
                                       asp-route-activityId="@Activity.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-users fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.MembersActivity2">
                                    <a action="#"  disabled
                                       class="disabled btn-control-dis btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-users fs-5"></i>
                                    </a>
                                </span>
                            }

                            <!-- Details -->
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Details">
                                <a href="javascript:void(0)"
                                   data-bs-toggle="modal"
                                   data-bs-target="#activityDetailsModal"
                                   data-id="@Activity.Id"
                                   class="btn-control btn-icon btn-sm rounded-circle">
                                    <i class="fa-solid fa-eye fs-5"></i>
                                </a>
                            </span>

                            <!-- Edit -->
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit"
                                       asp-route-id="@Activity.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a disabled class="btn-control btn-icon btn-sm rounded-circle disabled btn-control-dis ">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }

                            <!-- Delete -->
                            @if (Activity.SubscriptionCount == 0 && deletePermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete"
                                          asp-route-id="@Activity.Id"
                                          method="post"
                                          data-swal="delete"
                                          data-message="@Activity.TitleAr"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form action="#"
                                          class="d-inline">
                                        <button type="button" disabled
                                                class="disabled btn-control-dis btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoEvents</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
