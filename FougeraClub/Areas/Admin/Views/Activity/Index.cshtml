@model PaginatedList<ActivityVM>

@{
    ViewData["Title"] = Resource1.ActivitysIndex;
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title Single"] = @Resource1.ActivitysIndex ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("Activity", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Activity", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Activity", "Delete");
    var membersActivityPermission = PermissionScanner.ValidatePermission("Activity", "MembersActivity");
}
<!-- Header: Breadcrumb + Count + Actions -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count & Actions -->
    <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-end">
        <!-- Records Count -->
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto px-2 py-1">
            <span>@Resource1.RecordsCount:</span>
            <span id="countRecords">@ViewBag.CountRecords</span>
        </div>
    </div>
</div>
<!-- Main Card -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <!-- Page title section -->
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title">
                            <i class="ri-calendar-schedule-fill me-2 text-ico"></i>
                            @Resource1.ActivitysIndex
                        </h4>
                    </div>
                </div>

                <!-- Right Actions (Create / Print / Excel) -->
                <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
                    @if (addPermission)
                    {
                        <a asp-action="AddEdit" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource2.CreateNew
                        </a>
                    }

                    <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>

                    <a class="btn btn-success Excelbtn btn-sm" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"></i>@Resource1.createExcelReport_Download
                    </a>
                </div>
            </div>
            <!-- Filter / Search Panel -->
            <div class="rounded shadow-sm p-3">
                <form method="get" id="activityFilterForm" class="filterImg rounded p-2"
                    onsubmit="return onActivityFilterSubmit(event);">
                    <div class="row g-3xxxx">
                        <div class="filter-dropdown col-md-3">
                            <label for="searchTermInput" class="fw-medium mb-2">@Resource1.Search:</label>
                            <div class="search-box position-relative">
                                <i
                                    class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                <input type="text" name="searchTerm" id="searchTermInput" value="@Model.SearchTerm"
                                    class="form-control green-border form-control-sm filter-bordered ps-4"
                                    placeholder="@Resource1.ActivityTitle ..." />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <!-- Date From -->
                            <div class="filter-dropdown">
                                <label for="dateFrom" class="fw-medium mb-2">@Resource1.DateFrom:</label>
                                <div class="input-icon-left">
                                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                                        class="date-icon">
                                    <input type="date" name="dateFrom" id="dateFrom"
                                        class="form-control form-select-sm filter-bordered" value="@ViewBag.DateFrom" />
                                </div>
                            </div>
                        </div>
                        <div class="filter-dropdown col-md-3">
                            <label for="dateTo" class="fw-medium mb-2">@Resource1.DateTo:</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                                    class="date-icon">
                                <input type="date" name="dateTo" id="dateTo"
                                    class="form-control form-select-sm filter-bordered" value="@ViewBag.DateTo" />
                            </div>
                        </div>
                        <div class="col-md-3 d-flex flex-column justify-content-end">
                            <div class="d-flex justify-content-end">
                                <button type="button" @* id="btnClearFilters" *@               onclick="$('#dateTo').val(''); $('#dateFrom').val(''); $('#searchTermInput').val('');  $('#searchbtn').click();"
                                    class="btn-cancel-search btn btn-sm me-2">
                                    <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                                </button>
                                <button type="submit" id="searchbtn" class="btn btn-success btn-sm">
                                    <i class="ri-filter-line me-1"></i> @Resource1.Search
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="col-md-12 mt-3">
                    <div id="PartialNewListContainer table-striped p-3">
                        @await Html.PartialAsync("_ListPartial", Model)
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>
<!-- JS -->
<script>
    function openPrintPage() {
        const get = id => document.getElementById(id)?.value || '';
        const searchTerm = encodeURIComponent(get('searchTermInput'));
        const dateFrom = encodeURIComponent(get('dateFrom'));
        const dateTo = encodeURIComponent(get('dateTo'));

        var countRecords = document.getElementById('NewCountRecords')?.value;
        if (countRecords && countRecords > 3999) {
            showToastrCannotPrint();
        } else {
            const url = `/Admin/Activity/Print?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
            const printWindow = window.open(
                url,
                'printWindow',
                'width=1000,height=800,noopener,noreferrer'
            );
        }
    }

    function openExcelPage() {
        const get = id => document.getElementById(id)?.value || '';
        const searchTerm = encodeURIComponent(get('searchTermInput'));
        const dateFrom = encodeURIComponent(get('dateFrom'));
        const dateTo = encodeURIComponent(get('dateTo'));
        const url = `/Admin/Activity/createExcelReport_Download?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
        window.open(url, '_self');
    }
</script>


<!-- Modal -->
<div class="modal fade" id="activityDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body" id="activityDetailsBody">
                <div class="text-center text-muted py-3">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#activityDetailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var body = $(this).find('#activityDetailsBody');
                body.html('<div class="text-center text-muted py-3">Loading...</div>');
                $.ajax({
                    url: '/Admin/Activity/Details',
                    type: 'GET',
                    data: { id: id },
                    success: function (data) { body.html(data); },
                    error: function () {
                        body.html('<div class="alert alert-danger text-center m-0">فشل في تحميل بيانات الفعالية.</div>');
                    }
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#dateFrom').val(filters.dateFrom);
                $('#dateTo').val(filters.dateTo);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            function onActivityFilterSubmit(e) {
                if (e) e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
                return false;
            }

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                $('#dateFrom').val('');
                $('#dateTo').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    dateFrom: $('#dateFrom').val(),
                    dateTo: $('#dateTo').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var dateFrom = $('#dateFrom').val();
                var dateTo = $('#dateTo').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/Activity/Index',
                    type: 'GET',
                    data: { searchTerm, dateFrom, dateTo, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page

                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>

}