@using FougeraClub.Areas.Admin.ViewModels.Activity
@model ActivityVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? Resource1.EditActivity : Resource1.CreateActivity;
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title Single"] = (isEdit ? Resource1.EditActivity : Resource1.CreateActivity) ?? " ";
    ViewData["Title ListIndex"] = @Resource1.ActivitysIndex ?? " ";
}
<style>
    #newAlignMaxbuttons{
        /* width: 40%; */
        /* align-items: center; */
        display: flex !important;
        justify-content: end !important;
        /* justify-content: center; */
        align-items: center !important;
        gap: 5px !important;
        margin-right: 20px !important;
    }
</style>
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <div class="d-flex align-items-center gap-2">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa fa-book me-2 text-ico"></span>
                @ViewData["Title"]
            </h4>
        </div>
    </div>
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-end" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item"><a href="/Admin/Activity/Index">@ViewData["Title ListIndex"]</a></li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
</div>
<div class="card all-borders p-3">
    <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" class="needs-validation" />
        <input type="hidden" asp-for="Attachment_TempFilePath" class="needs-validation" />
        <input type="hidden" asp-for="Attachment_OldPath" class="needs-validation" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="TitleAr" class="form-label asteriskRequired">@Resource1.ActivityTitleAr</label>
                <input asp-for="TitleAr" class="form-control" placeholder="@Resource1.ActivityTitleAr" autocomplete="off" />
                <span asp-validation-for="TitleAr" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TitleEn" class="form-label asteriskRequired">@Resource1.ActivityTitleEn</label>
                <input asp-for="TitleEn" class="form-control" placeholder="@Resource1.ActivityTitleEn" autocomplete="off" />
                <span asp-validation-for="TitleEn" class="text-danger small"></span>
            </div>
            <div class="col-md-6 filter-dropdown">
                <label asp-for="StartDate" class="fw-medium asteriskRequired mb-2">@Resource2.StartDateActivity</label>
                <div class="input-icon-left">
                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                    <input asp-for="StartDate" class="form-control green-border form-control-sm filter-bordered" type="date" id="StartDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6 filter-dropdown">
                <label asp-for="EndDate" class="fw-medium asteriskRequired mb-2">@Resource2.EndDateActivity</label>
                <div class="input-icon-left">
                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                    <input asp-for="EndDate" class="form-control green-border form-control-sm filter-bordered" type="date" id="EndDate" />
                </div>
                <span asp-validation-for="EndDate" class="text-danger small"></span>
                <span class="text-danger small d-none" id="EndDateError">@Resource2.EndDateMustBeAfterStart</span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label asteriskRequired">@Resource1.Location</label>
                <input asp-for="Location" class="form-control" placeholder="@Resource1.Location" autocomplete="off" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MinimumAge" class="form-label asteriskRequired">@Resource2.MinimumAge</label>
                <input asp-for="MinimumAge" class="form-control text-start" placeholder="@Resource2.MinimumAge" autocomplete="off" />
                <span asp-validation-for="MinimumAge" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">@Resource1.Details</label>
                <textarea asp-for="Description" class="form-control" autocomplete="off" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            @* <div class="col-12">
                <label asp-for="Achievement" class="form-label">@Resource1.Achievement</label>
                <textarea asp-for="Achievement" class="form-control" autocomplete="off" rows="3"></textarea>
                <span asp-validation-for="Achievement" class="text-danger small"></span>
            </div> *@

            <div class="col-md-12 ">
                <div class="d-flex flex-column flex-lg-row">
                    <div style="width: 100%;">
                        <h5 class="form-label">@Resource2.UploadFile PDF </h5>
                        <div class="input-group mb-2  d-flex align-items-center">
                            <input type="file" class="form-control rounded-2 " accept=".pdf" asp-for="Attachment">
                            <label class="rounded-2 upload-file-rtl upload-file-hover upload-file-ltr " asp-for="Attachment"><i class="fa-solid fa-upload fa-xl"></i></label>
                        </div>
                        @* Preview *@
                        @if (!string.IsNullOrEmpty(Model.Attachment_TempFilePath))
                        {
                            @* <img src="~/@Model.Attachment_TempFilePath.Replace("wwwroot/", "")" class="img-thumbnail mt-2" style="max-height:140px;" /> *@
                            <a href="~/@Model.Attachment_TempFilePath.Replace("wwwroot/", "")" target="_blank" class="eye-ii">
                                <i class="fa fa-eye"></i> @Resource3.ViewFile
                            </a>
                        }
                        else if (isEdit && !string.IsNullOrEmpty(Model?.Attachment_OldPath))
                        {
                            <a href="~/@Model.Attachment_OldPath" target="_blank" class="eye-ii">
                                <i class="fa fa-eye"></i> @Resource3.ViewFile
                            </a>
                        }
                        <span asp-validation-for="Attachment" class="text-danger small"></span>

                        <div class=""><span class="d-inline-block mt-0 text-red"> @Resource3.MaximumFileSize5MB </span></div>

                    </div>

                    <div class="mb-1 newAlignMaxbuttons" id="newAlignMaxbuttons">
                        <button type="submit" class="btn-cancel-search btn btn-sm px-3">
                            <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                        </button>
                        <a asp-action="Index" class="btn btn-success btn-sm  px-3">
                            @Resource2.Back  <i class="fa-solid fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </div>
            
        </div>

    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const startInput = document.getElementById('StartDate');
            const endInput = document.getElementById('EndDate');
            const endError = document.getElementById('EndDateError');

            function validateDates() {
                const startDate = new Date(startInput.value);
                const endDate = new Date(endInput.value);

                if (startInput.value && endInput.value && endDate < startDate) {
                    endError.classList.remove('d-none');
                    endInput.classList.add('is-invalid');
                } else {
                    endError.classList.add('d-none');
                    endInput.classList.remove('is-invalid');
                }
            }

            startInput.addEventListener('change', validateDates);
            endInput.addEventListener('change', validateDates);
        });
    </script>
}
