@model EmployeeVM

@{
    ViewData["Title"] = Resource1.EmployeesList;

    var attachmentsPermission = PermissionScanner.ValidatePermission("Employees", "GetEmployeeAttachments");
    var addPermission = PermissionScanner.ValidatePermission("Employees", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Employees", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Employees", "Delete");
}

<input type="hidden" id="NewCountRecords" value="@Model.TotalCount" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label for="pageSizeSelect" class="form-label mb-0">@Resource2.PageSize:</label>

    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width: 74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize ? "selected" : null)">@s</option>
        }
    </select>
</nav>


<!-- Employee Table -->
<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th style="width:35%;">@Resource1.Name</th>
                <th style="width:20%;">@Resource1.JobTitle1</th>
                <th style="width:16%;">@Resource1.NationalIdNumber1</th>
                <th style="width:6%;">@Resource1.Salary</th>
                <th style="width:12%;">@Resource1.NationalIdExpiryDate2</th>
                <th style="width:9%;">@Resource1.PhoneNumber</th>
                <th style="width:10%;">@Resource1.ControlTools</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.all_EmployeeListVM == null || !Model.all_EmployeeListVM.Any())
            {
                <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                var lang = SessionHelper.GetCurrentLanguage();

                foreach (var emp in Model.all_EmployeeListVM)
                {
                    <tr data-id="@emp.Id">
                        <td data-label="@Resource1.Name" style="width:20%">
                            <a asp-action="Details" asp-route-id="@emp.Id" class="text-decoration-underline fw-medium">
                                @(lang == "ar" ? emp.FullNameAr : emp.FullNameEn)
                            </a>
                        </td>
                        <td data-label="@Resource1.JobTitle1">@emp.JobTitle</td>
                        <td data-label="@Resource1.NationalIdNumber1">@emp.NationalIdNumber</td>
                        <td data-label="@Resource1.Salary">@emp.Salary</td>
                        <td data-label="@Resource1.NationalIdExpiryDate" class="expiryDate">
                            @(emp.NationalIdExpiryDate?.ToString("d")?.Replace("/","-"))
                        </td>
                        <td data-label="@Resource1.PhoneNumber">@emp.PhoneNumber</td>
                        <td data-label="@Resource1.ControlTools" style="width:20%">
                            <!-- Details -->
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Details2">
                                <a asp-action="Details" asp-route-id="@emp.Id"
                                   class="btn-control btn-icon btn-sm rounded-circle">
                                    <i class="fa-solid fa-eye fs-5"></i>
                                </a>
                            </span>

                            <!-- Attachments -->
                            @if (attachmentsPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.UploadAttachments">
                                    <a class="btn-control btn-icon btn-sm rounded-circle open-attachments"
                                       data-employee-id="@emp.Id" style="cursor:pointer;">
                                        <i class="fa-solid fa-paperclip fs-5"></i>
                                    </a>
                                </span>
                            }

                            <!-- Edit -->
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@emp.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }

                            

                            <!-- Delete -->
                            @if (deletePermission && !emp.HasRelatedObjects)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Delete">
                                    <form asp-action="Delete" asp-route-id="@emp.Id" method="post" class="d-inline"
                                          data-swal="delete"
                                          data-message="@($"{Resource1.Employee} {(lang == "ar" ? emp.FullNameAr : emp.FullNameEn)}")">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <a asp-action="#"
                                       class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </a>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.CurrentPage - 1)">
                @Resource2.Previous
            </a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.CurrentPage + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
