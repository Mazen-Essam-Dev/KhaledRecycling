@model EmployeeVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? Resource1.Edit_Employee : Resource1.Add_New_Employee;
    ViewData["Title pakage"] = @Resource1.EmployeesManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.EmployeesList ?? " ";
    ViewData["Title Single"] = isEdit ? Resource1.Edit_Employee : Resource1.Add_New_Employee;
    var lang = SessionHelper.GetCurrentLanguage();
}

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>

                <li class="breadcrumb-item"> <a href="/Admin/Employees/Index">@ViewData["Title ListIndex"]</a> </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
<div class="col-6 d-flex justify-content-end align-items-center gap-2">
        <a asp-action="index" class="btn btn-success btn-sm">
            @Resource2.Back <i class="fa-solid fa-arrow-left me-1"></i>
        </a>
    </div>
</div>
<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="d-flex justify-content-center c-pro border p-3 mb-3">
        <div class="flex-grow-1 d-flex justify-content-start align-items-center">
            <div class="d-flex align-items-center gap-0">
                <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                    <span class="fa fa-edit me-2 text-ico"></span>
                    @ViewData["Title Single"]
                </h4>
            </div>
        </div>
        <div class="d-flex align-items-end gap-2">
    
            <div class="d-flex justify-content-center align-items-center rounded-2 border" style="width: 60px; height: 60px;">
                @if (!string.IsNullOrEmpty(Model?.Photo_TempFilePath))
                {
                    <div class="img-hover">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#photoModal">
                            <i class="fas fa-eye icon-eye"></i>
                            <img src="~/@Model.Photo_TempFilePath.Replace("wwwroot/", "")"
                                 class="border border-2 object-fit-cover preview"
                                 alt="profile picture"
                                 style="width:60px; height:60px;" />
                        </a>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model?.Photo_OldPath))
                {
                    <div class="img-hover">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#photoModal">
                            <i class="fas fa-eye icon-eye"></i>
                            <img src="~/@Model.Photo_OldPath"
                                 class="border border-2 object-fit-cover preview"
                                 alt="profile picture"
                                 style="width:60px; height:60px;" />
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-center align-items-center" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-user text-success fs-3" id="userIcon"></i>
                        <img src="~/@Model.PhotoPath"
                             class="border border-2 object-fit-cover d-none preview"
                             alt="profile picture"
                             style="width:60px; height:60px;" />
                    </div>
                }
            </div>
            <div class="d-flex flex-column align-items-start gap-1 justify-content-end" style="width: fit-content; height: 60px;">
                @if (!string.IsNullOrEmpty(Model?.PhotoPath) || !string.IsNullOrEmpty(Model?.Photo_OldPath) || !string.IsNullOrEmpty(Model?.Photo_TempFilePath))
                {
                    <label for="Photo" class="text-green" style="cursor: pointer;">
                        <i class="fa-solid fa-pen"></i> @Resource3.ChangeImage
                    </label>
                }
                else
                {
                    <label for="Photo" class="btn btn-success btn-sm w-100" style="cursor: pointer; width: fit-content;">
                        <i class="fa-solid fa-upload me-1"></i> @Resource3.AddImage
                    </label>
                }
                <span class="d-block text-gray fs-5">@Resource3.MaximumImageSize3MB</span>
            </div>

            @if (!string.IsNullOrEmpty(Model?.Photo_TempFilePath))
            {
                <div class="modal fade" id="photoModal" tabindex="-1" aria-labelledby="photoModal" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">@Resource2.EmployeeImage</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center">
                                <img src="~/@Model?.Photo_TempFilePath.Replace("wwwroot/", "")" class="img-fluid" alt="@Resource2.EmployeeImage" />
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(Model?.Photo_OldPath))
            {
                <div class="modal fade" id="photoModal" tabindex="-1" aria-labelledby="photoModal" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">@Resource2.EmployeeImage</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center">
                                <img src="~/@Model.Photo_OldPath" class="img-fluid" alt="@Resource2.EmployeeImage" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>

    <div class="container">
        <form asp-action="AddEdit" method="post" id="form" enctype="multipart/form-data">
            <input hidden asp-for="Id" />
            <input hidden asp-for="Photo_OldPath" />
            <input hidden asp-for="Photo_TempFilePath" />
            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource1.BasicData</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>
            <div class="c-edit-form mb-3">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label asteriskRequired" asp-for="FullNameAr">@Resource2.Name</label>
                        <input asp-for="FullNameAr" class="form-control" />
                        <span asp-validation-for="FullNameAr" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-2">
                        <label class="form-label" asp-for="Code">@Resource2.EmployeeNo</label>
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-2">
                        <label class="form-label" asp-for="JobTitle">@Resource1.JobTitle1</label>
                        <input asp-for="JobTitle" type="text" class="form-control" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-2">
                        <label asp-for="NationalityId" class="form-label">@Resource2.Nationality</label>
                        <select asp-for="NationalityId" class="form-select" asp-items="Model?.NationalitiesList">
                            <option value="">-- @Resource2.SelectNationality --</option>
                        </select>
                        <span asp-validation-for="NationalityId" class="text-danger small"></span>
                        <link href="/css/select2-custom.css" rel="stylesheet" />
                        <script src="/js/select2-cdn-loader.js"></script>
                        <script>
                            document.addEventListener('DOMContentLoaded', function () {
                                function initSelect2() {
                                    if (window.jQuery && window.jQuery.fn && window.jQuery.fn.select2) {
                                        $('#NationalityId').select2({
                                            placeholder: 'إختر الجنسية',
                                            allowClear: false,
                                            width: 'resolve',
                                            minimumResultsForSearch: 0
                                        });
                                    } else {
                                        setTimeout(initSelect2, 100);
                                    }
                                }
                                initSelect2();
                            });
                        </script>
                    </div>

                    <div class="col-md-4 mb-2">
                        <label class="form-label" asp-for="PhoneNumber">@Resource1.PhoneNumber</label>
                        <input asp-for="PhoneNumber" class="form-control" inputmode="numeric" pattern="\d*" placeholder="@Resource1.PhonePlaceholder_10" oninput="this.value=this.value.replace(/\D/g,'')" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-2">
                        <label class="form-label" asp-for="Email">@Resource1.Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label" asp-for="Address">@Resource1.Address</label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.PassportInfo</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="PassportNumber">@Resource1.PassportNumber</label>
                        <input asp-for="PassportNumber" class="form-control" />
                        <span asp-validation-for="PassportNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="PassportExpiryDate">@Resource1.PassportExpiryDate</label>
                        <div class="input-icon-left">
                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                            <input asp-for="PassportExpiryDate" type="date" class="form-control green-border form-control-sm filter-bordered" />
                        </div>
                        <span asp-validation-for="PassportExpiryDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <!-- ID Info Section -->
            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.IdInfo</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row">
                    @if (Model?.Id != null && Model?.Id != 0)
                    {
                        <div class="col-md-6">
                            <label class="form-label" asp-for="NationalIdNumber">@Resource2.IdNumber</label>
                            <input asp-for="NationalIdNumber" type="hidden" hidden class="form-control" />
                            <input type="text" id="NationalIdNumber2" name="NationalIdNumber2" readonly value="@Model.NationalIdNumber" class="form-control" />
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6 col-12">
                            <div class="mb-3">
                                <label class="form-label">@Resource2.IdNumber</label>
                                <div class="d-flex gap-2 align-items-center">
                                    <input id="g4" asp-for="g4" maxlength="1" dir="ltr" placeholder="X" class="form-control custom-input text-center" style="max-width:90px" inputmode="numeric" />
                                    <span>-</span>
                                    <input id="g3" asp-for="g3" maxlength="7" dir="ltr" placeholder="XXXXXXX" class="form-control custom-input text-center" style="max-width:300px" inputmode="numeric" />
                                    <span>-</span>
                                    <input id="g2" asp-for="g2" maxlength="4" dir="ltr" placeholder="XXXX" class="form-control custom-input text-center" style="max-width:200px" inputmode="numeric" />
                                    <span>-</span>
                                    <input id="g1" asp-for="g1" maxlength="3" dir="ltr" placeholder="XXX" class="form-control custom-input text-center" style="max-width:140px" inputmode="numeric" />
                                </div>
                                <input type="hidden" asp-for="NationalIdNumber" />
                                <span id="AllG" class="text-danger small"></span>
                                <span asp-validation-for="NationalIdNumber" class="text-danger"></span>
                            </div>
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="form-label" asp-for="NationalIdLocation" style="margin-top:.6rem;">@Resource2.PlaceOfIssue</label>
                        <input asp-for="NationalIdLocation" class="form-control" type="text" />
                        <span asp-validation-for="NationalIdLocation" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" asp-for="NationalIdExpiryDate">@Resource1.NationalIdExpiryDate</label>
                        <div class="input-icon-left">
                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                            <input asp-for="NationalIdExpiryDate" type="date" class="form-control green-border form-control-sm filter-bordered" />
                        </div>

                        <span asp-validation-for="NationalIdExpiryDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Financial Info Section -->
            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.FinancialInfo</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label asteriskRequired" asp-for="Salary">@Resource2.Salary</label>
                        <input asp-for="Salary" class="form-control" inputmode="numeric" pattern="\d*" maxlength="15" oninput="this.value=this.value.replace(/\D/g,'')" />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label asteriskRequired" asp-for="BankName">@Resource1.BankName</label>
                        <input asp-for="BankName" class="form-control" />
                        <span asp-validation-for="BankName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label asteriskRequired" asp-for="BankAccountNumber">@Resource1.BankAccountNumber</label>
                        <input asp-for="BankAccountNumber" class="form-control" />
                        <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label" asp-for="Notes">@Resource1.Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                <div class="col-md-6 mt-2">
                    <div class="input-group mb-3 d-flex align-items-center">
                        <input type="file" class="form-control rounded-2 d-none" accept=".jpg,.jpeg,.png" asp-for="Photo" id="Photo">
                    </div>
                    <span asp-validation-for="Photo" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-end gap-2 mb-4">
                <button type="submit" class="btn-cancel-search btn-sm btn">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                </button>
              
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Prevent non-numeric input
        function noChars(input) {
            input.value = input.value.replace(/[^0-9]/g, '');
        }

        document.addEventListener("DOMContentLoaded", function () {
            const hidden = document.getElementById("NationalIdNumber");
            const g1 = document.getElementById("g1");
            const g2 = document.getElementById("g2");
            const g3 = document.getElementById("g3");
            const g4 = document.getElementById("g4");
            const photoInput = document.getElementById('Photo');
            const preview = document.querySelector(".preview");
            const userIcon = document.getElementById("userIcon");

            // National ID number segmentation logic
            if (g1 && g2 && g3 && g4 && hidden) {
                function jumpNext(curr, nextId) {
                    curr.addEventListener("input", function () {
                        this.value = this.value.replace(/\D/g, "");
                        if (this.maxLength && this.value.length >= this.maxLength) {
                            document.getElementById(nextId)?.focus();
                        }
                    });
                }

                // Helper: Move to previous field on Backspace when empty
                function jumpPrev(curr, prevId) {
                    curr.addEventListener("keydown", function (e) {
                        if (e.key === "Backspace" && this.value.length === 0) {
                            const prev = document.getElementById(prevId);
                            prev?.focus();
                            // Optionally clear the previous field too
                            // prev.value = prev.value.slice(0, -1);
                        }
                    });
                }

                // Attach digit-only validation for all segments
                [g1, g2, g3, g4].forEach(el => {
                    el.addEventListener("input", () => {
                        el.value = el.value.replace(/\D/g, "");
                    });
                });

                // Setup auto focus
                jumpNext(g1, "g2");
                jumpNext(g2, "g3");
                jumpNext(g3, "g4");

                // Backward auto-jump on delete
                jumpPrev(g2, "g1");
                jumpPrev(g3, "g2");
                jumpPrev(g4, "g3");

                // Merge into hidden field on submit
                document.getElementById("form").addEventListener("submit", function (e) {
                    // If any segment is filled, require all; otherwise allow empty national id
                    const allGElement = document.getElementById("AllG");
                    const anyFilled = !!(g1.value || g2.value || g3.value || g4.value);
                    if (anyFilled) {
                        if (!g1.value || !g2.value || !g3.value || !g4.value) {
                            e.preventDefault();
                            if (allGElement) allGElement.textContent = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Resource2.IncorrectIdNumber))';
                            return false;
                        }
                        // all segments present -> merge
                        hidden.value = `${g1.value}-${g2.value}-${g3.value}-${g4.value}`;
                    } else {
                        // no segments filled -> clear hidden and allow submit
                        if (allGElement) allGElement.textContent = '';
                        hidden.value = '';
                    }
                });
            }

            // Photo preview functionality
            if (photoInput) {
                photoInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        // Validate file size (3MB)
                        if (file.size > 3 * 1024 * 1024) {
                            alert('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Resource3.MaximumImageSize3MB))');
                            this.value = '';
                            return;
                        }

                        const reader = new FileReader();
                        reader.onload = function(event) {
                            preview.src = event.target.result;
                            preview.classList.remove("d-none");
                            preview.classList.add("d-block");
                            if (userIcon) {
                                userIcon.classList.add("d-none");
                            }
                        }
                        reader.readAsDataURL(file);
                    } else {
                        preview.src = '';
                        preview.classList.add("d-none");
                        preview.classList.remove("d-block");
                        if (userIcon) {
                            userIcon.classList.remove("d-none");
                        }
                    }
                });
            }

            // Make file input clickable via labels
            // Removed redundant click handler for label[for="Photo"] to prevent double file dialog
        });
    </script>
}
