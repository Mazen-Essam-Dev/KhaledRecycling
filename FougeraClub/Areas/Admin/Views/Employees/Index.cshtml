@model EmployeeVM

@{
    ViewData["Title"] = @Resource1.EmployeesList;
    ViewData["Title pakage"] = @Resource1.EmployeesManagement ?? " ";
    ViewData["Title Single"] = @Resource1.EmployeesList ?? " ";


    var attachmentsPermission = PermissionScanner.ValidatePermission("Employees", "GetEmployeeAttachments");
    var addPermission = PermissionScanner.ValidatePermission("Employees", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Employees", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Employees", "Delete");
}
<!-- Breadcrumb & Record Count -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb" class="ms-2">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>

    <!-- Badges, Count, Create -->
    <div class="col-md-6 d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <span class="badge bg-light-danger p-2">@Resource2.IdExpired</span>
        <span class="badge bg-light-warning p-2">@Resource2.ExpireIn30Days</span>

        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 px-2 py-1">
            <span>@Resource1.RecordsCount:</span>
            <span id="countRecords">@Model.TotalCount</span>
        </div>


    </div>
</div>

<div class="row">
    <div class="col-12">
        <!-- Main Card -->
        <div class="card">
            <!-- Header -->
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <i class="fa-solid fa-user-tie me-1 text-ico"></i>
                            @Resource1.EmployeesList
                        </h4>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center gap-2 flex-wrap justify-content-end">
                    @if (addPermission)
                    {
                        <a asp-action="AddEdit" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource2.CreateNew
                        </a>
                    }
                    <button type="button" class="btn btn-success btn-sm" onclick="event.preventDefault(); openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>
                    <a class="btn btn-success Excelbtn btn-sm" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"></i>@Resource1.createExcelReport_Download
                    </a>
                </div>

                <script>
                    function openPrintPage() {
                        const get = id => document.getElementById(id)?.value || '';
                        const searchTerm = encodeURIComponent(get('searchTermInput'));
                        const dateFrom = encodeURIComponent(get('dateFrom'));
                        const dateTo = encodeURIComponent(get('dateTo'));
                        const countRecords = document.getElementById('NewCountRecords')?.value;

                        if (countRecords && countRecords > 3999) {
                            showToastrCannotPrint();
                        } else {
                            const url = `/Admin/Employees/Print?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                            window.open(url, 'printWindow', 'width=1000,height=800,noopener,noreferrer');
                        }
                    }

                    function openExcelPage() {
                        const get = id => document.getElementById(id)?.value || '';
                        const searchTerm = encodeURIComponent(get('searchTermInput'));
                        const dateFrom = encodeURIComponent(get('dateFrom'));
                        const dateTo = encodeURIComponent(get('dateTo'));

                        const url = `/Admin/Employees/createExcelReport_Download?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                        window.open(url, '_self');
                    }
                </script>
            </div>
            <!-- Filter Panel -->
            <div class="rounded shadow-sm p-3">
                <form method="get" asp-action="Index" class="filterImg rounded pb-3 pt-2">
                    <div class="container-fluid">
                        <div class="row g-3 align-items-end ">
                            <div class="col-md-3">
                                <label for="searchTermInput" class="fw-medium mb-1 text-success">@Resource2.Search:</label>
                                <div class="position-relative">
                                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                    <input type="text" name="searchTerm" id="searchTermInput"
                                           value="@Model.SearchString"
                                           class="form-control ps-4 form-control-sm filter-bordered"
                                           placeholder="@Resource1.Search_by_name_or_phone" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label for="dateFrom" class="fw-medium mb-1 text-success">@Resource2.From @Resource1.NationalIdExpiryDate:</label>
                                <div class="input-icon-left">
                                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                    <input type="date" name="dateFrom" id="dateFrom"
                                           class="form-control form-select-sm filter-bordered"
                                           value="@(Model.StartDate.HasValue? Model.StartDate.Value.ToString("d")?.Replace("/","-") : "")" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label for="dateTo" class="fw-medium mb-1 text-success">@Resource2.To @Resource1.NationalIdExpiryDate:</label>
                                <div class="input-icon-left">
                                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                    <input type="date" name="dateTo" id="dateTo"
                                           class="form-control form-select-sm filter-bordered"
                                           value="@(Model.EndDate.HasValue? Model.EndDate.Value.ToString("d")?.Replace("/","-") : "")" />
                                </div>
                            </div>
                            <div class="col-md-3 d-flex justify-content-end align-items-center gap-2">
                                <div class="d-flex gap-1">
                                    <button type="button" id="btnClearFilters" class="btn-cancel-search btn-sm btn">
                                        <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                                    </button>
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="ri-filter-line me-1"></i> @Resource1.Search
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ListPartial", Model)
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Delete Modal (unchanged logic) -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">@Resource1.Delete_Employee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Resource1.Close"></button>
            </div>

            <div class="modal-body">
                <p>@Resource1.are_you_sure_Delete <strong id="empName"></strong>؟</p>
            </div>

            <div class="modal-footer">
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="empId" />
                    <button type="button" class="btn btn-success btn-sm" data-bs-dismiss="modal">@Resource1.Cancel</button>
                    <button type="submit" class="btn-cancel-search btn-sm btn">@Resource1.Yes_delete</button>
                </form>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="deleteInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Resource2.Sorry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="deleteInfoMessage" class=" text-center"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel-search btn-sm btn" data-bs-dismiss="modal">@Resource1.Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Attachments Modal (unchanged logic) -->
<div class="modal fade" id="uploadFilesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div id="attachmentsContent"></div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (ViewBag.ReopenModal != null && (bool)ViewBag.ReopenModal)
    {
        <script>
            var myModal = new bootstrap.Modal(document.getElementById('uploadFilesModal'));
            myModal.show();
        </script>
    }

    <script>
            $(document).on("click", ".show-delete-info", function () {
            var message = $(this).data("message"); // take message from data-attribute
            $("#deleteInfoMessage").text(message);

            var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
            modal.show();
        });

    </script>

    <script>

        // Expiry highlighting (kept your logic)
        $(document).ready(function () {
            $('.expiryDate').each(function () {
                const endDateStr = $(this).text().trim();
                if (!endDateStr) return;

                const expiryDate = new Date(endDateStr);
                if (isNaN(expiryDate.getTime())) return;

                const today = new Date();
                const in30Days = new Date();

                today.setHours(0, 0, 0, 0);
                in30Days.setDate(today.getDate() + 30);
                in30Days.setHours(0, 0, 0, 0);
                expiryDate.setHours(0, 0, 0, 0);

                if (expiryDate < today) {
                    $(this).closest('tr').addClass('bg-light-danger');
                } else if (expiryDate <= in30Days) {
                    $(this).closest('tr').addClass('bg-light-warning');
                }
            });
        });


        document.querySelectorAll('.open-attachments').forEach(btn => {
          btn.addEventListener('click', async function () {
            const employeeId = this.getAttribute('data-employee-id');
            let response = await fetch('/Admin/Employees/GetEmployeeAttachments?id=' + employeeId);
            let html = await response.text();
            document.getElementById('attachmentsContent').innerHTML = html;

            // show bootstrap modal
            const modalEl = document.getElementById('uploadFilesModal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            // init handlers for the injected content
            initAttachmentsModal(modalEl, employeeId);
          });
        });

        function initAttachmentsModal(modalEl, employeeId) {
          // find elements inside the modal (these are from the partial HTML)
          const form = modalEl.querySelector('#attachmentsForm');
          const preview = modalEl.querySelector('#attachmentsPreview');
          const addFileBtn = modalEl.querySelector('#addFileBtn');
          const fileNameInput = modalEl.querySelector('#fileNameInput');
          const fileInput = modalEl.querySelector('#fileInput');

          if (!form || !preview) return;

          // Ensure EmployeeId hidden field exists and set it
          let empHidden = form.querySelector('input[name="EmployeeId"]');
          if (!empHidden) {
            empHidden = document.createElement('input');
            empHidden.type = 'hidden';
            empHidden.name = 'EmployeeId';
            form.appendChild(empHidden);
          }
          empHidden.value = employeeId;

          // Helper: re-index all attachments inputs inside each .file-card
          function updateIndices() {
            const cards = preview.querySelectorAll('.file-card');
            cards.forEach((card, idx) => {
              card.dataset.index = idx;
              // rename all inputs/selects/textareas inside this card
              card.querySelectorAll('input, select, textarea').forEach(el => {
                if (!el.name) return;
                // replace first occurrence of [number] with new index
                el.name = el.name.replace(/\[\d+\]/, `[${idx}]`);
              });
            });
          }

          // Make sure existing cards have a remove button and hidden inputs inside them
          preview.querySelectorAll('.file-card').forEach((card, idx) => {
            // ensure card has data-index
            card.dataset.index = idx;

            // move any hidden inputs into the card (if they are outside)
            // (skip if already inside)
            // NOTE: server-rendered hidden Path inputs already inside card in your markup.

            // ensure there is a remove button
            if (!card.querySelector('.remove-btn')) {
              const removeBtn = document.createElement('button');
              removeBtn.type = 'button';
              removeBtn.className = 'remove-btn';
              removeBtn.title = 'Remove';
              removeBtn.innerHTML = '&times;';
              // position it at top-right
              removeBtn.style.position = 'absolute';
              removeBtn.style.top = '4px';
              removeBtn.style.right = '4px';
              card.appendChild(removeBtn);
            }
          });

          // initial index based on existing cards
          let index = preview.querySelectorAll('.file-card').length;

          // Delegated remove handler (works for existing + newly added)
          preview.addEventListener('click', function (e) {
            const removeBtn = e.target.closest('.remove-btn');
            if (!removeBtn) return;

            const card = removeBtn.closest('.file-card');
            if (!card) return;

            // if a previewed image created object URL, revoke it
            const img = card.querySelector('img');
            if (img && img.src && img.src.startsWith('blob:')) {
              URL.revokeObjectURL(img.src);
            }

            // remove the card (hidden inputs inside card will be removed too)
            card.remove();

            // re-index remaining cards and update names
            updateIndices();

            // update index counter to current count
            index = preview.querySelectorAll('.file-card').length;
          });

          // Handler to add new attachments
          addFileBtn?.addEventListener('click', function () {
            const name = (fileNameInput?.value || '').trim();
            const file = fileInput?.files?.[0];

            if (!name) {
                $('#fileNameSpan').text('@Html.Raw(Resource1.Required)');
                return;
            }else{
                $('#fileNameSpan').text('');
            }
            if (!file) {
                $('#fileInputSpan').text('@Resource1.Required');
                return;
            }else{
                $('#fileInputSpan').text('');
            }

            const fileType = (file.type || '').toLowerCase();
            const isImage = fileType.startsWith('image/');
            const isPdf = fileType === 'application/pdf';

            // create card
            const container = document.createElement('div');
            container.className = 'file-card text-center position-relative';
            // place inputs inside this card to make reindexing easy
            container.dataset.index = index;

            let previewHTML = '';
            if (isImage) {
              const imgUrl = URL.createObjectURL(file);
              previewHTML = `<img src="${imgUrl}" class="img-thumbnail" style="width:90px;height:90px;object-fit:cover;border-radius:8px;">`;
            } else if (isPdf) {
              previewHTML = `<i class="fa-solid fa-file-pdf fa-5x text-danger"></i>`;
            } else {
              previewHTML = `<i class="fa-solid fa-file fa-5x text-secondary"></i>`;
            }

            container.innerHTML = `
              <button type="button" class="remove-btn" title="Remove">&times;</button>
              ${previewHTML}
              <div class="fw-medium mt-2">${escapeHtml(name)}</div>
            `;

            // create hidden file input (kept inside card)
            const tempFileInput = document.createElement('input');
            tempFileInput.type = 'file';
            tempFileInput.name = `Attachments[${index}].File`;
            tempFileInput.classList.add('d-none');

            // copy file into tempFileInput using DataTransfer
            const dt = new DataTransfer();
            dt.items.add(file);
            tempFileInput.files = dt.files;

            // create hidden name input inside card
            const nameField = document.createElement('input');
            nameField.type = 'hidden';
            nameField.name = `Attachments[${index}].Name`;
            nameField.value = name;

            // append hidden inputs inside card (so removal removes them)
            container.appendChild(tempFileInput);
            container.appendChild(nameField);

            preview.appendChild(container);

            // clear inputs
            fileNameInput.value = '';
            fileInput.value = '';

            index++;
            updateIndices();
          });

          // small helper: escape HTML for inserted names
          function escapeHtml(str) {
            return str.replace(/[&<>"']/g, function (m) {
              return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]);
            });
          }

          // finally, perform one reindex pass in case names/indices were not correct
          updateIndices();
        }

        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#dateFrom').val(filters.dateFrom);
                $('#dateTo').val(filters.dateTo);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                $('#dateFrom').val('');
                $('#dateTo').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    dateFrom: $('#dateFrom').val(),
                    dateTo: $('#dateTo').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var dateFrom = $('#dateFrom').val();
                var dateTo = $('#dateTo').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/Employees/Index',
                    type: 'GET',
                    data: { searchTerm, dateFrom, dateTo, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);

                        $('.expiryDate').each(function () {
                            const endDateStr = $(this).text().trim();
                            if (!endDateStr) return;

                            const expiryDate = new Date(endDateStr);
                            if (isNaN(expiryDate.getTime())) return;

                            const today = new Date();
                            const in30Days = new Date();

                            today.setHours(0, 0, 0, 0);
                            in30Days.setDate(today.getDate() + 30);
                            in30Days.setHours(0, 0, 0, 0);
                            expiryDate.setHours(0, 0, 0, 0);

                            if (expiryDate < today) {
                                $(this).closest('tr').addClass('bg-light-danger');
                            } else if (expiryDate <= in30Days) {
                                $(this).closest('tr').addClass('bg-light-warning');
                            }
                        });
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page

                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>

}
