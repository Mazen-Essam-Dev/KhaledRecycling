@using FougeraClub.Areas.Admin.ViewModels.AnnualSchedule
@model PaginatedList<AnnualScheduleVM>
@{
    ViewData["Title"] = @Resource1.InventoryList;
    ViewData["Title pakage"] = @Resource1.AnnualInventoryManagement ?? " ";
    ViewData["Title Single"] = @Resource1.InventoryList ?? " ";

    var allyears = ViewBag.allYears as List<string?>;

    var addPermission = PermissionScanner.ValidatePermission("AnnualSchedule", "Add");
    var editPermission = PermissionScanner.ValidatePermission("AnnualSchedule", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("AnnualSchedule", "Delete");
}


<input type="hidden" id="NewCountRecords" value="@Model.Count" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>

    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>@Resource1.Item</th>
                <th>@Resource1.ExchangeStatement</th>
                <th style="min-width: 70px !important;">@Resource1.Previous</th>
                <th style="min-width: 70px !important;">@Resource1.Current</th>
                <th style="min-width: 70px !important;">@Resource1.Record</th>
                <th style="min-width: 80px !important;">@Resource1.Status1</th>
                <th style="min-width: 100px !important;">التصنيف</th>
                <th style="min-width: 80px !important;">@Resource1.InventoryYear</th>
                <th>@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr data-id="@item?.Id">
                        <td data-label="@Resource1.Item">
                            <span class="fw-medium">@item?.Item</span>
                        </td>
                        <td data-label="@Resource1.ExchangeStatement">
                            <span>@item?.Statement</span>
                        </td>
                        <td data-label="@Resource1.Previous">
                            <span>@(item?.Previous != null ? item.Previous.Value.ToString("0") : "")</span>
                        </td>
                        <td data-label="@Resource1.Current">
                            <span>@(item?.Current != null ? item.Current.Value.ToString("0") : "")</span>
                        </td>
                        <td data-label="@Resource1.Record">
                            <span>@(item?.Record != null ? item.Record.Value.ToString("0") : "")</span>
                        </td>
                        <td data-label="@Resource1.Status1">
                            <span>@item?.Status</span>
                        </td>
                        <td data-label="التصنيف">
                            <span>@item?.CategoryName</span>
                        </td>
                        <td data-label="@Resource1.InventoryYear">
                            <span>@item?.year</span>
                        </td>
                        <td data-label="@Resource2.Actions">
                            <!-- Edit -->
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@item?.Id"
                                        class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            <!-- Delete -->
                            @if (deletePermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" asp-route-id="@item?.Id" data-swal="delete"
                                        data-message="@Resource1.Item @item?.Item" method="post" class="d-inline"
                                        onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>