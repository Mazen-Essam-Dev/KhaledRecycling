@model IQueryable<AnnualScheduleVM>
@using FougeraClub.Areas.Admin.ViewModels.AnnualSchedule
@using Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null; // No layout for print view
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.Email ?? "Unknown User";
}

<head>
    <meta charset="utf-8">
    <title></title>
    @if (SessionHelper.GetCurrentLanguage() == "ar")
    {
        <link href="~/ar/assets/css/report-rtl.css" rel="stylesheet" />
    }
    else
    {
        <link href="~/ar/assets/css/report-ltr.css" rel="stylesheet" />
    }

    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/css/prints/report.css" rel="stylesheet">
 
    <style>
        /* Force landscape when printing */
        @@page {
            size: A4 landscape;
        }


        @@media print {
            .no-print {
                display: none !important;
            }
            #report thead th {
                background-color: #47A644 !important;
                color: white !important;
                border-color: #c4c1c1 !important;
            }
        }
    </style>

</head>
<div id="report">
    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@Resource1.Loading..</span>
        </div>
        <p class="loading-text">@Resource1.TheReportIsLoadingpleasewait..</p>
    </div>


    <!-- Official Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap border-black  border-bottom p-3  mb-3">
        <div class="d-flex justify-content-between align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
            </div>
        </div>
        <div class="flex-fill text-center">
            <center>
                <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
            </center>
        </div>
        <div class="d-flex justify-content-end align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="header">
            <h2 class="text-danger">
                @Resource1.AnnualInventoryForm

            </h2>
            @* <p class="text-muted"> @AppDubaiTime.Now.ToString("HH:mm d", System.Globalization.CultureInfo.InvariantCulture)</p> *@
            <textarea id="details" name="details" class="form-control text-center shadow-sm rounded-3" rows="3">
                      @Resource1.AnnualTextarea1
                      @Resource1.AnnualTextarea2
@* بناءا على أجتماع الأدارة لعام 2023 وقرار الادارة رقم 12 بتاريخ 22/12/2024 قامت اللجنة بجرد موجودات النادى حسب ما جاء أدناه
اليوم .................وبتاريخ .............................تم جرد ....................م *@
    </textarea>
        </div>

        <table class="table table-bordered  align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Resource1.Item</th>
                    <th>@Resource1.Particular</th>
                    <th>@Resource1.Previous</th>
                    <th>@Resource1.Current</th>
                    <th>@Resource1.Record</th>
                    <th>@Resource1.Status1</th>
                    <th>التصنيف</th>
                    @* <th>@Resource1.InventoryYear</th> *@
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center p-5">
                            <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                <h5 class="mt-3">@Resource1.No_results_found</h5>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Item</td>
                            <td>@item.Statement</td>
                            <td>@item.Previous</td>
                            <td>@item.Current</td>
                            <td>@item.Record</td>
                            <td>@item.Status</td>
                            <td>@item.CategoryName</td>
                            @* <td>@item.year</td> *@
                        </tr>
                    }
                }
            </tbody>

            <tfoot>
                <tr style="border: none;">
                    <td colspan="2" style="min-height:300px !important;border: none !important;">
                        <div class="footer-container" id="footer-container" style="color: rgba(0, 0, 0, 0) !important;">
                            <div class="footer-top" id="footer-top">
                                <div class="right">Time: </div>
                                <div class="center" style="color: rgba(0, 0, 0, 0) !important;">Date: </div>
                                <div class="left">Printed by: </div>
                            </div>

                            <div class="footer-bottom" id="footer-bottom">
                                @Resource1.FujairahPrintFooter © @AppDubaiTime.Now.ToString("yyyy")
                            </div>
                        </div>
                    </td>
                </tr>
            </tfoot>

        </table>

        <div class="print-footer">
            <div class="footer-top">
                <div class="right">Time: @AppDubaiTime.Now.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
                <div class="center">Date: @AppDubaiTime.Now.ToString("dd/MM/yy", System.Globalization.CultureInfo.InvariantCulture)</div>
                <div class="left">
                    Printed by:
                    @((currentUserName.IndexOf("@") > 1) ? currentUserName.Substring(0, currentUserName.IndexOf("@")) : currentUserName)
                </div>
            </div>
            <hr class="footer-line">
            <div class="footer-bottom">
                @Resource1.FujairahPrintFooter © @AppDubaiTime.Now.ToString("yyyy")
            </div>
        </div>

        <div class="text-center no-print mt-3">
            <button id="containerPrintBtn" class="btn btn-primary" onclick="printPage()">طباعة التقرير</button>
            <button class="btn btn-danger ms-2" onclick="window.close()">إغلاق النافذة</button>
        </div>

    </div>

    <script>
        // When the page loads
        window.addEventListener('load', () => {
            // hide overlay if present
            setTimeout(() => {
                const ov = document.getElementById('loadingOverlay');
                if (ov) ov.style.display = 'none';
            }, 500);
        });

        // After printing, show the container print button again
        window.onafterprint = function () {
            const containerBtn = document.getElementById("containerPrintBtn");
            if (containerBtn) containerBtn.style.display = "inline-block";
        };

        // Print and hide the container print button while printing
        function printPage() {
            const containerBtn = document.getElementById("containerPrintBtn");
            if (containerBtn) containerBtn.style.display = "none";
            window.print();
        }
    </script>
</div>