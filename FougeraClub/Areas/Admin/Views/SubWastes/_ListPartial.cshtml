@model KhaledTeamRecycling.Areas.Admin.ViewModels.SubWaste.SubWasteVM

<input type="hidden" id="NewCountRecords" value="@Model.TotalCount" />

<nav class="d-flex justify-content-end w-25 align-items-center gap-2 my-2" style="margin-right: auto !important;">
    <label for="pageSizeSelect" class="form-label mb-0" style="    text-wrap-mode: nowrap;">Page Size:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width: 74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize ? "selected" : null)">@s</option>
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 80px;">No.</th>
                <th>Main Waste</th>
                <th>Name (AR)</th>
                <th>Name (EN)</th>
                <th style="width: 200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                var x = 0;
                foreach (var item in Model.Items)
                {
                    x++;
                    var isStopped = item.StatusChar == 'H';
                    var stopButtonText = isStopped ? "تفعيل" : "إيقاف";
                    var stopButtonClass = isStopped ? "btn-success" : "btn-warning";
                    var confirmMessage = isStopped
                        ? "هل أنت متأكد من التفعيل؟"
                        : "سيتم الإيقاف من شراء جديد فقط نهائيا وليس البيع، هل أنت متأكد؟";
                    var rowStyle = isStopped ? "background-color:#fd7e141f;" : string.Empty;
                    <tr style="@rowStyle">
                        <td>@(x)</td>
                        <td>@(SessionHelper.GetCurrentLanguage() == "ar" ? item.MainWaste?.NameAr : item.MainWaste?.NameEn)</td>
                        <td>@item.NameAr</td>
                        <td>@item.NameEn</td>
                        <td>
                            <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                            <form asp-action="ToggleStatus"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('@confirmMessage');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm @stopButtonClass">@stopButtonText</button>
                            </form>
                            <button type="button"
                                    class="btn btn-sm btn-danger open-delete-modal"
                                    data-id="@item.Id"
                                    data-name="@(item.NameAr ?? item.NameEn ?? "Item")">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center p-5">No data found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="@($"{Context.Request.Path}?page={Model.CurrentPage - 1}")" class="page-link ajax-page" data-page="@(Model.CurrentPage - 1)">Previous</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a href="@($"{Context.Request.Path}?page={i}")" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="@($"{Context.Request.Path}?page={Model.CurrentPage + 1}")" class="page-link ajax-page" data-page="@(Model.CurrentPage + 1)">Next</a>
        </li>
    </ul>
</nav>
