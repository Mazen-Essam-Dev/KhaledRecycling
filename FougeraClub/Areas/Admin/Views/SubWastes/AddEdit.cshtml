@model KhaledTeamRecycling.Areas.Admin.ViewModels.SubWaste.SubWasteVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "تعديل نوع نفاية فرعي" : "إضافة نوع نفاية فرعي";
    var lang = SessionHelper.GetCurrentLanguage();
    var secSell = lang == "ar" ? "أسعار البيع" : "Sell prices";
    var secBuy = lang == "ar" ? "أسعار الشراء" : "Buy prices";
    var secRatio = lang == "ar" ? "الكمية مقابل الكيلو" : "Ratio (count per kilo)";
}

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item"><a href="/Admin/SubWastes/Index">Sub Waste</a></li>
                <li class="breadcrumb-item"><a href="#">@ViewData["Title"]</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-6 d-flex justify-content-end align-items-center gap-2">
        <a asp-action="Index" class="btn btn-success btn-sm">
            Back <i class="fa-solid fa-arrow-left me-1"></i>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="d-flex justify-content-center c-pro border p-3 mb-3">
        <div class="flex-grow-1 d-flex justify-content-start align-items-center">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa fa-edit me-2 text-ico"></span>@ViewData["Title"]
            </h4>
        </div>
    </div>

    <div class="container">
        <form asp-action="AddEdit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

           @*  @if (Model.Id > 0)
            {
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <label class="form-label">Id</label>
                        <input type="text" class="form-control bg-light" value="@Model.Id" readonly disabled />
                    </div>
                </div>
            } *@

            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource1.BasicData</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label asteriskRequired" asp-for="FKMainWasteId">Main Waste</label>
                        <select asp-for="FKMainWasteId" class="form-select" asp-items="Model.MainWastesList">
                            <option value="">-- Select Main Waste --</option>
                        </select>
                        <span asp-validation-for="FKMainWasteId" class="text-danger"></span>
                    </div>

                    @* <div class="col-md-6">
                        <label class="form-label" asp-for="StatusId">@Resource1.Status</label>
                        <select asp-for="StatusId" class="form-select" asp-items="Model.StatusesList">
                            <option value="">--</option>
                        </select>
                        <span asp-validation-for="StatusId" class="text-danger"></span>
                    </div> *@

                    <div class="col-md-6">
                        <label class="form-label" asp-for="NameAr">@Resource2.Name (AR)</label>
                        <input asp-for="NameAr" class="form-control" />
                        <span asp-validation-for="NameAr" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" asp-for="NameEn">@Resource2.Name (EN)</label>
                        <input asp-for="NameEn" class="form-control" />
                        <span asp-validation-for="NameEn" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@secSell</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="SellPriceUnit">سعر القطعه</label>
                        <input asp-for="SellPriceUnit" type="number" step="any" placeholder="0" class="form-control only-decimal" />
                        <span asp-validation-for="SellPriceUnit" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="SellPriceKilo">سعر الكيلو</label>
                        <input asp-for="SellPriceKilo" type="number" step="any" placeholder="0" class="form-control only-decimal" />
                        <span asp-validation-for="SellPriceKilo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="SellPriceTon">سعر الطن</label>
                        <input asp-for="SellPriceTon" type="number" step="any" placeholder="0" class="form-control only-decimal" />
                        <span asp-validation-for="SellPriceTon" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@secBuy</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="BuyPriceUnit">سعر القطعه</label>
                        <input asp-for="BuyPriceUnit" type="number" step="any" placeholder="0" class="form-control only-decimal" />
                        <span asp-validation-for="BuyPriceUnit" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="BuyPriceKilo">سعر الكيلو</label>
                        <input asp-for="BuyPriceKilo" type="number" step="any" placeholder="0" class="form-control only-decimal" />
                        <span asp-validation-for="BuyPriceKilo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="BuyPriceTon">سعر الطن</label>
                        <input asp-for="BuyPriceTon" type="number" step="any" placeholder="0" class="form-control only-decimal" />
                        <span asp-validation-for="BuyPriceTon" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@secRatio</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>
                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="RatioCountFor1Kilo">RatioCountFor1Kilo</label>
                        <input asp-for="RatioCountFor1Kilo" type="number" step="any" placeholder="0" class="form-control only-decimal" />
                        <span asp-validation-for="RatioCountFor1Kilo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-2 mb-4">
                <button type="submit" class="btn-cancel-search btn-sm btn">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
