@model PaginatedList<CashDisbursementVoucherVM>

@{
    var lang = SessionHelper.GetCurrentLanguage();

    ViewData["Title pakage"] = @Resource2.FinancialManagement ?? " ";
    ViewData["Title Single"] = @Resource2.CashDisbursementVoucherList ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("CashDisbursementVoucher", "Add");
    var editPermission = PermissionScanner.ValidatePermission("CashDisbursementVoucher", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("CashDisbursementVoucher", "Delete");
}


<input type="hidden" id="NewCountRecords" value="@Model.Count" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize)">@s</option>
        }
        <option value="@Model.Count" selected="@(Model.PageSize == Model.Count)">@Resource2.All</option>
    </select>
</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:7%;">@* @Resource1.BondNo1 *@ .No</th>
                <th style="width:11%;">@Resource2.Amount</th>
                <th style="width:7%;">@* @Resource2.RequestDate *@ @Resource1.Date1</th>
                <th style="width:75%;">@Resource1.ControlTools</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.DocumentNo</td>
                        <td>@item.TotalAmount</td>
                        <td>@(item.Date.HasValue? item.Date.Value.ToString("d")?.Replace("/","-") : "")</td>


                        <td data-label="@Resource2.Actions">
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource2.ApprovalDisbursementRequest">
                                <a class="btn-control btn-icon btn-sm rounded-circle"
                                   asp-action="PrintCashDisbursementRequest" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-file fs-5"></i>
                                </a>
                            </span>
                            @if (item.DisbursementRequestSignatureId.HasValue && item.DisbursementRequestSignatureId.Value != 0)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.ExchangeProof2">
                                    <a class="btn-control btn-icon btn-sm rounded-circle"
                                       asp-action="ExchangeProof" asp-route-cashDisbursementVoucherId="@item.Id">
                                        <i class="fa-solid fa-file fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.ExchangeProof2">
                                    <a class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle"
                                       asp-action="#" >
                                        <i class="fa-solid fa-file"></i>
                                    </a>
                                </span>
                            }
                            @if (item.DisbursementRequestSignatureId.HasValue && item.DisbursementRequestSignatureId.Value != 0 && item.ExchangeProofApprovalDone)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.AcknowledgmentReceipt2">
                                    <a class="btn-control btn-icon btn-sm rounded-circle"
                                       asp-action="AcknowledgmentReceipt" asp-route-cashDisbursementVoucherId="@item.Id">
                                        <i class="fa-solid fa-file fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.AcknowledgmentReceipt2">
                                    <a class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle"
                                       asp-action="#">
                                        <i class="fa-solid fa-file"></i>
                                    </a>
                                </span>
                            }

                            <span data-bs-toggle="tooltip" data-bs-title="@Resource2.UploadAttachments">
                                <a class="btn-control btn-icon btn-sm rounded-circle open-attachments"
                                   data-voucher-id="@item.Id" style="cursor:pointer;">
                                    <i class="fa-solid fa-paperclip fs-5"></i>
                                </a>
                            </span>

                            @if (editPermission && (item.DisbursementRequestSignatureAccountantId == null || item.DisbursementRequestSignatureAccountantId == 0)) // Accountant in first page not signed yet
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit"
                                       asp-route-id="@item?.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            else if (editPermission && (item.DisbursementRequestSignatureId == null || item.DisbursementRequestSignatureId == 0) && PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager) // Manger in first page not signed yet And Manger is logged in
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit"
                                       asp-route-id="@item?.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="#"
                                       class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                               
                            
                            <!-- Delete CashDisbursementVoucher -->
                            @if (deletePermission && item != null && (item.DisbursementRequestSignatureAccountantId == null || item.DisbursementRequestSignatureAccountantId == 0)) // Accountant in first page not signed yet
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" data-swal="delete" data-message="@(Resource2.ItemNumber + " " + item?.DocumentNo)"
                                          asp-route-id="@item?.Id"
                                          method="post"
                                          class="d-inline" onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit"
                                                class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <a asp-action="#"
                                       class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </a>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
