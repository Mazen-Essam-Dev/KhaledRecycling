@model KhaledTeamRecycling.Areas.Admin.ViewModels.FinancialTimeline.FinancialTimelineVM

<input type="hidden" id="NewCountRecords" value="@Model.TotalCount" />

<nav class="d-flex justify-content-end w-25 align-items-center gap-2 my-2" style="margin-right: auto !important;">
    <label for="pageSizeSelect" class="form-label mb-0" style="text-wrap-mode: nowrap;">حجم الصفحة:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width: 74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize ? "selected" : null)">@s</option>
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 70px;">م</th>
                <th>التاريخ</th>
                <th>المصدر</th>
                <th>نوع العملية</th>
                <th>الحركة</th>
                <th>الطرف</th>
                <th>اسم العميل / المصنع</th>
                <th>الصنف</th>
                <th>ملاحظات</th>
                <th>المبلغ</th>
                <th>الحالة</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                var x = (Model.CurrentPage - 1) * Model.PageSize;
                foreach (var item in Model.Items)
                {
                    x++;
                    var rowStyle = item.TypeTransaction == '+'
                        ? "background-color:#19875414;"
                        : item.TypeTransaction == '-'
                            ? "background-color:#dc354514;"
                            : "";
                    var transactionClass = item.TypeTransaction == '+' ? "bg-success" : item.TypeTransaction == '-' ? "bg-danger" : "bg-secondary";
                    var statusClass = item.StatusShortChar == "D" ? "bg-primary" : item.StatusShortChar == "S" ? "bg-warning text-dark" : "bg-secondary";
                    var partyClass = item.PartyType == "عميل" ? "bg-info text-dark" : item.PartyType == "مصنع" ? "bg-dark" : "bg-secondary";

                    <tr style="@rowStyle">
                        <td>@x</td>
                        <td>@(item.SortDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                        <td>@item.SourceName</td>
                        <td>@item.OperationType</td>
                        <td><span class="badge @transactionClass">@(item.TypeTransaction == '+' ? "قبض / إيداع" : item.TypeTransaction == '-' ? "دفع / سحب" : "-")</span></td>
                        <td><span class="badge @partyClass">@item.PartyType</span></td>
                        <td>@item.UserName</td>
                        <td>@item.ItemName</td>
                        <td>@item.Notes</td>
                        <td>@(item.Amount?.ToString("0.00"))</td>
                        <td><span class="badge @statusClass">@item.StatusName</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center p-5">لا توجد بيانات.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.CurrentPage - 1)">السابق</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.CurrentPage + 1)">التالي</a>
        </li>
    </ul>
</nav>
