@using FougeraClub.Areas.Admin.ViewModels.Engineer
@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@model EngineerVM

@{
    ViewData["Title"] = Resource2.EngineerData ?? " ";
    Layout = null;
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "Unknown User";
    var today = DateTime.Now.ToString("dd/MM/yyyy");

}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet" />

    <style>
        body {
            font-family: "Tajawal", sans-serif;
            background: #fff;
            font-size: 13px;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            margin: 0;
        }

        .container {
            max-width: 900px;
            margin: auto;
            padding: 0;
        }

        .header-table td {
            padding: 0 !important;
            border: none !important;
        }

        table {
            border-collapse: collapse !important;
            width: 100%;
        }

        th, td {
            border: 1px solid #000 !important;
            padding: 5px !important;
            box-shadow: none;
        }

        th {
            background: #f5f5f5 !important;
            font-weight: bold;
        }

        img {
            max-width: 100%;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 14px;
        }

        @@media print {
            @@page {
                size: A4;
                margin: 10mm;
            }

            * {
                max-width: 100% !important;
                box-sizing: border-box !important;
            }

            table {
                width: 100% !important;
                table-layout: fixed;
                word-wrap: break-word;
            }

            .footer {
                border-top: 1px double #000;
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100%;
                text-align: center;
                padding: 10px 0 0 0;
                font-size: 14px;
            }

            #image1 {
                max-width: 120px !important;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <!-- Header -->
    <table class="header-table w-100 mb-4" style="border-bottom:1px solid #000;">
            <tr style="style=margin-bottom:15px">
                <td class="text-center" >
                <h5 style="color:#6d6058;font-weight:700;">الإمارات العربية المتحدة</h5>
                <h5 style="color:#6d6058;font-weight:700;">حكومة الفجيرة</h5>
                <h5 style="font-weight:700;">نادي الفجيرة العلمي</h5>
            </td>

                <td class="text-center" style="width:120px;margin-bottom:15px">
                <img src="/ar/assets/images/logo-ar.png" style="width:80px;" />
            </td>

                <td class="text-center" style="margin-bottom:15px">
                <h5 style="color:#6d6058;font-weight:700;">UNITED ARAB EMIRATES</h5>
                <h5 style="color:#6d6058;font-weight:700;">GOVT. OF FUJAIRAH</h5>
                <h5 style="font-weight:700;">FUJAIRAH SCIENCE CLUB</h5>
            </td>
        </tr>
    </table>

        <!-- ================= TITLE + PHOTO + EMP NO ================= -->
        <div style="display: flex; justify-content: space-between; align-items: center; width:100%;margin-bottom: 15px;">

            <div style="display:flex; flex-direction:column;">
                <div style="margin-bottom:10px; font-weight:bold;" >@ViewData["Title"]</div>
                <div style="text-align: center; background: #f5f5f5; padding:1px 5px;">
                   @*  تاريخ : <span>@today</span> *@
                </div>
            </div>

            <div style="display:flex; align-items:center; gap:15px;">
                <div style="display:flex; flex-direction:column;">
                    <div style="margin-bottom:10px; font-weight:bold;">رقم المهندس</div>
                    <div style="text-align:center; background:#f5f5f5;">@Model?.Code</div>
                </div>
                @if (!string.IsNullOrEmpty(Model?.ProfileImagePath))
                {
                    <img id="image1" src="~/@Model.ProfileImagePath"
                         style="height:80px; max-width:120px; border:1px solid #000;" />
                }
                else
                {
                    <img id="image1" src="/assets/images/no-image.png"
                         style="height:80px;  max-width:120px; border:1px solid #000;" />
                }

            </div>
        </div>

    <!-- Basic Information -->
        <table class="mb-3" width="100%">
            <colgroup>
                <col width="15%">
                <col>
                <col width="15%">
                <col>
            </colgroup>

        <tr>
            <th colspan="4">البيانات الأساسية</th>
        </tr>
        <tr>
            <td>@Resource2.Name</td>
            <td>@Model?.FullName</td>
                <td>@Resource2.Nationality</td>
            <td>@Model?.Nationality?.NameAr</td>
        </tr>
        <tr>
            <td>@Resource2.Profession</td>
            <td>@Model?.Position</td>
            <td>@Resource2.GraduationYear</td>
            <td>@Model?.GraduationYear</td>
        </tr>
        <tr>
            <td>@Resource1.DateOfBirth</td>
            <td>@Model?.DateOfBirth?.ToString("d")?.Replace("/", "-")</td>
            <td>@Resource1.Address</td>
            <td>@Model?.Address</td>
        </tr>
        <tr>
            <td>@Resource1.WorkLocation</td>
            <td colspan="3">@Model?.WorkAddress</td>
        </tr>
    </table>

    <!-- Contact Information -->
    <table class="mb-3" width="100%">
        <colgroup>
            <col width="15%">
            <col>
            <col width="15%">
            <col>
        </colgroup>

        <tr>
            <th colspan="4">بيانات التواصل</th>
        </tr>
        <tr>
                <td>البريد الإلكتروني</td>
            <td>@Model?.Email</td>
            <td>@Resource1.PhoneNumber</td>
            <td>@Model?.PhoneNumber</td>
        </tr>
       
    </table>

    <!-- Passport / ID -->
    <table class="mb-3" width="100%">
        <colgroup>
            <col width="15%">
            <col>
            <col width="15%">
            <col>
        </colgroup>

        <tr>
            <th colspan="4">بيانات الجواز والهوية</th>
        </tr>
        <tr>
            <td>رقم الجواز</td>
            <td>@Model?.PassportNumber</td>
            <td>انتهاء الجواز</td>
                <td>@Model?.PassportExpiryDate?.ToString("d")?.Replace("/", "-")</td>
        </tr>
        <tr>
            <td>رقم الهوية</td>
            <td>@Model?.IdNumber</td>
            <td>مكان إصدار الهوية</td>
            <td>@Model?.IdReleaseLocation</td>
        </tr>
        <tr>
            <td>انتهاء الهوية</td>
                <td colspan="3">@Model?.IdExpiryDate?.ToString("d")?.Replace("/", "-")</td>
        </tr>
    </table>

    <!-- Salary / Bank -->
    <table class="mb-3" width="100%">
        <colgroup>
            <col width="15%">
            <col>
            <col width="15%">
            <col>
        </colgroup>

        <tr>
            <th colspan="4">البيانات المالية</th>
        </tr>
        <tr>
            <td>الراتب</td>
            <td>@Model?.Salary</td>
            <td>اسم البنك</td>
            <td>@Model?.BankName</td>
        </tr>
        <tr>
            <td>رقم الحساب</td>
            <td colspan="3">@Model?.BankAccountNo</td>
        </tr>
    </table>

    <!-- Notes -->
    <table class="mb-3">
        <tr>
            <th>الملاحظات</th>
        </tr>
        <tr>
            <td>@Model?.Notes</td>
        </tr>
    </table>

</div>

<!-- Footer -->
    <div class="footer">
        <p class="PrintedBy">Printed by : <span style="font-weight:bold !important;"> @((currentUserName.IndexOf("@") > 1) ? currentUserName.Substring(0, currentUserName.IndexOf("@")) : currentUserName)  |  @AppDubaiTime.Now.ToString("dd/MM/yyyy, HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span> </p>
    </div>

    <script>
    window.onload = function () {
        setTimeout(() => window.print(), 500);
        window.onafterprint = () => window.close();
    };
</script>

</body>
</html>
