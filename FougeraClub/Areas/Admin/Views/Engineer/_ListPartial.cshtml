@using FougeraClub.Areas.Admin.ViewModels.Engineer
@using FougeraClub.Areas.Admin.ViewModels.CashExchangeBond
@model PaginatedList<EngineerVM>

@{
    var lang = SessionHelper.GetCurrentLanguage();
    ViewData["Title"] = Resource1.EngineerList;
    ViewData["Title pakage"] = @Resource1.EngineersAssociationManagement ?? " ";
    ViewData["Title Single"] = @Resource1.EngineerList ?? " ";

    var selectedId = ViewBag.selectedNationalityId?.ToString();
    var nationalityList = ViewBag.Nationalities as List<SelectListItem> ?? new List<SelectListItem>();
    var selectedGraduationYear = ViewBag.selectedGraduationYear;
    var yearList = ViewBag.Years as List<SelectListItem> ?? new List<SelectListItem>();

    var addPermission = PermissionScanner.ValidatePermission("Engineer", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Engineer", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Engineer", "Delete");
}
<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped" >
        <thead>
            <tr>
                <th style="width: 30%;">@Resource2.Name</th>
                <th style="width:12% ;">@Resource2.Profession</th>
                <th style="width:20%;">@Resource2.Nationality</th>
                <th style="width: 12%;">@Resource2.GraduationYear</th>
                <th style="width:20%;">@Resource2.Specialization</th>
                <th style="width:13% ;">@Resource1.MobileNumber</th>
                <th style="width:25%;">@Resource2.Actions</th>
            </tr>

        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var engineer in Model.Items)
                {
                    <tr data-id="@engineer?.Id">
                        <td data-label="@Resource2.FullName" style="width: 180px; ">
                            <span class="fw-medium">@engineer.FullName</span>
                        </td>

                        <td data-label="@Resource2.Position" style="width: 40px;">
                            <span>@engineer.Position</span>
                        </td>

                        <td data-label="@Resource2.Nationality" style="width: 40px;">
                            <span>@(lang == "ar" ? engineer?.Nationality?.NameAr : engineer?.Nationality?.NameEn)</span>
                        </td>

                        <td data-label="@Resource2.GraduationYear" style="width: 40px;">
                            <span>@engineer?.GraduationYear</span>
                        </td>

                        <td data-label="@Resource2.Specialization" style="width: 40px; ">
                            <span>@engineer?.Specialization</span>
                        </td>

                        <td data-label="@Resource2.PhoneNumber" style="width: 130px; ">
                            <span>@engineer?.PhoneNumber</span>
                        </td>

                        <td data-label="@Resource2.Actions">
                            <!-- Details -->
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Details">
                                <a asp-action="Details" asp-route-id="@engineer?.Id"
                                    class="btn-control btn-icon btn-sm rounded-circle">
                                    <i class="fa-solid fa-eye fs-5"></i>
                                </a>
                            </span>
                            <!-- Edit -->
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@engineer?.Id"
                                        class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            <!-- Delete -->
                            @if (deletePermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" asp-route-id="@engineer?.Id" data-swal="delete"
                                        data-message="@engineer?.FullName" method="post" class="d-inline"
                                        onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoEngineers</h5>
                            <p class="mb-0">@Resource1.NoEngineersMessage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>