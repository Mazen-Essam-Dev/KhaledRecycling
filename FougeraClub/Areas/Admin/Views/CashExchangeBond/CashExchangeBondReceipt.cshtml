@using FougeraClub.Areas.Admin.ViewModels.CashExchangeBond
@model CashExchangeBondVM
@{
    ViewData["Title"] = Resource1.CashExchangeBondReceipt2;
    ViewData["Title pakage"] = @Resource2.FinancialManagement;
    ViewData["Title ListIndex"] = Resource2.ListofCashExchangeBonds ?? " ";
    ViewData["Title Single"] = @Resource1.CashExchangeBondReceipt2;
    var boolManagerSignature = Model.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath);
    var boolAccountantSigniture = Model.AccountantSigniture != null && !string.IsNullOrEmpty(Model.AccountantSigniture.ImagePath);
}

<style>
    * {
        box-sizing: border-box;
    }
    input {
        border: none;
        outline: none;
        background-color: transparent;
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    #printArea {
        width: 79%;
        background: white;
        margin: auto;
        
    }


    .a4-page {
  width: 79%;
  aspect-ratio: 210 / 297;
  background: white;
  margin: auto;

}

    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    h5 {
        margin: 0;
        line-height: 1.4;
    }


    @@media print {

        html, body

    {
        width: 100%;
        overflow: visible !important;
    }

    .container {
        max-width: 100% !important;
    }

    img {
        max-width: 100% !important;
    }

    .overflow-table {
        width: 100%;
        overflow-x: hidden;
    }

    .print-none, .custom-navbar {
        display: none !important;
    }

    body {
        background: #fff !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        font-size: 12px;
        margin: 0 !important;
        padding: 0 !important;
    }

    #printArea {
        width: 800px !important;
        margin: 0 auto !important;
        padding: 0 !important;
    }

    .row {
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

        .row, .col, div {
            box-sizing: border-box !important;
            max-width: 100% !important;
        }
    .flex-fill {
        flex: 1 1 auto !important;
        min-width: 0 !important;
    }
    input {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        -webkit-appearance: none;
    }

            input[type=number]::-webkit-inner-spin-button,
            input[type=number]::-webkit-outer-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }
    }
</style>
<script>
    function printDiv(divId) {
      var content = document.getElementById(divId).innerHTML;
      var originalPage = document.body.innerHTML;
      window.print();
      document.body.innerHTML = originalPage;
      location.reload();
    }
</script>
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap print-none">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">
                        وحدة إدارة الماليات
                    </a>
                </li>

                <li class="breadcrumb-item"><a href="/Admin/CashExchangeBond/Index">@ViewData["Title ListIndex"]</a></li>

                <li class="breadcrumb-item">
                    <a href="#">
                        سند صرف نقدى
                    </a>
                </li>
            </ol>

        </nav>
    </div>
    <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-end gap-2">
            @if (boolManagerSignature && boolAccountantSigniture)
            {
                <button href="#" onclick="printDiv('printArea')" ; return false;" class="print-btn btn btn-success btn-sm">
                    <i class="fa fa-print me-1"></i> @Resource2.Print

                </button>
            }
            <a asp-action="Index" id="Backbtn" class="btn btn-cancel-search btn-sm">
                @Resource2.Back  <i class="fa-solid fa-arrow-left me-1"></i>
            </a>
        </div>
    </div>

</div>
<div class="card">
    <div id="printArea" class="container">
        <div class="inner-container  mb-3 mt-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap  border-bottom py-3  mb-3">
                <div class="d-flex justify-content-between align-items-center flex-fill">
                    <div style="text-align:center">
                        <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                        <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                        <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
                    </div>
                </div>
                <div class="flex-fill text-center">
                    <center>
                        <img src="~/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
                    </center>
                </div>
                <div class="d-flex justify-content-end align-items-center flex-fill">
                    <div style="text-align:center">
                        <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                        <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                        <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                    </div>
                </div>

            </div>
            <div class="d-flex justify-content-center">
                <h1 class="text-center fs-3" style="width:fit-content;font-size: 17px;font-weight: 700; color:#af1717;">سند صرف نقدى</h1>
            </div>
            <div class="text-center">
                <h3 class="fs-4" style=" text-decoration: underline;text-decoration-color: #af1717;text-decoration-thickness: 1px;font-size: 17px;font-weight: 700; color:#af1717;">Cash Payment Voucher</h3>
                <!--  
                <span class="d-inline-block fs-5 my-1 bg-gray px-2 py-1">@Model.Code</span>-->
            </div>
            <div class="d-flex justify-content-between mb-2">
                <div class="w-50 text-start">
                    <span style="padding: 0 10px;font-size: 14px;font-weight: 700; min-width: 160px;">تاريخ </span>
                    <span class="d-inline-block fs-5  border border-black fw-bold text-center px-4">
                        @Model.Date
                    </span>
                </div>
                <div class="w-50 text-end">
                    <span style="padding: 0 10px;font-size: 14px;font-weight: 700; min-width: 160px;"> رقم </span>
                    <span class="d-inline-block fs-5  border border-black fw-bold text-center px-4 text-red">
                    @Model.Code
                    </span>
                </div>
            </div>
            <form action="/" method="post" class="mt-2 mb-4">
                <!-- Sum of Amount -->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-2">
                        <span class="d-inline-block fs-5 my-1  py-1 w-100">
                            <input id="amountInput" type="number" value="@Model.Money" readonly class="fw-bold w-100 fs-5  border border-black fw-bold text-center text-black" />
                        </span>
                    </div>
                    <div class="col-8">
                        <input id="SumAmount" type="text" value="@ViewBag.arMoney" readonly class="w-100 border-dashed border-bottom border-1 border-black text-center fw-bold" style="border-top:0;border-right:0;border-left:0;" />
                    </div>
                       <div class="col-2 text-center fs-4 fw-normal">
                        <label class="text-black" for="SumAmount" style="padding-top: 8px;">فقط لاغير</label>
                    </div>
                </div>
                <div class="row d-flex align-items-center my-2">
                    <div class="col-2 text-right fs-4 fw-normal">
                        <label class="text-black" for="SumAmount">يصرف إلى : </label>
                    </div>
                    <div class="col-10">
                        <input id="SumAmount" type="text" value="@Model.PersonName" readonly class="w-100 border-dashed border-bottom border-1 border-black text-center" style="border-top:0;border-right:0;border-left:0;" />
                    </div>
                </div>
                <!-- Being -->
                <div class="row d-flex align-items-center my-2">
                    <div class="col-2 text-right fs-4 fw-normal">
                        <label class="text-black" for="Being">وذلك عن</label>
                    </div>
                    <div class="col-10">
                        <input id="Being" type="text" value="@Model.AboutText" readonly class="w-100 border-dashed border-bottom border-1 border-black text-center" style="border-top:0;border-right:0;border-left:0;"/>
                    </div>
                </div>

                <!-- Signatures -->
                <div style="display: flex; justify-content: center; align-items: start; gap: 200px; margin-top: 2rem;">
                    <div style="width: 10%; text-align: center; display: flex; flex-direction: column;">
                        <label class="form-label fw-semibold text-black">@Resource1.Recipient</label>
                    </div>
                    <div style="width: 20%; text-align: center; display: flex; flex-direction: column;">
                        <label class="form-label fw-semibold text-black">@Resource1.Accountant : @Model.AccountantFullName</label>
                        <div class="small text-muted">
                            @if (Model.AccountantSigniture != null && !string.IsNullOrEmpty(Model.AccountantSigniture.ImagePath))
                            {
                                <img src="~/@Model.AccountantSigniture.ImagePath" class="img-fluid" style="height: 70px;" alt="Accountant Signature" />
                            }
                            else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Accountant && await PermissionScanner.CheckLoggedUserIfHasSignature())
                            {
                                <div id="accountantSignatureSection" class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                                    <span id="clickSign1">إضغط هنا للتوقيع</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div style="width: 20%; text-align: center; display: flex; flex-direction: column;">
                        <label class="form-label fw-semibold text-black">@Resource1.Manager1 : @Model.ManagerFullName</label>
                        @if (Model.AccountantSigniture != null && !string.IsNullOrEmpty(Model.AccountantSigniture.ImagePath))
                        {
                            <div class="small text-muted">
                                @if (Model.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath))
                                {
                                    <img src="~/@Model.ManagerSignature.ImagePath" class="img-fluid" style="height: 70px;" alt="Manager Signature" />
                                }
                                else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager && await PermissionScanner.CheckLoggedUserIfHasSignature())
                                {
                                    <div id="managerSignatureSection" class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                                        <span id="clickSign2">إضغط هنا للتوقيع</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <!-- Money Table -->
                <div class="text-center px-3">
                    <div class="row">
                        <div class="col-2 border border-1 border-black p-1">
                            @Resource1.Money
                        </div>
                        <div class="col-2 border border-1 border-black p-1">@Resource1.AccountNo</div>
                        <div class="col-8 border border-1 border-black p-1">
                            @Resource1.Particular
                        </div>
                    </div>
                    @if (Model?.Details != null)
                    {
                        foreach (var detail in Model.Details)
                        {
                            <div class="row">
                                <div class="col-2 border border-1 border-black p-1">
                                    <input type="number" class="text-center w-100" readonly placeholder="00.00" value="@detail.Money" style="border:0;" />
                                </div>
                                <div class="col-2  border border-1 border-black p-1">
                                    <input type="text" class="text-center w-100" readonly placeholder="00.00" value="@detail.AccountNo" style="border:0;" />
                                </div>
                                <div class="col-8 border border-1 border-black p-1">
                                    <input type="text" readonly class="text-center w-100" value="@detail.Particular" style="border:0" />
                                </div>
                            </div>
                        }

                        <div class="row">
                            @{
                                var allmoney = Model.Details.Sum(x => x.Money);
                            }
                            <div class="col-2 border border-1 border-black p-1">
                                <input type="number" readonly class="text-center fw-bold w-100" placeholder="00.00" value="@allmoney?.ToString("0.00")" style="border:0" />
                            </div>
                            <div class="col-2 border border-1 border-black p-1">
                            </div>
                            <div class="col-8 border border-1 border-black p-1">
                                <label class="fw-bold text-center mt-1 text-black">@($" {Resource1.Total} : {TafqeetHelper.Tafqeet(allmoney.Value, CurrencyHelper.AED_Main_Ar, CurrencyHelper.AED_Sub_Ar)}")</label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-2 border border-1 border-black p-1">
                                <input type="text" class="text-center w-100" readonly placeholder="00.00" value="" style="border:0" />
                            </div>
                            <div class="col-2 border border-1 border-black p-1">
                                <input type="text" class="text-center w-100" readonly placeholder="00.00" value="" style="border:0" />
                            </div>
                            <div class="col-2 border border-1 border-black p-1">
                                <input type="text" class="text-center w-100" readonly value="" p-1 />
                            </div>
                            <div class="col-4 border border-1 border-black p-1">
                                <input type="text" readonly class="text-center w-100"  value="" style="border:0" />
                            </div>
                            <div class="col-2 border border-1 border-black p-1">
                                <input type="number" readonly class="text-center w-100" placeholder="00.00" value="" style="border:0" />
                            </div>
                        </div>
                    }

                </div>
            </form>
            <!-- OTP Modal: shared for both roles -->
            <div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="otpModalLabel">@Resource2.EnterOTP</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form id="otpForm">
                            <input type="hidden" id="otpEntityId" name="id" value="@Model.Id" />
                            <input type="hidden" id="otpRole" name="role" value="" />
                            <div class="modal-body text-center">
                                <p>@Resource2.PleaseEnterOTPToConfirmSignature</p>
                                <div class="d-flex justify-content-center gap-2">
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        <input inputmode="numeric" maxlength="1" class="form-control otp-digit text-center fs-4" style="width:60px;" />
                                    }
                                </div>
                                <div class="invalid-feedback text-center mt-2" style="display:none;">@Resource2.EnterValidDigitsCode</div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-cancel-search btn" data-bs-dismiss="modal">@Resource2.Close</button>
                                <button type="submit" class="btn btn-success">@Resource2.Confirm</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const otpInputs = Array.from(document.querySelectorAll("#otpModal .otp-digit")).reverse(); // reverse order for RTL
            const otpModal = document.getElementById("otpModal");
            const invalidFeedback = document.querySelector("#otpModal .invalid-feedback");

            otpInputs.forEach((input, index) => {
                input.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ""); // only digits
                    if (e.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus(); // move left (since reversed)
                    }
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });

            otpModal.addEventListener("shown.bs.modal", () => {
                otpInputs.forEach(i => i.value = "");
                otpInputs[0].focus();
                invalidFeedback.style.display = "none";
            });

            document.getElementById("otpForm").addEventListener("submit", function (e) {
                const otpValue = otpInputs.map(i => i.value).reverse().join(""); // restore normal order
                if (otpValue.length < 4) {
                    e.preventDefault();
                    invalidFeedback.style.display = "block";
                    return false;
                }
                invalidFeedback.style.display = "none";
                console.log("OTP entered:", otpValue);
            });
        });
    </script>


    <script>
        $(document).ready(function () {
            const otpModalEl = document.getElementById('otpModal');
            if (!otpModalEl) return;

            const otpModal = new bootstrap.Modal(otpModalEl, { backdrop: 'static', keyboard: false });
            const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit'));
            const otpForm = document.getElementById('otpForm');
            const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

            function openOtpModal(role) {
                $('#otpRole').val(role);
                // Send OTP
                $.ajax({
                    url: '/Admin/CashExchangeBond/SendOtp',
                    type: 'POST',
                    data: { id: $('#otpEntityId').val(), role: role },
                    success: function (response) {
                        if (response.success) {
                            otpModal.show();
                        } else {
                            alert('Failed to send OTP.');
                        }
                    },
                    error: function () {
                        alert('Error sending OTP.');
                    }
                });
            }

            $('#accountantSignatureSection').on('click', function () { openOtpModal('accountant'); });
            $('#managerSignatureSection').on('click', function () { openOtpModal('manager'); });

            otpForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const code = otpDigits.map(d => d.value.trim()).join('');
                const id = document.getElementById('otpEntityId')?.value;
                const role = document.getElementById('otpRole')?.value;

                if (!/^\d{4}$/.test(code)) {
                    otpDigits.forEach(d => d.classList.add('is-invalid'));
                    otpInvalid.style.display = 'block';
                    return;
                }

                otpDigits.forEach(d => d.classList.remove('is-invalid'));
                otpInvalid.style.display = 'none';

                try {
                    const response = await fetch('/Admin/CashExchangeBond/ValidateOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: id, code: code, role: role })
                    });
                    const result = await response.json();

                    if (result.success) {
                        otpModal.hide();
                        location.reload();
                    } else {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.textContent = result.message || "Invalid OTP.";
                        otpInvalid.style.display = 'block';
                    }
                } catch (err) {
                    alert('OTP validation failed.');
                }
            });
        });
    </script>

    <script>
        function printPage() {
            const overlay = document.getElementById('loadingOverlay');

            // Hide loading overlay if it exists
            if (overlay) {
                setTimeout(() => {
                    overlay.style.display = 'none';
                }, 500);
            }

            // Trigger print
            setTimeout(() => {
                window.print();
            }, 800);

        }
    </script>
</div>
