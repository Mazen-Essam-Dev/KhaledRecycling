@using FougeraClub.Areas.Admin.ViewModels.EstimatedBudgetForExternalParticipation

@model EstimatedBudgetForExternalParticipationVM

@using Application.Helpers
@using Microsoft.AspNetCore.Identity
@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null; // No layout for print view
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "Unknown User";
    ViewData["Title"] = /* Resource1.Details2 +" " + */ Resource1.EstimatedBudgetForExternalParticipation;
    var lang = SessionHelper.GetCurrentLanguage();

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="style.css" />
    <title>Document</title>
</head>
<body>
    <div class="d-flex justify-content-between align-items-center flex-wrap border-black  border-bottom p-3  mb-3">
        <div class="d-flex justify-content-between align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
            </div>
        </div>
        <div class="flex-fill text-center">
            <center>
                <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
            </center>
        </div>
        <div class="d-flex justify-content-end align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
            </div>
        </div>
    </div>

    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@Resource1.Loading..</span>
        </div>
        <p class="loading-text">@Resource1.TheReportIsLoadingpleasewait..</p>
    </div>


    <main>
        <h4 class="text-center text-decoration-underline fw-bolder">@ViewData["Title"]</h4>
        <div class="container">
            <table>
                <tr>
                    <th class="bg-red text-white pe-2 w-25">@Resource1.Date :</th>
                    <th class="pe-2">@Model?.CreationDate?.ToString("d")?.Replace("/", "-")</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.ParticipatingTitle :</th>
                    <th class="pe-2">@Model?.ParticipatingTitle</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.Regulator :</th>
                    <th class="pe-2">@Model?.Regulator</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.ParticipatingCountry :</th>
                    <th class="pe-2">@Model?.ParticipatingCountry</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.DateFrom :</th>
                    <th class="pe-2">@Model?.ParticipatingDate</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.DateTo :</th>
                    <th class="pe-2">@Model?.ParticipatingDateTo</th>
                </tr>
            </table>
            <div class="my-2 border-black">
                <table>
                    <thead>
                        <tr>
                            <th colspan="7" class="fs-5 fw-bolder text-center bg-green">
                                @Resource1.DetailsForSharing
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr colspan="7">
                            <td class="p-1 fs-6 bg-green w-25">@Resource1.ParticipatingType</td>
                            @if (Model?.ParticipatingType == 1)
                            {
                                <td>
                                    <label for="input-one">@Resource1.meeting</label>
                                </td>
                            }
                            @if (Model?.ParticipatingType == 2)
                            {
                                <td>
                                    <label for="input-one">@Resource1.gallery</label>
                                </td>
                            }
                            @if (Model?.ParticipatingType == 3)
                            {
                                <td>
                                    <label for="input-one">@Resource1.Competition</label>
                                </td>
                            }
                            <td class="p-1 fs-6 bg-green w-25">@Resource1.RequiredToparticipate</td>
                            @if (Model?.RequiredToparticipate == 1)
                            {
                                <td>
                                    <label for="input-one">@Resource1.Participants1</label>
                                </td>
                            }
                            @if (Model?.RequiredToparticipate == 2)
                            {
                                <td>
                                    <label for="input-one">@Resource1.projects</label>
                                </td>
                            }
                            <td></td>
                        </tr>
                        <tr>
                            <td class="p-1 fs-6 bg-green w-25">@Resource2.NumberOfParticipants</td>
                            <td class="p-1 fs-7">@($"{Model?.ManagersCount ?? 0} {Resource1.administration}")</td>
                            <td class="p-1 fs-7">@($"{Model?.TechnicalSupervisorsCount ?? 0} {Resource1.TechnicalSupervisor}")</td>
                            <td class="p-1 fs-7">@($"{Model?.ActivitiesSupervisorsCount ?? 0} {Resource1.ActivitiesSupervisors}")</td>
                            <td class="p-1 fs-7">@($"{Model?.MembersCount ?? 0} {Resource1.MembersCount}")</td>
                        </tr>

                    </tbody>
                </table>
            </div>

            <div class="my-2 border-black">
                <table>
                    <thead>
                        <tr>
                            <th colspan="6" class="fs-5 fw-bolder text-center bg-green">
                                @Resource1.RequiredFinancialFees
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.ParticipationFeesForAdministrators</td>
                            <td colspan="3">@Model?.ParticipationFeesForAdministrators</td>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.ParticipationFeesHeadOfDelegation</td>
                            <td colspan="3">@Model?.ParticipationFeesHeadOfDelegation</td>
                        </tr>

                        <tr>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.ParticipationFeesForEntireTeam</td>
                            <td colspan="3">@Model?.ParticipationFeesForEntireTeam</td>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.Subsidies</td>
                            <td colspan="3">@Model?.Subsidies</td>
                        </tr>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.FeeStatement</td>
                            <td colspan="3">@Model?.FeeStatement</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="my-2 border-black">
                <table>
                    <thead>
                        <tr>
                            <th colspan="6" class="fs-5 fw-bolder text-center bg-green">
                                @Resource1.BudgetRequiredForParticipation
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.TotalFeesForParticipation</td>
                            <td colspan="3">@Model?.TotalFeesForParticipation</td>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.TravelTicketValue</td>
                            <td colspan="3">@Model?.TravelTicketValue</td>
                        </tr>

                        <tr>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.ReserveAmountForDelegation</td>
                            <td colspan="3">@Model?.ReserveAmountForDelegation</td>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.HotelAccommodationFees</td>
                            <td colspan="3">@Model?.HotelAccommodationFees</td>
                        </tr>

                        <tr>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.AllowanceTravelForHeadOfDelegation</td>
                            <td colspan="3">@Model?.AllowanceTravelForHeadOfDelegation</td>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.SupervisorsTravelAllowance</td>
                            <td colspan="3">@Model?.SupervisorsTravelAllowance</td>
                        </tr>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-7">@Resource1.TotalBudgetRequired</td>
                            <td colspan="3">@Model?.TotalBudgetRequired1</td>
                            <td colspan="3">@Model?.TotalBudgetRequired2</td>
                        </tr>

                    </tbody>
                </table>
            </div>
            <div class="my-1 border-black">
                <table>
                    <thead>
                        <tr>
                            <th colspan="7" class="fs-5 fw-bolder text-center bg-green">
                                @Resource1.Candidates
                            </th>
                        </tr>
                        <tr class="fs-6 fw-bolder text-center bg-green">
                            <td class="px-2 fw-bold fs-6">@Resource1.adj</td>
                            <td colspan="3" class="p-2">@Resource1.Name</td>
                            <td colspan="3" class="p-2">@Resource1.profession</td>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model?.EstimatedBudgetForExternalParticipationDetails.Count(); i++)
                        {
                            var row = Model.EstimatedBudgetForExternalParticipationDetails.ElementAt(i);
                            <tr>
                                <td class="px-2 fw-bold fs-6">@row.Adj</td>
                                <td colspan="3" class="p-2">@row?.Name</td>
                                <td colspan="3" class="p-2">@row?.Profession</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <table>

                    <tfoot>
                        <tr class="text-center">
                            <td class="px-2 fw-bold fs-6 bg-green">@Resource1.Notes</td>
                            <td colspan="4" class="fs-7 p-2">@Model?.Notes</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Signature Section -->
            <div class="row g-3 d-flex justify-content-end">
                <label class="form-label fw-semibold">@Resource1.SignatureManager</label>
                @if (Model?.Signature != null)
                {
                    <div class="col-md-4 text-center">
                        <div class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                            <div class="small text-muted">
                                @if (!string.IsNullOrEmpty(Model?.Signature.ImagePath))
                                {
                                    <div class="col-md-10 mg-2 mt-1 ms-3 m-4">
                                        <div class="card shadow-sm">
                                            <div class="card-body text-center">
                                                <img src="~/@Model?.Signature.ImagePath" class="img-fluid rounded"
                                                     style="max-height: 200px;" alt="Upload one" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>
    </main>

    <div class="footer">
        <p class="PrintedBy">Printed by : <span> @((currentUserName.IndexOf("@") > 1) ? currentUserName.Substring(0, currentUserName.IndexOf("@")) : currentUserName)  |  @AppDubaiTime.Now.ToString("dd/MM/yyyy, HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span> </p>
    </div>

    <script>

        // This Part Is Important
        window.addEventListener('load', () => {
            setTimeout(() => document.getElementById('loadingOverlay').style.display = 'none', 500);
            setTimeout(() => window.print(), 800);
        });
         // Close window after printing
            window.onafterprint = function() {
                setTimeout(function() {
                    window.close();
                }, 500);
            };
    </script>
</body>
</html>


<style>
    body {
        font-family: 'Arial', sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
        direction: rtl; /* Right to Left */
    }

    .container {
        width: 90%;
        margin: 50px auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: transparent;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    th, td {
        padding: 12px;
        text-align: right; /* Right-aligned for Arabic text */
        border: 2px solid #000;
    }

        th:nth-child(1) {
            width: 200px; /* Column 1: الاسم */
        }

    .bg-red {
        background-color: rgb(167, 4, 4) !important;
    }

    td:nth-child(1) {
        width: 200px; /* Column 1: الاسم */
    }

    .bg-green {
        background-color: rgb(167, 192, 138) !important;
    }

    @@media print {

        body {
            background: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            font-size: 12px;
            margin: 0 40px !important;
        }

        .container {
            width: 100%;
            margin: 0;
            padding: 0;
        }

        header, footer {
            page-break-after: avoid;
            page-break-before: avoid;
        }

        table {
            width: 100%;
            /* border-collapse: collapse; */
            box-shadow: none;
        }

        th, td {
            border: 1px solid #000 !important;
            padding: 2px !important;
        }

        .bg-red {
            background-color: #a70404 !important;
            color: #fff !important;
        }

        .bg-green {
            background-color: #a7c08a !important;
            color: #000 !important;
        }

        .no-print, .btn, .logo {
            width: 60px !important
        }

        .page-break {
            page-break-before: always;
        }
    }
</style>