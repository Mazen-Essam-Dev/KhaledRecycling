    ViewData["Title ListIndex"] = @Resource1.EstimatedBudgetForExternalParticipationList ?? " ";

    ViewData["Title Single"] = (isEdit ? (Resource1.Edit + " " + Resource1.EstimatedBudgetForExternalParticipation) :
    (Resource1.Add + " " + Resource1.EstimatedBudgetForExternalParticipation)) ?? " ";

    var AllEmployeesNames = ViewBag.EmployeesNames as IEnumerable<EmployeesNameDTO>;
    var AllMissionsChecked = Model?.EstimatedBudgetForExternalParticipationDetails.Select(x => x.Id).Distinct().ToList();
}


