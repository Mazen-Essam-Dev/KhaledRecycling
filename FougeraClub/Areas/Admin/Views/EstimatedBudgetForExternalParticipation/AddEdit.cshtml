@section Scripts {
    <partial name="_ValidationScriptsPartial" />


    <script>
        document.getElementById("MembersCount").addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
        document.getElementById("ActivitiesSupervisorsCount").addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
        document.getElementById("TechnicalSupervisorsCount").addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
        document.getElementById("ManagersCount").addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>

    <script>
        let rowIndex = @Model?.EstimatedBudgetForExternalParticipationDetails?.Count() ?? 0;

        function addRow() {
            const idPage = document.getElementById("idPage").value;
            const adj = document.getElementById("newAdj").value;
            const name = document.getElementById("newName").value;
            const profession = document.getElementById("newProfession").value;

            if (!adj || !name || !profession) {
                $("#newAdjSpan").text("");
                $("#newNameSpan").text("");
                $("#newProfessionSpan").text("");
                if (!adj) {
                    $("#newAdjSpan").text("@Html.Raw(Resource1.Required)");
                }
                if (!name) {
                    $("#newNameSpan").text("@Html.Raw(Resource1.Required)");
                }
                if (!profession ) {
                    $("#newProfessionSpan").text("@Html.Raw(Resource1.Required)");                  
                }

                return;
            }
            $("#newAdjSpan").text("");
            $("#newNameSpan").text("");
            $("#newProfessionSpan").text("");

            const tbody = document.getElementById("Details");

            const row = document.createElement("tr");
            if(idPage > 0)
            { // Edit
                row.innerHTML = `
                <td><input class="form-control" name="EstimatedBudgetForExternalParticipationDetails[${rowIndex}].Adj" value="${adj}" /></td>
                <td><input class="form-control" name="EstimatedBudgetForExternalParticipationDetails[${rowIndex}].Name" value="${name}" /></td>
                <td><input class="form-control" name="EstimatedBudgetForExternalParticipationDetails[${rowIndex}].Profession" value="${profession}" /></td>
                <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
            `;
            }else{ // add 
                row.innerHTML = `
                <td><input class="form-control" name="EstimatedBudgetForExternalParticipationDetails[${rowIndex}].Adj" value="${adj}"  /></td>
                <td><input class="form-control" name="EstimatedBudgetForExternalParticipationDetails[${rowIndex}].Name" value="${name}"  /></td>
                <td><input class="form-control" name="EstimatedBudgetForExternalParticipationDetails[${rowIndex}].Profession" value="${profession}"  /></td>
                <td class="text-center"><button type="button" class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash fs-5"></i></button></td>
            `;
            }
            

            tbody.appendChild(row);
            rowIndex++;
            // Clear inputs
            document.getElementById("newAdj").value = "";
            document.getElementById("newName").value = "";
            document.getElementById("newProfession").value = "";
        }

        // Store the row to be deleted
        let rowToDelete = null;
        function removeRow(button) {
            rowToDelete = button.closest("tr");
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        function confirmDeleteRow() {
            if (rowToDelete) {
                rowToDelete.remove();
                // Reindex all rows
                const rows = document.querySelectorAll("#Details tr");
                rows.forEach((row, i) => {
                    const inputs = row.querySelectorAll("input");
                    inputs.forEach(input => {
                        const name = input.getAttribute("name");
                        if (name) {
                            input.setAttribute("name", name.replace(/\[\d+\]/, `[${i}]`));
                        }
                    });
                });
                rowIndex = rows.length;
                rowToDelete = null;
            }
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            if (modal) modal.hide();
        }
    </script>

    <script>
        // Auto-calculate Total Budget Required from Budget Required for Participation fields
        (function () {
            const fields = [
                'TotalFeesForParticipation',
                'TravelTicketValue',
                'ReserveAmountForDelegation',
                'HotelAccommodationFees',
                'AllowanceTravelForHeadOfDelegation',
                'SupervisorsTravelAllowance',
                'MembersAllowance'
            ];

            function parseNumber(val) {
                if (!val) return 0;
                const n = parseFloat(val);
                return isNaN(n) ? 0 : n;
            }

            function computeTotal() {
                let sum = 0;
                fields.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) sum += parseNumber(el.value);
                });
                const totalEl = document.getElementById('TotalBudgetRequired1');
                const hiddenEl = document.getElementById('TotalBudgetRequired2');
                if (totalEl) totalEl.value = sum;
                if (hiddenEl) hiddenEl.value = sum;
            }

            // Attach listeners
            document.addEventListener('DOMContentLoaded', function () {
                fields.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.addEventListener('input', computeTotal);
                });
                // initial compute
                computeTotal();
            });
        })();
    </script>

    <!-- Delete Modal (matches other admin pages) -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Resource2.ConfirmDelete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>هل أنت متأكد من أنك تريد حذف هذا العنصر؟ هذا الإجراء لا يمكن التراجع عنه.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">@Resource2.Cancel</button>
                    <button type="button" class="btn btn-cancel-search" onclick="confirmDeleteRow()">@Resource2.Delete</button>
                </div>
            </div>
        </div>
    </div>

}