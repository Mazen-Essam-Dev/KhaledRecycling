            margin: 10mm;
        }
    }
</style>
<script>
    function printDiv(divId) {
      window.print();
      document.body.innerHTML = originalPage;
      location.reload();
    }
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        (function () {
            const otpModalEl = document.getElementById('otpModal');
            if (!otpModalEl) return;

            const otpModal = new bootstrap.Modal(otpModalEl, { backdrop: 'static', keyboard: false });
            const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit')).reverse(); // reverse for RTL
            const otpForm = document.getElementById('otpForm');
            const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

            // Navigate between OTP inputs
            otpDigits.forEach((input, index) => {
                input.addEventListener('input', (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ''); // digits only
                    if (e.target.value && index < otpDigits.length - 1) {
                        otpDigits[index + 1].focus(); // move left in RTL
                    }
                });

                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && !input.value && index > 0) {
                        otpDigits[index - 1].focus();
                    }
                });
            });

            // Reset inputs on modal show
            otpModalEl.addEventListener('shown.bs.modal', () => {
                otpDigits.forEach(i => i.value = '');
                otpDigits[0].focus();
                otpInvalid.style.display = 'none';
                otpDigits.forEach(d => d.classList.remove('is-invalid'));
            });

            // Function to open OTP modal for a given role
            function openOtpModal(role) {
                document.getElementById('otpRole').value = role;
                fetch('/Admin/MaterialOrder/SendOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        otpModal.show();
                    } else {
                        alert('Failed to send OTP.');
                    }
                })
                .catch(err => console.error('Error sending OTP:', err));
            }

            // Trainer signature trigger
            const trainerSection = document.getElementById('trainerSignatureSection');
            if (trainerSection) {
                trainerSection.addEventListener('click', () => openOtpModal('Trainer'));
                trainerSection.addEventListener('keypress', e => {
                    if (e.key === 'Enter' || e.key === ' ') { trainerSection.click(); e.preventDefault(); }
                });
            }

            // Manager signature trigger
            const managerSection = document.getElementById('managerSignatureSection');
            if (managerSection) {
                managerSection.addEventListener('click', () => openOtpModal('Manager'));
                managerSection.addEventListener('keypress', e => {
                    if (e.key === 'Enter' || e.key === ' ') { managerSection.click(); e.preventDefault(); }
                });
            }

            // Validate OTP on submit
            otpForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const code = otpDigits.map(d => d.value.trim()).reverse().join(''); // restore normal order
                const id = document.getElementById('otpEntityId')?.value;
                const role = document.getElementById('otpRole')?.value;

                if (!/^\d{4}$/.test(code)) {
                    otpDigits.forEach(d => d.classList.add('is-invalid'));
                    otpInvalid.textContent = 'Please enter a valid 4-digit OTP';
                    otpInvalid.style.display = 'block';
                    return;
                }

                otpDigits.forEach(d => d.classList.remove('is-invalid'));
                otpInvalid.style.display = 'none';

                try {
                    const response = await fetch('/Admin/MaterialOrder/ValidateOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: parseInt(id), code: code, role: role })
                    });
                    const result = await response.json();

                    if (result.success) {
                        otpModal.hide();
                        location.reload();
                    } else {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.textContent = result.message || 'Invalid OTP.';
                        otpInvalid.style.display = 'block';
                    }
                } catch (err) {
                    console.error('OTP validation failed:', err);
                }
            });

        })();
    });
</script>