@using Application.Helpers
@using FougeraClub.Areas.Admin.ViewModels.AdministrativeReportQuarterlyAnnual
@using System.Globalization

@model QuartersReportAdminstrativeDetailsVM

@{
    var s = Enum.GetName(typeof(QuartersYear), ViewBag.quarter ?? 0);
    var QuarterName = " ";
    if (s != null)
        QuarterName = Resource1.ResourceManager.GetString(s, CultureInfo.CurrentUICulture);
    ViewData["Title pakage"] = @Resource1.MissionsManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.AdministrativeReportQuarterlyAnnual ?? " ";


    var title = (ViewBag.selectedYear != null ? Resource1.ReportThe + " " + Resource1.AdminstrativeThe + " " + QuarterName + " " + Resource1.Theyear1 + " " + ViewBag.selectedYear + " " + Resource1.millad : " ");

    var boolManagerSignature = Model?.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath);
    var titleLable = (ViewBag.selectedYear != null ? Resource1.Summary + " " + Resource1.ReportThe + " " + Resource1.AdminstrativeThe + " " + QuarterName : " ");


    if (ViewBag.quarter == 5)
    {
        ViewData["Title"] = Resource1.Summary + " " + title;
        ViewData["Title Single"] = Resource1.Summary + " " + title;
        ViewData["Title Quarter"] = " ";
    }
    else
    {
        ViewData["Title"] = Resource1.Summary + " " + title;
        ViewData["Title Single"] = Resource1.Summary + " " + title;
    }
}


<script>
    function printDiv(divId) {
      window.print();
      document.body.innerHTML = originalPage;
