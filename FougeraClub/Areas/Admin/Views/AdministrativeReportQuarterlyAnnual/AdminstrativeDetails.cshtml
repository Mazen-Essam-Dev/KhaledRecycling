<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap print-none">
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item"><a href="/Admin/AdministrativeReportQuarterlyAnnual/Index">@ViewData["Title ListIndex"]</a></li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-end gap-2">
            @if (boolManagerSignature)
            {
                <button onclick="printDiv('printArea')" ;="" return="" false;"="" class="print-btn btn btn-success btn-sm">
                    <i class="fa fa-print me-1"></i> @Resource2.Print
                </button>
            }
            <input type="hidden" hidden id="selectedYear" name="selectedYear" value="@ViewBag.SelectedYear" />
            <input type="hidden" hidden id="quarter" name="quarter" value="@ViewBag.quarter" />
            <a class="btn btn-cancel-search btn-sm back-btn" asp-action="Index">
                @Resource2.Back  <i class="fa-solid fa-arrow-left me-1"></i>
            </a>
        </div>
    </div>
</div>
<div class="card">
    <div class="container mb-3" id="printArea">
        <div class="d-flex justify-content-between border-black  border-bottom py-3  mb-3">
            <div class="d-flex" style="height: 70px;">
                <div>
                    <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:70px; height:70px;">
                </div>
                <div class="ms-2 d-flex flex-column justify-content-center">
                    <h5 style="color:#000000; font-size: 18px;font-weight: 700; margin:0;" class="mb-2">نادي الفجيرة العلمي</h5>
                    <h5 style="color:#000000; font-size: 15px;font-weight: 700; margin:0;">FUJAIRAH SCIENCE CLUB</h5>
                </div>
            </div>

            <div>
                <div class="d-flex">
                    <div>
                        <div style="padding: 5px 10px;background-color: #af1717;color:#fff; font-weight:bold;">@titleLable</div>
                    </div>
                    <div>
                        <div style="padding: 5px 21px;background:#ccc;color:#000;font-weight:bold;min-width: 71px;">@ViewBag.selectedYear</div>
                    </div>
                </div>
              
            </div>
        </div>

        <div style="color:#af1717; font-weight:bold; font-size:17px; text-align:center; margin-bottom:30px;">
            @ViewData["Title"]
        </div>
        <div>
            <!-- Table -->
            <div class="overflow-table">
                <table style="width:100%;  text-align:center;border-collapse:collapse;" cellspacing="0" cellpadding="5">
                    <thead>
                        <tr style="background:#af1717">
                            <th style="width:5%; background:#af1717 !important; color:#fff !important; font-weight:600;">@Resource1.S</th>
                            <th style="width:15%;background:#af1717 !important; color:#fff !important;font-weight:600;">@Resource1.StartDateActivity2</th>
                            <th style="width:15%;background:#af1717 !important; color:#fff !important;font-weight:600;">@Resource1.EndDateActivity2</th>
                            <th style="width:65%;background:#af1717 !important; color:#fff !important;font-weight:600;">@Resource1.ActivityReasonStatement</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.AdminstrativeDetailsVM_List != null)
                        {
                            var n = 0;
                            {
                                // Build month list for quarter or full year
                                var listQuarter = new List<List<int>> {
                                    new List<int>{ 1,2,3 },
                                    new List<int>{4,5,6},
                                    new List<int>{7,8,9},
                                    new List<int>{10,11,12},
                                };

                                List<int> monthsToRender;
                                if (ViewBag.quarter != null && (int)ViewBag.quarter == 5)
                                {
                                    monthsToRender = Enumerable.Range(1, 12).ToList();
                                }
                                else if (ViewBag.quarter != null)
                                {
                                    monthsToRender = listQuarter[(int)ViewBag.quarter - 1];
                                }
                                else
                                {
                                    monthsToRender = Enumerable.Range(1, 12).ToList();
                                }

                                foreach (var month in monthsToRender)
                                {
                                    DateTime date = new DateTime((ViewBag.selectedYear ?? DateTime.Now.Year), month, 1);
                                    var monthRow = Resource1.Month1 + " " + date.ToString("MMMM") + " " + ViewBag.selectedYear + " " + Resource1.millad;
                                    <!-- Month row -->
                                    <tr style="background-color:#eee">
                                        <td colspan="4" style="color:#000;font-weight:500;" class="text-center">@monthRow</td>
                                    </tr>

                                    var record = Model.AdminstrativeDetailsVM_List?.FirstOrDefault(r => r.month == month);
                                    var Details = record?.Details?.OrderBy(y => y.ActivityEndDate).ToList();

                                    if (Details == null || Details.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted p-2">لا يوجد نشاط</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var detail in Details)
                                        {
                                            n++;
                                            <tr>
                                                <td>@n</td>
                                                <td>@detail.ActivityStartDate?.ToString("d")?.Replace("/","-")</td>
                                                <td>@detail.ActivityEndDate?.ToString("d")?.Replace("/","-")</td>
                                                <td>@detail.Reason</td>
                                            </tr>
                                        }
                                    }
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="20" class="text-center p-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                        <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3">@Resource1.NoData</h5>
                                        <p class="mb-0">@Resource2.GoToCreatePage</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="d-flex justify-content-end border-black border-top mt-3" style="padding-top: 20px; text-align:center;">
            <div class="flex-column align-items-center">
                <label class="form-label fw-bold text-black">@Resource1.Manager1 / <span>@Model.ManagerFullName</span></label>
            @if (Model?.ManagerSignature != null)
            {
                    <div class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                        <div class="small text-muted">
                            @if (!string.IsNullOrEmpty(Model?.ManagerSignature.ImagePath))
                            {
                              
                                   <img src="~/@Model?.ManagerSignature.ImagePath" class="img-fluid rounded" style="height: 70px;" alt="Upload one" />
                              
                            }
                        </div>
                    </div>
            }
                else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager && await PermissionScanner.CheckLoggedUserIfHasSignature())
            {

                    <div id="managerSignatureSection" class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                        <div class="small text-muted">إضغط هنا للتوقيع</div>
                    </div>
            }
            </div>
        </div>

        <!-- OTP Modal: shared for both roles -->
        <div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="otpModalLabel">@Resource2.EnterOTP</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="otpForm">
                        @* <input type="hidden" id="otpEntityId" name="id" value="@Model.Id" /> *@
                        <input type="hidden" id="otpRole" name="role" value="" />
                        <div class="modal-body text-center">
                            <p>@Resource2.PleaseEnterOTPToConfirmSignature</p>
                            <div class="d-flex justify-content-center gap-2">
                                @for (int i = 0; i < 4; i++)
                                {
                                    <input inputmode="numeric" maxlength="1" class="form-control otp-digit text-center fs-4" style="width:60px;" />
                                }
                            </div>
                            <div class="invalid-feedback text-center mt-2" style="display:none;">@Resource2.EnterValidDigitsCode</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-cancel-search btn" data-bs-dismiss="modal">@Resource2.Close</button>
                            <button type="submit" class="btn btn-success">@Resource2.Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const otpInputs = Array.from(document.querySelectorAll("#otpModal .otp-digit")).reverse(); // reverse order for RTL
            const otpModal = document.getElementById("otpModal");
            const invalidFeedback = document.querySelector("#otpModal .invalid-feedback");

            otpInputs.forEach((input, index) => {
                input.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ""); // only digits
                    if (e.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus(); // move left (since reversed)
                    }
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });

            otpModal.addEventListener("shown.bs.modal", () => {
                otpInputs.forEach(i => i.value = "");
                otpInputs[0].focus();
                invalidFeedback.style.display = "none";
            });

            document.getElementById("otpForm").addEventListener("submit", function (e) {
                const otpValue = otpInputs.map(i => i.value).reverse().join(""); // restore normal order
                if (otpValue.length < 4) {
                    e.preventDefault();
                    invalidFeedback.style.display = "block";
                    return false;
                }
                invalidFeedback.style.display = "none";
                console.log("OTP entered:", otpValue);
            });
        });
    </script>


    <script>
        $(document).ready(function () {
            function openOtpModal(role) {
                $('#otpRole').val(role);
                // Send OTP
                $.ajax({
                    url: '/Admin/AdministrativeReportQuarterlyAnnual/SendOtp',
                    type: 'POST',
                    data: {/*  id: $('#otpEntityId').val(), */ role: role },
                    success: function (response) {
                        if (response.success) {
                            const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
                            otpModal.show();
                        } else {
                            alert('Failed to send OTP.');
                        }
                    },
                    error: function () {
                        alert('Error sending OTP.');
                    }
                });
            }
            // $('#trainerSignatureSection').on('click', function () { openOtpModal('trainer'); });
            $('#managerSignatureSection').on('click', function () { openOtpModal('manager'); });

            // OTP form logic
            const otpModalEl = document.getElementById('otpModal');
            if (!otpModalEl) return;
            const otpModal = new bootstrap.Modal(otpModalEl, { backdrop: 'static', keyboard: false });
            const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit'));
            const otpForm = document.getElementById('otpForm');
            const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

            otpForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const code = otpDigits.map(d => d.value.trim()).join('');
                // const id = document.getElementById('otpEntityId')?.value;
                const role = document.getElementById('otpRole')?.value;

                if (!/^\d{4}$/.test(code)) {
                    otpDigits.forEach(d => d.classList.add('is-invalid'));
                    otpInvalid.style.display = 'block';
                    return;
                }

                otpDigits.forEach(d => d.classList.remove('is-invalid'));
                otpInvalid.style.display = 'none';

                try {
                    const response = await fetch('/Admin/AdministrativeReportQuarterlyAnnual/ValidateOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            // id: id,
                            code: code,
                            role: role,
                            type: @((int?)Model?.Type),
                            quarter: @((int?)Model?.Quarter),
                            year: @((int?)Model?.Year)
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        otpModal.hide();
                        // Optionally reload page or update signature section
                        location.reload();
                    } else {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.textContent = result.message || "Invalid OTP.";
                        otpInvalid.style.display = 'block';
                    }
                } catch (err) {
                    alert('OTP validation failed.');
                }
            });
        });
    </script>
}

