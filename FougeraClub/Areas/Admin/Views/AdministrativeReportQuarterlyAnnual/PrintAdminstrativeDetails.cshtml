@using FougeraClub.Areas.Admin.ViewModels.AdministrativeReportQuarterlyAnnual

@model QuartersReportAdminstrativeDetailsVM
@using Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using System.Globalization
@inject UserManager<ApplicationUser> UserManager
@{
    var lang = SessionHelper.GetCurrentLanguage();
    Layout = null; // No layout for print view
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "Unknown User";
    var s = Enum.GetName(typeof(QuartersYear), ViewBag.quarter ?? 0);
    var QuarterName = " ";
    if (s != null)
        QuarterName = Resource1.ResourceManager.GetString(s, CultureInfo.CurrentUICulture);
    var title = (ViewBag.selectedYear != null ? Resource1.ReportThe + " " + Resource1.AdminstrativeThe + " " + QuarterName + " " + Resource1.Theyear1 + " " + ViewBag.selectedYear + " " + Resource1.millad : " ");
    var titleLable = (ViewBag.selectedYear != null ? Resource1.Summary + " " + Resource1.ReportThe + " " + Resource1.AdminstrativeThe + " " + QuarterName : " ");

    if (ViewBag.quarter == 5)
    {
        ViewData["Title"] = Resource1.AdministrativeReportAnnual;
    }
    else
    {
        ViewData["Title"] = Resource1.Details2 + " " + Resource1.AdministrativeReport + " - " + QuarterName;
    }
}
<head>
    <meta charset="utf-8">
    <title></title>
    @if (SessionHelper.GetCurrentLanguage() == "ar")
    {
        <link href="~/ar/assets/css/report-rtl.css" rel="stylesheet" />
    }
    else
    {
        <link href="~/ar/assets/css/report-ltr.css" rel="stylesheet" />
    }

    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        .fs-15 {
            font-size: 15px !important;
        }

        table {
            
            width: 100%;
            text-align: center;
        }

      
        .w-sm {
            width: 7%;
        }

        .w-md {
            width: 10%;
        }

      @@media print {
        .print-title

        {
            text-align: center;
        }

        .print-header2 {
            position: fixed;
            top: 50px;
            left: 0;
            right: 0;
            text-align: center;
        }

        .print-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            text-align: center;
        }

        .page-break {
            page-break-after: always;
        }

            body {
                -webkit-print-color-adjust: exact; /* For WebKit browsers */
                print-color-adjust: exact; /* For Firefox */
            }

            .row {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
            }

            .col-md-6 {
                flex: 0 0 48%; /* Adjust as needed for spacing */
                margin-bottom: 10px; /* Space between rows */
            }

            .container-div {
                    padding: 5px 10px;
                    color: #fff; /* Keep text color for print */
                }

            .first-div {
                        background-color: #a80b0b; /* Retain background color */
                    }

            .second-div {
                        background-color: gray; /* Retain background color */
                    }

            .logo {
                max-width: 100%; /* Ensure logo fits */
                height: auto; /* Maintain aspect ratio */
            }
            /* Hide elements that are not needed in print */
            img {
                display: block; /* Hide if you want to remove the logo */
            }
      

        }

    
   
    </style>

</head>
<div id="report">
    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@Resource1.Loading..</span>
        </div>
        <p class="loading-text">@Resource1.TheReportIsLoadingpleasewait..</p>
    </div>  
    <!-- Official Header -->
    <div class="print-header">
        <!-- Official Header -->
        <div class="d-flex justify-content-between align-items-center flex-wrap border-black  border-bottom p-3  mb-3">
            <div class="d-flex justify-content-between align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
                </div>
            </div>
            <div class="flex-fill text-center">
                <center>
                    <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
                </center>
            </div>
            <div class="d-flex justify-content-end align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                </div>
            </div>
        </div>


        <div class="row d-flex align-items-center justify-content-around">
            <div  class="container-div col-md-6 d-flex " style="color: #fff;">
                <div class="first-div" style="padding: 5px 10px;background-color: #a80b0b;">@ViewBag.selectedYear</div>
                <div class="second-div" style="padding: 5px 10px;background: gray;">@titleLable</div>
            </div>
            <div class="col-md-6" style="text-align: inherit;display: flex;justify-content: flex-end;">
                <div class="d-flex align-items-center gap-3 ">
                    <div class="d-flex flex-column">
                        <h5 class="fs-10">نادي الفجيرة العلمي</h5>
                        <h5 class="fs-10"> Fujairah Science Club</h5>
                    </div>
                    <div>
                        <img src="~/assets/images/logo.png" class="logo" onerror="this.style.display='none'" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content-inner">
        <div class="data-part">
            <div class="p-1">
                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center">
                        <thead class="table-light">
                            <!-- The title you want to repeat -->
                            <tr>
                                <th colspan="10" style="text-align:center; font-size:18px; background-color:#fff; color:darkred; border:none; padding-bottom:35px;" >
                                    @( Resource1.Summary + " " + title)
                                </th>
                            </tr>

                            <tr>
                                <th colspan="1" class="w-sm fs-15"  >@Resource1.S</th>
                                <th colspan="2" class=" w-md fs-15">@Resource1.StartDateActivity2</th>
                                <th colspan="2" class="w-md fs-15">@Resource1.EndDateActivity2</th>
                                <th colspan="5" class=" fs-15">@Resource1.ActivityReasonStatement</th>
                            </tr>
                        </thead>
                        <tbody id="candidatesBody">
                            @if (Model != null && Model.AdminstrativeDetailsVM_List != null)
                            {
                                var n = 0;
                                var c = 0;
                                var rowPerPage = 15; // Number of records per page
                                foreach (var record in Model.AdminstrativeDetailsVM_List)
                                {
                                    var monthRow = Resource1.Month1 + " " + record.Date?.ToString("MMMM") + " " + ViewBag.selectedYear + " " + Resource1.millad;
                                    <!-- Month row -->
                                    <tr class="fw-bold" style="background-color:palegoldenrod;">
                                        <td colspan="10" style="color:darkred;font-size:15px;background-color:#bcbfc5;" class="text-center">@monthRow</td>
                                    </tr>
                                    var Details = record.Details.OrderBy(y => y.ActivityEndDate).ToList();
                                    foreach (var detail in Details)
                                    {
                                        n++;
                                        c++;
                                        c = (n == 10) ? 0 : c;
                                        <tr class="@((c % rowPerPage == 0 || n == 10) ? "page-break" : "")">
                                            <td colspan="1" style="background-color:#bcbfc5;">@n</td>
                                            <td colspan="2">@detail.ActivityStartDate?.ToString("d")?.Replace("/","-")</td>
                                            <td colspan="2">@detail.ActivityEndDate?.ToString("d")?.Replace("/","-")</td>
                                            <td colspan="5" class="text-start">@detail.Reason</td>
                                        </tr>
                                    }
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="20" class="text-center p-5">
                                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                            <h5 class="mt-3">@Resource1.NoData</h5>
                                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                                        </div>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>


    <div class="print-footer">
        <div class="">
            <div class="">
                <!-- Signature Section -->
                <hr class="custom-hr" />
                <div class="row g-3 d-flex justify-content-end">


                    <!-- Manager Signature -->
                    <div class="col-md-6 text-center">
                        <div id="managerSignatureSection" class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                            <label class="form-label fw-semibold">@Resource1.SignatureManager</label>
                            <div class="small text-muted">
                                @if (Model?.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath))
                                {
                                    <img src="~/@Model.ManagerSignature.ImagePath" class="img-fluid rounded mt-2" style="max-height: 100px;" alt="Manager Signature" />
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- small footer row for social / contact icons -->
                <!-- Footer with icons -->
                <div class="footer-icons d-flex justify-content-center align-items-center ltr flex-wrap gap-3 mt-4" style="font-size:16px;">

                    <!-- Landline -->
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-telephone text-warning"></i>
                        <span>09-2220191</span>
                    </div>

                    <!-- Phone -->
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-telephone-fill text-primary"></i>
                        <span>050-1965658</span>
                    </div>

                    <!-- WhatsApp -->
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-whatsapp text-success"></i>
                        <span>fujsc</span>
                    </div>

                    <!-- Twitter -->
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-twitter text-danger"></i>
                        <span>fujsc</span>
                    </div>

                    <!-- Instagram -->
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-instagram text-danger"></i>
                        <span>fuj.sc</span>
                    </div>

                    <!-- Facebook -->
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-facebook text-primary"></i>
                        <span>fujsc</span>
                    </div>

                    <!-- YouTube -->
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-youtube text-danger"></i>
                        <span>fujsc</span>
                    </div>

                    <!-- Website -->
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-globe2 text-warning"></i>
                        <span><a href="http://www.fujsc.ae/" target="_blank" style="cursor:pointer;">www.fujsc.ae</a></span>
                    </div>

                </div>

                <div class="footer">
                    <p class="PrintedBy">Printed by : <span> @((currentUserName.IndexOf("@") > 1) ? currentUserName.Substring(0, currentUserName.IndexOf("@")) : currentUserName)  |  @AppDubaiTime.Now.ToString("dd/MM/yyyy, HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span> </p>
                </div>
            </div>
        </div>
    </div>

 <script>

        // This Part Is Important
        window.addEventListener('load', () => {
            setTimeout(() => document.getElementById('loadingOverlay').style.display = 'none', 500);
            setTimeout(() => window.print(), 800);
        });
         // Close window after printing
            window.onafterprint = function() {
                setTimeout(function() {
                    window.close();
                }, 500);
            };
    </script>  
</div>
