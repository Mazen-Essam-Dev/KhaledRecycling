                                <th colspan="5" class=" fs-15">@Resource1.ActivityReasonStatement</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var duration = 0;
                            }
                            @if (Model != null && Model.ActivitiesDetailsVM != null)
                            {
                                var n = 0;
                                foreach (var record in Model.ActivitiesDetailsVM.MonthsOfYearsAnnualyWithDetails)
                                {
                                    var monthRow = Resource1.Month1 + " " + record.Date?.ToString("MMMM") + " " + ViewBag.selectedYear + " " + Resource1.millad;
                                    <!-- Month row -->
                                    <tr class="fw-bold" style="background-color:palegoldenrod;">
                                        <td colspan="10" style="color:darkred;font-size:15px;background-color:#bcbfc5;" class="text-center">@monthRow</td>
                                    </tr>

                                    var Details = record.Details.OrderBy(y => y.ActivityEndDate).ToList();
                                    foreach (var detail in Details)
                                    {
                                        n++;
                                        <tr>
                                            <td class="fw-bolder" colspan="1" style="background-color:#bcbfc5;">@n</td>
                                            @if (detail?.ActivityStartDate != null && detail?.ActivityEndDate != null)
                                            {
                                                duration += ((int)detail.ActivityEndDate.Value.Day - (int)detail.ActivityStartDate.Value.Day) + 1;
                                                <td colspan="2">@(detail?.ActivityEndDate.Value.Day - @detail?.ActivityStartDate.Value.Day + 1)</td>
                                            }
                                            else
                                            {
                                                <td colspan="2"> - </td>
                                            }
                                            <td colspan="2">@detail?.NumberOfParticipants</td>
                                            <td colspan="5">@detail?.Reason</td>
                                        </tr>
                                    }
                                }
                            }
