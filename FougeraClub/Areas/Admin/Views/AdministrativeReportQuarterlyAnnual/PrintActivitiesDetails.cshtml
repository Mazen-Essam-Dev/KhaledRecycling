</style>


@using System.Text.Json


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
<script>
    const ctx = document.getElementById('multiPie').getContext('2d');

    // 🔹 Custom plugin for center text
    const centerText = {
      id: 'centerText',
      beforeDraw(chart) {
        const { width, height, ctx } = chart;
        ctx.save();

        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = 'black';

        // First line (small)
        ctx.font = '18px Arial';
        ctx.fillText('@duration', width / 2, height / 2 - 20);

        // Divider line
        ctx.font = '16px Arial';
        ctx.fillText('———', width / 2, height / 2);

        // Second line (bold large)
        ctx.font = 'bold 20px Arial';
        ctx.fillText('@Model?.ActivitiesDetailsVM?.MonthsOfYearsAnnualyWithDetails.Sum(x => x.Details.Sum(d => d.NumberOfParticipants ?? 0))', width / 2, height / 2 + 20);

        ctx.restore();
      }
    };

    // 🔹 JSON-serialized lists from backend
    let monthLabelsArr = @Html.Raw(JsonSerializer.Serialize(Model?.ActivitiesDetailsVM?.PieChart.MonthsLables));

    let month1Arr = @Html.Raw(JsonSerializer.Serialize(Model?.ActivitiesDetailsVM?.PieChart.Month1NoOfParticipations));
    let month2Arr = @Html.Raw(JsonSerializer.Serialize(Model?.ActivitiesDetailsVM?.PieChart.Month2NoOfParticipations));
    let month3Arr = @Html.Raw(JsonSerializer.Serialize(Model?.ActivitiesDetailsVM?.PieChart.Month3NoOfParticipations));



    let sum = arr => arr.reduce((a, b) => a + b, 0);

    let monthsArr = [
      sum(month1Arr) / 100,
      sum(month2Arr) / 100,
      sum(month3Arr) / 100
    ];

    // 🔹 Flatten values
    let valuesArr = [
      ...month1Arr,
      ...month2Arr,
      ...month3Arr
    ];

    let month1Color = '#36A2EB';
    let month2Color = '#FF6384';
    let month3Color = '#FFCE56';
    let mainColorArr = [month1Color, month2Color, month3Color];

    let colorsArr = [
      ...month1Arr.map(() => month1Color),
      ...month2Arr.map(() => month2Color),
      ...month3Arr.map(() => month3Color)
    ];

    const chart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: monthLabelsArr,
        datasets: [
          {
            label: 'Middle',
            data: monthsArr,
            backgroundColor: mainColorArr,
            borderWidth: 3,
            radius: '50%',
            cutout: '0%',
            customLabels: ["","",""]
          },
          {
            label: 'Outer',
            data: valuesArr,
            backgroundColor: colorsArr,
            borderWidth: 3,
            radius: '100%',
            cutout: '50%',
            customLabels: valuesArr,
            mapping: [
              ...month1Arr.map(() => 0),
              ...month2Arr.map(() => 1),
              ...month3Arr.map(() => 2)
            ]
          }
        ]
      },
      options: {
        plugins: {
          datalabels: {
            color: '#fff',
            font: { weight: 'bold', size: 12 },
            formatter: (value, context) => {
              let dataset = context.dataset;
              return dataset.customLabels
                ? dataset.customLabels[context.dataIndex]
                : context.chart.data.labels[context.dataIndex];
            }
          },
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              label: function (context) {
                let dataset = context.dataset;
                let label = dataset.customLabels
                  ? dataset.customLabels[context.dataIndex]
                  : context.chart.data.labels[context.dataIndex];

                // If outer, also show parent Month
                if (dataset.label === 'Outer') {
                  let parent = dataset.mapping[context.dataIndex];
                  return `(${chart.data.datasets[0].customLabels[parent]}) ${label}: ${context.formattedValue}`;
                }
                return `${label}: ${context.formattedValue}`;
              }
            }
          }
        }
      },
      plugins: [ChartDataLabels, centerText]
    });
</script>




<script>

    // This Part Is Important
    window.addEventListener('load', () => {
