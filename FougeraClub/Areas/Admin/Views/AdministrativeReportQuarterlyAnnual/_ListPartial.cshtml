@model AdministrativeReportQuarterlyAnnualIndexVM

@{
    var lang = SessionHelper.GetCurrentLanguage();

    ViewData["Title pakage"] = @Resource1.ExternalWorkMissionManagement ?? " ";
    ViewData["Title Single"] = @Resource1.AdministrativeReportQuarterlyAnnual ?? " ";

    var All2DetailsPermission = PermissionScanner.ValidatePermission("AdministrativeReportQuarterlyAnnual", "All2Details");
    var CurrectYear = AppDubaiTime.Now.Year;
    var list5Quarters = ViewBag.list5Quarters as List<bool>;
}


<input type="hidden" id="Newh3titlepage" value="@(ViewBag.selectedYear != null ? Resource1.ReportForTheyear + " " + ViewBag.selectedYear + " " + Resource1.millad : " ")" />


<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                @* <th style="width:8%;">@Resource1.NoSerial</th> *@
                <th>الفترة الزمنية</th>
                <th style="width:80%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Quarters.Any() && ViewBag.selectedYear != null)
            {
                var n = 0;
                foreach (var item in Model.Quarters)
                {
                    n++;
                    @if (ViewBag.SelectedYear != null && list5Quarters != null && list5Quarters?[n - 1] == true){
                    <tr id="@item.Value">
                        @* <td>@(n)</td> *@
                        <td id="@item.Value">@(item.Text)</td>
                        <td class="text-center">
                            <!-- Edit CashExchangeBond -->
                                @if (item.Value != "5")
                                {
                                    @if (Model.ActivitiesCounts[n-1] > 0)
                                    {
                                        <span data-bs-toggle="tooltip" data-bs-title="@($"{Resource1.Summary} {Resource1.Report} {Resource1.Activity2}")">
                                            <button class=" media-btn btn-control rounded btn-sm px-2 " onclick="goToActivitiesDetails('@item.Value')"><i class="fa-solid fa-file fs-6 me-1"></i> @($"{Resource1.Report} {Resource1.Activity2}") </button>
                                        </span>
                                    }

                                    @if (Model.AdministrativeCounts[n - 1] > 0)
                                    {
                                        <span data-bs-toggle="tooltip" data-bs-title="@($"{Resource1.Summary} {Resource1.ReportThe} {Resource1.AdminstrativeThe}")">
                                            <button class="media-btn btn-control rounded btn-sm px-2" onclick="goToAdminstrativeDetails('@item.Value')"><i class="fa-solid fa-file fs-6 me-1"></i> @($"{Resource1.ReportThe} {Resource1.AdminstrativeThe}") </button>
                                        </span>
                                    }
                                }
                                @if ((Model.ActivitiesCounts[n - 1] + Model.AdministrativeCounts[n - 1]) > 0)
                                    {
                                        <span data-bs-toggle="tooltip" data-bs-title="@($"{Resource1.Summary} {Resource1.ReportThe} {Resource1.summition}")">
                                        <button class="media-btn btn-control rounded btn-sm px-2" onclick="goToAll2Details('@item.Value')"><i class="fa-solid fa-file fs-6 me-1"></i> @($"{Resource1.ReportThe} {Resource1.summition}") </button>
                                        </span>
                                    }
                                @if (item.Value == "5")
                                {
                                    @if (((Model.ActivitiesCounts[n - 1] + Model.AdministrativeCounts[n - 1]) > 0) && Model.CollaborativeIsSiggned==true)
                                    {
                                        
                                    }
                                }
   
                        </td>
                    </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.SelectYearFirst</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

