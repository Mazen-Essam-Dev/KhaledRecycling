@model AdministrativeReportQuarterlyAnnualIndexVM

@{
    var lang = SessionHelper.GetCurrentLanguage();

    ViewData["Title pakage"] = @Resource1.ExternalWorkMissionManagement ?? " ";
    ViewData["Title Single"] = @Resource1.AdministrativeReportQuarterlyAnnual ?? " ";

    var CurrectYear = AppDubaiTime.Now.Year;
    var list5Quarters = ViewBag.list5Quarters as List<bool>;
}

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">

        <div class="d-flex align-items-center gap-2">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa-solid fa-file  me-1 text-ico"></span>
                @Resource1.AdministrativeReportQuarterlyAnnual
            </h4>
        </div>
    </div>
    <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <!-- Main card container for services data -->
        <div class="card">
            <div class="rounded shadow-sm p-3">
                <!-- Search Panel -->
                <form method="get" id="studentFilterForm" class="filterImg rounded p-2">
                    <div class="row mb-1">
                        <div class="filter-dropdown col-md-10">
                            <div class="filter-dropdown">
                                <label for="yearSelect" class="fw-bold mb-1">@Resource2.Year:</label>
                                <div class="input-icon-left">
                                    <img src="~/assets/images/YearAndMonthIcon.png" alt="calendar icon" class="date-icon">
                                    <select class="form-select form-select-sm filter-bordered"
                                            required
                                            id="yearSelect"
                                            name="selectedYear"
                                            oninvalid="this.setCustomValidity('⚠️ @Resource1.PleaseSelectAyear')"
                                            oninput="this.setCustomValidity('')">
                                        <option value="">-- @Resource2.Select --</option>
                                        @foreach (var year in ViewBag.Years as List<int>)
                                        {
                                            if (year == ViewBag.SelectedYear)
                                            {
                                                <option value="@year" selected>@year</option>
                                            }
                                            else if (ViewBag.SelectedYear == null && CurrectYear == year)
                                            {
                                                ViewBag.SelectedYear = CurrectYear;
                                                <option value="@year" selected>@year</option>
                                            }
                                            else
                                            {
                                                <option value="@year">@year</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    <!-- Filter Action Buttons -->
                        <div class=" col-md-2 gap-1 d-flex justify-content-end align-items-end">
                            <button type="button" id="btnClearFilters" class="btn btn-cancel-search btn-sm coustom-min-w">
                                <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                            </button>
                            <button type="submit" class="btn btn-sm btn-success coustom-min-w">
                                <i class="ri-filter-line me-1"></i> @Resource1.Search
                            </button>
                    </div>
                    </div>
                </form>
                <!-- For The Title New Generated -->
                <div class="row">
                    <div class="col-md-12 mt-4">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@(ViewBag.selectedYear != null ? Resource1.ReportForTheyear + " " + ViewBag.selectedYear + " " + Resource1.millad : " ")</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
                    </div>
                </div>
                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ListPartial", Model)
                </div>


            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function openPrintWindow(event, url) {
            event.preventDefault(); //to prevent normal redirect
            window.open(
                url,
                'printWindow',
                'width=1000,height=800,noopener,noreferrer'
            );
        }
    </script>

    <script>
        function goToActivitiesDetails(quarter) {
            // const searchbtn = document.getElementById("searchbtn");
            // searchbtn.click();

            const yearSelect = document.getElementById("yearSelect");

            // This will make the browser display the default or custom required message
            if (!yearSelect.reportValidity()) {
                return; // It will not continue if there is no value
            }

            // It has a value → spirit on the link
            const url = `/Admin/AdministrativeReportQuarterlyAnnual/ActivitiesDetails?quarter=${quarter}&selectedYear=${encodeURIComponent(yearSelect.value)}`;
            window.location.href = url;
        }
    </script>
    <script>
        function goToAdminstrativeDetails(quarter) {
            // const searchbtn = document.getElementById("searchbtn");
            // searchbtn.click();

            const yearSelect = document.getElementById("yearSelect");

            // This will make the browser display the default or custom required message
            if (!yearSelect.reportValidity()) {
                return; // It will not continue if there is no value
            }

            // It has a value → spirit on the link
            const url = `/Admin/AdministrativeReportQuarterlyAnnual/AdminstrativeDetails?quarter=${quarter}&selectedYear=${encodeURIComponent(yearSelect.value)}`;
            window.location.href = url;
        }
    </script>
    <script>
        function goToAll2Details(quarter) {
            // const searchbtn = document.getElementById("searchbtn");
            // searchbtn.click();

            const yearSelect = document.getElementById("yearSelect");

            // This will make the browser display the default or custom required message
            if (!yearSelect.reportValidity()) {
                return; // It will not continue if there is no value
            }

            // It has a value → spirit on the link
            const url = `/Admin/AdministrativeReportQuarterlyAnnual/All2Details?quarter=${quarter}&selectedYear=${encodeURIComponent(yearSelect.value)}`;
            window.location.href = url;
        }
    </script> 


    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#yearSelect').val(filters.selectedYear);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#yearSelect').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    selectedYear: $('#yearSelect').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var selectedYear = $('#yearSelect').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/AdministrativeReportQuarterlyAnnual/Index',
                    type: 'GET',
                    data: { selectedYear, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newH3titlepage = $('#Newh3titlepage').val();
                        $('#h3titlepage').text(newH3titlepage);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page

                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>

}


