        </div>

    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
<style>
    .graph {
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f5f5f5;
        border:1px solid #eee;
    }

    #multiPie {
        max-width: 500px;
        max-height: 500px;
    }
</style>


@using System.Text.Json

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const otpInputs = Array.from(document.querySelectorAll("#otpModal .otp-digit")).reverse(); // reverse order for RTL
            const otpModal = document.getElementById("otpModal");
            const invalidFeedback = document.querySelector("#otpModal .invalid-feedback");

            otpInputs.forEach((input, index) => {
                input.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ""); // only digits
                    if (e.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus(); // move left (since reversed)
                    }
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });

            otpModal.addEventListener("shown.bs.modal", () => {
                otpInputs.forEach(i => i.value = "");
                otpInputs[0].focus();
                invalidFeedback.style.display = "none";
            });

            document.getElementById("otpForm").addEventListener("submit", function (e) {
                const otpValue = otpInputs.map(i => i.value).reverse().join(""); // restore normal order
                if (otpValue.length < 4) {
                    e.preventDefault();
                    invalidFeedback.style.display = "block";
                    return false;
                }
                invalidFeedback.style.display = "none";
                console.log("OTP entered:", otpValue);
            });
        });
    </script>


    <script>
        const ctx = document.getElementById('multiPie').getContext('2d');

        // 🔹 Custom plugin for center text
        const centerText = {
            id: 'centerText',
            beforeDraw(chart) {
                const { width, height, ctx } = chart;
                ctx.save();

                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillStyle = 'black';

                // First line (small)
                ctx.font = '14px Arial';
                ctx.fillText('@duration', width / 2, height / 2 - 20);


                // Divider line
                ctx.font = '16px Arial';
                ctx.fillText('———', width / 2, height / 2);

                // Second line (bold large)
                ctx.font = 'bold 18px Arial';
                ctx.fillText('@Model?.ActivitiesDetailsVM?.MonthsOfYearsAnnualyWithDetails?.Sum(x => x.Details.Sum(d => d.NumberOfParticipants ?? 0))', width / 2, height / 2 + 20);


                ctx.restore();
            }
        };

        // 🔹 JSON-serialized lists from backend
        let monthLabelsArr = @Html.Raw(JsonSerializer.Serialize(Model?.ActivitiesDetailsVM?.PieChart.MonthsLables));

        let month1Arr = @Html.Raw(JsonSerializer.Serialize(Model?.ActivitiesDetailsVM?.PieChart.Month1NoOfParticipations));
        let month2Arr = @Html.Raw(JsonSerializer.Serialize(Model?.ActivitiesDetailsVM?.PieChart.Month2NoOfParticipations));
        let month3Arr = @Html.Raw(JsonSerializer.Serialize(Model?.ActivitiesDetailsVM?.PieChart.Month3NoOfParticipations));



        let sum = arr => arr.reduce((a, b) => a + b, 0);

        let monthsArr = [
            sum(month1Arr) / 100,
            sum(month2Arr) / 100,
            sum(month3Arr) / 100
        ];

        // 🔹 Flatten values
        let valuesArr = [
            ...month1Arr,
            ...month2Arr,
            ...month3Arr
        ];
             
        let month1Color = '#398439';
         let month2Color = '#af1717';
        let month3Color = '#FFCE56';
        let mainColorArr = [month1Color, month2Color, month3Color];

        let colorsArr = [
            ...month1Arr.map(() => month1Color),
            ...month2Arr.map(() => month2Color),
            ...month3Arr.map(() => month3Color)
        ];

        const chart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: monthLabelsArr,
                datasets: [
                    {
                        label: 'Middle',
                        data: monthsArr,
                        backgroundColor: mainColorArr,
                        borderWidth: 3,
                        radius: '50%',
                        cutout: '0%',
                        customLabels: ["", "", ""]
                    },
                    {
                        label: 'Outer',
                        data: valuesArr,
                        backgroundColor: colorsArr,
                        borderWidth: 3,
                        radius: '100%',
                        cutout: '50%',
                        customLabels: valuesArr,
                        mapping: [
                            ...month1Arr.map(() => 0),
                            ...month2Arr.map(() => 1),
                            ...month3Arr.map(() => 2)
                        ]
                    }
                ]
            },
            options: {
                interaction: { mode: null },   // disable hover globally
                hover: { mode: null },
                plugins: {
                    tooltip: { enabled: false },
                    datalabels: {
                        color: '#fff',
                        font: { weight: 'bold', size: 12 },
                        formatter: (value, context) => {
                            let dataset = context.dataset;
                            return dataset.customLabels
                                ? dataset.customLabels[context.dataIndex]
                                : context.chart.data.labels[context.dataIndex];
                        }
                    },
                            legend: {
            position: 'bottom',
            onClick: () => {}   // يمنع إخفاء/إظهار الداتا عند الضغط على الـ legend
        },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let dataset = context.dataset;
                                let label = dataset.customLabels
                                    ? dataset.customLabels[context.dataIndex]
                                    : context.chart.data.labels[context.dataIndex];

                                // If outer, also show parent Month
                                if (dataset.label === 'Outer') {
                                    let parent = dataset.mapping[context.dataIndex];
                                    return `(${chart.data.datasets[0].customLabels[parent]}) ${label}: ${context.formattedValue}`;
                                }
                                return `${label}: ${context.formattedValue}`;
                            }
                        }
                    }
                }
            },
            plugins: [ChartDataLabels, centerText]
        });
    </script>

    <script>
        $(document).ready(function () {
            function openOtpModal(role) {
                $('#otpRole').val(role);
                // Send OTP
                $.ajax({
                    url: '/Admin/AdministrativeReportQuarterlyAnnual/SendOtp',
                    type: 'POST',
                    data: { /* id: $('#otpEntityId').val(),  */role: role },
                    success: function (response) {
                        if (response.success) {
                            const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
                            otpModal.show();
                        } else {
                            alert('Failed to send OTP.');
                        }
                    },
                    error: function () {
                        alert('Error sending OTP.');
                    }
                });
            }
            // $('#trainerSignatureSection').on('click', function () { openOtpModal('trainer'); });
            $('#managerSignatureSection').on('click', function () { openOtpModal('manager'); });

            // OTP form logic
            const otpModalEl = document.getElementById('otpModal');
            if (!otpModalEl) return;
            const otpModal = new bootstrap.Modal(otpModalEl, { backdrop: 'static', keyboard: false });
            const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit'));
            const otpForm = document.getElementById('otpForm');
            const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

            otpForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const code = otpDigits.map(d => d.value.trim()).join('');
                // const id = document.getElementById('otpEntityId')?.value;
                const role = document.getElementById('otpRole')?.value;

                if (!/^\d{4}$/.test(code)) {
                    otpDigits.forEach(d => d.classList.add('is-invalid'));
                    otpInvalid.style.display = 'block';
                    return;
                }

                otpDigits.forEach(d => d.classList.remove('is-invalid'));
                otpInvalid.style.display = 'none';

                try {
                    const response = await fetch('/Admin/AdministrativeReportQuarterlyAnnual/ValidateOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            // id: id,
                            code: code,
                            role: role,
                            type: @((int?)Model?.Type),
                            quarter: @((int?)Model?.Quarter),
                            year: @((int?)Model?.Year)
                            })
                    });
                    const result = await response.json();

                    if (result.success) {
                        otpModal.hide();
                        // Optionally reload page or update signature section
                        location.reload();
                    } else {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.textContent = result.message || "Invalid OTP.";
                        otpInvalid.style.display = 'block';
                    }
                } catch (err) {
                    alert('OTP validation failed.');
                }
            });
        });
    </script>

}