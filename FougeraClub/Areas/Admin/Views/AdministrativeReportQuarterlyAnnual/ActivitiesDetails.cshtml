                                {
                                    <input inputmode="numeric" maxlength="1" class="form-control otp-digit text-center fs-4"
                                        style="width:60px;" />
                                }
                            </div>
                            <div class="invalid-feedback text-center mt-2" style="display:none;">
                                @Resource2.EnterValidDigitsCode</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-cancel-search btn"
                                    data-bs-dismiss="modal">
                                @Resource2.Close
                            </button>
