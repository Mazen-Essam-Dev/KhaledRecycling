<div class="card">
    <div class="container mb-3" id="printArea">
        <div class="d-flex justify-content-between border-black  border-bottom py-3  mb-3">
            <div class="d-flex" style="height: 70px;">
                <div>
                    <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:70px; height:70px;">
                </div>
                <div class="ms-2 d-flex flex-column justify-content-center">
                    <h5 style="color:#000000; font-size: 18px;font-weight: 700; margin:0;" class="mb-2">نادي الفجيرة العلمي</h5>
                    <h5 style="color:#000000; font-size: 15px;font-weight: 700; margin:0;">FUJAIRAH SCIENCE CLUB</h5>
                </div>
            </div>
            <div>
                <div class="d-flex">
                    <div>
                        <div style="padding: 5px 10px;background-color: #af1717;color:#fff; font-weight:bold;">@titleLable</div>
                    </div>
                    <div>
                        <div style="padding: 5px 21px;background:#ccc;color:#000;font-weight:bold;min-width: 71px;">@ViewBag.selectedYear</div>
                    </div>
                </div>
               
            </div>
        </div>
        <div style="color:#af1717; font-weight:bold; font-size:17px; text-align:center; margin-bottom:30px;">
                @(ViewBag.selectedYear != null ? Resource1.Summary + " " +
                                Resource2.ActivityReport + " " + QuarterName + " " + Resource1.Theyear1 + " " + ViewBag.selectedYear + "                " + Resource1.millad : " ")
            </div>
            <!-- Table -->
                <div class="overflow-table">
                    <table style="width:100%;  text-align:center;border-collapse:collapse;" cellspacing="0" cellpadding="5">
                    <thead>
                        <tr style="background:#af1717">
                            <th style="width:10%; background:#af1717 !important; color:#fff !important; font-weight:600;">@Resource1.S</th>
                            <th style="width:15%;background:#af1717 !important; color:#fff !important;font-weight:600;">@Resource2.TimePeriod</th>
                            <th style="width:15%;background:#af1717 !important; color:#fff !important;font-weight:600;">@Resource2.NumberOfParticipants</th>
                            <th style="width:60%;background:#af1717 !important; color:#fff !important;font-weight:600;">@Resource1.ActivityReasonStatement</th>

                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var duration = 0;
                        }
                        @if (Model != null && Model.ActivitiesDetailsVM != null &&
                                                Model.ActivitiesDetailsVM.MonthsOfYearsAnnualyWithDetails != null)
                        {
                            var n = 0;

                            var listQuarter = new List<List<int>> {
                                new List<int>{ 1,2,3 },
                                new List<int>{4,5,6},
                                new List<int>{7,8,9},
                                new List<int>{10,11,12},
                            };

                            List<int> monthsToRender;
                            if (ViewBag.quarter != null && (int)ViewBag.quarter == 5)
                            {
                                monthsToRender = Enumerable.Range(1, 12).ToList();
                            }
                            else if (ViewBag.quarter != null)
                            {
                                monthsToRender = listQuarter[(int)ViewBag.quarter - 1];
                            }
                            else
                            {
                                monthsToRender = Enumerable.Range(1, 12).ToList();
                            }

                            foreach (var month in monthsToRender)
                            {
                                DateTime date = new DateTime((ViewBag.selectedYear ?? DateTime.Now.Year), month, 1);
                                var monthRow = Resource1.Month1 + " " + date.ToString("MMMM") + " " + ViewBag.selectedYear + " " + Resource1.millad;
                                <!-- Month row -->
                                <tr style="background-color:#eee">
                                    <td colspan="4" style="color:#000;font-weight:500;" class="text-center">@monthRow</td>
                                </tr>

                                var record = Model.ActivitiesDetailsVM.MonthsOfYearsAnnualyWithDetails.FirstOrDefault(r => r.month == month);
                                var Details = record?.Details?.OrderBy(y => y.ActivityEndDate).ToList();

                                if (Details == null || Details.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted p-2">لا يوجد نشاط</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var detail in Details)
                                    {
                                        n++;
                                        <tr>
                                            <th style="background:#af1717 !important; color:#fff !important;">@n</th>
                                            @if (detail?.ActivityStartDate != null && detail?.ActivityEndDate != null)
                                            {
                                                duration += ((int)detail.ActivityEndDate.Value.Day -
                                                (int)detail.ActivityStartDate.Value.Day) + 1;
                                                <td>@(detail?.ActivityEndDate.Value.Day - @detail?.ActivityStartDate.Value.Day + 1)</td>
                                            }
                                            else
                                            {
                                                <td> - </td>
                                            }
                                            <td>@detail?.NumberOfParticipants</td>
                                            <td>@detail?.Reason</td>
                                        </tr>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="20" class="text-center p-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                        <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3">@Resource1.NoData</h5>
                                        <p class="mb-0">@Resource2.GoToCreatePage</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-semibold" style="background-color:#eee">
                            <td>@Resource2.Total</td>
                            <td>@duration</td>
                            <td>@Model?.ActivitiesDetailsVM?.MonthsOfYearsAnnualyWithDetails?.Sum(x => x.Details.Sum(d
                                                                => d.NumberOfParticipants ?? 0))</td>
                            <td>@Resource2.ActivtiesDetailsFooter</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        <div class="text-center mt-3">
            <h3 style="display:grid;place-items:center; font-size:16px !important; font-weight:bold;" class="mb-3 mt-4">
                @(ViewBag.selectedYear != null ? Resource2.ActivityReportChart + " " +
                                QuarterName + " " + Resource1.Theyear1 + " " + ViewBag.selectedYear + " " + Resource1.millad : " ")
            </h3>
        </div>
        <div class="graph">
            <canvas id="multiPie"></canvas>
            </div>
    
        <!-- Signature Section -->
            <div class="d-flex justify-content-end border-black border-top mt-3" style="padding-top: 20px; text-align:center;">
            <div class="flex-column align-items-center">
                <label class="form-label fw-bold text-black">@Resource1.Manager1 / <span>@Model.ManagerFullName</span></label>
                <label class="form-label fw-semibold"></label>
                @if (Model?.ManagerSignature != null)
                {
                    <div class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                        <div class="small text-muted">
                            @if (!string.IsNullOrEmpty(Model?.ManagerSignature.ImagePath))
                            {

                                            <img src="~/@Model?.ManagerSignature.ImagePath" class="img-fluid rounded"
                                                style="height:70px; max-width:100%" alt="Upload one" />
                                           
                            }
                        </div>
                    </div>
                }
                else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager && await
                PermissionScanner.CheckLoggedUserIfHasSignature())
                {
                    <div id="managerSignatureSection" class="signature-trigger" role="button" tabindex="0"
                        style="cursor:pointer;">
                        <div class="small text-muted">إضغط هنا للتوقيع</div>
                    </div>
                }
            </div>
        </div>

        <!-- OTP Modal: shared for both roles -->
        <div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="otpModalLabel">@Resource2.EnterOTP</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="otpForm">
                        <input type="hidden" id="otpEntityId" name="id" value="@Model?.Id" />
                        <input type="hidden" id="otpRole" name="role" value="" />
                        <div class="modal-body text-center">
                            <p>@Resource2.PleaseEnterOTPToConfirmSignature</p>
                            <div class="d-flex justify-content-center gap-2">
