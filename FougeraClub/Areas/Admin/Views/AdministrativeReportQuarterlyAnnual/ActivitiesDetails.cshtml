@using Application.Helpers
@using FougeraClub.Areas.Admin.ViewModels.AdministrativeReportQuarterlyAnnual
@using System.Globalization

@model QuartersReportActivitiesDetailsVM

@{
    var s = Enum.GetName(typeof(QuartersYear), ViewBag.quarter ?? 0);
    var QuarterName = " ";
    if (s != null)
        QuarterName = Resource1.ResourceManager.GetString(s, CultureInfo.CurrentUICulture);
    ViewData["Title pakage"] = @Resource1.MissionsManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.AdministrativeReportQuarterlyAnnual ?? " ";

    if (ViewBag.quarter == 5)
    {
        ViewData["Title"] = Resource1.Details2 + " " + Resource1.AdministrativeReportAnnual;
        ViewData["Title Single"] = Resource1.Details2 + " " + Resource1.AdministrativeReportAnnual;
        ViewData["Title Quarter"] = " ";
    }
    else
    {
        ViewData["Title"] = Resource2.QuarterlyActivityReportSummary + " - " + QuarterName;
        ViewData["Title Single"] = Resource2.QuarterlyActivityReportSummary + " - " + QuarterName;
    }

    var PrintDetailsPermission = PermissionScanner.ValidatePermission("AdministrativeReportQuarterlyAnnual",
    "ActivitiesDetails");

    var boolManagerSignature = Model?.ManagerSignature != null && !string.IsNullOrEmpty(Model.ManagerSignature.ImagePath);

    var titleLable = Resource2.ActivityReport + " " + QuarterName + " " + Resource2.Annual;


}
