                            data: @Html.Raw(Json.Serialize(Model?.MonthsOfYearsAnnualyActivitiesAndAdministrativeVM?.activities)),
                            backgroundColor: 'rgba(175, 23, 23, 0.6)', // Red
                            borderColor: 'rgba(175, 23, 23, 0.8)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1, // Only makes the gradient 1
                                precision: 0   // Prevents decimal numbers
                            }
                        }
                    }
                }
            });
            myChart.options.plugins = {
                        ...myChart.options.plugins,
                        legend: {
                            position: 'bottom',   // 👈 Keep the legend under the drawing
                            labels: {
                                boxWidth: 40,
                                boxHeight: 20,
                                padding: 60,   // 👈 Extra space between elements
                                font: {
                                    size: 16  // Legend font size
                                }
                            }
                        },
                        tooltip: {
                            bodyFont: {
                                size: 15  // tooltip font size
                            }
                        }
                    };

                        myChart.options.scales = {
                            x: {
                                ticks: {
                                    font: {
                                        size: 15  //X Axis font size
                                    }
                                }
                            },
                            y: {
                                ticks: {
