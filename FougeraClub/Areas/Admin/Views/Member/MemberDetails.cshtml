@using KhaledTeamRecycling.Areas.Admin.ViewModels.Member
@model MemberVM

@{
    ViewData["Title"] = @Resource2.MemberDetails ?? " ";
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.Members2 ?? " ";
    ViewData["Title Single"] = @Resource2.MemberDetails ?? " ";
}
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>

                <li class="breadcrumb-item"> <a href="/Admin/Member/Index">@ViewData["Title ListIndex"]</a> </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-end">
            <a asp-area="Admin"
               asp-controller="Member"
               asp-action="PrintDetails"
               asp-route-id="@Model?.Id"
               target="_blank"
               class="btn btn-success btn-sm">
                <i class="fa fa-print me-1"></i> @Resource2.Print
            </a>
        </div>
    </div>
</div>
<div class="card shadow-sm rounded-3 all-borders">
    <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start">
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-0">
                <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                    <span class="fa fa-edit me-2 text-ico"></span>
                    @ViewData["Title"]
                </h4>
            </div>
        </div>
        <div class="d-flex flex-column align-items-start gap-0">
            <div>
                <span class="small text-success">@Resource2.Code</span>
                <span class="">
                    @Model?.Code
                </span>
            </div>
            <div>
                <span class="small text-success">@Resource2.RegistrationDate</span>
                <span class="">
                    @Model?.RegistrationDate.ToString("dd MMM yyyy")
                </span>
            </div>
        </div>
    </div>
    <div class=" col-md-12 d-flex justify-content-center align-items-center flex-wrap mb-3 c-pro ">
        <div class="d-flex align-items-center gap-3 position-relative mt-2 mb-1">
            <div class="text-center">
                @if (!string.IsNullOrEmpty(Model?.ProfileImage_TempFilePath))
                {
                    <div class="img-hover">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#profileImageModal">
                            <i class="fas fa-eye icon-eye"></i>
                            <img src="~/@Model?.ProfileImage_TempFilePath.Replace("wwwroot/", "")"
                                 class="up-pic  object-fit-cover " alt="profile picture" id="preview" />
                        </a>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model?.ProfileImage_OldPath))
                {
                    <div class="img-hover">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#profileImageModal">
                            <i class="fas fa-eye icon-eye"></i>
                            <img src="~/@Model.ProfileImage_OldPath"
                                 class="up-pic  object-fit-cover " alt="profile picture" id="preview" />
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-center align-items-center up-pic ">
                        <i class="fa-solid fa-user text-muted"></i>
                    </div>
                }
                <div class="hidden">
                </div>
                <span class="d-block mb-1 text-red fs-6"> @Resource3.MaximumImageSize3MB </span>
            </div>
        </div>
    </div>
    <div class="container">
    <form @* asp-action="AddEdit" method="post" enctype="multipart/form-data" *@>
