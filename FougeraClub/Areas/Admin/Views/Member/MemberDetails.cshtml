                    if (Model?.GenderId?.ToString() == item.Value)
                    {           
                    var isChecked = Model?.GenderId?.ToString() == item.Value ? "checked" : "";
                    <div class="form-check form-check-inline mt-1">
                                <input class="form-check-input" type="radio" readonly disabled
                               name="GenderId"
                               id="gender_@item.Value"
                               value="@item.Value"
                               @(isChecked) />

                        <label class="form-check-label" for="gender_@item.Value">@item.Text</label>
                    </div>
                    }
                }
                <span asp-validation-for="GenderId" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
