</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('.select2').select2({
                allowClear: false,
                width: '100%'
            });
        });
    </script>
    <script>
        var nationalitiesOne = @Html.Raw(Json.Serialize(Model.NationalitiesOne));
        var nationalities = @Html.Raw(Json.Serialize(Model.Nationalities));
        var selectNationalityResourceText = "@Html.Raw((Resource2.SelectNationality))";
    </script>
    <script>
          function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
          document.addEventListener("DOMContentLoaded", function () {
              const dobInput = document.getElementById("DateOfBirth");
              const ageInput = document.getElementById("Age");

              const fatherWrapper = document.getElementById("fatherPhoneWrapper");
              const motherWrapper = document.getElementById("motherPhoneWrapper");
              const fatherPhone = document.getElementById("FatherPhone");
              const motherPhone = document.getElementById("MotherPhone");

              function calculateAge() {
                  const dob = new Date(dobInput.value);
                  if (!isNaN(dob)) {
                      const today = new Date();
                      let age = today.getFullYear() - dob.getFullYear();
                      const m = today.getMonth() - dob.getMonth();
                      if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) {
                          age--;
                      }

                      ageInput.value = age;

                      // Show/hide Father and Mother phone inputs based on age
                      const showGuardianFields = age < 18;
                      fatherWrapper.style.display = showGuardianFields ? "block" : "none";
                      motherWrapper.style.display = showGuardianFields ? "block" : "none";
                      fatherPhone.disabled = !showGuardianFields;
                      motherPhone.disabled = !showGuardianFields;

                      if (!showGuardianFields) {
                          fatherPhone.value = "";
                          motherPhone.value = "";
                      }
                  } else {
                      ageInput.value = '';
                      fatherWrapper.style.display = "none";
                      motherWrapper.style.display = "none";
                      fatherPhone.disabled = true;
                      motherPhone.disabled = true;
                      fatherPhone.value = "";
                      motherPhone.value = "";
                  }
              }

              dobInput.addEventListener("change", calculateAge);
              calculateAge(); // Initial run
          });

          document.addEventListener("DOMContentLoaded", function () {
            const professionRadios = document.querySelectorAll('input[name="ProfessionId"]');
            const professionWrapper = document.getElementById("professionWrapper");
            const ProfessionPlaceWrapper = document.getElementById("ProfessionPlaceWrapper");
            const guardianProfessionWrapper = document.getElementById("guardianProfessionWrapper");
            const professionInput = document.getElementById("Profession");
            const ProfessionPlaceInput = document.getElementById("ProfessionPlace");
            const guardianProfessionInput = document.getElementById("GuardianProfession");

            function toggleProfessionInputs() {
                const selected = document.querySelector('input[name="ProfessionId"]:checked');
                if (selected) {
                    if (selected.value === professionRadios[0].value) {
                        professionWrapper.style.display = "block";
                        ProfessionPlaceWrapper.style.display = "block";
                        guardianProfessionWrapper.style.display = "none";
                        guardianProfessionInput.value = ".";
                    } else if (selected.value === professionRadios[3].value) {
                        professionWrapper.style.display = "block";
                        ProfessionPlaceWrapper.style.display = "none";
                        guardianProfessionWrapper.style.display = "none";
                        guardianProfessionInput.value = ".";
                        ProfessionPlaceInput.value = ".";
                    } else if (selected.value === professionRadios[1].value) {
                        professionWrapper.style.display = "none";
                        ProfessionPlaceWrapper.style.display = "none";
                        guardianProfessionWrapper.style.display = "block";
                        professionInput.value = ".";
                        ProfessionPlaceInput.value = ".";
                    } else {
                        professionWrapper.style.display = "none";
                        ProfessionPlaceWrapper.style.display = "none";
                        guardianProfessionWrapper.style.display = "none";
                        professionInput.value = ".";
                        ProfessionPlaceInput.value = ".";
                        guardianProfessionInput.value = ".";
                    }
                }
            }

              professionRadios.forEach(radio => {
                  radio.addEventListener("change", toggleProfessionInputs);
              });

              toggleProfessionInputs(); // Initial run

                //////////////////////
                /////////////////////

                const nationalityDropdown = document.getElementById("NationalityId");
                const MemberTypeRadios = document.querySelectorAll('input[name="MemberTypeId"]');

                function fillDropdown(data) {

                    // مسح كل البيانات
                    nationalityDropdown.innerHTML = "";

                    // إضافة option الافتراضي
                    let defaultOption = document.createElement("option");
                    defaultOption.value = "";
                    defaultOption.textContent = selectNationalityResourceText;
                    nationalityDropdown.appendChild(defaultOption);

                    // إضافة البيانات الجديدة
                    data.forEach(item => {
                        let option = document.createElement("option");
                        option.value = item.value;
                        option.textContent = item.text;
                        nationalityDropdown.appendChild(option);
                    });

                    // تصفير الاختيار
                    nationalityDropdown.value = "";
                }

                function ChangedMemberType() {

                    let selected = document.querySelector('input[name="MemberTypeId"]:checked');

                    if (!selected) return;

                    if (selected.value === MemberTypeRadios[0].value) {
                        console.log("Member Selected");

                        fillDropdown(nationalitiesOne);
                        //$('#NationalityId').prop('disabled', true);

                        let $ddl = $('#NationalityId');

                        // تعطيل الدروب داون
                        $ddl.prop('disabled', true);

                        // اختيار ثاني عنصر (index = 1)
                        $ddl.prop('selectedIndex', 1).trigger('change');

                    } else if (selected.value === MemberTypeRadios[1].value) {
                        console.log("Sub Selected");
                        let $ddl = $('#NationalityId');
                        // تفعيل
                        $ddl.prop('disabled', false);

                        // حفظ القيمة الحالية
                        let selectedNat = $('#NationalityIdOld').val();
                        console.log({selectedNat});
                        // إعادة تعبئة
                        fillDropdown(nationalities);

                        // لو القيمة القديمة موجودة في الجديد رجّعها
                        if ($ddl.find(`option[value="${selectedNat}"]`).length > 0) {
                            $ddl.val(selectedNat);
                        } else {
                            // لو مش موجودة اختار أول عنصر حقيقي
                            if ($ddl.find('option').length > 1) {
                                $ddl.prop('selectedIndex', 1);
                            }
                        }

                        $ddl.trigger('change');
                    }
                }

                MemberTypeRadios.forEach(radio => {
                    radio.addEventListener("change", ChangedMemberType);
                });

                ChangedMemberType();

                $('form').on('submit', function () {
                    $('#NationalityId').prop('disabled', false);
                });
                ////////////
                /////////////
          });

        // ===================================================================
              const ProfileImage = document.getElementById('ProfileImage');
          const preview = document.getElementById('preview');


            ProfileImage.addEventListener('change', function() {
              const file = this.files[0];
              if (file) {
                  const reader = new FileReader();
                  reader.onload = function(event) {
                      preview.src = event.target.result;
                      preview.style.display = 'block';

                  }
                  reader.readAsDataURL(file);
              } else {
                  preview.src = '';
                  preview.style.display = 'none';

              }
          });

    </script>
}
