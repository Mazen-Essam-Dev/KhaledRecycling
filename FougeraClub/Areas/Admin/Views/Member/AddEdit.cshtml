@using KhaledTeamRecycling.Areas.Admin.ViewModels.Member
@model MemberVM

@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = (isEdit ? Resource2.EditMember : Resource2.CreateMember) ?? " ";
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.Members2 ?? " ";
    ViewData["Title Single"] = (isEdit ? Resource2.EditMember : Resource2.CreateMember) ?? " ";
}
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-start" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>

                <li class="breadcrumb-item"> <a href="/Admin/Member/Index">@ViewData["Title ListIndex"]</a> </li>

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    @* <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-end">
            <a asp-area="Admin"
               asp-controller="Member"
               asp-action="PrintDetails"
               asp-route-id="@Model?.Id"
               target="_blank"
               class="btn btn-success btn-sm">
                <i class="fa fa-print me-1"></i> @Resource2.Print
            </a>
        </div>
    </div> *@
</div>
<div class="card shadow-sm rounded-3 all-borders">
    <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start">
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-0">
                <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                    <span class="fa fa-edit me-2 text-ico"></span>
                    @ViewData["Title"]
                </h4>
            </div>
        </div>
        <div class="d-flex flex-column align-items-start gap-0">
            <div>
                <span class="small text-success">@Resource2.Code</span>
                <span class="">
                    @Model?.Code
                </span>
            </div>
            <div>
                <span class="small text-success">@Resource2.RegistrationDate</span>
                <span class="">
                    @Model?.RegistrationDate.ToString("dd MMM yyyy")
                </span>
            </div>
        </div>
    </div>
    <div class=" col-md-12 d-flex justify-content-center align-items-center flex-wrap mb-3 c-pro ">
        <div class="d-flex align-items-center gap-3 position-relative mt-2 mb-1">
            <div class="text-center">
                @if (!string.IsNullOrEmpty(Model?.ProfileImage_TempFilePath))
                {
                    <div class="img-hover">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#profileImageModal">
                            <i class="fas fa-eye icon-eye"></i>
                            <img src="~/@Model?.ProfileImage_TempFilePath.Replace("wwwroot/", "")"
                                 class="up-pic  object-fit-cover " alt="profile picture" id="preview" />
                        </a>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model?.ProfileImage_OldPath))
                {
                    <div class="img-hover">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#profileImageModal">
                            <i class="fas fa-eye icon-eye"></i>
                            <img src="~/@Model.ProfileImage_OldPath"
                                 class="up-pic  object-fit-cover " alt="profile picture" id="preview" />
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-center align-items-center up-pic ">
                        <i class="fa-solid fa-user text-muted"></i>
                    </div>
                }
                <div class="p-image">
                    <label asp-for="ProfileImage"><i class="fa-solid fa-edit cursor-pointer"></i></label>
                </div>
                <span class="d-block mb-1 text-red fs-6"> @Resource3.MaximumImageSize3MB </span>
            </div>
        </div>
    </div>
    <div class="container">
    <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input asp-for="Id" hidden />
            <input asp-for="IdImage_TempFilePath" hidden />
            <input asp-for="Passport_TempFilePath" hidden />
            <input asp-for="ProfileImage_TempFilePath" hidden />
            <input asp-for="IdImage_OldPath" hidden />
            <input asp-for="Passport_OldPath" hidden />
            <input asp-for="ProfileImage_OldPath" hidden />
            <input asp-for="Code" hidden type="number" class="form-control" placeholder="@Resource2.Code" />
        <div class="row">
            <div class="col-md-12">
                <div class="text-left sec-title">
                    <div class="lg-title">
                        <h1>@Resource1.BasicData</h1>
                    </div>
                    <div class="title-sep-left"></div>
                    <div class="title-sep-sm-left"></div>
                </div>
            </div>
            </div>
            <div class="c-edit-form mb-3">
            <div class="row g-3 ">
            <div class="col-md-3">
                        <label asp-for="FullNameAr" class="form-label asteriskRequired">@Resource1.MemberNameAr</label>
                        <input asp-for="FullNameAr" class="form-control " placeholder="@Resource1.MemberNameAr" />
                <span asp-validation-for="FullNameAr" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                        <label asp-for="FullNameEn" class="form-label asteriskRequired">@Resource1.MemberNameEn</label>

                    <input asp-for="FullNameEn" class="form-control " placeholder="@Resource1.MemberNameEn" />
                <span asp-validation-for="FullNameEn" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="NationalityId" class="form-label asteriskRequired">@Resource2.Nationality</label>
                <select asp-for="NationalityId" id="NationalityId" name="NationalityId" class="form-select select2">
                    <option value="">@Resource2.SelectNationality</option>
                </select>
                <span asp-validation-for="NationalityId" class="text-danger small"></span>
            </div>
            <input hidden name="NationalityIdOld" id="NationalityIdOld" value="@Model.NationalityId" />
            
            <div class="col-md-3">
                        <label class="form-label d-block asteriskRequired">@Resource2.Gender</label>
                @foreach (var item in Html.GetEnumSelectList<Gender>() ?? Enumerable.Empty<SelectListItem>())
                {
                    var isChecked = Model?.GenderId?.ToString() == item.Value ? "checked" : "";
                    <div class="form-check form-check-inline mt-1">
                        <input class="form-check-input" type="radio"
                               name="GenderId"
                               id="gender_@item.Value"
                               value="@item.Value"
                               @(isChecked) />

                        <label class="form-check-label" for="gender_@item.Value">@item.Text</label>
                    </div>
                }
                <span asp-validation-for="GenderId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="mb-2 d-block form-label asteriskRequired">@Resource2.Type</label>
                    @foreach (var item in Html.GetEnumSelectList<MemberTypeEnum>() ?? Enumerable.Empty<SelectListItem>())
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input"
                                    type="radio"
                                    name="MemberTypeId"
                                    id="MemberType_@item.Value"
                                    value="@item.Value"
                                    @(Model.MemberTypeId?.ToString() == item.Value ? "checked" : "") />
                            <label class="form-check-label" for="MemberType_@item.Value">
                                @item.Text
                            </label>
                        </div>
                    }
                <span asp-validation-for="MemberTypeId" class="text-danger small"></span>
            </div>
                    <div class="col-md-3 filter-dropdown">
                        <label asp-for="DateOfBirth" class="form-label asteriskRequired ">@Resource2.DateOfBirth</label>
                  <div class="input-icon-left">
                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                            <input asp-for="DateOfBirth" type="date" class="form-control green-border form-control-sm filter-bordered" id="DateOfBirth" placeholder="@Resource2.DateOfBirth" max="@AppDubaiTime.Now.AddDays(-1).ToString("yyyy-MM-dd")" />
                   </div>
                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                        <label asp-for="Age" class="form-label  asteriskRequired">@Resource2.Age</label>
                <input asp-for="Age" readonly type="number" class="form-control " id="Age" placeholder="@Resource2.Age" />
                <span asp-validation-for="Age" class="text-danger small"></span>
            </div>

            <div class="col-md-3" id="fatherPhoneWrapper" style="display: none;">
                        <label asp-for="FatherPhone" class="form-label asteriskRequired"> @Resource2.FatherPhone</label>

                <input asp-for="FatherPhone" class="form-control" inputmode="numeric" pattern="\d*" oninput="this.value=this.value.replace(/\D/g,'')" placeholder="@Resource1.PhonePlaceholder_10" />
                <span asp-validation-for="FatherPhone" class="text-danger small"></span>
            </div>

            <div class="col-md-3" id="motherPhoneWrapper" style="display: none;">
                        <label asp-for="MotherPhone" class="form-label asteriskRequired">@Resource2.MotherPhone</label>

                <input asp-for="MotherPhone" class="form-control" inputmode="numeric" pattern="\d*" oninput="this.value=this.value.replace(/\D/g,'')" placeholder="@Resource1.PhonePlaceholder_10" />
                <span asp-validation-for="MotherPhone" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                        <label asp-for="PhoneNumber" class="form-label asteriskRequired">@Resource1.PhoneNumber</label>
                <input asp-for="PhoneNumber" class="form-control" inputmode="numeric" pattern="\d*" oninput="this.value=this.value.replace(/\D/g,'')" placeholder="@Resource1.PhonePlaceholder_10" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                        <label asp-for="CityId" class="form-label asteriskRequired">@Resource2.City</label>
                @{ if ((Model?.CityId == null || Model.CityId == 0) && !isEdit) { Model.CityId = 24; } }
                <select asp-for="CityId" class="form-select" asp-items="Model?.CitiesList">
                    <option value="">-- @Resource2.SelectCity --</option>
                </select>
                <span asp-validation-for="CityId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                        <label class="form-label d-block asteriskRequired">@Resource2.Profession</label>
                @foreach (var item in Html.GetEnumSelectList<Profession>() ?? Enumerable.Empty<SelectListItem>())
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ProfessionId" id="profession_@item.Value"
                               value="@item.Value" @(Model.ProfessionId?.ToString() == item.Value ? "checked" : "") />
                        <label class="form-check-label" for="profession_@item.Value">@item.Text</label>
                    </div>
                }
                <span asp-validation-for="ProfessionId" class="text-danger small"></span>
            </div>
            <div class="col-md-9" id="guardianProfessionWrapper" style="display: none;">
                        <label asp-for="GuardianProfession" class="form-label asteriskRequired">@Resource1.FatherProfession</label>

                    <input asp-for="GuardianProfession" class="form-control " id="GuardianProfession" placeholder="@Resource1.FatherProfession" />
                <span asp-validation-for="GuardianProfession" class="text-danger small"></span>
            </div>

            <!-- Profession (User Job) — shown only if first option is selected -->
            <div class="col-md-3" id="professionWrapper" style="display: none;">
                        <label asp-for="Profession" class="form-label asteriskRequired">@Resource2.Profession</label>
                <input asp-for="Profession" class="form-control" id="Profession" />
                <span asp-validation-for="Profession" class="text-danger small"></span>
            </div>

            <div class="col-md-6" id="ProfessionPlaceWrapper" style="display: none;">
                        <label asp-for="ProfessionPlace" class="form-label asteriskRequired">@Resource1.WorkLocation</label>
                <input asp-for="ProfessionPlace" class="form-control" id="ProfessionPlace" />
                <span asp-validation-for="ProfessionPlace" class="text-danger small"></span>
            </div>

            <div class="col-md-12">
                        <label asp-for="Address" class="form-label asteriskRequired">@Resource2.Address</label>
                <textarea asp-for="Address" class="form-control" placeholder="@Resource2.Address" rows="3"></textarea>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
        </div>
            </div>




        <div class="row g-3">
      <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.IdInfo</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>

                </div>
            </div>

                <div class="c-edit-form mb-3">
                    <div class="row g-3">

            <div class="col-md-6">
                        <label asp-for="IdNumber" class="form-label asteriskRequired">@Resource1.IdNumber1</label>
                <input asp-for="IdNumber" class="form-control " placeholder="@Resource1.IdNumber1" />
                <span asp-validation-for="IdNumber" class="text-danger small"></span>
            </div>

                    <div class="col-md-6 filter-dropdown">
                        <label asp-for="IdExpiryDate" class="form-label asteriskRequired">@Resource2.IdExpiryDate</label>
                        <div class="input-icon-left">
                            <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                            <input asp-for="IdExpiryDate" type="date" class="form-control green-border form-control-sm filter-bordered valid" placeholder="@Resource2.IdExpiryDate" />
                        </div>
                <span asp-validation-for="IdExpiryDate" class="text-danger small"></span>
            </div>
 </div>
 </div>








            <div class="row g-3">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.Qualifications</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>

                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">

            <div class="col-md-6">
                        <label asp-for="AcademicQualification" class="form-label asteriskRequired">@Resource2.AcademicQualification</label>
                <input asp-for="AcademicQualification" class="form-control" placeholder="@Resource2.AcademicQualification" />
                <span asp-validation-for="AcademicQualification" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                        <label asp-for="EducationInstitution" class="form-label asteriskRequired">@Resource2.EducationInstitution</label>
                <input asp-for="EducationInstitution" class="form-control" placeholder="@Resource2.EducationInstitution" />
                <span asp-validation-for="EducationInstitution" class="text-danger small"></span>
            </div>


            <div class="col-md-6">
                        <label asp-for="Hobby" class="form-label asteriskRequired">@Resource2.Hobby</label>
                <textarea asp-for="Hobby" class="form-control" placeholder="@Resource2.Hobby" rows="3"></textarea>
                <span asp-validation-for="Hobby" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                        <label asp-for="Languages" class="form-label asteriskRequired">@Resource2.LanguagesYouSpeak</label>
                <textarea asp-for="Languages" class="form-control" placeholder="@Resource2.Languages" rows="3"></textarea>
                <span asp-validation-for="Languages" class="text-danger small"></span>
            </div>
        </div>
            </div>



            <div class="row g-3">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.SocialMedia</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>

                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">

            <div class="col-md-4">
                <label asp-for="Facebook" class="form-label">@Resource2.Facebook</label>
                <input asp-for="Facebook" class="form-control" placeholder="@Resource2.Facebook" />
                <span asp-validation-for="Facebook" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Xplatform" class="form-label">@Resource2.Xplatform</label>
                <input asp-for="Xplatform" class="form-control" placeholder="@Resource2.Xplatform" />
                <span asp-validation-for="Xplatform" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Instagram" class="form-label">@Resource2.Instagram</label>
                <input asp-for="Instagram" class="form-control" placeholder="@Resource2.Instagram" />
                <span asp-validation-for="Instagram" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                        <label class="form-label d-block">@Resource2.HeardBy</label>
                @foreach (var item in Html.GetEnumSelectList<HeardBySources>() ?? Enumerable.Empty<SelectListItem>())
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="HeardBy" id="heardby_@item.Value"
                               value="@item.Value" @(Model.HeardBy?.ToString() == item.Value ? "checked" : "") />
                                <label class="form-check-label text-black fw-normal" for="heardby_@item.Value">@item.Text</label>
                    </div>
                }

                <span asp-validation-for="HeardBy" class="text-danger small"></span>
                <!-- Hidden input to submit the selected GenderId value -->
                <input type="hidden" asp-for="HeardBy" value="@Model?.HeardBy" />

            </div>

            <div class="col-md-8">
                <input type="hidden" name="License" id="LicenseHidden" value="false" />

                        <div class="form-check form-check-inline mt-3">
                    <!-- Checkbox shown to the user -->
                            <input class="form-check-input" type="checkbox" 
                           id="License"
                           value="true"
                           @(Model.License.Value ? "checked" : "") />

                            <label class="form-check-label text-black fw-normal" for="License">
                        @Resource2.LicensePhotographSocialMedia
                    </label>
                </div>

                <span asp-validation-for="License" class="text-danger small d-block"></span>
            </div>
        </div>
            </div>
            <div class="row g-3">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.LoginData</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>

                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
            <div class="col-md-12">
                        <label asp-for="Email" class="form-label asteriskRequired">@Resource2.Email</label>
                <input asp-for="Email" class="form-control" placeholder="@Resource2.Email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <div class="position-relative">
                            <label asp-for="Password" class="form-label asteriskRequired">@Resource2.NewPassword &nbsp;&nbsp;  <span class="text-danger small fs-6"> ( @Resource1.PasswordShouldBe3 )</span>  </label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control" type="password" id="Password" />
                                <button type="button" class="btn btn-outline-primary"
                                onclick="togglePassword('Password', this)">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Password" class="text-danger small"></span>

                </div>
            </div>

            <div class="col-md-6">
                <div class="position-relative">
                            <label asp-for="ConfirmPassword" class="form-label asteriskRequired">@Resource2.ConfirmNewPassword</label>

                    <div class="input-group">
                        <input asp-for="ConfirmPassword" class="form-control" type="password" id="ConfirmPassword" />
                                <button type="button" class="btn btn-outline-primary"
                                onclick="togglePassword('ConfirmPassword', this)">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
                </div>
            </div>




            <div class="row g-3">
                <div class="col-md-12">
                    <div class="text-left sec-title">
                        <div class="lg-title">
                            <h1>@Resource2.AttachedFiles</h1>
                        </div>
                        <div class="title-sep-left"></div>
                        <div class="title-sep-sm-left"></div>
                    </div>

                </div>
            </div>

            <div class="c-edit-form mb-3">
                <div class="row g-3">
            <!-- Profile Image Section -->
            <div class="col-md-4 d-none ">
                <div class="mb-3">
                    <div class="input-group mb-3  d-flex align-items-center">
                        <input asp-for="ProfileImage" type="file" class="form-control rounded-2 d-none" accept=".jpg,.jpeg,.png">

                    </div>
                    <div>
                        <span class="d-inline-block mb-1 text-red"> @Resource3.MaximumImageSize3MB </span>
                    </div>
                    <span asp-validation-for="ProfileImage" class="text-danger small"></span>
                </div>
            </div>

            <!-- ID Image Section -->
            <div class="col-md-6 ">
                <div class="mb-3">

                    <div class="input-group mb-3  d-flex align-items-center">
                        <input asp-for="IdImage" type="file" class="form-control rounded-2 " accept=".jpg,.jpeg,.png">
                        <label asp-for="IdImage" class="upload-file-rtl upload-file-ltr rounded-2 upload-file-hover"><i class="fa-solid fa-upload fa-xl"></i></label>
                    </div>

                    @if (!string.IsNullOrEmpty(Model?.IdImage_OldPath) || !string.IsNullOrEmpty(Model?.IdImage_TempFilePath))
                    {
                            <a href="#" data-bs-toggle="modal" data-bs-target="#idImageModal" class="eye-ii d-flex justify-content-start align-items-center gap-1">
                            <i class="fa fa-eye"></i>
                                <span class="text-black">
                                @Resource2.IdImage
                            </span>
                        </a>
                    }
                    <div>
                        <span class="d-inline-block mb-1 text-red"> @Resource3.MaximumImageSize3MB </span>

                    </div>
                    <span asp-validation-for="IdImage" class="text-danger small"></span>
                </div>
            </div>

            <!-- Passport Image Section -->
            <div class="col-md-6">
                <div class="mb-3">

                    <div class="input-group mb-3  d-flex align-items-center">
                        <input asp-for="PassportImage" type="file" class="form-control rounded-2 " accept=".jpg,.jpeg,.png">
                        <label asp-for="PassportImage" class="upload-file-rtl upload-file-ltr rounded-2 upload-file-hover"><i class="fa-solid fa-upload fa-xl"></i></label>
                    </div>

                    @if (!string.IsNullOrEmpty(Model?.Passport_OldPath) || !string.IsNullOrEmpty(Model?.Passport_TempFilePath))
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#passportImageModal" class="eye-ii d-flex justify-content-start align-items-center gap-1">
                            <i class="fa fa-eye"></i>
                            <span class="text-black">
                                @Resource2.PassportImage
                            </span>
                        </a>
                    }

                    <div>
                        <span class="d-inline-block mb-1 text-red"> @Resource3.MaximumImageSize3MB </span>
                    </div>
                    <span asp-validation-for="PassportImage" class="text-danger small"></span>
                </div>
            </div>

                    @if (!string.IsNullOrEmpty(Model?.ProfileImage_TempFilePath))
                    {
                        <div class="modal fade" id="profileImageModal" tabindex="-1" aria-labelledby="profileImageLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">@Resource2.ProfileImage</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Resource1.Close1"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <img src="~/@Model.ProfileImage_TempFilePath.Replace("wwwroot/", "")" class="img-fluid" alt="@Resource1.Photo" />
                                    </div>

                                </div>
                            </div>
                        </div>

                    }
                    else if (isEdit && !string.IsNullOrEmpty(Model?.ProfileImage_OldPath))
                    {
                        <div class="modal fade" id="profileImageModal" tabindex="-1" aria-labelledby="profileImageLabel" aria-hidden="true">
