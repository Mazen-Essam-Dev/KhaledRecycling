@model IQueryable<LogsVM>
@using Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using System.Globalization
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null; // No layout for print view
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "Unknown User";
    var lang = SessionHelper.GetCurrentLanguage();
    var allMembersName = ViewBag.allMembersName as IEnumerable<SelectListItem>;


    var culture_ar = new CultureInfo("ar"); // ex: "ar" أو "en"
    var culture_en = new CultureInfo("en-GB"); // ex: "ar" أو "en"

    var PerformedAnOperation_Ar = (Resource2.ResourceManager.GetString("PerformedAnOperation", culture_ar));
    var InPage_Ar = (Resource2.ResourceManager.GetString("InPage", culture_ar));
    var PerformedAnOperation_En = (Resource2.ResourceManager.GetString("PerformedAnOperation", culture_en));
    var InPage_En = (Resource2.ResourceManager.GetString("InPage", culture_en));
}

<head>
    <meta charset="utf-8">
    <title></title>
    @if (SessionHelper.GetCurrentLanguage() == "ar")
    {
        <link href="~/ar/assets/css/report-rtl.css" rel="stylesheet" />
    }
    else
    {
        <link href="~/ar/assets/css/report-ltr.css" rel="stylesheet" />
    }
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/css/prints/report.css" rel="stylesheet">
    <style>
        @@media print {


            #report thead th {
                background-color: #47A644 !important;
                color: white !important;
                border-color: #c4c1c1 !important;
            }
        }
    </style>
</head>


<div id="report">
    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@Resource1.Loading..</span>
        </div>
        <p class="loading-text">@Resource1.TheReportIsLoadingpleasewait..</p>
    </div>

    <!-- Official Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap border-black  border-bottom p-3  mb-3">
        <div class="d-flex justify-content-between align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
            </div>
        </div>
        <div class="flex-fill text-center">
            <center>
                <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
            </center>
        </div>
        <div class="d-flex justify-content-end align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
            </div>
        </div>
    </div>


    <div class="container">
        <div class="header">
            <h2 class="text-danger">@Resource1.LogHistorys1</h2>
            @* <p class="text-muted"> @AppDubaiTime.Now.ToString("HH:mm d", System.Globalization.CultureInfo.InvariantCulture)</p> *@
        </div>


        <div class="table-responsive">
            <table class="table table-bordered ">
                <thead>
                    <tr>
                        <th>@Resource2.Username</th>
                        <th>@Resource2.Type</th>
                        <th>@Resource1.Date</th>
                        <th>@Resource1.Time</th>
                        <th style="min-width: 600px !important;">@Resource2.Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                @* Employee Name *@
                                @{
                                    if (string.IsNullOrEmpty(log.UserFullName))
                                    {
                                        var memberName = allMembersName?.Where(mem => mem.Value.ToString() == log.UserId).FirstOrDefault()?.Text;
                                        log.UserFullName = !string.IsNullOrEmpty(memberName) ? memberName : (Resource1.NotFoundNow ?? "Not Found");
                                    }
                                }
                                <td data-label="@Resource2.Username">
                                    <span class="fw-medium">@log.UserFullName</span>
                                </td>
                                <td data-label="@Resource2.Type">
                                    @{
                                        var userKindLabel = "";
                                        if (log.UserKind == "Member")
                                        {
                                            userKindLabel = Resource1.member ?? "Member";
                                        }
                                        else
                                        {
                                            userKindLabel = lang == "ar" ? "مستخدم نظام" : "System User";
                                        }
                                    }
                                    <span>@userKindLabel</span>
                                </td>
                                <td data-label="@Resource1.Date">
                                    <span>@log.RequestTime.Date.ToString("yyyy-MMMM-dd")</span>
                                </td>
                                <td data-label="@Resource1.Time">
                                    <span>@log.RequestTime.ToString("hh:mm:ss tt")</span>
                                </td>
                                @* @{
                                    var key = log.Controller + "s";
                                    if (log.Controller.Contains("."))
                                    {
                                        key = log.Controller.Substring(0, log.Controller.IndexOf('.'));
                                    }

                                    var controllerNameResource =
                                    string.IsNullOrEmpty(Resource2.ResourceManager.GetString(key))
                                    ? Resource1.ResourceManager.GetString(key)
                                    : Resource2.ResourceManager.GetString(key);

                                    if (string.IsNullOrEmpty(controllerNameResource))
                                    {
                                        controllerNameResource =
                                        string.IsNullOrEmpty(Resource1.ResourceManager.GetString(log.Controller))
                                        ? Resource2.ResourceManager.GetString(log.Controller)
                                        : Resource1.ResourceManager.GetString(log.Controller);
                                    }
                                }
                                <td style="text-align: center;" data-label="@Resource1.Process">
                                    @Resource2.PerformedAnOperation
                                    @{
                                        var actionText = Resource2.ResourceManager.GetString(log.Action) ??
                                        Resource1.ResourceManager.GetString(log.Action);
                                    }
                                    @if (!string.IsNullOrEmpty(log.LogTarget))
                                    {
                                        <span class="fw-bold">@(actionText ?? log.Action) (@log.LogTarget)</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold">@(actionText ?? log.Action)</span>
                                    }
                                    @Resource2.InPage
                                    <span class="fw-bold">@(controllerNameResource ?? log.Controller)</span>
                                </td> *@


                                <td class="fw-bold" style="text-align: center;" data-label="@Resource1.Process">

                                        @Html.Raw(
                                        ((lang == "ar") ? log.NameAr : log.NameEn)
                                        ?.Replace(@InPage_En ?? "__", $"<span style='font-weight:normal;'>{InPage_En}</span>")
                                        ?.Replace(@PerformedAnOperation_En ?? "__", $"<span style='font-weight:normal;'>{PerformedAnOperation_En}</span>")
                                        ?.Replace(@InPage_Ar ?? "__", $"<span style='font-weight:normal;'>{InPage_Ar}</span>")
                                        ?.Replace(@PerformedAnOperation_Ar ?? "__", $"<span style='font-weight:normal;'>{PerformedAnOperation_Ar}</span>")
                                                        )
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center p-5">
                                <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                    <i class="ri-alert-line" style="font-size: 3rem;"></i>
                                    <h5 class="mt-3">@Resource1.No_results_found</h5>
                                    <p class="mb-0">@Resource1.No_results_found</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr style="border: none;">
                        <td colspan="2" style="min-height:300px !important;border: none !important;">
                            <div class="footer-container" id="footer-container" style="color: rgba(0, 0, 0, 0) !important;">
                                <div class="footer-top" id="footer-top">
                                    <div class="right">Time: </div>
                                    <div class="center" style="color: rgba(0, 0, 0, 0) !important;">Date: </div>
                                    <div class="left">Printed by: </div>
                                </div>

                                <div class="footer-bottom" id="footer-bottom">
                                    @Resource1.FujairahPrintFooter © @AppDubaiTime.Now.ToString("yyyy")
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>

            </table>

            <div class="print-footer">
                <div class="footer-top">
                    <div class="right">Time: @AppDubaiTime.Now.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
                    <div class="center">Date: @AppDubaiTime.Now.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                    <div class="left">
                        Printed by:
                        @((currentUserName.IndexOf("@") > 1) ? currentUserName.Substring(0, currentUserName.IndexOf("@")) : currentUserName)
                    </div>
                </div>
                <hr class="footer-line">
                <div class="footer-bottom">
                    @Resource1.FujairahPrintFooter © @AppDubaiTime.Now.ToString("yyyy")
                </div>
            </div>


            <div class="text-center no-print mt-3">
                <button class="btn btn-primary" onclick="window.print()">طباعة التقرير</button>
                <button class="btn btn-danger ms-2" onclick="window.close()">إغلاق النافذة</button>
            </div>
    </div>

    <script>

        // This Part Is Important
        window.addEventListener('load', () => {
            setTimeout(() => document.getElementById('loadingOverlay').style.display = 'none', 500);
            setTimeout(() => window.print(), 800);
        });
        // Close window after printing
        window.onafterprint = function () {
            setTimeout(function () {
                window.close();
            }, 500);
        };
    </script>
</div>