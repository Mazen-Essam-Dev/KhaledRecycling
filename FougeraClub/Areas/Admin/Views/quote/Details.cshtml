                                <td class="text-center">@item.ItemName</td>
                                <td class="text-center supplier-name">@item.SupplierName</td>
                                <td class="text-center item-qty">@item.Quantity</td>
                                <td class="text-center item-price">
                                    @if (Model.IsConfirmed)
                                    {
                                        <span class="price-display">@price.ToString("0.00")</span>
                                        <input type="number" step="0.01" min="0"
                                               class="form-control form-control-sm price-input text-center"
                                               value="@price.ToString("0.00")"
                                               style="display:none; width:100px; margin:auto;" />
                                    }
                                    else
                                    {
                                        <span>@price.ToString("0.00")</span>
                                    }
                                </td>
                                <td class="text-center item-total">@totalRecord.ToString("0.00")</td>                               
                            </tr>
                            index++;
                            itemIndex++;
                        }
                    }

                    // Unassigned items
                    var unassignedItems = Model.Items.Where(i => i.SupplierId == null).ToList();
                    if (unassignedItems.Any())
                    {
                        foreach (var item in unassignedItems)
                        {
                            var price = item.SinglePrice ?? 0;
                            var quantity = item.Quantity ?? 0;
                            decimal totalRecord = price * quantity;
                            <tr class="item-row unassigned-row" data-supplier-id="" data-item-id="@item.ItemId">
                                <td class="bg-yellow text-center">@(index + 1)</td>
                                <td>@item.ItemName</td>
