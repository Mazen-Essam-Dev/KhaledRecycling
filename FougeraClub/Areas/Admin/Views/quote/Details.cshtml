        // ──────── Create Initial Materials If Empty ────────
        function createInitialMaterialsIfEmpty() {
            // Check if there are any items left (assigned or unassigned)
            const hasAnyItems = items.length > 0;
            
            if (!hasAnyItems) {
                // Create initial unassigned materials from the base items
                // Use the base items that don't have suppliers assigned as template
                const baseItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Items?.Where(i => i.SupplierId == null).Select(i => new SupplierAssignmentItemVM { 
                    ItemId = i.ItemId, 
                    ItemName = i.ItemName, 
                    Quantity = i.Quantity, 
                    SupplierId = null, 
                    SupplierName = null, 
                    SinglePrice = i.SinglePrice, 
                    ItemSupplierIsConfirmed = false 
                }) ?? new List<SupplierAssignmentItemVM>()));
                
                if (baseItems && baseItems.length > 0) {
                    baseItems.forEach(baseItem => {
                        items.push({
                            ItemId: baseItem.itemId,
                            ItemName: baseItem.itemName,
                            Quantity: baseItem.quantity,
                            SupplierId: null,
                            SupplierName: null,
                            SinglePrice: baseItem.singlePrice || 0,
                            ItemSupplierIsConfirmed: false
                        });
                    });
                }
            }
        }

        // ──────── Initial Render ────────
        // Initialize with base materials if no items exist
        createInitialMaterialsIfEmpty();
        renderTable();
    });
