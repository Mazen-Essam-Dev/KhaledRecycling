@section Scripts{

<script>
    function printDiv(divId) {
      window.print();
      document.body.innerHTML = originalPage;
      location.reload();
    }
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        (function () {
            const otpModalEl = document.getElementById('otpModal');
            if (!otpModalEl) return;

            const otpModal = new bootstrap.Modal(otpModalEl, { backdrop: 'static', keyboard: false });
            const otpDigits = Array.from(otpModalEl.querySelectorAll('.otp-digit')).reverse(); // reverse for RTL
            const otpForm = document.getElementById('otpForm');
            const otpInvalid = otpModalEl.querySelector('.invalid-feedback');

            // Navigate between OTP inputs
            otpDigits.forEach((input, index) => {
                input.addEventListener('input', (e) => {
                    e.target.value = e.target.value.replace(/\D/g, ''); // digits only
                    if (e.target.value && index < otpDigits.length - 1) {
                        otpDigits[index + 1].focus(); // move left in RTL
                    }
                });

                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && !input.value && index > 0) {
                        otpDigits[index - 1].focus();
                    }
                });
            });

            // Reset inputs on modal show
            otpModalEl.addEventListener('shown.bs.modal', () => {
                otpDigits.forEach(i => i.value = '');
                otpDigits[0].focus();
                otpInvalid.style.display = 'none';
                otpDigits.forEach(d => d.classList.remove('is-invalid'));
            });

            // Function to open OTP modal for a given role
            function openOtpModal(role) {
                document.getElementById('otpRole').value = role;
                fetch('/Admin/MaterialOrder/SendOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        otpModal.show();
                    } else {
                        alert('Failed to send OTP.');
                    }
                })
                .catch(err => console.error('Error sending OTP:', err));
            }

            // Supervisor signature trigger
            const supervisorSignatureSection = document.getElementById('supervisorSignatureSection');
            if (supervisorSignatureSection) {
                supervisorSignatureSection.addEventListener('click', () => openOtpModal('Supervisor'));
                supervisorSignatureSection.addEventListener('keypress', e => {
                if (e.key === 'Enter' || e.key === ' ') { supervisorSignatureSection.click(); e.preventDefault(); }
                });
            }

            // Accountant signature trigger
            const accountantSignatureSection = document.getElementById('accountantSignatureSection');
            if (accountantSignatureSection) {
                accountantSignatureSection.addEventListener('click', () => openOtpModal('Accountant'));
                accountantSignatureSection.addEventListener('keypress', e => {
                if (e.key === 'Enter' || e.key === ' ') { accountantSignatureSection.click(); e.preventDefault(); }
                });
            }

            // Secetary signature trigger
            const secetarySignatureSection = document.getElementById('secetarySignatureSection');
            if (secetarySignatureSection) {
                secetarySignatureSection.addEventListener('click', () => openOtpModal('Secetary'));
                secetarySignatureSection.addEventListener('keypress', e => {
                if (e.key === 'Enter' || e.key === ' ') { secetarySignatureSection.click(); e.preventDefault(); }
                });
            }

                // Manager signature trigger
                const managerSignatureSection = document.getElementById('managerSignatureSection');
                if (managerSignatureSection) {
                    managerSignatureSection.addEventListener('click', () => openOtpModal('Manager'));
                    managerSignatureSection.addEventListener('keypress', e => {
                    if (e.key === 'Enter' || e.key === ' ') { managerSignatureSection.click(); e.preventDefault(); }
                    });
                }

            // Validate OTP on submit
            otpForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const code = otpDigits.map(d => d.value.trim()).reverse().join(''); // restore normal order
                const id = document.getElementById('otpEntityId')?.value;
                const role = document.getElementById('otpRole')?.value;

                if (!/^\d{4}$/.test(code)) {
                    otpDigits.forEach(d => d.classList.add('is-invalid'));
                    otpInvalid.textContent = 'Please enter a valid 4-digit OTP';
                    otpInvalid.style.display = 'block';
                    return;
                }

                otpDigits.forEach(d => d.classList.remove('is-invalid'));
                otpInvalid.style.display = 'none';

                try {
                    const response = await fetch('/Admin/quote/ValidateOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: parseInt(id), code: code, role: role })
                    });
                    const result = await response.json();

                    if (result.success) {
                        otpModal.hide();
                        location.reload();
                    } else {
                        otpDigits.forEach(d => d.classList.add('is-invalid'));
                        otpInvalid.textContent = result.message || 'Invalid OTP.';
                        otpInvalid.style.display = 'block';
                    }
                } catch (err) {
                    console.error('OTP validation failed:', err);
                }
            });

        })();
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        // ──────── State ────────
        const MAX_SUPPLIERS = 3;
        let items = JSON.parse(document.getElementById('itemsJson').textContent);
        let suppliers = JSON.parse(document.getElementById('suppliersJson').textContent);
        const quoteId = @(Model?.Id ?? 0);

        // Track confirmed supplier IDs from DB (items with ItemSupplierIsConfirmed)
        let confirmedSupplierIds = [...new Set(items.filter(i => i.SupplierId && i.ItemSupplierIsConfirmed).map(i => i.SupplierId))];
        // Track all assigned supplier IDs (confirmed or pending)
        let assignedSupplierIds = [...new Set(items.filter(i => i.SupplierId).map(i => i.SupplierId))];

        const tableBody = document.getElementById('tableBody');
        const supplierDropdown = document.getElementById('supplierDropdown');
        const btnAdd = document.getElementById('btnAddSupplier');
        const limitWarning = document.getElementById('supplierLimitWarning');
        const supplierSection = document.getElementById('supplierSelectionSection');

        // ──────── Update Dropdown Visibility ────────
        function updateDropdownVisibility() {
            // Count total assigned suppliers (confirmed + pending)
            const assignedCount = assignedSupplierIds.length;
            if (supplierSection) {
                if (assignedCount >= MAX_SUPPLIERS) {
                    supplierSection.style.display = 'none';
                } else {
                    supplierSection.style.display = 'block';
                }
            }
            if (limitWarning) {
                limitWarning.style.display = assignedCount >= MAX_SUPPLIERS ? 'block' : 'none';
            }
        }

        // ──────── Update Supplier Totals ────────
        function updateSupplierTotals() {
            // Group items by supplier and calculate totals
            const supplierTotals = {};
            
            items.filter(i => i.SupplierId).forEach(item => {
                const price = parseFloat(item.SinglePrice) || 0;
                const qty = parseInt(item.Quantity) || 0;
                const total = price * qty;
                
                if (!supplierTotals[item.SupplierId]) {
                    supplierTotals[item.SupplierId] = 0;
                }
                supplierTotals[item.SupplierId] += total;
            });
            
            // Update all visible supplier total cells
            document.querySelectorAll('.supplier-total-cell').forEach(cell => {
                const supplierId = cell.dataset.supplierId;
                if (supplierId && supplierTotals[supplierId] !== undefined) {
                    // Only update visible cells (not hidden ones)
                    if (!cell.style.display || cell.style.display !== 'none') {
                        cell.textContent = supplierTotals[supplierId].toFixed(2);
                    }
                }
            });
        }

      // ──────── Render Table ────────
function renderTable() {

    tableBody.innerHTML = '';

    let rowIndex = 1;

    // العناصر المرتبطة بشركات فقط
    const supplierItems = items.filter(i => i.SupplierId);

    // تجميع حسب الشركة
    const grouped = {};

    supplierItems.forEach(item => {
        if (!grouped[item.SupplierId]) {
            grouped[item.SupplierId] = {
                supplierName: item.SupplierName,
                items: []
            };
        }
        grouped[item.SupplierId].items.push(item);
    });

    // عرض كل شركة
    Object.keys(grouped).forEach(suppId => {

        const group = grouped[suppId];

        // ======= حساب المجموع الكامل للشركة قبل رسم الصفوف =======
        let supplierTotal = group.items.reduce((sum, item) => {
            const price = parseFloat(item.SinglePrice) || 0;
            const qty = parseInt(item.Quantity) || 0;
            return sum + (price * qty);
        }, 0);

        let itemIndex = 0;
        const isSupplierConfirmed = confirmedSupplierIds.includes(parseInt(suppId));

        group.items.forEach(item => {

            const price = parseFloat(item.SinglePrice) || 0;
            const qty = parseInt(item.Quantity) || 0;
            const total = price * qty;

            const tr = document.createElement('tr');
            tr.className = 'item-row';
            tr.dataset.supplierId = suppId;
            tr.dataset.itemId = item.ItemId;

            let priceCell = '';
            let controlCell = '';
            let totalCell = '';

            if (isSupplierConfirmed) {
                priceCell = `
                    <span class="price-display">${price.toFixed(2)}</span>
                    <input type="number"
                        class="form-control form-control-sm price-input text-center"
                        value="${price.toFixed(2)}"
                        step="0.01"
                        style="display:none;width:100px;margin:auto;" />
                `;
            } else {
                priceCell = `<span>${price.toFixed(2)}</span>`;
            }

            // ======= أول صف لكل شركة =======
            if (itemIndex === 0) {

                totalCell = `<td class="text-center supplier-total-cell" rowspan="${group.items.length}" data-supplier-id="${suppId}">${supplierTotal.toFixed(2)}</td>`;              

            } else {
                // صفوف باقي العناصر
                totalCell = `<td class="text-center supplier-total-cell" style="display:none;" data-supplier-id="${suppId}">${supplierTotal.toFixed(2)}</td>`;

                controlCell = ''; // باقي الصفوف للشركة غير المؤكدة لا تحتاج أزرار
            }

            tr.innerHTML = `
                <td class="bg-yellow text-center">${rowIndex}</td>
                <td>${item.ItemName}</td>
                <td class="text-center supplier-name">${item.SupplierName}</td>
                <td class="text-center item-qty">${qty}</td>
                <td class="text-center item-price">${priceCell}</td>
                <td class="text-center item-total">${total.toFixed(2)}</td>
                ${totalCell}
            `;

            tableBody.appendChild(tr);

            rowIndex++;
            itemIndex++;
        });

    });

    if (supplierItems.length === 0) {
        tableBody.innerHTML = `
            <tr>
                <td colspan="8" class="text-center text-muted py-4">
                    لم يتم إضافة أي شركة بعد
                </td>
            </tr>
        `;
    }

    updateDropdownVisibility();
    attachEventListeners();
    updateSupplierTotals();
}
        // ──────── Attach Events ────────
        function attachEventListeners() {

            // ── Delete single item (AJAX) ──
            document.querySelectorAll('.btn-delete-item').forEach(btn => {
                btn.addEventListener('click', function () {
                    const row = this.closest('tr');
                    const itemId = parseInt(row.dataset.itemId);
                    const suppId = parseInt(row.dataset.supplierId);

                    if (!confirm('هل تريد حذف هذا العنصر؟')) return;

                    fetch('/Admin/quote/DeleteSingleItem', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ QuoteId: quoteId, ItemId: itemId, SupplierId: suppId })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            // Remove from local items
                            items = items.filter(i => !(i.ItemId === itemId && i.SupplierId === suppId));
                            // Recalculate
                            assignedSupplierIds = [...new Set(items.filter(i => i.SupplierId).map(i => i.SupplierId))];
                            confirmedSupplierIds = confirmedSupplierIds.filter(id => assignedSupplierIds.includes(id));
                            renderTable();
                        } else {
                            alert(data.message || 'حدث خطأ أثناء الحذف');
                        }
                    })
                    .catch(err => {
                        console.error('Delete item failed:', err);
                        alert('حدث خطأ أثناء الحذف');
                    });
                });
            });

            // ── Delete all items of a confirmed supplier (AJAX) ──
            document.querySelectorAll('.btn-delete-supplier').forEach(btn => {
                btn.addEventListener('click', function () {
                    const suppId = parseInt(this.dataset.supplierId);

                    if (!confirm('هل تريد حذف كل مواد هذه الشركة؟')) return;

                    fetch('/Admin/quote/DeleteSupplierItems', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ QuoteId: quoteId, SupplierId: suppId })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            // Remove from local items
                            items = items.filter(i => i.SupplierId !== suppId);
                            assignedSupplierIds = assignedSupplierIds.filter(id => id !== suppId);
                            confirmedSupplierIds = confirmedSupplierIds.filter(id => id !== suppId);
                            
                            // Create initial materials for assignment if no items remain
                            createInitialMaterialsIfEmpty();
                            
                            renderTable();
                        } else {
                            alert(data.message || 'حدث خطأ أثناء الحذف');
                        }
                    })
                    .catch(err => {
                        console.error('Delete supplier failed:', err);
                        alert('حدث خطأ أثناء الحذف');
                    });
                });
            });

            // ── Delete local (not yet confirmed) supplier ──
            document.querySelectorAll('.btn-delete-supplier-local').forEach(btn => {
                btn.addEventListener('click', function () {
                    const suppId = parseInt(this.dataset.supplierId);
                    items = items.filter(i => i.SupplierId !== suppId);
                    assignedSupplierIds = assignedSupplierIds.filter(id => id !== suppId);
                    renderTable();
                });
            });

            // ── Confirm supplier → AJAX to ConfirmSingleSupplier ──
            document.querySelectorAll('.btn-confirm-supplier').forEach(btn => {
                btn.addEventListener('click', function () {
                    const suppId = parseInt(this.dataset.supplierId);
                    const btnEl = this;
                    btnEl.disabled = true;
                    btnEl.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> جاري التأكيد...';

                    fetch('/Admin/quote/ConfirmSingleSupplier', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ QuoteId: quoteId, SupplierId: suppId })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            // Update local items with server data
                            // Remove old items for this supplier
                            items = items.filter(i => i.SupplierId !== suppId);
                            // Add new items from server
                            if (data.items && data.items.length > 0) {
                                data.items.forEach(si => {
                                    items.push({
                                        ItemId: si.itemId,
                                        ItemName: si.itemName,
                                        Quantity: si.quantity,
                                        SupplierId: si.supplierId,
                                        SupplierName: si.supplierName,
                                        SinglePrice: si.singlePrice,
                                        ItemSupplierIsConfirmed: si.itemSupplierIsConfirmed
                                    });
                                });
                            }
                            // Mark as confirmed
                            if (!confirmedSupplierIds.includes(suppId)) {
                                confirmedSupplierIds.push(suppId);
                            }
                            assignedSupplierIds = [...new Set(items.filter(i => i.SupplierId).map(i => i.SupplierId))];
                            renderTable();
                        } else {
                            alert(data.message || 'حدث خطأ أثناء التأكيد');
                            btnEl.disabled = false;
                            btnEl.innerHTML = '<i class="fa fa-check-circle me-1"></i> تأكيد';
                        }
                    })
                    .catch(err => {
                        console.error('Confirm supplier failed:', err);
                        alert('حدث خطأ أثناء التأكيد');
                        btnEl.disabled = false;
                        btnEl.innerHTML = '<i class="fa fa-check-circle me-1"></i> تأكيد';
                    });
                });
            });

            // ── Edit price (AJAX) ──
            document.querySelectorAll('.btn-edit-price').forEach(btn => {
                btn.addEventListener('click', function () {
                    const row = this.closest('tr');
                    const priceDisplay = row.querySelector('.price-display');
                    const priceInput = row.querySelector('.price-input');

                    if (priceInput.style.display === 'none') {
                        priceDisplay.style.display = 'none';
                        priceInput.style.display = 'block';
                        priceInput.focus();

                        const savePrice = () => {
                            const newPrice = parseFloat(priceInput.value) || 0;
                            const itemId = parseInt(row.dataset.itemId);
                            const suppId = parseInt(row.dataset.supplierId);

                            // Send AJAX to update price
                            fetch('/Admin/quote/UpdateItemPrice', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ QuoteId: quoteId, ItemId: itemId, SupplierId: suppId, NewPrice: newPrice })
                            })
                            .then(r => r.json())
                            .then(data => {
                                if (data.success) {
                                    const item = items.find(i => i.ItemId === itemId && i.SupplierId === suppId);
                                    if (item) {
                                        item.SinglePrice = newPrice;
                                    }
                                    renderTable();
                                    updateSupplierTotals();
                                } else {
                                    alert(data.message || 'حدث خطأ أثناء تعديل السعر');
                                    renderTable();
                                }
                            })
                            .catch(err => {
                                console.error('Update price failed:', err);
                                alert('حدث خطأ أثناء تعديل السعر');
                                renderTable();
                            });
                        };

                        priceInput.addEventListener('blur', savePrice, { once: true });
                      priceInput.addEventListener('keydown', function (e) {
    // منع كتابة - أو أي حرف غير رقمي أو النقطة العشرية
    if (e.key === '-' || (!/[0-9.]/.test(e.key) && e.key !== 'Backspace' && e.key !== 'Tab' && e.key !== 'Enter' && e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) {
        e.preventDefault();
    }

    // حفظ عند Enter
    if (e.key === 'Enter') {
        e.preventDefault();
        priceInput.blur();
    }
});

priceInput.addEventListener('input', function () {
    // منع القيم السالبة في حال تم اللصق أو التعديل المباشر
    if (parseFloat(priceInput.value) < 0) {
        priceInput.value = 0;
    }
});
                    } else {
                        priceDisplay.style.display = 'inline';
                        priceInput.style.display = 'none';
                    }
                });
            });
        }

// ──────── Add Supplier ────────
if (btnAdd) {
    btnAdd.addEventListener('click', function () {

        const selectedOption = supplierDropdown.options[supplierDropdown.selectedIndex];

        if (!selectedOption || !selectedOption.value) {
            alert('يرجى اختيار شركة');
            return;
        }

        const suppId = parseInt(selectedOption.value);
        const suppName = selectedOption.text;

        // Check if already assigned
        if (assignedSupplierIds.includes(suppId)) {
            alert('هذه الشركة مضافة بالفعل');
            return;
        }

        // Check max suppliers
        if (assignedSupplierIds.length >= MAX_SUPPLIERS) {
            if (limitWarning) limitWarning.style.display = 'block';
            return;
        }

        // Get unique quote items to use as templates (get one instance of each item)
        const uniqueQuoteItems = [];
        const seenItemIds = new Set();
        
        items.forEach(item => {
            if (!seenItemIds.has(item.ItemId)) {
                uniqueQuoteItems.push({
                    ItemId: item.ItemId,
                    ItemName: item.ItemName,
                    Quantity: item.Quantity,
                    SupplierId: null,
                    SupplierName: null,
                    SinglePrice: 0,
                    ItemSupplierIsConfirmed: false
                });
                seenItemIds.add(item.ItemId);
            }
        });

        // If no items exist, use the original template items from the model
        let templateItems = uniqueQuoteItems;
        if (templateItems.length === 0) {
            const originalTemplateItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Items?.Where(i => i.SupplierId == null).Select(i => new SupplierAssignmentItemVM { 
                ItemId = i.ItemId, 
                ItemName = i.ItemName, 
                Quantity = i.Quantity, 
                SupplierId = null, 
                SupplierName = null, 
                SinglePrice = i.SinglePrice, 
                ItemSupplierIsConfirmed = false 
            }) ?? new List<SupplierAssignmentItemVM>()));
            
            templateItems = originalTemplateItems.map(item => ({
                ItemId: item.itemId,
                ItemName: item.itemName,
                Quantity: item.quantity,
                SupplierId: null,
                SupplierName: null,
                SinglePrice: item.singlePrice || 0,
                ItemSupplierIsConfirmed: false
            }));
        }

        if (templateItems.length === 0) {
            alert('لا توجد مواد للنسخ');
            return;
        }
        // Prevent duplicate items if supplier is re-added

        items = items.filter(i => i.SupplierId !== suppId);
        // Create copies for the new supplier
        const newItems = templateItems.map(item => ({
            ItemId: item.ItemId,
            ItemName: item.ItemName,
            Quantity: item.Quantity,
            SupplierId: suppId,
            SupplierName: suppName,
            SinglePrice: 0,
            ItemSupplierIsConfirmed: false
        }));

        // Add to items list
        items.push(...newItems);

        // Track supplier
        assignedSupplierIds.push(suppId);

        // Reset dropdown
        supplierDropdown.value = '';

        // Re-render table
        renderTable();
    });
}

