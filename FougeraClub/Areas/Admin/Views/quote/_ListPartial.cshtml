@using FougeraClub.Areas.Admin.ViewModels.quote
@model PaginatedList<quoteVM>

@{
    var lang = SessionHelper.GetCurrentLanguage();

    ViewData["Title pakage"] = @Resource1.quotesManagement ?? " ";
    ViewData["Title Single"] = @Resource1.quotesList ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("quote", "Add");
    var editPermission = PermissionScanner.ValidatePermission("quote", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("quote", "Delete");
    var Details_ComparePricesPermission = PermissionScanner.ValidatePermission("quote", "Details_ComparePrices");

    var AddOREditPermission = addPermission || editPermission;
    var NotAddEditPermission = !AddOREditPermission;


    var AllUserNamesList = ViewBag.UsersList as IEnumerable<SelectListItem>;
    var AllDepartmentsList = ViewBag.DepartmentsList as IEnumerable<SelectListItem>;
}
<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:8%;">رقم العرض</th>
                <th style="width:11%;">تاريخ العرض</th>
                <th>المطلوب</th>
                <th style="width:9%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    if (item == null) continue;
                    var boolFirstSignature = item.SignatureSuperVisor != null && !string.IsNullOrEmpty(item.SignatureSuperVisor.ImagePath);
                    var boolManagerSignature = item.SignatureManager != null && !string.IsNullOrEmpty(item.SignatureManager.ImagePath);

                    @* var thisUserName = AllUserNamesList?.Where(x => item.UserId == x.Value).FirstOrDefault(); *@
                    <tr data-id="@item?.Id">
                        <td data-label="رقم العرض">
                            <span class="fw-medium">@item?.quoteCode</span>
                        </td>

                        <td data-label="تاريخ العرض">
                            <span>@(item.Date.HasValue ? (lang == "ar" ? item.Date.Value.ToString("d")?.Replace("/","-") :
                                                        item.Date.Value.ToString("d")?.Replace("/","-")) : "")</span>
                        </td>

                        <td data-label="المطلوب">
                            <span>@(item.OrderText)</span>
                        </td>

                        <td data-label="@Resource2.Actions">

                            <!-- Details -->
                            @if (Details_ComparePricesPermission || AddOREditPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Details_ComparePrices">
                                    <a asp-action="Details_ComparePrices" asp-route-id="@item?.Id"
                                        class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-eye fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Details">
                                    <a asp-action="Details" asp-route-id="@item?.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-eye fs-5"></i>
                                    </a>
                                </span>
                            }

                            @* Attachment *@
                           @*  <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Attachments">
                                <button type="button"
                                        class="btn-control btn-icon btn-sm rounded-circle open-quote-attachments-modal"
                                        data-quote-id="@item.Id">
                                    <i class="fa-solid fa-paperclip fs-5"></i>
                                </button>
                            </span> *@

                    @if (editPermission && (!boolFirstSignature || (!boolManagerSignature && PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager)))
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@item?.Id"
                                        class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            else //Fake
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <button asp-action="#" disabled
                                        class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </button>
                                </span>
                            }
                            <!-- Print button removed from grid as requested -->
                            <!-- Delete quote -->
                            @if (deletePermission && !boolFirstSignature)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" asp-route-id="@item?.Id" data-swal="delete"
                                        data-message="@item?.quoteCode" method="post" class="d-inline"
                                        onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <button asp-action="#" disabled
                                        class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </button>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>