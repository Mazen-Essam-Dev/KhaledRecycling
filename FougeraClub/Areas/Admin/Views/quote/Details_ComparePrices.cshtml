            const hasAnyItems = items.length > 0;
            
            if (!hasAnyItems) {
                // Create initial unassigned materials from the base items
                // Use the base items that don't have suppliers assigned as template
                const baseItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Items?.GroupBy(i => i.ItemId).Select(g => g.First()).Select(i => new SupplierAssignmentItemVM { 
                    ItemId = i.ItemId, 
                    ItemName = i.ItemName, 
