                        .catch(err => {
                            console.error('Final confirm failed:', err);
                            Swal.fire('خطأ!', 'حدث خطأ في الاتصال بالخادم', 'error');
                        });
                    }
                });
            });
        }

        // ──────── Confirm Delete Logic (Modal) ────────
        document.getElementById('confirmDeleteSupplierBtn').addEventListener('click', function () {
            if (supplierToDelete !== null) {
                const suppId = supplierToDelete;
                
                fetch('/Admin/quote/DeleteSupplierItems', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ QuoteId: quoteId, SupplierId: suppId })
                })
                .then(r => r.json())
                .then(data => {
                    items = items.filter(i => i.SupplierId !== suppId);
                    assignedSupplierIds = assignedSupplierIds.filter(id => id !== suppId);
                    confirmedSupplierIds = confirmedSupplierIds.filter(id => id !== suppId);
                    createInitialMaterialsIfEmpty();
                    renderTable();
                })
                .catch(err => {
                    console.error('Delete supplier failed:', err);
                    items = items.filter(i => i.SupplierId !== suppId);
                    assignedSupplierIds = assignedSupplierIds.filter(id => id !== suppId);
                    confirmedSupplierIds = confirmedSupplierIds.filter(id => id !== suppId);
                    createInitialMaterialsIfEmpty();
                    renderTable();
                });

                supplierToDelete = null;
            }
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteSupplierModal'));
            if (modal) modal.hide();
        });

        // ──────── Confirm Edit Logic (Modal) ────────
        document.getElementById('confirmEditSupplierBtn').addEventListener('click', function () {
            if (supplierToEdit !== null) {
                const suppId = supplierToEdit;
                
                // Get copies of current items before delete
                const copies = items.filter(i => i.SupplierId === suppId).map(i => ({...i, ItemSupplierIsConfirmed: false}));

                fetch('/Admin/quote/DeleteSupplierItems', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ QuoteId: quoteId, SupplierId: suppId })
                })
                .then(r => r.json())
                .then(data => {
                    // Remove confirmed
                    items = items.filter(i => i.SupplierId !== suppId);
                    confirmedSupplierIds = confirmedSupplierIds.filter(id => id !== suppId);
                    
                    // Re-add as unconfirmed
                    items.push(...copies);
                    
                    // Immediately save them with prices
                    copies.forEach(copy => {
                        if (copy.SinglePrice > 0) {
                            fetch('/Admin/quote/UpdateItemPrice', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ QuoteId: quoteId, ItemId: copy.ItemId, SupplierId: suppId, NewPrice: copy.SinglePrice })
                            });
                        }
                    });
                    
                    renderTable();
                })
                .catch(err => {
                    console.error('Edit supplier failed:', err);
                    alert('حدث خطأ');
                });

                supplierToEdit = null;
            }
            var modal = bootstrap.Modal.getInstance(document.getElementById('editSupplierModal'));
            if (modal) modal.hide();
        });

    });
</script>

<!-- Delete Supplier Modal -->
<div class="modal fade" id="deleteSupplierModal" tabindex="-1" aria-labelledby="deleteSupplierModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Resource2.ConfirmDelete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>هل تريد حذف هذه الشركة بكل بضائعها؟ هذا الإجراء لا يمكن التراجع عنه.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel-search btn btn-sm" data-bs-dismiss="modal">@Resource2.Cancel</button>
                <button type="button" class="btn btn-success btn-sm" id="confirmDeleteSupplierBtn">@Resource2.Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Supplier Modal -->
<div class="modal fade" id="editSupplierModal" tabindex="-1" aria-labelledby="editSupplierModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تاكيد التعديل </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>  هل تريد تعديل هذه الشركة؟
سيؤدي هذا الإجراء إلى إلغاء التأكيد الحالي وإتاحة تعديل أسعار المواد مرة أخرى.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel-search btn btn-sm" data-bs-dismiss="modal">@Resource2.Cancel</button>
                <button type="button" class="btn btn-success btn-sm" id="confirmEditSupplierBtn">@Resource2.Edit</button>
            </div>
        </div>
    </div>
</div>

}