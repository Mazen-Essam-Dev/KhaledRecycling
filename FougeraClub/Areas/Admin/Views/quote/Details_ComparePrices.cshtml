@using Application.Helpers
@using FougeraClub.Areas.Admin.ViewModels.quote
@using FougeraClub.Areas.Admin.ViewModels.quote.Details
@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@model quoteitemsVM
@{
    ViewData["Title"] = Resource1.quotes;
    ViewData["Title pakage"] = @Resource1.quotesManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.quotesList ?? " ";
    ViewData["Title Single"] = "تفاصيل طلب المواد";

    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "Unknown User";

    var quote = Model?.quote;
    var boolSignatureSuperVisor = quote?.SignatureSuperVisor != null && !string.IsNullOrEmpty(quote.SignatureSuperVisor.ImagePath);
    var boolSignatureAccountant = quote?.SignatureAccountant != null && !string.IsNullOrEmpty(quote.SignatureAccountant.ImagePath);
    var boolSignatureUserSecetary = quote?.SignatureUserSecetary != null && !string.IsNullOrEmpty(quote.SignatureUserSecetary.ImagePath);
    var boolManagerSignature = quote?.SignatureManager != null && !string.IsNullOrEmpty(quote.SignatureManager.ImagePath);

}

<!-- Breadcrumb -->
<div class="row my-3 d-flex justify-content-between align-items-center print-none">
    <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-strat">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item"><a href="#">@ViewData["Title pakage"]</a></li>
                <li class="breadcrumb-item"><a href="/Admin/quote">@ViewData["Title ListIndex"]</a></li>
                <li class="breadcrumb-item"><a href="#">@ViewData["Title Single"]</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-md-6 d-flex align-items-center justify-content-end gap-1 flex-wrap">
        @if (boolSignatureSuperVisor && boolManagerSignature)
        {
            <button onclick="printDiv('printArea')" ;="" return="" false;"="" class="print-btn btn btn-success btn-sm">
                <i class="fa fa-print me-1"></i>@Resource2.Print
            </button>
        }

        <a asp-controller="quote" asp-action="Index" class="btn-cancel-search btn-sm btn">
            رجوع <i class="fa-solid fa-arrow-left me-1"></i>
        </a>
    </div>
</div>

<div class="print-container" id="printArea">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap border-black  p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#a98a5b; font-size: 19px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                <h5 style="color:#a98a5b; font-size: 19px;font-weight: 700;">حكومة الفجيرة</h5>
                <h5 style="color:#000000; font-size: 19px;font-weight: 700;">نادي الفجيرة العلمي</h5>
            </div>
        </div>
        <div class="flex-fill text-center mb-2 me-2">
            <center>
                <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width: 110px;">
            </center>
        </div>
        <div class="d-flex justify-content-end align-items-center flex-fill">
            <div style="text-align:center">
                <h5 style="color:#a98a5b; font-size: 19px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                <h5 style="color:#a98a5b; font-size: 19px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                <h5 style="color:#000000; font-size: 19px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
            </div>
        </div>
    </div>





    <div class="d-flex justify-content-between px-3  ms-3 me-5 fw-semibold" style="text-align: right;">
       
        <div>
            <p class="mb-1">
                التاريخ : @(Model?.Date?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy"))
            </p>
          
        </div>
        <div>

            <p>
                 الرقم : @(Model?.quoteCode ?? "لا يوجد")
            </p>

        </div>

    </div>
    <div class=" d-flex justify-content-center align-items-center m-auto">
        <div class="fw-semibold fs-3">
            (مقارنة عروض أسعار وترسية)
        </div>
    </div>

    <div class=" px-4 mt-2 fw-bold" style="text-align: right;">
        <p class="mb-1 ">
            سعــــــادة / مدير نادي الفجيرة العلمي
        </p>
        <p class="mb-1">
           المطلوب / @(Model?.order)
        </p>
    </div>

   
    <!-- Supplier Selection (print-none) - always rendered, visibility managed by JS -->
    <div class="px-4 mt-3 print-none" id="supplierSelectionSection">
        <div class="d-flex align-items-center gap-2 flex-wrap w-100" style="direction:rtl;">
            <label class="fw-semibold mb-0 black">اختر شركة:</label>
            <select id="supplierDropdown" class="form-select" style="width:300px;">
                <option value="">-- اختر شركة --</option>
                @if (Model?.SuppliersList != null)
                {
                    @foreach (var supplier in Model.SuppliersList)
                    {
                        <option value="@supplier.Value">@supplier.Text</option>
                    }
                }
            </select>
            <button type="button" id="btnAddSupplier" class="btn btn-success btn-sm">
                <i class="fa fa-plus me-1"></i> إضافة
            </button>
            @if (!Model.IsConfirmed)
            {
                <button type="button" id="btnFinalConfirmQuote" class="btn btn-primary btn-sm ms-auto">
                    <i class="fa fa-check-circle me-1"></i> اعتماد
                </button>
            }
        </div>
        <div id="supplierLimitWarning" class="text-danger mt-2 fw-semibold" style="display:none;">
            <i class="fa fa-exclamation-triangle me-1"></i> الحد الأقصى للشركات هو 3
        </div>
    </div>

    <!-- Items Table -->
    <div class="print-background mt-4 px-2">
        <table class="table w-100 table-bordered" id="assignmentTable">
            <thead>
                <tr>
                    <th class="bg-yellow text-center" style="width:2%">م</th>
                    <th class="bg-yellow text-center" style="width:25%">البيان</th>
                    <th class="bg-yellow text-center" style="width:13%">اسم الشركة</th>
                    <th class="bg-yellow text-center" style="width:8%">الكمية</th>
                    <th class="bg-yellow text-center" style="width:12%">السعر</th>
                    <th class="bg-yellow text-center" style="width:12%">السعر الاجمالي</th>
                    <th class="bg-yellow text-center" style="width:11%">المجموع</th>
                    <th class="bg-yellow text-center print-none" style="width:17%">التحكم</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (Model?.Items != null && Model.Items.Any())
                {
                    var index = 0;
                    // Group items by supplier
                    var groupedItems = Model.Items
                    .Where(i => i.SupplierId != null)
                    .GroupBy(i => new { i.SupplierId, i.SupplierName })
                    .ToList();

                    foreach (var group in groupedItems)
                    {
                        decimal supplierTotal = 0;
                        int itemIndex = 0;
                        foreach (var item in group)
                        {
                            var price = item.SinglePrice ?? 0;
                            var quantity = item.Quantity ?? 0;
                            decimal totalRecord = price * quantity;
                            supplierTotal += totalRecord;
                            
                            bool isFirstItem = itemIndex == 0;
                            <tr class="item-row" data-supplier-id="@item.SupplierId" data-item-id="@item.ItemId">
                                <td class="bg-yellow  text-center" style="color:#2b3038 ">@(index + 1)</td>
                                <td class="text-center">@item.ItemName</td>
                                <td class="text-center supplier-name">@item.SupplierName</td>
                                <td class="text-center item-qty">@item.Quantity</td>
                                <td class="text-center item-price">
                                    @if (Model.IsConfirmed)
                                    {
                                        <span class="price-display">@price.ToString("0.00")</span>
                                        <input type="number" step="0.01" min="0"
                                               class="form-control form-control-sm price-input text-center"
                                               value="@price.ToString("0.00")"
                                               style="display:none; width:100px; margin:auto;" />
                                    }
                                    else
                                    {
                                        <span>@price.ToString("0.00")</span>
                                    }
                                </td>
                                <td class="text-center item-total">@totalRecord.ToString("0.00")</td>
                                @if (isFirstItem)
                                {
                                    <td class="text-center supplier-total-cell" rowspan="@group.Count()" data-supplier-id="@group.Key.SupplierId">@supplierTotal.ToString("0.00")</td>
                                    if (!Model.IsConfirmed)
                                    {
                                        <td class="text-center print-none supplier-control-cell" rowspan="@group.Count()">
                                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-supplier me-1"
                                                    data-supplier-id="@group.Key.SupplierId" title="حذف كل مواد الشركة">
                                                <i class="fa fa-times-circle me-1"></i> حذف الشركة
                                            </button>
                                            <button type="button" class="btn btn-success btn-sm btn-confirm-supplier"
                                                    data-supplier-id="@group.Key.SupplierId" title="تأكيد الشركة">
                                                <i class="fa fa-check-circle me-1"></i> تأكيد
                                            </button>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="text-center print-none">
                                            <button type="button" class="btn btn-warning btn-sm btn-edit-price me-1" title="تعديل السعر">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm btn-delete-item" title="حذف">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    }
                                }
                                else
                                {
                                    if (Model.IsConfirmed)
                                    {
                                        <td class="text-center supplier-total-cell" style="display:none;" data-supplier-id="@group.Key.SupplierId">@supplierTotal.ToString("0.00")</td>
                                        <td class="text-center print-none">
                                            <button type="button" class="btn btn-warning btn-sm btn-edit-price me-1" title="تعديل السعر">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm btn-delete-item" title="حذف">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    }
                                }
                            </tr>
                            index++;
                            itemIndex++;
                        }
                    }

                    // Unassigned items
                    var unassignedItems = Model.Items.Where(i => i.SupplierId == null).ToList();
                    if (unassignedItems.Any())
                    {
                        foreach (var item in unassignedItems)
                        {
                            var price = item.SinglePrice ?? 0;
                            var quantity = item.Quantity ?? 0;
                            decimal totalRecord = price * quantity;
                            <tr class="item-row unassigned-row" data-supplier-id="" data-item-id="@item.ItemId">
                                <td class="bg-yellow text-center">@(index + 1)</td>
                                <td>@item.ItemName</td>
                                <td class="text-center supplier-name text-muted">غير معين</td>
                                <td class="text-center item-qty">@item.Quantity</td>
                                <td class="text-center item-price">@price.ToString("0.00")</td>
                                <td class="text-center item-total">@totalRecord.ToString("0.00")</td>
                                <td class="text-center">—</td>
                                <td class="text-center print-none">—</td>
                            </tr>
                            index++;
                        }
                    }
                }
                else
                {
                    <tr id="emptyRow">
                        <td colspan="8" class="text-center text-muted py-4">لا توجد مواد</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mx-2 px-2 py-2">
            @if (Model.IsConfirmed&&!(PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager))
            {
                <div class="text-danger fs-4 fw-semibold p-2 border rounded bg-light" style="min-height: 50px;">
                    @Model?.textarea
                </div>
            }
            else
            {
                <label class="fw-bold mb-1 black">الملاحظات :</label>
                <textarea id="quoteTextArea" class="form-control text-danger fs-5 fw-semibold mb-2" rows="3" placeholder="أدخل الملاحظات هنا...">@Model?.textarea</textarea>
                <div class="text-end print-none">
                    <button type="button" id="btnSaveTextArea" class="btn btn-primary btn-sm black">
                        <i class="fa fa-save me-1"></i> حفظ الملاحظات
                    </button>
                    <span id="textAreaSaveStatus" class="text-success ms-2 fw-bold" style="display:none;">تم الحفظ بنجاح</span>
                </div>
            }
        </div>
    </div>
    
    <!-- Confirm / Actions -->
    <div class="print-none" id="confirmActionsSection">
    </div>

    <!-- Signature Section -->
 <div class="signatures-section">
        <div class="row">
            <!-- Right side signatures -->
           <div class="">
                <div class="col-md-8">
                    <div class="fw-bold ">
                        <p class="text-decoration-underline " style=" text-underline-offset: 6px;"> تصديق وموافقة لجنة المشتريات :</p>
                    </div>
                    <div >
                        <div  class="d-flex justify-content-0 gap-3">
                            <p class="mb-3 fw-semibold my-auto"> 1- مشرف الأنشطة:</p>
                            @if (boolSignatureSuperVisor)
                            {
                                <img src="~/@quote?.SignatureSuperVisor?.ImagePath"
                                     class="img-fluid"
                                     style="height:70px;" />
                            }
                            else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.ActivitiesSupervisor
                            && await PermissionScanner.CheckLoggedUserIfHasSignature())
                            {
                                <div id="supervisorSignatureSection"
                                     class="signature-trigger"
                                     role="button"
                                     tabindex="0"
                                     style="cursor:pointer;">
                                    إضغط هنا للتوقيع
                                </div>
                            }
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-0 gap-3">
                            <p class="mb-3 fw-semibold my-auto"> 2- المحاسب:</p>
                            @if (boolSignatureAccountant)
                            {
                                <img src="~/@quote?.SignatureAccountant?.ImagePath"
                                     class="img-fluid"
                                     style="height:70px;" />
                            }
                            else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Accountant
                            && await PermissionScanner.CheckLoggedUserIfHasSignature() && boolSignatureSuperVisor)
                            {
                                <div id="accountantSignatureSection"
                                     class="signature-trigger"
                                     role="button"
                                     tabindex="0"
                                     style="cursor:pointer;">
                                    إضغط هنا للتوقيع
                                </div>
                            }
                        </div>
                    </div>
                    <div >
                        <div class="d-flex justify-content-0 gap-3">
                            <p class="mb-3 fw-semibold my-auto">3- السكرتير:</p>
                            @if (boolSignatureUserSecetary)
                            {
                                <img src="~/@quote?.SignatureUserSecetary?.ImagePath"
                                     class="img-fluid"
                                     style="height:70px;" />
                            }
                            else if (PermissionScanner.ValidatePermission("quote", "SecrtaryPermissionSign")
                            && await PermissionScanner.CheckLoggedUserIfHasSignature() && boolSignatureAccountant)
                            {
                                <div id="secetarySignatureSection"
                                     class="signature-trigger"
                                     role="button"
                                     tabindex="0"
                                     style="cursor:pointer;">
                                    إضغط هنا للتوقيع
                                </div>
                            }
                        </div>
                    </div>
                </div>
                      <!-- Left side manager signature -->
            <div class="col-md-12">
                <div class="text-center ">
                    <div class="d-flex justify-content-end w-100" >
                        <p class="fw-semibold">يعتمد,, </p>
                        @if (boolManagerSignature)
                        {
                            <img src="~/@quote?.SignatureManager?.ImagePath"
                                 class="img-fluid"
                                 style="height:70px;" />
                        }
                        else if (PermissionScanner.ValidateRoleNumber() == RoleNumber.Manager
                        && await PermissionScanner.CheckLoggedUserIfHasSignature() && boolSignatureUserSecetary)
                        {
                            <div id="managerSignatureSection"
                                 class="signature-trigger"
                                 role="button"
                                 tabindex="0"
                                 style="cursor:pointer;">
                                إضغط هنا للتوقيع
                            </div>
                        }
                    </div>
                </div>
            </div>
            </div>
      
        </div>
    </div>
</div>

<!-- OTP Modal -->
<div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="otpModalLabel">@Resource2.EnterOTP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="otpForm">
                <input type="hidden" id="otpEntityId" name="id" value="@Model?.Id" />
                <input type="hidden" id="otpRole" name="role" value="" />
                <div class="modal-body text-center">
                    <p>@Resource2.PleaseEnterOTPToConfirmSignature</p>
                    <div class="d-flex justify-content-center gap-2">
                        @for (int i = 0; i < 4; i++)
                        {
                            <input inputmode="numeric" maxlength="1"
                                   class="form-control otp-digit text-center fs-4"
                                   style="width:60px;" />
                        }
                    </div>
                    <div class="invalid-feedback text-center mt-2" style="display:none;">
                        @Resource2.EnterValidDigitsCode
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource2.Close</button>
                    <button type="submit" class="btn btn-success">@Resource2.Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

