@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        $('.typeradiobtn, #DateInput').on('change', function () {
            let id = document.getElementById("Id").value;
            let selectedDate = document.getElementById("DateInput").value;
            const msgValid = "@Html.Raw(Resource1.Dateisvalid)";
            const msgInvalid = "@Html.Raw(@Resource2.ReportIsExist)";
        });

    </script>

    <script>
        $(document).ready(function () {

            // 🔹 Integer numbers only (0-9)
            $('.only-integer').on('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });

            // 🔹 Decimal numbers (one dot . allowed)
            $('.only-decimal').on('input', function () {
                // Remove anything other than a number or dot .
                this.value = this.value.replace(/[^0-9.]/g, '');

                // Allow only one dot .
                if ((this.value.match(/\./g) || []).length > 1) {
                    this.value = this.value.slice(0, -1);
                }
            });

        });
    </script>

    <script>
        let rowIndex = @Model?.quotesItems?.Count() ?? 0;

        function addRow() {
            const quantity = document.getElementById("Quantity").value;
            const itemName = document.getElementById("ItemName").value;

            if (!quantity || !itemName) {
                $("#ItemNameSpan").text("");
                $("#QuantitySpan").text("");
                if (!quantity) {
                    $("#QuantitySpan").text("@Html.Raw(Resource1.Required)");
                }
                if (!itemName) {
                    $("#ItemNameSpan").text("@Html.Raw(Resource1.Required)");
                }
                return;
            }
            $("#ItemNameSpan").text("");
            $("#QuantitySpan").text("");


            const tbody = document.getElementById("quotesItems");
            const row = document.createElement("tr");

                   row.innerHTML = `
        <td>
        <input class="form-control only-integer"
        type="number"
        name="quotesItems[${rowIndex}].Quantity"
        value="${quantity}"
        readonly />
        </td>

        <td>
        <input class="form-control"
        type="text"
        name="quotesItems[${rowIndex}].ItemName"
        value="${itemName}"
        readonly />
        </td>

        <td class="text-center">

        <input type="hidden" class="editQuantityTemp"/>
        <input type="hidden" class="editItemNameTemp"/>

        <button type="button"
        class="btn-control btn-icon btn-sm rounded-circle me-1"
        onclick="toggleEditRow(this)">
        <i class="fa-solid fa-pen fs-6"></i>
        </button>

        <button type="button"
        class="btn-control btn-icon btn-sm rounded-circle"
        onclick="removeRow(this)">
        <i class="fa-solid fa-trash fs-5"></i>
        </button>

        </td>
        `;

            tbody.appendChild(row);
            rowIndex++;

            // Clear inputs
            document.getElementById("Quantity").value = "";
            document.getElementById("ItemName").value = "";
        }

        // Store the row to be deleted
        let rowToDelete = null;
        function removeRow(button) {
            rowToDelete = button.closest("tr");
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        function confirmDeleteRow() {
            if (rowToDelete) {
                rowToDelete.remove();
                // Reindex all rows
                const rows = document.querySelectorAll("#quotesItems tr");
                rows.forEach((row, i) => {
                    const inputs = row.querySelectorAll("input");
                    inputs.forEach(input => {
                        const name = input.getAttribute("name");
                        if (name) {
                            input.setAttribute("name", name.replace(/\[\d+\]/, `[${i}]`));
                        }
                    });
                });
                rowIndex = rows.length;
                rowToDelete = null;
            }
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            if (modal) modal.hide();
        }
    </script>
    <script>
              function toggleEditRow(button) {

            const row = button.closest("tr");

            const qtyInput = row.querySelector('input[name*="Quantity"]');
            const nameInput = row.querySelector('input[name*="ItemName"]');

            const tempQty = row.querySelector(".editQuantityTemp");
            const tempName = row.querySelector(".editItemNameTemp");

            const icon = button.querySelector("i");

            const isEditMode = icon.classList.contains("grayBtn");

            // ENTER EDIT MODE
            if (!isEditMode) {

                tempQty.value = qtyInput.value;
                tempName.value = nameInput.value;

                qtyInput.removeAttribute("readonly");
                nameInput.removeAttribute("readonly");

                //icon.classList.remove("fa-pen");
                icon.classList.add("grayBtn");

                qtyInput.focus();
            }

            // SAVE
            else {

                const quantity = qtyInput.value.trim();
                const itemName = nameInput.value.trim();

                // validation
                if (!quantity || !itemName) {

                    if (!quantity) {
                        qtyInput.classList.add("is-invalid");
                        qtyInput.focus();
                    } else {
                        qtyInput.classList.remove("is-invalid");
                    }

                    if (!itemName) {
                        nameInput.classList.add("is-invalid");
                        if (quantity) nameInput.focus();
                    } else {
                        nameInput.classList.remove("is-invalid");
                    }

                    return;
                }

                // remove validation style
                qtyInput.classList.remove("is-invalid");
                nameInput.classList.remove("is-invalid");

                // store new values
                tempQty.value = quantity;
                tempName.value = itemName;

                qtyInput.value = tempQty.value;
                nameInput.value = tempName.value;

                qtyInput.setAttribute("readonly", true);
                nameInput.setAttribute("readonly", true);

                icon.classList.remove("grayBtn");
            }
        }

        //إضافة حفظ بالـ  Enter (اختياري لكنه احترافي)
        document.addEventListener("keydown", function (e) {

            if (e.key === "Enter") {

                const activeRow = document.activeElement.closest("tr");

                if (!activeRow) return;

                const btn = activeRow.querySelector(".grayBtn");

                if (btn) {
                    e.preventDefault();
                    toggleEditRow(btn.closest("button"));
                }

            }

        });
    </script>
    <script>
                document.getElementById("submitQuoteBtn").addEventListener("click", function (e) {

            let hasEmpty = false;

            const rows = document.querySelectorAll("#quotesItems tr");

            rows.forEach(row => {

                const qty = row.querySelector('input[name*="Quantity"]');
                const name = row.querySelector('input[name*="ItemName"]');

                if (qty && name) {

                    if (!qty.value.trim() || !name.value.trim()) {

                        qty.classList.add("is-invalid");
                        name.classList.add("is-invalid");

                        hasEmpty = true;
                    }

                }

            });

            if (hasEmpty) {

                e.preventDefault();

                const toast = new bootstrap.Toast(document.getElementById("validationToast"));
                toast.show();

            }

        });


        document.addEventListener("input", function (e) {

            if (e.target.classList.contains("form-control")) {
                e.target.classList.remove("is-invalid");
            }

        });
    </script>

    <!-- Delete Modal (matches other admin pages) -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Resource2.ConfirmDelete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>هل أنت متأكد من أنك تريد حذف هذا العنصر؟ هذا الإجراء لا يمكن التراجع عنه.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel-search btn btn-sm"
                        data-bs-dismiss="modal">@Resource2.Cancel</button>
                    <button type="button" class="btn btn-success btn-sm"
                        onclick="confirmDeleteRow()">@Resource2.Delete</button>
                </div>
            </div>
        </div>
    </div>


}