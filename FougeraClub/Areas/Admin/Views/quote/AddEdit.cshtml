@using FougeraClub.Areas.Admin.ViewModels.quote
@using System.Globalization
@model quoteVM

@{
    var isEdit = Model?.Id > 0;
    var lang = SessionHelper.GetCurrentLanguage();
    ViewData["Title"] = isEdit ? "تعديل عرض سعر" : "إضافة عرض سعر";
    ViewData["Title pakage"] = @Resource1.quotesManagement ?? " ";
    ViewData["Title ListIndex"] = @Resource1.quotesList ?? " ";
    ViewData["Title Single"] = ((Model?.Id == 0) ? "إضافة عرض سعر جديد" : "تعديل عرض سعر") ?? " ";
    var boolFirstSignature = Model?.SignatureSuperVisor != null && !string.IsNullOrEmpty(Model.SignatureSuperVisor.ImagePath);
    var boolManagerSignature = Model?.SignatureManager != null && !string.IsNullOrEmpty(Model.SignatureManager.ImagePath);
}
<!-- Breadcrumb Navigation Column -->
