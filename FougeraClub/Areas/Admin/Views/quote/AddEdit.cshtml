                    <tbody id="quotesItems">
                        @if (Model?.quotesItems != null)
                        {
                            var index = 0;
                            foreach (var detail in Model.quotesItems)
                            {
                                @* <tr>
                                    <td><input class="form-control only-integer" type="number" name="quotesItems[@index].Quantity"
                                            value="@detail.Quantity"  /></td>
                                    <td><input class="form-control" type="text" name="quotesItems[@index].ItemName"
