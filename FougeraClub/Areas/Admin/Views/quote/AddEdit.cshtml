                                    </td>
                                    <td class="text-center"><button type="button"
                                            class="btn-control btn-icon btn-sm rounded-circle" onclick="removeRow(this)"><i
                                                class="fa-solid fa-trash fs-5"></i></button></td>
                                </tr> *@
                                @* <tr>
                                    <td>
                                        <input class="form-control only-integer"
                                               type="number"
                                               name="quotesItems[@index].Quantity"
                                               value="@detail.Quantity"
                                               readonly />
                                    </td>

                                    <td>
                                        <input class="form-control"
                                               type="text"
                                               name="quotesItems[@index].ItemName"
                                               value="@detail.ItemName"
                                               readonly />
                                    </td>

                                    <td class="text-center">

                                        <!-- Edit -->
                                        <button type="button"
                                                class="btn-control btn-icon btn-sm rounded-circle me-1"
                                                onclick="toggleEditRow(this)">
                                            <i class="fa-solid fa-pen fs-6"></i>
