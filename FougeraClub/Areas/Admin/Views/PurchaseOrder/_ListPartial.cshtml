@using FougeraClub.Areas.Admin.ViewModels.PurchaseOrder
@model PaginatedList<PurchaseOrderVM>

@{
    var lang = SessionHelper.GetCurrentLanguage();

    ViewData["Title pakage"] = @Resource1.PurchaseOrderManagement ?? " ";
    ViewData["Title Single"] = @Resource1.PurchaseOrderList ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("PurchaseOrder", "Add");
    var editPermission = PermissionScanner.ValidatePermission("PurchaseOrder", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("PurchaseOrder", "Delete");

    var suppliers = ViewBag.suppliers as IEnumerable<Domain.Entities.Supplier>;
}
<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>

<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th style="width:7%;">@* @Resource1.PurchaseOrderCode *@ .No</th>
                <th >@Resource1.SupplierName</th>
                <th style="width:7%;">@Resource2.Date</th>
                <th style="width:9%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    var boolManagerSignature = item.Signature != null && !string.IsNullOrEmpty(item.Signature.ImagePath);

                    var thisSupplier = suppliers?.Where(x => item.SupplierId == x.Id).FirstOrDefault();
                    <tr data-id="@item?.Id">
                        <td data-label="@Resource1.PurchaseOrderCode">
                            <span class="fw-medium">@item?.PurchaseOrderCode</span>
                        </td>
                        <td data-label="@Resource1.SupplierName">
                            <span>@(lang == "ar" ? thisSupplier?.SupplierNameAr : thisSupplier?.SupplierNameEn)</span>
                        </td>
                        <td data-label="@Resource2.Date">
                            <span>@(item.Date.HasValue ? (lang == "ar" ? item.Date.Value.ToString("d")?.Replace("/","-") :
                                                        item.Date.Value.ToString("d")?.Replace("/","-")) : "")</span>
                        </td>
                        <td data-label="@Resource2.Actions">
                            <!-- Details -->
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Details">
                                <a asp-action="Details" asp-route-id="@item?.Id"
                                    class="btn-control btn-icon btn-sm rounded-circle">
                                    <i class="fa-solid fa-eye fs-5"></i>
                                </a>
                            </span>

                            @* Attachment *@
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Attachments">
                                <button type="button"
                                        class="btn-control btn-icon btn-sm rounded-circle open-purchaseOrder-attachments-modal"
                                        data-purchaseorder-id="@item.Id">
                                    <i class="fa-solid fa-paperclip fs-5"></i>
                                </button>
                            </span>

                            @if (editPermission && !boolManagerSignature)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@item?.Id"
                                        class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            else //Fake
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <button asp-action="#" disabled
                                        class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </button>
                                </span>
                            }
                            <!-- Print button removed from grid as requested -->
                            <!-- Delete PurchaseOrder -->
                            @if (deletePermission && !boolManagerSignature)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" asp-route-id="@item?.Id" data-swal="delete"
                                        data-message="@item?.PurchaseOrderCode" method="post" class="d-inline"
                                        onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <button asp-action="#" disabled
                                        class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </button>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>