                                <td>@detail.Quantity?.ToString("0")</td>
                                <td>@detail.SinglePrice?.ToString("0.00")</td>
                                <td>@totalRecord.ToString("0.00")</td>
                            </tr>
                            index++;
                        }

                            if (hasVAT)
                            {
                                VATTotal = VATValue * totalAll;
                            }
                            else
                            {
                                VATTotal = 0.00m;
                            }
                            var totalWithVat = totalAll + VATTotal;

                        totalAllGlogal = totalAll;
                        totalWithVatGlogal = totalWithVat;
                        VATTotalGlogal = VATTotal;
                        VATValueGlogal = VATValue;

