                        var hasVAT = Model.HasVAT;
                        foreach (var detail in Model.Items)
                        {
                            if (detail.SinglePrice == null) detail.SinglePrice = 0.00m;
                            if (detail.Quantity == null) detail.Quantity = 0;
                            var totalRecord = detail.SinglePrice.Value * detail.Quantity.Value;
                            totalAll = totalAll + totalRecord;
                            <tr >
