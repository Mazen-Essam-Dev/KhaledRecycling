@model PaginatedList<SupplierVM>

@{
    ViewData["Title"] = @Resource1.Suppliers ?? " ";
    ViewData["Title pakage"] = @Resource1.SuppliersManagement ?? " ";
    ViewData["Title Single"] = @Resource1.SuppliersList ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("Supplier", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Supplier", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Supplier", "Delete");
}

<!-- Header with Title, Count, and Create Button -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-md-6">
        <nav aria-label="breadcrumb" class="ms-2">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count and Action Buttons -->
    <div class="col-md-6 d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource2.SuppliersCount:</span>
            <span id="countRecords">@Model.Count</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <!-- Header with actions + status badges -->
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                                <span class="fa-solid fa-user-tie me-1 text-ico"></span>
                                @Resource1.Supplier_List
                            </h4>
                        </div>
                    </div>
                </div>

                <!-- Right: actions -->
                <div class="d-flex align-items-center gap-2 flex-wrap" style="margin-left: 4px;">
                    @if (addPermission)
                    {
                        <a asp-action="AddEdit" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource2.NewSupplier
                        </a>
                    }
                    <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>
                    <!-- Print Export As Excel -->
                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"
                            style="font-size:17px;"></i>@Resource1.createExcelReport_Download
                    </a>
                </div>
            </div>


            <div class=" p-3">
                <form method="get" id="supplierFilterForm" class="filterImg rounded p-3">
                    <div class="row">
                        <!-- Search Column -->

                        <div class="filter-dropdown col-md-12 mb-2">
                            <label for="searchTermInput" class="fw-bold mb-2">@Resource2.Search:</label>
                            <div class="search-box position-relative">
                                <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                <input type="text" name="searchTerm" id="searchTermInput" value="@Model.SearchTerm"
                                       class="form-control form-control-sm filter-bordered ps-4"
                                       placeholder="@Resource2.SearchByCompanyNameOrPhone" />
                            </div>
                        </div>

                        <!-- Radios -->
                        <div class="col-md-9 d-flex align-items-center gap-4">
                            <!-- Main label -->
                            <label class="form-label fw-semibold mb-0">
                                @Resource2.Type
                            </label>

                            <!-- Radios -->
                            <div class="d-flex flex-wrap gap-4">
                                @foreach (var item in ViewBag.TypeEnumList ?? Enumerable.Empty<SelectListItem>())
                                {
                                    <div class="form-check mb-0">
                                        <input class="form-check-input typeradiobtn" type="radio"
                                               name="selectedType" id="TypeEnum_@item.Value"
                                               value="@item.Value" />
                                        <label class="form-check-label" for="TypeEnum_@item.Value">
                                            @item.Text
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Buttons Column -->
                        <div class="col-md-3 d-flex justify-content-end gap-3 mt-4 mt-md-0">
                            <button type="button" id="btnClearFilters" class="btn-cancel-search btn-sm btn coustom-min-w">
                                <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                            </button>
                            <button type="submit" class="btn btn-success btn-sm coustom-min-w">
                                <i class="ri-filter-line me-1"></i> @Resource1.Search
                            </button>
                        </div>
                    </div>
                </form>
            </div>


                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ListPartial", Model)
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Delete Modal (unchanged logic) -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">@Resource1.Delete @Resource1.Supplier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Resource1.Close"></button>
            </div>

            <div class="modal-body">
                <p>@Resource1.are_you_sure_Delete <strong id="empName"></strong>؟</p>
            </div>

            <div class="modal-footer">
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="empId" />
                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">@Resource1.Cancel</button>
                    <button type="submit" class="btn btn-cancel-search">@Resource1.Yes_delete</button>
                </form>
            </div>

        </div>
    </div>
</div>

<!-- Attachments Modal (unchanged logic) -->
<div class="modal fade" id="uploadFilesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div id="attachmentsContent"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (ViewBag.ReopenModal != null && (bool)ViewBag.ReopenModal)
    {
        <script>
            var myModal = new bootstrap.Modal(document.getElementById('uploadFilesModal'));
            myModal.show();
        </script>
    }
    <script>
        $(document).on("click", ".show-delete-info", function () {
            var message = $(this).data("message"); // take message from data-attribute
            $("#deleteInfoMessage").text(message);

            var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
            modal.show();
        });

        // Delete modal population (unchanged)
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var empId = button.getAttribute('data-emp-id');
            var empName = button.getAttribute('data-emp-name');

            var modalEmpId = deleteModal.querySelector('#empId');
            var modalEmpName = deleteModal.querySelector('#empName');

            modalEmpId.value = empId;
            modalEmpName.textContent = empName;
        });

        // Expiry highlighting (kept your logic)
        $(document).ready(function () {
            $('.expiryDate').each(function () {
                const endDateStr = $(this).text().trim();
                if (!endDateStr) return;

                const expiryDate = new Date(endDateStr);
                if (isNaN(expiryDate.getTime())) return;

                const today = new Date();
                const in30Days = new Date();

                today.setHours(0, 0, 0, 0);
                in30Days.setDate(today.getDate() + 30);
                in30Days.setHours(0, 0, 0, 0);
                expiryDate.setHours(0, 0, 0, 0);

                if (expiryDate < today) {
                    $(this).closest('tr').addClass('badge-expired');
                } else if (expiryDate <= in30Days) {
                    $(this).closest('tr').addClass('badge-warning');
                }
            });
        });

        // Attachments modal (unchanged)
        document.querySelectorAll('.open-attachments').forEach(btn => {
            btn.addEventListener('click', async function () {
                var employeeId = this.getAttribute('data-employee-id');
                let response = await fetch('/Admin/Supplier/GetEmployeeAttachments?id=' + employeeId);
                let html = await response.text();
                document.getElementById('attachmentsContent').innerHTML = html;

                var modal = new bootstrap.Modal(document.getElementById('uploadFilesModal'));
                modal.show();
            });
        });
    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#selectedType').val(filters.selectedType);
                if (filters.selectedType) {
                    $('input[name="selectedType"]').prop('checked', false);
                    $('input[name="selectedType"][value="' + filters.selectedType + '"]').prop('checked', true);
                }
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                $('input[name="selectedType"]').prop('checked', false);
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    selectedType: $('input[name="selectedType"]:checked').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var selectedType = $('input[name="selectedType"]:checked').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/Supplier/Index',
                    type: 'GET',
                    data: { searchTerm,selectedType, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });

        function openPrintPage() {
            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
            const selectedType = $('input[name="selectedType"]:checked').val();
            var countRecords = document.getElementById('NewCountRecords').value;
            if (countRecords && countRecords > 3999) {
                showToastrCannotPrint(); // Toaster Can't Print more 3999 record
            }
            else {
                const url = `/Admin/Supplier/Print?searchTerm=${searchTerm}&&selectedType=${selectedType}`;
                //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                // Open a standalone pop window (not a tab) so the original page doesn't freeze
                const printWindow = window.open(
                    url,
                    'printWindow',
                    'width=1000,height=800,noopener,noreferrer'
                );
            }
        }
        function openExcelPage() {
            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
            const selectedType = $('input[name="selectedType"]:checked').val();
            const url = `/Admin/Supplier/createExcelReport_Download?searchTerm=${searchTerm}&&selectedType=${selectedType}`;
            window.open(url, '_self');
        }

    </script>
}