@model PaginatedList<SupplierVM>

@{
    ViewData["Title"] = @Resource1.Supplier ?? " ";

    var addPermission = PermissionScanner.ValidatePermission("Supplier", "Add");
    var editPermission = PermissionScanner.ValidatePermission("Supplier", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Supplier", "Delete");
}
<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 me-3 mb-3">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>

    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>

<div class="table-responsive px-3">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>@Resource1.SupplierName</th>
                <th style="width:14%;">@Resource1.Email</th>
                <th style="width:13%;">@Resource1.Mobile</th>
                <th style="width:20%;">@Resource1.VATNumber</th>
                <th style="width:8%;">@Resource1.Type</th>
                <th style="width:6%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                var lang = SessionHelper.GetCurrentLanguage();
                foreach (var supplier in Model.Items)
                {
                    <tr data-id="@supplier.Id">
                        <td data-label="@Resource1.SupplierName">@(lang == "ar" ? supplier.SupplierNameAr :
                                                supplier.SupplierNameEn)</td>
                        <td data-label="@Resource1.Email">@supplier.Email</td>
                        <td data-label="@Resource1.Mobile">@supplier.Mobile</td>
                        <td data-label="@Resource1.VATNumber">@supplier.VATNumber</td>
                        <td data-label="@Resource1.Type">@supplier.textCategory</td>
                <td data-label="@Resource2.Actions">
                            @if (editPermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit" asp-route-id="@supplier.Id"
                                        class="btn-control btn-icon btn-sm rounded-circle btn-soft-primary">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            @if (deletePermission && !supplier.HasRelatedData)
                            {
                                <form asp-action="Delete" asp-route-id="@supplier.Id" method="post" class="d-inline"
                                    data-swal="delete"
                                    data-message="@Resource1.Supplier @(lang == "ar" ? supplier.SupplierNameAr : supplier.SupplierNameEn)">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <button asp-action="#" disabled
                                            class="disabled btn btn-control-dis  btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </button>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.No_results_found</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>


</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3 mb-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page" data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>