@model TrainerIndexVM

@{
    ViewData["Title"] = Resource2.Trainers ?? " ";
    ViewData["Title pakage"] = Resource1.ActivitiesManagement ?? " ";
    ViewData["Title Single"] = Resource1.TrainersList ?? " ";

    var editPermission = PermissionScanner.ValidatePermission("Trainer", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("Trainer", "Delete");
    var addPermission = PermissionScanner.ValidatePermission("Trainer", "Add");
    var lang = SessionHelper.GetCurrentLanguage();
}

<input type="hidden" id="NewCountRecords" value="@Model?.TrainerWithUserVM_Paginated?.Count" />

<!-- Page Size Selector -->
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            if (s == Model?.TrainerWithUserVM_Paginated?.PageSize)
            {
                <option value="@s" selected="selected">@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
</nav>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>@Resource2.TrainerName</th>
                <th style="width:12%;">@Resource1.Phone</th>
                <th style="width:23%;">@Resource2.Email</th>
                <th style="width:20%;">@Resource1.Specialization</th>
                <th style="width:8%;">@Resource2.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.TrainerWithUserVM_Paginated == null || !Model.TrainerWithUserVM_Paginated.Items.Any())
            {
                <tr>
                    <td colspan="5" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var trainer in Model.TrainerWithUserVM_Paginated.Items)
                {
                    <tr data-id="@trainer?.Trainer?.Id">
                        <td data-label="@Resource2.TrainerName">
                            <span class="fw-medium text-decoration-underline cursor-pointer"
                                  onclick="window.location.href='/Admin/Trainer/AddEdit/@trainer?.Trainer?.Id'">
                                @(lang == "ar" ? trainer?.User?.FullNameAr : trainer?.User?.FullNameEn)
                            </span>
                        </td>
                        <td data-label="@Resource1.Phone">
                            <span>@trainer?.User?.PhoneNumber</span>
                        </td>
                        <td data-label="@Resource2.Email">
                            <span>@trainer?.User?.UserName</span>
                        </td>
                        <td data-label="@Resource1.Specialization">
                            <span>@(lang == "ar" ? trainer?.Trainer?.Department?.NameAr : trainer?.Trainer?.Department?.NameEn)</span>
                        </td>
                        <td data-label="@Resource2.Actions">
                            <!-- Edit -->
                            @if (editPermission @* && trainer?.Trainer?.Courses?.Count() == 0 *@ )
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Edit">
                                    <a asp-action="AddEdit"
                                       asp-route-id="@trainer?.Trainer?.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource1.Edit">
                                    <a action="#" disabled
                                       class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>
                                </span>
                            }

                            <!-- Delete -->
                            @if (trainer?.Trainer?.Courses?.Count() == 0 && deletePermission)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete"
                                          asp-route-id="@trainer.Trainer.Id"
                                          method="post"
                                          class="d-inline"
                                          data-swal="delete"
                                          data-message="@trainer?.User?.FullNameAr"
                                          onsubmit="return confirm('@Resource2.ConfirmDelete');">
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <button type="button" disabled
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteInfoModal"
                                            class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-trash fs-5"></i>
                                    </button>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.TrainerWithUserVM_Paginated.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.TrainerWithUserVM_Paginated.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TrainerWithUserVM_Paginated.TotalPages; i++)
        {
            <li class="page-item @(i == Model.TrainerWithUserVM_Paginated.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.TrainerWithUserVM_Paginated.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.TrainerWithUserVM_Paginated.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
<div class="modal fade" id="deleteInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Resource2.Sorry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="">
                    @Resource2.CantDeleteTrainer
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="
btn btn-success btn-sm" data-bs-dismiss="modal">
                    @Resource2.Close
                </button>
            </div>
        </div>
    </div>
</div>
