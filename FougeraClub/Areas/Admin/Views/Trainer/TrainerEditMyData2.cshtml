@model TrainerVM

@{
    ViewData["Title"] = Resource2.TrainerData;
    ViewData["Title pakage"] = @Resource2.TrainerControlPanel ?? " ";
    ViewData["Title Single"] = (Resource2.TrainerData) ?? " ";
}
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <div class="d-flex align-items-center gap-2">
            <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                <span class="fa fa-book me-2 text-ico"></span>
                @ViewData["Title"]
            </h4>
        </div>
    </div>
    <div class="col-md-6">
        <nav class="d-flex align-items-center justify-content-end" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>


                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
</div>
<div class="card all-borders p-3">
        <form asp-action="TrainerEditMyData2" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DepartmentId" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Attachment_TempFilePath" class="needs-validation" />
        <input type="hidden" asp-for="Attachment_OldPath" class="needs-validation" />

        <div class="row g-3">
                    <div class="col-md-6">
                <label asp-for="UserId" class="form-label asteriskRequired">@Resource2.TainerName</label>
                        <input type="text" disabled class="form-control bg-light" value="@(Model?.UsersList?.FirstOrDefault(x => x.Value == Model.UserId.ToString())?.Text)" readonly />
                        <span asp-validation-for="UserId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                <label asp-for="DepartmentId" class="form-label asteriskRequired">@Resource1.Specialization</label>
                        <input type="text" disabled class="form-control bg-light" value="@(Model?.DepartmentsList?.FirstOrDefault(x => x.Value == Model.DepartmentId.ToString())?.Text)" readonly />
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                <label asp-for="Bio" class="form-label">@Resource2.Profile</label>
                        <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>
                    <div class="col-md-10">
                        <h5 class="form-label">@Resource2.UploadFile PDF</h5>
                        
                        <div class="input-group mb-2  d-flex align-items-center">
                            <input type="file" class="form-control rounded-2 " accept=".pdf" asp-for="Attachment">
                    <label class="rounded-2 upload-file-rtl upload-file-hover upload-file-ltr " asp-for="Attachment"><i class="fa-solid fa-upload fa-xl"></i></label>
                        </div>
                        @* Preview *@
                        @if (!string.IsNullOrEmpty(Model.Attachment_TempFilePath))
                        {
                            @* <img src="~/@Model.Attachment_TempFilePath.Replace("wwwroot/", "")" class="img-thumbnail mt-2" style="max-height:140px;" /> *@
                            <a href="~/@Model.Attachment_TempFilePath.Replace("wwwroot/", "")" target="_blank" class="eye-ii">
                                <i class="fa fa-eye"></i> @Resource3.ViewFile
                            </a>
                        }
                        else if (!string.IsNullOrEmpty(Model?.Attachment_OldPath))
                        {
                            <a href="~/@Model.Attachment_OldPath" target="_blank" class="eye-ii">
                                <i class="fa fa-eye"></i> @Resource3.ViewFile
                            </a>
                        }
                        <span asp-validation-for="Attachment" class="text-danger small"></span>
                    </div>
            <div class="col-md-2 d-flex align-items-center justify-content-end"><span class="d-inline-block mt-2 text-red"> @Resource3.MaximumFileSize5MB </span></div>
            <div class="d-flex align-items-center justify-content-end gap-3 mt-1">
                <button type="submit" class="btn-cancel-search btn btn-sm px-3">
                            <i class="fa-solid fa-floppy-disk me-1"></i>@Resource2.Save
                        </button>
                <a asp-action="Index" class="btn btn-success btn-sm  px-3">
                    @Resource2.Back <i class="fa-solid fa-arrow-left"></i>
                        </a>
                    </div>
                    </div>
            </form>
        </div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
