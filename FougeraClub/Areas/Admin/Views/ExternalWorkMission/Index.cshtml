@using Application.Helpers
@using Domain.DTOs.Admin
@using Domain.DTOs.Admin.SalaryManagement
@using FougeraClub.Areas.Admin.ViewModels.ExternalWorkMission
@model PaginatedList<ExternalWorkMissionVM>

@{
    ViewData["Title"] = Resource1.ExternalWorkMissionList;
    ViewData["Title pakage"] = @Resource1.ExternalWorkMissionManagement ?? " ";
    ViewData["Title Single"] = @Resource1.ExternalWorkMissionList ?? " ";
    var addPermission = PermissionScanner.ValidatePermission("ExternalWorkMission", "Add");
    var editPermission = PermissionScanner.ValidatePermission("ExternalWorkMission", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("ExternalWorkMission", "Delete");

    var lang = SessionHelper.GetCurrentLanguage();
    var AllEmployeesNames = ViewBag.EmployeesNames as IEnumerable<EmployeesNameDTO>;

}
<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteExternalWorkMissionModal" tabindex="-1"
    aria-labelledby="deleteExternalWorkMissionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-danger-header">
                <h5 class="modal-title" id="deleteExternalWorkMissionModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>@Resource1.ConfirmDelete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong class="modal1">@Resource1.ConfirmDelete:</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel-search" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>@Resource1.Cancel
                </button>
                <form id="deleteExternalWorkMissionForm" method="post" asp-action="Delete">
                    <input type="hidden" id="singleIdToDelete" name="id" value="" />
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-trash me-1"></i>@Resource1.Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Header with Title, Count, and Create Button -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <!-- Breadcrumb Navigation Column -->
    <div class="col-6">
        <nav aria-label="breadcrumb" class="ms-2">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <!-- Records Count Display Column -->
    <div class="col d-flex justify-content-end align-items-center text-nowrap me-3">
        <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
            <span>@Resource1.RecordsCount:</span>
            <span><label id="countRecords">@Model.Count </label></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <!-- Main card container for services data -->
        <div class="card">
            <!-- Card header with title and action buttons -->
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <!-- Page title section -->
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center col-md-6 flex-wrap">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <i
                                class="fa-solid fa-solid fa-briefcase me-1 text-ico"></i>@Resource1.ExternalWorkMissionList
                        </h4>
                    </div>
                </div>
                <!-- Action buttons section (Print, Export, Add, Toggle) -->
                <div class="d-flex align-items-center gap-2 flex-wrap" style="margin-left: 4px;">
                    @if (addPermission)
                    {
                        <a asp-action="AddEdit" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> @Resource1.CreateNew
                        </a>
                    }
                    <!-- Print report button -->
                    <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                        <i class="fa fa-print me-1"></i> @Resource2.Print
                    </button>

                    <script>
                        function openPrintPage() {
                            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
                            const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
                            const dateTo = encodeURIComponent(document.getElementById('dateTo').value);
                            var countRecords = document.getElementById('NewCountRecords').value;
                            if (countRecords && countRecords > 3999) {
                                showToastrCannotPrint(); // Toaster Can't Print more 3999 record
                            }
                            else {
                                const url = `/Admin/ExternalWorkMission/Print?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                                //window.open(url, '_blank'); //old For open in newTab but this freeze main page
                                // Open a standalone pop window (not a tab) so the original page doesn't freeze
                                const printWindow = window.open(
                                    url,
                                    'printWindow',
                                    'width=1000,height=800,noopener,noreferrer'
                                );
                            }
                        }

                    </script>

                    <!-- Print Export As Excel -->
                    <a class="btn btn-success Excelbtn" onclick="openExcelPage();">
                        <i class="fa-solid fa-file-excel me-2"
                            style="font-size:17px;"></i>@Resource1.createExcelReport_Download
                    </a>
                    <script>
                        function openExcelPage() {
                            const searchTerm = encodeURIComponent(document.getElementById('searchTermInput').value);
                            const dateFrom = encodeURIComponent(document.getElementById('dateFrom').value);
                            const dateTo = encodeURIComponent(document.getElementById('dateTo').value);

                            const url = `/Admin/ExternalWorkMission/createExcelReport_Download?searchTerm=${searchTerm}&dateFrom=${dateFrom}&dateTo=${dateTo}`;

                            window.open(url, '_self');
                        }

                    </script>
                </div>
            </div>

            <div class="rounded shadow-sm p-3">
                <!-- Search Panel -->
                <form method="get" id="singleFilterForm" class="filterImg rounded">
                    <div class="row p-2">
                        <div class="filter-dropdown col-md-4">
                            <label for="searchTermInput" class=" fw-bold mb-2">@Resource1.Search:</label>
                            <div class="search-box position-relative">
                                <i
                                    class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted"></i>
                                <input type="text" name="searchTerm" id="searchTermInput" value="@Model.SearchTerm"
                                    class="form-control form-control-sm filter-bordered ps-4"
                                    placeholder="@Resource1.Name ..." />
                            </div>
                        </div>
                        <div class="filter-dropdown col-md-4">
                            <label for="dateFrom" class="fw-semibold mb-2">@Resource1.DateFrom:</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                                    class="date-icon">
                                <input type="date" name="dateFrom" id="dateFrom"
                                    class="form-control form-select-sm filter-bordered" value="@ViewBag.DateFrom" />
                            </div>
                        </div>
                        <div class="filter-dropdown col-md-4">
                            <label for="dateTo" class=" fw-bold mb-2">@Resource1.DateTo:</label>
                            <div class="input-icon-left">
                                <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon"
                                    class="date-icon">
                                <input type="date" name="dateTo" id="dateTo"
                                    class="form-control form-select-sm filter-bordered" value="@ViewBag.DateTo" />
                            </div>
                        </div>
                    </div>
                    <!-- Filter Action Buttons -->
                    <div class="d-flex justify-content-end align-items-center p-2 gap-3 flex-wrap">
                        <button type="button" id="btnClearFilters" class="btn-cancel-search btn-sm btn">
                            <i class="fa-solid fa-xmark me-1"></i> @Resource2.Clear
                        </button>
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="ri-filter-line me-1"></i> @Resource1.Search
                        </button>
                    </div>
                </form>


                <!-- Table -->
                <div id="PartialNewListContainer">
                    @await Html.PartialAsync("_ListPartial", Model)
                </div>


            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="deleteInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Resource2.Sorry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="deleteInfoMessage" class="fw-bold text-center text-danger"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource1.Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        // Initialize tooltips
        function initTooltips() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }
        document.addEventListener('DOMContentLoaded', function () {
            initTooltips();
        });
    </script>

    <script>
        $(document).on("click", ".show-delete-info", function () {
            var message = $(this).data("message"); // take message from data-attribute
            $("#deleteInfoMessage").text(message);

            var modal = new bootstrap.Modal(document.getElementById("deleteInfoModal"));
            modal.show();
        });

    </script>

    <script>
        $(document).ready(function () {

            // We specify the storage key with the page name
            const pageKey = window.location.pathname + "_filters";

            // Retrieve stored filters when the page is opened
            if (sessionStorage.getItem(pageKey)) {
                let filters = JSON.parse(sessionStorage.getItem(pageKey));
                $('#searchTermInput').val(filters.searchTerm);
                $('#dateFrom').val(filters.dateFrom);
                $('#dateTo').val(filters.dateTo);
                $('#pageSizeSelect').val(filters.pageSize);

                // Load the list again with the old parameters
                loadNewPartialList(filters.page, filters.pageSize);
            }

            // When he click the search button
            $('form.filterImg').on('submit', function (e) {
                e.preventDefault();
                saveFilters(1); // We store from the first page
                loadNewPartialList(1);
            });

            // Clear Button
            $(document).on('click', '#btnClearFilters', function () {
                $('#searchTermInput').val('');
                $('#dateFrom').val('');
                $('#dateTo').val('');
                saveFilters(1);
                loadNewPartialList(1);
            });

            // Change the pagenation
            $(document).on('click', '.ajax-page', function () {
                var page = $(this).data('page');
                saveFilters(page);
                loadNewPartialList(page);
            });

            // Change the number of rows
            $(document).on('change', '#pageSizeSelect', function () {
                var pageSize = $(this).val();
                saveFilters(1, pageSize);
                loadNewPartialList(1, pageSize);
            });

            // function For Save The Last state
            function saveFilters(page, pageSizeOverride) {
                var filters = {
                    searchTerm: $('#searchTermInput').val(),
                    dateFrom: $('#dateFrom').val(),
                    dateTo: $('#dateTo').val(),
                    page: page,
                    pageSize: pageSizeOverride || $('#pageSizeSelect').val()
                };
                sessionStorage.setItem(pageKey, JSON.stringify(filters));
            }

            function loadNewPartialList(page, pageSizeOverride) {
                var searchTerm = $('#searchTermInput').val();
                var dateFrom = $('#dateFrom').val();
                var dateTo = $('#dateTo').val();
                var pageSize = pageSizeOverride || $('#pageSizeSelect').val();

                $.ajax({
                    url: '/Admin/ExternalWorkMission/Index',
                    type: 'GET',
                    data: { searchTerm, dateFrom, dateTo, page, pageSize },
                    beforeSend: function () {
                        $('#PartialNewListContainer').html('<div class="text-center p-5">Loading...</div>');
                    },
                    success: function (data) {
                        $('#PartialNewListContainer').html(data);
                        const newCountRecords = $('#NewCountRecords').val();
                        $('#countRecords').text(newCountRecords);
                        initTooltips(); // this Function for Reload Tootips Text after Ajax Called in index Pages or another page
                    },
                    error: function () {
                        $('#PartialNewListContainer').html('<div class="alert alert-danger">Error loading data</div>');
                    }
                });
            }
        });
    </script>
}