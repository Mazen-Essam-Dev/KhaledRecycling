@using Application.Helpers
@using Domain.DTOs.Admin
@using Domain.DTOs.Admin.SalaryManagement
@using FougeraClub.Areas.Admin.ViewModels.ExternalWorkMission
@model PaginatedList<ExternalWorkMissionVM>

@{
    ViewData["Title"] = Resource1.ExternalWorkMissionList;
    ViewData["Title pakage"] = @Resource1.ExternalWorkMissionManagement ?? " ";
    ViewData["Title Single"] = @Resource1.ExternalWorkMissionList ?? " ";
    var addPermission = PermissionScanner.ValidatePermission("ExternalWorkMission", "Add");
    var editPermission = PermissionScanner.ValidatePermission("ExternalWorkMission", "Edit");
    var deletePermission = PermissionScanner.ValidatePermission("ExternalWorkMission", "Delete");
    var lang = SessionHelper.GetCurrentLanguage();
    var AllEmployeesNames = ViewBag.EmployeesNames as IEnumerable<EmployeesNameDTO>;

}

<input type="hidden" id="NewCountRecords" value="@Model.Count" />
<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
    <label class="form-label mb-0" for="pageSizeSelect">@Resource2.PageSize:</label>
    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" style="width:74px;">
        @foreach (var s in new[] { 50, 100, 150 })
        {
            <option value="@s" selected="@(s == Model.PageSize)">@s</option>
        }
    </select>

</nav>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th style="width:27%;">@Resource1.Name</th>
                <th style="width:18%;">@Resource1.EmployeeJob</th>
                <th style="width:7%;">@Resource1.Date</th>
                <th style="width:11%;">@Resource1.MissionLocation</th>
                <th style="width:10%;">@Resource1.MissionCountry</th>
                <th style="width:25%;">@Resource1.MissionType1</th>
                <th style="width:8%;">@Resource1.Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items.Any())
            {
                foreach (var single in Model.Items)
                {
                    var employee = AllEmployeesNames?.FirstOrDefault(e => e.Id == single.EmployeeId);
                    var empName = lang == "ar" ? employee?.FullNameAr : employee?.FullNameEn;
                    var empJobTitle = employee?.JobTitle;
                    <tr data-id="@single.Id">
                        <td data-label="@Resource1.Name">
                            <span class="fw-medium">@empName</span>
                        </td>
                        <td data-label="@Resource1.EmployeeJob">
                            <span class="fw-medium">@empJobTitle</span>
                        </td>
                        <td data-label="@Resource1.Date">
                            <span>@(single.MissionDate?.ToString("d")?.Replace("/","-"))</span>
                        </td>
                        <td data-label="@Resource1.MissionLocation">
                            <span>@single.MissionLocation</span>
                        </td>
                        <td data-label="@Resource1.MissionCountry">
                            <span>@single.MissionCountry</span>
                        </td>
                        <td data-label="@Resource1.MissionType1">
                            @if (single.Missions.Count > 0) { single.Missions = single.Missions.DistinctBy(x => x.MessionKey).OrderBy(x => x.MessionKey).ToList(); }
                            @{
                                var missionsList = single.Missions.ToList();
                            }
                            @for (int i = 0; i < missionsList.Count; i++)
                            {
                                var missionTy = missionsList[i];
                                var missionTypeEnum = (MissionType)missionTy.MessionKey;
                                var missionTypeName = EnumHelper.GetDisplayName(missionTypeEnum);
                                <span>@missionTypeName@(i < missionsList.Count - 1 ? " - " : "")</span>
                            }
                        </td>
                        <td data-label="@Resource1.Actions">
                            <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Details">
                                <a asp-action="Details"
                                   asp-route-id="@single.Id"
                                   class="btn-control btn-icon btn-sm rounded-circle">
                                    <i class="fa-solid fa-eye fs-5"></i>
                                </a>
                            </span>
                            @if (editPermission && single.SignatureIdApproved == null)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a asp-action="AddEdit"
                                       asp-route-id="@single.Id"
                                       class="btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square  fs-5"></i>
                                    </a>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Edit">
                                    <a action="#" disabled
                                       class=" disabled btn-control-dis btn-control btn-icon btn-sm rounded-circle">
                                        <i class="fa-solid fa-pen-to-square  fs-5"></i>
                                    </a>
                                </span>
                            }
                            @if (deletePermission && single.SignatureIdApproved == null)
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form asp-action="Delete" asp-route-id="@single.Id" class="d-inline" method="post" data-swal="delete" data-message="@empName">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span data-bs-toggle="tooltip" data-bs-title="@Resource2.Delete">
                                    <form action="#" class="d-inline" method="post" data-swal="delete" data-message="@empName">
                                        <button type="button" disabled class=" disabled btn-control-dis  btn-control btn-icon btn-sm rounded-circle">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center p-5">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="ri-alert-line" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">@Resource1.NoData</h5>
                            <p class="mb-0">@Resource2.GoToCreatePage</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
    <ul class="pagination my-1">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex - 1)">
                @Resource2.Previous
            </a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a href="javascript:void(0)" class="page-link ajax-page" data-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a href="javascript:void(0)" class="page-link ajax-page"
               data-page="@(Model.PageIndex + 1)">
                @Resource2.Next
            </a>
        </li>
    </ul>
</nav>
