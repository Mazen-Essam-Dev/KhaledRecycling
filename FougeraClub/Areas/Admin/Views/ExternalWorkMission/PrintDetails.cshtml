@model ExternalWorkMissionVM

@using Application.Helpers
@using Domain.DTOs.Admin.SalaryManagement
@using FougeraClub.Areas.Admin.ViewModels.ExternalWorkMission
@using Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null; // No layout for print view
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "Unknown User";
    ViewData["Title"] = Resource1.ViewdetailsExternalworkMission;

    var lang = SessionHelper.GetCurrentLanguage();
    var AllEmployeesNames = ViewBag.EmployeesNames as IEnumerable<EmployeesNameDTO>;
    var AllMissionsChecked = Model?.Missions.Select(x => x.MessionKey).Distinct().ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="style.css" />
    <title>Document</title>
</head>
<body>
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap  border-bottom p-3  mb-3">
            <div class="d-flex justify-content-between align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
                </div>
            </div>
            <div class="flex-fill text-center">
                <center>
                    <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
                </center>
            </div>
            <div class="d-flex justify-content-end align-items-center flex-fill">
                <div style="text-align:center">
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                    <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                    <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                </div>
            </div>
        </div>
    </div>

    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@Resource1.Loading..</span>
        </div>
        <p class="loading-text">@Resource1.TheReportIsLoadingpleasewait..</p>
    </div>

    <main>
        <h3 class="text-center text-decoration-underline fw-bolder">@ViewData["Title"]</h3>
        <div class="container">
            <table>
                <tr>
                    <th class="bg-red text-white pe-2 w-25">@Resource1.Date :</th>
                    <th class="pe-2">@Model?.MissionDate?.ToString("d")?.Replace("/","-")</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.Employee_name :</th>
                    @if (SessionHelper.GetCurrentLanguage() == "ar")
                    {
                        <th class="pe-2">@Model?.Employee?.FullNameAr</th>
                    }
                    else
                    {
                        <th class="pe-2">@Model?.Employee?.FullNameEn</th>
                    }
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.EmployeeJob1 :</th>
                    <th class="pe-2">@ViewBag.selectedEmployeeJob</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.MissionLocation :</th>
                    <th class="pe-2">@Model?.MissionLocation</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.MissionCountry :</th>
                    <th class="pe-2">@Model?.MissionCountry</th>
                </tr>
                <tr>
                    <th class="bg-red text-white pe-2">@Resource1.MissionWorkDescription :</th>
                    <th class="pe-2">@Model?.MissionWorkDescription</th>
                </tr>
            </table>
            <div class="my-4 border-black">

                <table>
                    <thead>
                        <tr>
                            <th colspan="7" class="fs-5 fw-bolder text-center bg-green">
                                @Resource1.MissionDetails
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-6 w-25">@Resource1.MissionType1</td>
                            @if (AllMissionsChecked?.Count > 0)
                            {
                                @if (AllMissionsChecked.Contains((int)MissionType.Forum))
                                {
                                    <td>
                                        <input type="checkbox" id="input-one" checked class="border border-black border-2">
                                        <label for="input-one" class="">@Resource1.crossroads</label>
                                    </td>
                                }
                                @if (AllMissionsChecked.Contains((int)MissionType.Conference))
                                {
                                    <td>
                                        <input type="checkbox" id="input-one" checked class="border border-black border-2">
                                        <label for="input-one" class="">@Resource1.Conference</label>
                                    </td>
                                }
                                @if (AllMissionsChecked.Contains((int)MissionType.Exhibition))
                                {
                                    <td>
                                        <input type="checkbox" id="input-one" checked class="border border-black border-2 ">
                                        <label for="input-one" class="">@Resource1.Exhibition</label>
                                    </td>
                                }
                                @if (AllMissionsChecked.Contains((int)MissionType.Competition))
                                {
                                    <td>
                                        <input type="checkbox" id="input-one" checked class="border border-black border-2 ">
                                        <label for="input-one" class="">@Resource1.Competition</label>
                                    </td>
                                }
                                @if (AllMissionsChecked.Contains((int)MissionType.ClubEquipment))
                                {
                                    <td>
                                        <input type="checkbox" id="input-one" checked class="border border-black border-2 ">
                                        <label for="input-one" class="">@Resource1.ClubEquipment</label>
                                    </td>
                                }
                                @if (AllMissionsChecked.Contains((int)MissionType.ExchangeOrDelivery))
                                {
                                    <td>
                                        <input type="checkbox" id="input-one" checked class="border border-black border-2 ">
                                        <label for="input-one" class="">@Resource1.ExchangeOrDelivery</label>
                                    </td>
                                }

                            }

                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="my-4 border-black">
                <table>
                    <thead>
                        <tr>
                            <th colspan="4 " class="fs-5 fw-bolder text-center bg-green">
                                @Resource1.RequiredFinancialFees
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-6 w-25">@Resource1.PetroleumFees</td>
                            <td colspan="3" class="pe-2">@Model?.PetroleumFees</td>
                        </tr>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-6">@Resource1.FoodFees</td>
                            <td colspan="3" class="pe-2">@Model?.FoodFees</td>
                        </tr>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-6">@Resource1.MissionAllowance</td>
                            <td colspan="3" class="pe-2">@Model?.MissionAllowance</td>
                        </tr>
                        <tr>
                            <td class="bg-green p-2 fw-bold fs-6">@Resource1.Totals</td>
                            <td colspan="3" class="pe-2">@(Model?.MissionAllowance + Model?.FoodFees + Model?.PetroleumFees)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="my-1 border-black">
                <table>
                    <thead>
                        <tr>
                            <th colspan="4 " class="fs-5 fw-bolder text-center bg-green">
                                @Resource1.Candidates
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-2 fw-bold fs-6">@Model?.CandidateName1</td>
                            <td colspan="3" class="p-2">@Model?.CandidateAdj1</td>
                        </tr>
                        <tr>
                            <td class="px-2 fw-bold fs-6">@Model?.CandidateName2</td>
                            <td colspan="3" class="p-2">@Model?.CandidateAdj2</td>
                        </tr>
                        <tr>
                            <td class="px-2 fw-bold fs-6">@Model?.CandidateName3</td>
                            <td colspan="3" class="p-2">@Model?.CandidateAdj3</td>
                        </tr>
                        <tr>
                            <td class="px-2 fw-bold fs-6">@Model?.CandidateName4</td>
                            <td colspan="3" class="p-2">@Model?.CandidateAdj4</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Signature Section -->
            <div class="row g-3 mt-2">

                <!-- Signature Manager -->
                <div class="col-md-6 text-start text-bold fs-5">
                    <label class="form-label fw-semibold">@Resource1.SignatureManager</label>
                    @if (Model?.Signature != null)
                    {
                        <div class="col-md-4 text-center">
                            <div class="signature-trigger" role="button" tabindex="0" style="cursor:pointer;">
                                <div class="small text-muted">
                                    @if (!string.IsNullOrEmpty(Model?.Signature.ImagePath))
                                    {
                                        <div class="col-md-10 mg-2 mt-1 ms-3 m-4">
                                            <div class="card shadow-sm">
                                                <div class="card-body text-center">
                                                    <img src="~/@Model?.Signature.ImagePath" class="img-fluid rounded"
                                                         style="max-height: 200px;" alt="Upload one" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </main>

    <div class="footer">
        <p class="PrintedBy">Printed by : <span> @((currentUserName.IndexOf("@") > 1) ? currentUserName.Substring(0, currentUserName.IndexOf("@")) : currentUserName)  |  @AppDubaiTime.Now.ToString("dd/MM/yyyy, HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span> </p>
    </div>

    <script>

        // This Part Is Important
        window.addEventListener('load', () => {
            setTimeout(() => document.getElementById('loadingOverlay').style.display = 'none', 500);
            setTimeout(() => window.print(), 800);
        });
         // Close window after printing
            window.onafterprint = function() {
                setTimeout(function() {
                    window.close();
                }, 500);
            };
    </script>
</body>
</html>


<style>
    body {
        font-family: 'Arial', sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
        direction: rtl; /* Right to Left */
    }

    .header-container {
        width: 90%;
        margin: 50px auto;
    }

    .container {
        width: 90%;
        margin: 50px auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: transparent;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    th, td {
        padding: 12px;
        text-align: right; /* Right-aligned for Arabic text */
        border: 2px solid #000;
    }

        th:nth-child(1) {
            width: 200px; /* Column 1: الاسم */
        }

    .bg-red {
        background-color: rgb(167, 4, 4) !important;
    }

    td:nth-child(1) {
        width: 200px; /* Column 1: الاسم */
    }

    .bg-green {
        background-color: rgb(167, 192, 138) !important;
    }

    @@media print {
        .border-black {
            margin: 5px 0 !important;
            padding: 0 !important;
        }

        body {
            background: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            font-size: 12px;
            margin: 0 40px !important;
        }

        .container {
            width: 100%;
            margin: 0;
            padding: 0;
        }

        header, footer {
            page-break-after: avoid;
            page-break-before: avoid;
        }

        table {
            width: 100%;
            /* border-collapse: collapse; */
            box-shadow: none;
        }

        th, td {
            border: 1px solid #000 !important;
            padding: 1px !important;
        }

        .bg-red {
            background-color: #a70404 !important;
            color: #fff !important;
        }

        .bg-green {
            background-color: #a7c08a !important;
            color: #000 !important;
        }

        .no-print, .btn, .logo {
            width: 60px !important
        }

        .page-break {
            page-break-before: always;
        }
    }
</style>