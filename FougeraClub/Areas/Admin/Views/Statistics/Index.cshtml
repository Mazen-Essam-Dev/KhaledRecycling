@using System.Text.Json
@using KhaledTeamRecycling.Areas.Admin.ViewModels.Statistics
@model StatisticsVM

@{
    ViewData["Title"] = "الإحصائيات بالرسومات";
    var topUserLabels = Model.TopUsersByType.Select(x => x.UserTypeName).ToList();
    var topUserTotals = Model.TopUsersByType.Select(x => x.Total).ToList();
    var trackedTypes = new[] { 1, 2, 3 };

    var pendingUserTypeLabels = Model.PendingFinancialsByUserType.Select(x => x.Label).ToList();
    var pendingUserTypeCounts = Model.PendingFinancialsByUserType.Select(x => x.Count).ToList();

    var subProductLabels = Model.PendingFinancialsBySubProduct.Select(x => x.Label).ToList();
    var subProductCounts = Model.PendingFinancialsBySubProduct.Select(x => x.Count).ToList();

    var mainProductLabels = Model.PendingFinancialsByMainProduct.Select(x => x.Label).ToList();
    var mainProductCounts = Model.PendingFinancialsByMainProduct.Select(x => x.Count).ToList();

    var subWasteLabels = Model.PendingFinancialsBySubWaste.Select(x => x.Label).ToList();
    var subWasteCounts = Model.PendingFinancialsBySubWaste.Select(x => x.Count).ToList();

    var mainWasteLabels = Model.PendingFinancialsByMainWaste.Select(x => x.Label).ToList();
    var mainWasteCounts = Model.PendingFinancialsByMainWaste.Select(x => x.Count).ToList();
}

<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6 mb-2">
        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
            <span class="fa fa-chart-simple me-2 text-ico"></span>الإحصائيات بالرسومات
        </h4>
    </div>
    <div class="col-md-6 mb-2 d-flex justify-content-end">
        <button type="button" class="btn btn-success btn-sm" onclick="printCurrentPage()">
            <i class="fa fa-print me-1"></i>طباعة الصفحة
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small mb-2">إجمالي العمليات التي تم تنفيذها</div>
                <div class="fs-2 fw-bold text-success">@Model.TotalPendingFinancials</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small mb-2">إجمالي المستخدمين في الحاصلين على نقاط</div>
                <div class="fs-2 fw-bold text-primary">@Model.TotalUsersWithPoints</div>
            </div>
        </div>
    </div>
    @foreach (var item in Model.TopUsersByType)
    {
        <div class="col-xl-2 col-lg-4 col-md-6 col-sm-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">الأعلى في فئة @item.UserTypeName</div>
                    <div class="fw-bold mb-1">@item.UserName</div>
                    <div class="text-success">@item.Total.ToString("0.##")</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-6 col-lg-12">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">أعلى مستخدم حسب النوع بالمبالغ المتداولة</h5>
            </div>
            <div class="card-body">
                <canvas id="topUsersChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-12">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">عدد العمليات التي تم تنفيذها لكل نوع مستخدم</h5>
            </div>
            <div class="card-body">
                <canvas id="pendingByUserTypeChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    @foreach (var typeId in trackedTypes)
    {
        var amountChart = Model.TopUsersByAmountPerType.FirstOrDefault(x => x.UserTypeId == typeId);
        <div class="col-xl-4 col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 pt-3">
                    <h5 class="mb-0">أعلى 3 @((amountChart?.UserTypeName) ?? $"نوع {typeId}") حسب مبالغ التداول</h5>
                </div>
                <div class="card-body">
                    <canvas id="amountTopType@(typeId)" height="180"></canvas>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4 mb-4">
    @foreach (var typeId in trackedTypes)
    {
        var countChart = Model.TopUsersByPendingCountPerType.FirstOrDefault(x => x.UserTypeId == typeId);
        <div class="col-xl-4 col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 pt-3">
                    <h5 class="mb-0">أعلى 3 @((countChart?.UserTypeName) ?? $"نوع {typeId}") حسب عدد عمليات تم تنفيذها</h5>
                </div>
                <div class="card-body">
                    <canvas id="countTopType@(typeId)" height="180"></canvas>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-6 col-lg-12">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">العمليات التي تم تنفيذها على المنتجات الفرعية (فرعي - أساسي)</h5>
            </div>
            <div class="card-body">
                <canvas id="subProductsChart" height="180"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-12">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">العمليات التي تم تنفيذها على المنتجات الأساسية</h5>
            </div>
            <div class="card-body">
                <canvas id="mainProductsChart" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-6 col-lg-12">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">العمليات التي تم تنفيذها على النفايات الفرعية (فرعي - أساسي)</h5>
            </div>
            <div class="card-body">
                <canvas id="subWastesChart" height="180"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-12">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">العمليات التي تم تنفيذها على النفايات الأساسية</h5>
            </div>
            <div class="card-body">
                <canvas id="mainWastesChart" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function printCurrentPage() {
            window.print();
        }

        const palette = [
            '#198754',
            '#0d6efd',
            '#ffc107',
            '#dc3545',
            '#6f42c1',
            '#20c997',
            '#fd7e14',
            '#6610f2',
            '#6c757d',
            '#198754aa',
            '#0d6efdaa'
        ];

        function normalizeChartData(labels, data) {
            if (!labels || labels.length === 0 || !data || data.length === 0) {
                return {
                    labels: ['لا توجد بيانات'],
                    data: [0]
                };
            }

            return { labels, data };
        }

        function createChart(id, type, labels, data, datasetLabel, horizontal = false, integerTicks = true) {
            const normalized = normalizeChartData(labels, data);
            const backgroundColors = normalized.labels.map((_, index) => palette[index % palette.length]);

            new Chart(document.getElementById(id), {
                type: type,
                data: {
                    labels: normalized.labels,
                    datasets: [{
                        label: datasetLabel,
                        data: normalized.data,
                        backgroundColor: backgroundColors,
                        borderColor: backgroundColors,
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: horizontal ? 'y' : 'x',
                    plugins: {
                        legend: {
                            display: type === 'doughnut' || type === 'pie'
                        }
                    },
                    scales: type === 'doughnut' || type === 'pie'
                        ? {}
                        : {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: integerTicks ? 0 : 2
                                }
                            }
                        }
                }
            });
        }

        createChart(
            'topUsersChart',
            'bar',
            @Html.Raw(JsonSerializer.Serialize(topUserLabels)),
            @Html.Raw(JsonSerializer.Serialize(topUserTotals)),
            'إجمالي Totals'
        );

        createChart(
            'pendingByUserTypeChart',
            'doughnut',
            @Html.Raw(JsonSerializer.Serialize(pendingUserTypeLabels)),
            @Html.Raw(JsonSerializer.Serialize(pendingUserTypeCounts)),
            'عدد الماليات'
        );

        @foreach (var typeId in trackedTypes)
        {
            var amountChart = Model.TopUsersByAmountPerType.FirstOrDefault(x => x.UserTypeId == typeId);
            var amountLabels = amountChart?.AmountItems.Select(x => x.Label).ToList() ?? new List<string>();
            var amountValues = amountChart?.AmountItems.Select(x => x.Value).ToList() ?? new List<decimal>();
            <text>
        createChart(
            'amountTopType@(typeId)',
            'bar',
            @Html.Raw(JsonSerializer.Serialize(amountLabels)),
            @Html.Raw(JsonSerializer.Serialize(amountValues)),
            'إجمالي مبلغ التداول',
            true,
            false
        );
            </text>
        }

        @foreach (var typeId in trackedTypes)
        {
            var countChart = Model.TopUsersByPendingCountPerType.FirstOrDefault(x => x.UserTypeId == typeId);
            var countLabels = countChart?.CountItems.Select(x => x.Label).ToList() ?? new List<string>();
            var countValues = countChart?.CountItems.Select(x => x.Count).ToList() ?? new List<int>();
            <text>
        createChart(
            'countTopType@(typeId)',
            'bar',
            @Html.Raw(JsonSerializer.Serialize(countLabels)),
            @Html.Raw(JsonSerializer.Serialize(countValues)),
            'عدد عمليات تم تنفيذها',
            true
        );
            </text>
        }

        createChart(
            'subProductsChart',
            'bar',
            @Html.Raw(JsonSerializer.Serialize(subProductLabels)),
            @Html.Raw(JsonSerializer.Serialize(subProductCounts)),
            'عدد الماليات',
            true
        );

        createChart(
            'mainProductsChart',
            'pie',
            @Html.Raw(JsonSerializer.Serialize(mainProductLabels)),
            @Html.Raw(JsonSerializer.Serialize(mainProductCounts)),
            'عدد الماليات'
        );

        createChart(
            'subWastesChart',
            'bar',
            @Html.Raw(JsonSerializer.Serialize(subWasteLabels)),
            @Html.Raw(JsonSerializer.Serialize(subWasteCounts)),
            'عدد الماليات',
            true
        );

        createChart(
            'mainWastesChart',
            'pie',
            @Html.Raw(JsonSerializer.Serialize(mainWasteLabels)),
            @Html.Raw(JsonSerializer.Serialize(mainWasteCounts)),
            'عدد الماليات'
        );
    </script>
}
