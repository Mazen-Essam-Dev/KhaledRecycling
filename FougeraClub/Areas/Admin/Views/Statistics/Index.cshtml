@using KhaledTeamRecycling.Areas.Admin.ViewModels.Statistics
@model StatisticsVM
@{
    ViewData["Title"] = Resource1.Statistics;
    ViewData["Title pakage"] = @Resource1.ActivitiesManagement ?? " ";
    ViewData["Title Single"] = @Resource1.Statistics ?? " ";
}
<!-- Breadcrumb & Record Count -->
<div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 py-2 flex-nowrap">

                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title pakage"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewData["Title Single"]</a>
                </li>
            </ol>
        </nav>
    </div>
    <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">

        @* <button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
            <i class="fa fa-print me-1"></i> @Resource2.Print
        </button> *@
        <!-- Print Scripts -->
        <script>
            function openPrintPage() {
                    const url = `/Admin/Statistics/Print`;
                    window.open(url, 'printWindow', 'width=1000,height=800,noopener,noreferrer');               
            }

        </script>
    </div>


</div>
<div class="row">
    <div class="card">
    <div class="col-12">
    
            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <!-- Page title section -->
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <span class="fa fa-chart-simple me-2 text-ico"></span>
                            @ViewData["Title"]
                        </h4>
                    </div>
                </div>

            </div>
        </div>


        <div class="container">
        <div class="row">
        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <div class="icon_box_all style_one shadow-sm rounded-3 ">
                <div class="icon_content  icon_centers ">
                    <div class="icon">
                            <span class="fas fa-bullhorn fs-2"></span>
                    </div>
                    <div class="txt_content">
                        <h3> @Resource1.TotalActivityParticipants</h3>
                        <p class="fw-bold"> @Model.TotalInActivities</p>
                    </div>
                </div>
                <div class="shape-decoration"></div>
            </div>
        </div>
        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <div class="icon_box_all style_one shadow-sm rounded-3 ">
                <div class="icon_content  icon_centers ">
                    <div class="icon">
                            <span class="fas fa-book-open fs-2"></span>
                    </div>
                    <div class="txt_content">
                        <h3>@Resource1.TotalCourseParticipants</h3>
                        <p class="fw-bold">@Model.TotalInCourses</p>
                    </div>
                </div>
                <div class="shape-decoration"></div>
            </div>
        </div>

        </div>
    </div>

        <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">

            <div class="flex-grow-1">
                <div class="d-flex align-items-center">
                    <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                        <span class="fa fa-chart-pie me-2 text-ico"></span>
                        @Resource1.AgePercentagesofParticipants
                    </h4>
                </div>
            </div>


        </div>
        <div class="container">
        <div class="row">
        @foreach (var age in Model.AgeGroupStats)
        {
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                <div class="icon_box_all style_one shadow-sm rounded-3 ">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@age.Label</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>
              
                    <div>
                        <h3>@age.Percentage%</h3>
                        <p class="fw-bold">@age.Count @Resource1.Participants</p>
                    </div>

                    <div class="shape-decoration"></div>
                </div>
            </div>
        }

        </div>
        </div>

        <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center">
                    <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                        <span class="fas fa-bookmark me-2 text-ico"></span>
                        @Resource1.Courseparticipationforeachdepartment
                    </h4>
                </div>
            </div>
        </div>
         <div class="container">
        <div class="row">
            @foreach (var course in Model.CourseDepartmentCategoryStats)
            {

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="icon_box_all style_one shadow-sm rounded-3 ">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@course.Label</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>

                        <div>
                            <h3>@course.Percentage%</h3>
                            <p class="fw-bold">@course.Count @Resource1.Participants</p>
                        </div>

                        <div class="shape-decoration"></div>
                    </div>
                </div>
            }

        </div>
        </div>




        <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center">
                    <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                        <span class="fas fa-venus-mars me-2 text-ico"></span>
                        @Resource1.RatioMalesFemales
                    </h4>
                </div>
            </div>
        </div>

        <div class="container">
         <div class="row">
       
            @foreach (var gender in Model.GenderStats)
            {

                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                    <div class="icon_box_all style_one shadow-sm rounded-3 ">
                        <div class="text-left sec-title">
                            <div class="lg-title">
                                <h1>@gender.Label</h1>
                            </div>
                            <div class="title-sep-left"></div>
                            <div class="title-sep-sm-left"></div>
                        </div>

                        <div>
                            <h3>@gender.Percentage%</h3>
                            <p class="fw-bold">@gender.Count @Resource1.Participants</p>
                        </div>

                        <div class="shape-decoration"></div>
                    </div>
                </div>
            }
                </div>
        </div>

            <div class="card-header border-bottom card-tabs d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <span class="fas fa-globe me-2 text-ico"></span>
                            @Resource1.RatioResidentsCitizens
                        </h4>
                    </div>
                </div>
            </div>

        <div class="container">
            <div class="row">
                @foreach (var residentsOrCitizen in Model.ResidentsAndCitizensStats)
                {

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="icon_box_all style_one shadow-sm rounded-3 ">
                            <div class="text-left sec-title">
                                <div class="lg-title">
                                    <h1>@residentsOrCitizen.Label</h1>
                                </div>
                                <div class="title-sep-left"></div>
                                <div class="title-sep-sm-left"></div>
                            </div>

                            <div>
                                <h3>@residentsOrCitizen.Percentage%</h3>
                                <p class="fw-bold">@residentsOrCitizen.Count @Resource1.Participants</p>
                            </div>

                            <div class="shape-decoration"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts { 
    
   

    @if (ViewData["ShowToastrLoginSuccesfullyLoggedIn_Admin"] != null && (bool)ViewData["ShowToastrLoginSuccesfullyLoggedIn_Admin"] == true)
    {
        <script>
            // Toaster For you Logged In Succesfully
            function ShowToastrLoginSuccesfullyLoggedIn() {
              toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-center",
                "timeOut": "3000"
              };
              var textmessage ='@Html.Raw(Resource1.HelloYouloggedInSuccessfully)';

              toastr.success(textmessage);
            }
        </script>
    }
    
} 