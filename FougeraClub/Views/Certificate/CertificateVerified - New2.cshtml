@using Domain.Resources
@using FougeraClub.Areas.Admin.ViewModels.Course
@using FougeraClub.Helpers

@model CertificateVM
@{
    Layout = null;
    ViewData["Title"] = Resource1.CertificateVerification;
    var lang = SessionHelper.GetCurrentLanguage();
    var memberName = lang == "ar" ? Model.MemberNameAr : Model.MemberNameEn;
    var CourseTitle = lang == "ar" ? Model.CourseTitleAr : Model.CourseTitleEn;
    var dateFormat = "dd-MMMM-yyyy";
    var startDate = Model.StartDate.ToString(dateFormat) + " ";
    var EndDate = Model.EndDate.ToString(dateFormat) + " ";
    var EndDate2 = Model.EndDate.ToString("dd/MM/yyyy");
    var year00 = Model.EndDate.ToString("yy");
    var certificateSerial = $"S.N. FSC-{year00}/{Model.CertificateSerial}";
    var gender = (Model.GenderId == 2) ? Resource1.MemberWoman : Resource1.MemberMale;
    var nameWithGender = memberName;
    var AttendedParticipatedwiththeclubonlinetrainingworkshop = (Model.GenderId == 2) ?
        Resource1.AttendedParticipatedwiththeclubonlinetrainingworkshop :
        Resource1.MaleAttendedParticipatedwiththeclubonlinetrainingworkshop;
}


<!DOCTYPE html>
<html lang="@lang" dir="@(lang == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico" />
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css" />
    <!-- Custom CSS -->
    <link href="~/assets/css/memberlogin.css" rel="stylesheet" />
    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        /* Custom radio button style with hollow circle */
        #languageSelector .form-check-input[type="radio"] {
            width: 20px;
            height: 20px;
            border: 2px solid #198754;
            border-radius: 50%;
            background-color: transparent;
            cursor: pointer;
            position: relative;
            appearance: none;
            -webkit-appearance: none;
        }

        #languageSelector .form-check-input[type="radio"]:checked {
            background-color: transparent;
            border-color: #198754;
        }

        #languageSelector .form-check-input[type="radio"]:checked::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #198754;
        }

        #languageSelector .form-check-input[type="radio"]:focus {
            box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
            border-color: #198754;
        }
    </style>
    <style>
        :root {
            --green: #47A644;
            --green-dark: #28a745;
            --red: #dc3545;
            --red-dark: #a71d2a;
            --text: #555;
            --bg: #f4f7fb;
            --card-bg: rgba(255, 255, 255, 0.95);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", Tahoma, sans-serif;
        }

        body {
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
        }

        /* Centering wrapper */
        .page {
            /* position: fixed; */
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Background blobs */
        .blob {
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.6;
            z-index: 0;
        }

            .blob.green {
                background: var(--green);
                top: -120px;
                right: -120px;
            }

            .blob.red {
                background: var(--green);
                bottom: -120px;
                left: -120px;
            }

        /* Card */
        .card {
            position: relative;
            z-index: 1;
            max-width: 480px;
            width: 100%;
            padding: 2.5rem 2rem;
            text-align: center;
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            border-radius: 18px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.08);
            margin-inline: auto;
        }

        .icon {
            font-size: 2.8rem;
            margin-bottom: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            color: #fff;
        }

        .verified .icon {
            background: linear-gradient(135deg, var(--green-dark), var(--green));
        }

        .not-valid .icon {
            background: linear-gradient(135deg, var(--red-dark), var(--red));
        }

        h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        p {
            font-size: 0.95rem;
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        .club-name {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--green);
            margin-bottom: 1.5rem;
        }

        .btn-success {
            padding: 0.6rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 8px;
            border: none;
            background-color: var(--green);
            color: #fff;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .btn-success:hover {
                background-color: var(--green-dark);
            }

        @@media (max-width: 576px) {
            .card {
                padding: 2rem 1.5rem;
            }

            .icon {
                width: 70px;
                height: 70px;
                font-size: 2.4rem;
            }

            h1 {
                font-size: 1.3rem;
            }
        }

        /* Navbar */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 2rem;
            background-color: #ffffff;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
            border-radius: 12px;
            margin: 1rem;
            flex-wrap: wrap;
            z-index: 1000;
        }

        /* Left side: logo + site name */
        .nav-left {
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .navbar-logo {
            height: 40px;
            width: auto;
            border-radius: 6px;
            object-fit: contain;
        }

        .site-name {
            font-size: 1.25rem;
            font-weight: 700;
            color: #47A644; /* brand green */
            white-space: nowrap;
        }

        /* Right side: language + logout buttons */
        .nav-right {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        /* Language / logout buttons */
        .lang-btn {
            padding: 0.35rem 0.8rem;
            font-size: 0.9rem;
            font-weight: 600;
            color: #47A644;
            border: 1px solid #47A644;
            border-radius: 6px;
            text-decoration: none;
            transition: all 0.2s ease-in-out;
        }

            .lang-btn:hover {
                background-color: #47A644;
                color: #fff;
                box-shadow: 0 4px 12px rgba(71, 166, 68, 0.4);
                transform: translateY(-1px);
            }

        /* Logout icon styling */
        .nav-right .fa-arrow-right {
            font-size: 1rem;
        }

        /* Responsive */
        @@media (max-width: 576px) {
            .navbar {
                flex-direction: column;
                align-items: flex-start;
                padding: 1rem;
                gap: 0.5rem;
            }

            .nav-right {
                width: 100%;
                justify-content: flex-end;
            }
        }
    </style>
</head>

<body>
            <div class="container-page">

        <div class="form-con">



            <div class="page" @* style="position: fixed;z-index: 9999;    transform: translate(-36%, -30%) !important;" *@ style="transform: translate(-31%, -17%) !important;">
                    <!-- Background blobs -->

                    <!-- Centered Card -->
                    <main class="card">
                        @if (Model.IsValid)
                        {
                            <div class="verified">
                                <div class="icon">✔</div>
                                <h1>@Resource1.ResourceManager.GetString("CertificateVerified_Verified")</h1>
                                <p>@Resource1.ResourceManager.GetString("CertificateVerified_IssuedBy")</p>
                                <div class="club-name">@Resource1.ResourceManager.GetString("CertificateVerified_ClubName")</div>
                                <button onclick="PrintCertificate(@Model.Id)" class="btn-success">
                                    @Resource1.ViewOriginalCertificate
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="not-valid">
                                <div class="icon">✖</div>
                                <h1>@Resource1.ResourceManager.GetString("CertificateVerified_NotValid")</h1>
                                <p>@Resource1.ResourceManager.GetString("CertificateVerified_Invalid")</p>
                                <div class="club-name">@Resource1.ResourceManager.GetString("CertificateVerified_ClubName")</div>
                            </div>
                        }
                    </main>
            </div>
        </div>

              
            </div>


    <!-- Scripts -->
    <script src="~/bootstrap/bootstrap-5.3.8-dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function PrintCertificate(subscriptionId) {
            const url = `/Certificate/PrintCertificate?subscriptionId=${subscriptionId}`;
            const printWindow = window.open(url, 'printWindow', 'width=1500,height=800,noopener,noreferrer');
        }
    </script>
    <script>
        const form = document.getElementById("account");
        const loader = document.querySelector(".loader");
        const loginText = document.querySelector(".login");

        form.addEventListener("submit", async function (e) {
            // Show loading when user submits
            loader.classList.remove("d-none");
            loginText.classList.add("d-none");

            // Allow normal form submit
            // Wait a small delay for UI to update
            await new Promise(resolve => setTimeout(resolve, 50));

            // The form will now submit and reload/redirect
            // If an error occurs (like validation), Razor will rerender the page with error messages.
            // So we detect if that happens and hide the loader again.
        });

        // After page reload (when validation errors appear)
        window.addEventListener("DOMContentLoaded", function () {
            const validationSummary = document.querySelector("[asp-validation-summary]");
            // If there are validation errors, hide loader again
            if (validationSummary && validationSummary.textContent.trim() !== "") {
                loader.classList.remove("d-block");
                loader.classList.add("d-none");
                loginText.classList.remove("d-none");
            }
        });
          // Toggle password visibility
          function togglePassword(inputId, iconElement) {
              const input = document.getElementById(inputId);
              if (input.type === "password") {
                  input.type = "text";
                  iconElement.classList.remove("fa-eye");
                  iconElement.classList.add("fa-eye-slash");
              } else {
                  input.type = "password";
                  iconElement.classList.remove("fa-eye-slash");
                  iconElement.classList.add("fa-eye");
              }
          }
    </script>
    <script>
        // Loading button animation
        const loadingBtn = document.querySelector(".loadind-btn");
        if (loadingBtn) {
            loadingBtn.addEventListener("click", function () {
                const loader = document.querySelector(".spinner");
                const loginText = document.querySelector(".login");
                loader.classList.remove('d-none');
                loginText.classList.add('d-none');
            });
        }

        // Toggle password visibility
        function togglePassword(inputId, iconElement) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
            }
        }

        // Language switcher with radio buttons
        document.addEventListener('DOMContentLoaded', function () {
            const enRadio = document.getElementById('langEn');
            const arRadio = document.getElementById('langAr');
            
            if (enRadio && arRadio) {
                enRadio.addEventListener('change', function () {
                    if (this.checked) {
                        window.location.href = '/Member/Home/ChangeLanguage?lang=en';
                    }
                });
                arRadio.addEventListener('change', function () {
                    if (this.checked) {
                        window.location.href = '/Member/Home/ChangeLanguage?lang=ar';
                    }
                });
            }
        });
    </script>
</body>
</html>
