@using Domain.Resources
@using KhaledTeamRecycling.Areas.Admin.ViewModels.Course
@using KhaledTeamRecycling.Helpers

@model CertificateVM
@{
    var lang = SessionHelper.GetCurrentLanguage();
    var memberName = lang == "ar" ? Model.MemberNameAr : Model.MemberNameEn;
    var CourseTitle = lang == "ar" ? Model.CourseTitleAr : Model.CourseTitleEn;
    var dateFormat = "dd-MMMM-yyyy";

    var startDate = Model.StartDate.ToString(dateFormat) + " " /* + Resource1.millad */;
    var EndDate = Model.EndDate.ToString(dateFormat) + " " /* + Resource1.millad */;
    var EndDate2 = Model.EndDate.ToString("dd/MM/yyyy");

    var year00 = Model.EndDate.ToString("yy");
    var certificateSerial = $"S.N. FSC-{year00}/{Model.CertificateSerial}";
    var gender = (Model.GenderId == 2) ? Resource1.MemberWoman : Resource1.MemberMale;
    var nameWithGender = /* gender + " / " + */ memberName;
    var AttendedParticipatedwiththeclubonlinetrainingworkshop = (Model.GenderId == 2) ?
    Resource1.AttendedParticipatedwiththeclubonlinetrainingworkshop :
    Resource1.MaleAttendedParticipatedwiththeclubonlinetrainingworkshop;

    Layout = null;
}

<!doctype html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Resource1.CertificateAttendanceAndParticipation</title>

    <!-- Certificate StyleSheet -->
    <link rel="stylesheet" src="~/assets\css\CertificateStyleSheet.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">

    <!-- Arabic font (Google Fonts) -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- Get All Fonts Styles -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri&display=swap" rel="stylesheet">


    <link href="~/ar/assets/css/report-rtl.css" rel="stylesheet" />
    @*  @if (lang == "ar")
    {
        <link href="~/ar/assets/css/report-rtl.css" rel="stylesheet" />
    } *@
    @*    else
    {
        <link href="~/ar/assets/css/report-ltr.css" rel="stylesheet" />
    } *@

    <style>
        :root {
            --gold: #c9a227;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: #eee;
            padding: 30px;
            max-height: 500px !important;
        }

        /* ====== OUTER WRAPPER ====== */
        .certificate-wrap {
            max-width: 1200px;
            margin: auto;
            background: #fff;
            padding: 20px;
        }

        /* ====== Triple Gold Frame ====== */
        .certificate-frame {
            border: 6px solid var(--gold);
            padding: 6px;
        }

        .certificate-frame-inner {
            border: 3px solid var(--gold);
            padding: 6px;
        }

        .certificate-content {
            border: 2px solid var(--gold);
            padding: 12px 76px;
            min-height: auto;
            position: relative;
        }

        /* ====== TITLE ====== */
        .cert-title {
            font-family: 'Cairo', Andalus;
            font-size: 53px;
            font-weight: 800;
            color: var(--gold);
            text-align: center;
            margin-bottom: 20px;
        }

        /* ====== Subtitle ====== */
        .cert-sub {
            text-align: center;
            font-size: 26px;
            color: #c00000;
            font-weight: 700;
        }


        .new-margin1 {
        }

        /* ====== Name ====== */
        .participant-name {
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            margin: 20px 0;
            margin-top: -50px;
        }

        /* ====== Main Text ====== */
        .cert-text {
            text-align: center;
            font-size: 23px;
            line-height: 2.2;
            margin-top: -13px;
        }

        .margintop2 {
            margin-top: 14px;
        }
        /* ====== Footer ====== */
        .footer-area {
            position: absolute;
            bottom: -86px;
            left: 70px;
            right: 70px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 114px;
        }

        .signature {
            text-align: center;
            font-size: 20px;
        }

        .serial {
            font-size: 14px;
        }

        .qr img {
            width: 110px;
        }
        /* responsive adjustments */
        @@media (max-width: 768px) {
            .cert-title {
                font-family: 'Cairo', Andalus;
                font-size: 20px;
            }

            .participant-name {
                font-size: 20px;
                padding: 6px 12px;
                margin-top: -50px;
            }

            .certificate-inner {
                max-height: 640px;
            }
        }

        @@media print {
            @@page {
                size: A4 landscape;
                margin: 20mm 1mm; /* يتحكم في المسافة فوق وتحت */
            }

            body {
                font-family: 'Cairo', sans-serif;
                background: #eee;
                padding: 52px 0 !important;
                max-height: 500px !important;
            }
            /* ====== OUTER WRAPPER ====== */
            .certificate-wrap {
                max-width: 1200px;
                margin: auto;
                background: #fff;
                padding: 20px;
            }
            /* ====== Triple Gold Frame ====== */
            .certificate-frame {
                border: 6px solid var(--gold);
                padding: 6px;
            }

            .certificate-frame-inner {
                border: 3px solid var(--gold);
                padding: 6px;
            }

            .certificate-content {
                border: 2px solid var(--gold);
                padding: 12px 76px;
                min-height: auto;
                position: relative;
            }
            /* ====== TITLE ====== */
            .cert-title {
                font-family: 'Cairo', Andalus;
                font-size: 53px;
                font-weight: 800;
                color: var(--gold);
                text-align: center;
                margin-bottom: 15px;
            }
            /* ====== Subtitle ====== */
            .cert-sub {
                text-align: center;
                font-size: 30px;
                color: #c00000;
                font-weight: 700;
            }

            .margintop2 {
                margin-top: 5.5px;
            }
            /* ====== Name ====== */
            .participant-name {
                font-size: 30px;
                font-weight: bold;
                text-align: center;
                margin: -4px 0;
                margin-top: -35px;
            }
            /* ====== Main Text ====== */
            .cert-text {
                text-align: center;
                font-size: 23px;
                line-height: 1.2;
                margin-top: 30px;
            }

            .new-margin1 {
                margin-top: 9px;
            }
            /* ====== Footer ====== */
            .footer-area {
                position: absolute;
                left: 70px;
                right: 70px;
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                margin-bottom: 124px;
            }

            .signature {
                text-align: center;
                font-size: 20px;
            }

            .serial {
                font-size: 20px;
                margin: 0px 49px;
                /* margin-inline-start: 67px; */
                margin-left: -188px;
            }

            .qr img {
                width: 110px;
            }
            /* Shrink content if needed to fit */
            html,
            body {
                zoom: 0.95;
                max-height: 400px !important;
                /* adjust this between 0.7 - 0.95 until it fits */
            }
        }
    </style>

</head>
<body style="background-color: white !important;">

    <div id="report">
        <!-- Loading Overlay -->
        <div id="loadingOverlay" class="loading-overlay">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">@Resource1.Loading..</span>
            </div>
            <p class="loading-text">@Resource1.TheReportIsLoadingpleasewait..</p>
        </div>


        <div class="certificate-wrap">
            <div class="certificate-frame">
                <div class="certificate-frame-inner">
                    <div class="certificate-content" style="line-height: 1;display: flex;flex-direction: column;gap: 3px;">

                        <!-- Top Logos -->
                        <div class="d-flex justify-content-between">
                            <img src="~/assets/images/certificate/master_logo.png" width="160" height="180" style="margin-inline-start: -46px; margin-inline-end: 112px;">

                            <div style="margin-inline-start: -47px; margin-inline-end: 48px;">
                                <!-- Title -->
                                <div class="cert-title">
                                    @Resource1.CertificateAttendanceParticipation
                                </div>

                                <div class="cert-sub margintop2">
                                    @Resource1.FujairahScientificClubwitnesses
                                </div>

                                <div class="cert-sub margintop2" style="color: #0a7a2f;">
                                    @Resource1.AccordingThisTestimony
                                </div>
                            </div>

                            <img src="~/assets/images/certificate/right_logo.png" width="160" height="180" style="margin-inline-start: 39px; margin-inline-end: -59px;">
                        </div>



                        <div class="participant-name" style="color: black;">
                            @nameWithGender
                        </div>
                        <br />
                        <div class="cert-text new-margin1 ">
                            @if (lang == "ar")
                            {
                                @if (Model.GenderId == 2) //Female
                                {
                                    <strong style="font-size:28px !important;"> قد حضرت وشاركت بفعالية ونجاح في</strong>
                                }
                                else
                                {
                                    <strong style="font-size:28px !important;"> قد حضر وشارك بفعالية ونجاح في</strong>
                                }
                            }
                            else // English
                            {
                                @if (Model.GenderId == 2) //Female
                                {
                                    <strong style="font-size:23px !important;"> Has successfully attended and actively participated in</strong>
                                }
                                else
                                {
                                    <strong style="font-size:23px !important;"> Has successfully attended and actively participated in</strong>
                                }
                            }


                            <br />
                            @if (lang == "ar")
                            {
                                <strong style="font-size:28px !important;">@CourseTitle</strong>

                            }
                            else
                            {
                                <strong style="font-size:23px !important;">@CourseTitle</strong>
                            }
                            <br />
                            <br />


                            <strong>@Resource1.duringPeriodFrom</strong>
                            @startDate

                            <strong>@Resource1.To1</strong>
                            @EndDate

                            <br /><br />
                            @if (lang == "ar")
                            {
                                <div style="font-weight: bold !important;">
                                    @Resource1.part1Cert
                                    <br />
                                    @Resource1.part2Cert
                                </div>
                            }
                            else
                            {
                                <div style="font-size: 18.5px !important; margin-top: -20px !important; font-weight: bold !important;">
                                    Demonstrating scientific engagement, academic commitment, and effective participation
                                    <br />
                                    .in accordance with the standards of Fujairah Science Club
                                    <br />
                                    ,This Certificate is awarded in recognition of the above participation
                                    <br />
                                    .With our sincere wishes for continued success and excellence
                                </div>
                            }

                        </div>



                        @if (lang == "ar")
                        {

                            <!-- Footer -->
                            <div class="footer-area">

                                <!-- QR Right -->
                                <div class="qr d-flex">

                                    @if (Model.QrCodeBase64 != null)
                                    {
                                        <img src="data:image/png;base64,@Model.QrCodeBase64"
                                             alt="QR Code"
                                             style="width:117px;height:117px;" />
                                    }
                                    else
                                    {
                                        <img src="~/assets/images/qrTest.png" style="width:117px;height:117px;" />
                                    }

                                    <div style="font-size:19px; font-weight: bold; margin-top: 70px !important; margin-inline-start: 10px !important;">
                                        حررت بتاريخ: @EndDate2
                                    </div>
                                </div>

                                <!-- Signature Center -->
                                <div class="signature">
                                    <strong> مــــــديـــــــــــر عــــــــــــــــام</strong>
                                    <br>
                                    <br>
                                    <strong>نـــادي الفجيــرة العلمــي</strong>
                                    <br>
                                    <br>
                                    <br>

                                </div>

                            </div>
                        }
                        else
                        {

                            <!-- Footer -->
                            <div class="footer-area">

                                <!-- Signature Center -->
                                <div class="signature">
                                    <strong> General Manager</strong>
                                    <br>
                                    <br>
                                    <strong>Fujairah Scientific Club</strong>
                                    <br>
                                    <br>
                                    <br>

                                </div>

                                <!-- QR Right -->
                                <div class="qr d-flex">
                                    <div style="font-size:19px; font-weight: bold; margin-top: 70px; margin-inline-start: 10px !important;">
                                        Held On: @EndDate2
                                    </div>
                                    @if (Model.QrCodeBase64 != null)
                                    {
                                        <img src="data:image/png;base64,@Model.QrCodeBase64"
                                             alt="QR Code"
                                             style="width:117px;height:117px;" />
                                    }
                                    else
                                    {
                                        <img src="~/assets/images/qrTest.png" style="width:117px;height:117px;" />
                                    }
                                </div>

                            </div>
                        }

                        <!-- small footer row for social / contact icons -->
                        <!-- Footer with icons -->
                        <div class="footer-icons d-flex justify-content-center align-items-center ltr flex-wrap gap-3 mt-4"
                             style="font-size:16px;padding-top: 97px;">

                            <!-- Landline -->
                            <div class="d-flex align-items-center gap-1">
                                <span>09-2220191</span>
                                <i class="bi bi-telephone text-warning"></i>
                            </div>

                            <!-- Phone -->
                            <div class="d-flex align-items-center gap-1">
                                <span>050-1965658</span>
                                <i class="bi bi-telephone-fill text-primary"></i>
                            </div>

                            <!-- WhatsApp -->
                            <div class="d-flex align-items-center gap-1">
                                <span>fujsc</span>
                                <i class="bi bi-whatsapp text-success"></i>
                            </div>

                            <!-- Twitter -->
                            <div class="d-flex align-items-center gap-1">
                                <span>fujsc</span>
                                <i class="bi bi-twitter text-danger"></i>
                            </div>

                            <!-- Instagram -->
                            <div class="d-flex align-items-center gap-1">
                                <span>fuj.sc</span>
                                <i class="bi bi-instagram text-danger"></i>
                            </div>

                            <!-- Facebook -->
                            <div class="d-flex align-items-center gap-1">
                                <span>fujsc</span>
                                <i class="bi bi-facebook text-primary"></i>
                            </div>

                            <!-- YouTube -->
                            <div class="d-flex align-items-center gap-1">
                                <span>fujsc</span>
                                <i class="bi bi-youtube text-danger"></i>
                            </div>

                            <!-- Website -->
                            <div class="d-flex align-items-center gap-1">
                                <span>
                                    <a href="http://www.fujsc.ae/" target="_blank"
                                       style="cursor:pointer;">www.fujsc.ae</a>
                                </span>
                                <i class="bi bi-globe2 text-warning"></i>
                            </div>


                            <!-- Serial Left -->
                            <div class="serial">
                                @certificateSerial
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>



        <!-- Optionally include Bootstrap JS (not needed for layout only) -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        <script>

            // This Part Is Important
            window.addEventListener('load', () => {
                setTimeout(() => document.getElementById('loadingOverlay').style.display = 'none', 500);
                setTimeout(() => window.print(), 800);
            });

            window.onafterprint = () => {
                window.history.back();
            };
        </script>
    </div>
</body>

</html>