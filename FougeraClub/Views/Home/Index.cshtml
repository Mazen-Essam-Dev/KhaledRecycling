@{
    Layout = null;
    ViewData["Title"] = "Green Life";

    var loginUrl = Url.Page("/Account/Login", new { area = "Identity" }) ?? "/Identity/Account/Login";
    var registerUrl = Url.Action("Register", "Auth");
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Green Life منصة لإعادة تدوير المخلفات وجمع الموارد وإعادة استخدامها بشكل آمن." />
    <title>@ViewData["Title"] | حياة نظيفة ونقية للجميع</title>
    <link rel="shortcut icon" href="~/assets/images/logo_only.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet" />
    <link href="~/css/landing.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <svg class="icon-sprite" aria-hidden="true">
        <symbol id="gl-recycle" viewBox="0 0 24 24">
            <path d="M7.5 19h9.2a3.4 3.4 0 0 0 2.9-5.1l-1.1-1.9" />
            <path d="m16.4 15.7 3.5-1 1 3.5" />
            <path d="M7.8 5.3 3.3 13a3.4 3.4 0 0 0 2.9 5.1H9" />
            <path d="m7.2 10.2-1-3.5-3.5 1" />
            <path d="M10 4.2h.4a3.4 3.4 0 0 1 2.9 1.7l2.2 3.8" />
            <path d="m12.7 4.4 2.6 2.5 2.5-2.6" />
        </symbol>
        <symbol id="gl-truck" viewBox="0 0 24 24">
            <path d="M3 7h11v9H3z" />
            <path d="M14 10h3.8l3.2 3.3V16h-7z" />
            <path d="M6.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
            <path d="M17.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
        </symbol>
        <symbol id="gl-shield" viewBox="0 0 24 24">
            <path d="M12 3 20 6v5.5c0 5-3.4 7.9-8 9.5-4.6-1.6-8-4.5-8-9.5V6z" />
            <path d="m8.5 12 2.2 2.2 4.8-5" />
        </symbol>
        <symbol id="gl-coins" viewBox="0 0 24 24">
            <ellipse cx="8" cy="7" rx="5" ry="3" />
            <path d="M3 7v4c0 1.7 2.2 3 5 3s5-1.3 5-3V7" />
            <path d="M8 14v3c0 1.7 2.2 3 5 3s5-1.3 5-3v-4" />
            <path d="M13 10c2.8 0 5 1.3 5 3s-2.2 3-5 3" />
        </symbol>
        <symbol id="gl-bag" viewBox="0 0 24 24">
            <path d="M6 8h12l1 12H5z" />
            <path d="M9 8a3 3 0 0 1 6 0" />
        </symbol>
        <symbol id="gl-user-gear" viewBox="0 0 24 24">
            <circle cx="9" cy="7" r="3" />
            <path d="M3.5 20a5.7 5.7 0 0 1 9.6-4.1" />
            <circle cx="17" cy="17" r="2.2" />
            <path d="M17 12.8v1.1M17 20.1v1.1M12.8 17h1.1M20.1 17h1.1M14 14l.8.8M19.2 19.2l.8.8M20 14l-.8.8M14.8 19.2l-.8.8" />
        </symbol>
        <symbol id="gl-megaphone" viewBox="0 0 24 24">
            <path d="M4 13h3l9 4V5L7 9H4z" />
            <path d="m7 13 1 6h3" />
            <path d="M19 9.5a3 3 0 0 1 0 3" />
        </symbol>
        <symbol id="gl-hand-heart" viewBox="0 0 24 24">
            <path d="M4 14.5 8.5 17H13l5.5-3a2 2 0 0 1 2.5.6 2 2 0 0 1-.7 2.8L14 21H8l-4-2.2z" />
            <path d="M12 12.5 8.9 9.4a2.2 2.2 0 0 1 3.1-3.1 2.2 2.2 0 0 1 3.1 3.1z" />
        </symbol>
        <symbol id="gl-box" viewBox="0 0 24 24">
            <path d="m3 7.5 9-4.5 9 4.5-9 4.5z" />
            <path d="M3 7.5v9l9 4.5 9-4.5v-9" />
            <path d="M12 12v9" />
        </symbol>
        <symbol id="gl-seedling" viewBox="0 0 24 24">
            <path d="M12 21V10" />
            <path d="M12 10c-4.5 0-7-2.4-8-7 4.6.4 7 2.8 8 7Z" />
            <path d="M12 13c4.5 0 7-2.4 8-7-4.6.4-7 2.8-8 7Z" />
        </symbol>
    </svg>

    <header class="landing-navbar">
        <div class="landing-container nav-content">
            <a class="brand" href="#top" aria-label="Green Life">
                <span class="brand-mark">
                    <img src="~/assets/images/logo_only.png" alt="" />
                </span>
                <span>
                    <strong>Green Life</strong>
                    <small>حياة أنضف للجميع</small>
                </span>
            </a>

            <nav class="nav-links" aria-label="روابط الصفحة">
                <a href="#top">الرئيسية</a>
                <a href="#about">عن جرين لايف</a>
                <a href="#how">ازاي بنشتغل</a>
                <a href="#features">المميزات</a>
                <a href="#contact">تواصل معنا</a>
            </nav>

            <div class="nav-actions">
                <a class="btn btn-ghost" href="@loginUrl">تسجيل الدخول</a>
                @if (!string.IsNullOrWhiteSpace(registerUrl))
                {
                    <a class="btn btn-primary" href="@registerUrl">انضم إلينا</a>
                }
            </div>
        </div>
    </header>

    <main id="top">
        <section class="hero-section">
            <div class="landing-container hero-grid">
                <div class="hero-copy reveal reveal-right">
                    <span class="eyebrow">
                        <svg class="gl-icon" aria-hidden="true"><use href="#gl-recycle"></use></svg>
                        إعادة تدوير آمنة وذكية
                    </span>
                    <h1>
                        <span>Green Life</span>
                        حياة نظيفة ونقية للجميع
                    </h1>
                    <p class="hero-subtitle">
                        حياة مليانة صحة وسعادة للكل من خلال إعادة تدوير المخلفات.
                    </p>
                    <p class="hero-description">
                        في جرين لايف بنهتم بكل تفاصيل التوعية بأهمية إعادة تدوير الموارد، وإنتاج منتجات جديدة آمنة وصالحة للاستخدام، مع التخلص من باقي المخلفات بشكل صحي يحافظ على البيئة.
                    </p>
                    <div class="hero-actions">
                        <a class="btn btn-primary btn-large" href="@loginUrl">تسجيل الدخول</a>
                        <a class="btn btn-secondary btn-large" href="#about">اعرف أكتر</a>
                    </div>
                </div>

                <div class="hero-visual reveal reveal-left" aria-hidden="true">
                    <div class="eco-panel">
                    <div class="eco-icon">
                            <svg class="gl-icon" aria-hidden="true"><use href="#gl-recycle"></use></svg>
                    </div>
                        <h2>دورة موارد أنضف</h2>
                        <p>جمع من باب البيت، تدوير آمن، وكوينز تقدر تستخدمها في منتجات صالحة للاستخدام.</p>
                        <div class="eco-stats">
                            <span><strong>01</strong>تسجيل</span>
                            <span><strong>02</strong>استلام</span>
                            <span><strong>03</strong>مكافآت</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" id="about">
            <div class="landing-container">
                <div class="section-heading reveal reveal-up">
                    <span class="section-kicker">عن جرين لايف</span>
                    <h2>منصة تساعدك تحول الموارد القابلة لإعادة الاستخدام لقيمة حقيقية</h2>
                    <p>
                        بمجرد ما تسجل معانا، بيتواصل معاك أحد أفراد الفريق يعرفك أكتر على نشاطنا، وبعدها بيجي مندوب لحد باب البيت يستلم الموارد، وتقدر من خلال مشاركتك تجمع كوينز تشتري بيها منتجات آمنة وصالحة للاستخدام.
                    </p>
                </div>

                <div class="service-grid">
                    <article class="service-card reveal reveal-up">
                        <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-truck"></use></svg></span>
                        <h3>نجمع الموارد من باب بيتك</h3>
                        <p>مندوب متخصص يوصل لك في الموعد المناسب لاستلام الموارد بطريقة منظمة ومريحة.</p>
                    </article>
                    <article class="service-card reveal reveal-up">
                        <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-shield"></use></svg></span>
                        <h3>نعيد تدوير المخلفات بشكل آمن</h3>
                        <p>نتعامل مع المخلفات وفق خطوات صحية تقلل الضرر وتحافظ على البيئة.</p>
                    </article>
                    <article class="service-card reveal reveal-up">
                        <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-coins"></use></svg></span>
                        <h3>تجمع كوينز من مشاركتك</h3>
                        <p>كل مشاركة مؤثرة تتحول لرصيد كوينز يدعم رحلتك مع Green Life.</p>
                    </article>
                    <article class="service-card reveal reveal-up">
                        <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-bag"></use></svg></span>
                        <h3>تشتري منتجات صالحة للاستخدام</h3>
                        <p>استخدم الكوينز في الحصول على منتجات جديدة آمنة وعملية من خلالنا.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="section section-soft" id="how">
            <div class="landing-container">
                <div class="section-heading reveal reveal-up">
                    <span class="section-kicker">ازاي بنشتغل</span>
                    <h2>خطوات بسيطة من التسجيل لحد الاستفادة</h2>
                </div>

                <div class="steps">
                    <div class="step reveal reveal-right"><span>1</span><p>سجّل معانا</p></div>
                    <div class="step reveal reveal-right"><span>2</span><p>فريقنا يتواصل معاك</p></div>
                    <div class="step reveal reveal-right"><span>3</span><p>المندوب يستلم الموارد من باب البيت</p></div>
                    <div class="step reveal reveal-right"><span>4</span><p>تجمع كوينز</p></div>
                    <div class="step reveal reveal-right"><span>5</span><p>تستخدم الكوينز في شراء منتجات آمنة وصالحة</p></div>
                </div>
            </div>
        </section>

        <section class="section" id="features">
            <div class="landing-container feature-layout">
                <div class="section-heading align-start reveal reveal-right">
                    <span class="section-kicker">ليه Green Life؟</span>
                    <h2>كل تفصيلة بتتم من خلال خبراء وفنيين على دراية كاملة بكل الجوانب</h2>
                    <p>
                        هدفنا إن إعادة التدوير تكون تجربة سهلة، موثوقة، ومفيدة للبيئة والمجتمع.
                    </p>
                </div>

                <div class="feature-list">
                    <div class="feature-item reveal reveal-left"><svg class="gl-icon" aria-hidden="true"><use href="#gl-user-gear"></use></svg><span>خبراء وفنيين متخصصين</span></div>
                    <div class="feature-item reveal reveal-left"><svg class="gl-icon" aria-hidden="true"><use href="#gl-megaphone"></use></svg><span>توعية بأهمية إعادة التدوير</span></div>
                    <div class="feature-item reveal reveal-left"><svg class="gl-icon" aria-hidden="true"><use href="#gl-hand-heart"></use></svg><span>تخلص صحي وآمن من المخلفات</span></div>
                    <div class="feature-item reveal reveal-left"><svg class="gl-icon" aria-hidden="true"><use href="#gl-box"></use></svg><span>منتجات جديدة آمنة وصالحة للاستخدام</span></div>
                    <div class="feature-item reveal reveal-left"><svg class="gl-icon" aria-hidden="true"><use href="#gl-seedling"></use></svg><span>مساهمة حقيقية في حماية البيئة</span></div>
                </div>
                <div class="why-extra reveal reveal-up">
    <div class="section-heading">
        <span class="section-kicker">ما يميزنا؟</span>
        <h2>تجربة عربية سهلة وواضحة لإعادة التدوير من أول خطوة</h2>
        <p>
            في Green Life بنجمع بين سهولة الاستخدام، التوعية، المتابعة، والخبرة الفنية علشان نخلي إعادة التدوير تجربة عملية ومفيدة لكل بيت.
        </p>
    </div>

        <div class="service-grid why-extra-grid">
            <article class="service-card reveal reveal-up">
                <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-user-gear"></use></svg></span>
                <h3>واجهة مستخدم سهلة</h3>
                <p>تجربة بسيطة وواضحة تساعدك تستخدم الموقع وتتابع خدماتك من غير أي تعقيد.</p>
            </article>

            <article class="service-card reveal reveal-up">
                <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-megaphone"></use></svg></span>
                <h3>اللغة العربية</h3>
                <p>الموقع مصمم باللغة العربية علشان يكون قريب وسهل لكل المستخدمين.</p>
            </article>

            <article class="service-card reveal reveal-up">
                <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-seedling"></use></svg></span>
                <h3>دورات تعليمية وتوعية</h3>
                <p>بنقدم محتوى توعوي ودورات تساعد على نشر ثقافة إعادة التدوير والحفاظ على البيئة.</p>
            </article>

            <article class="service-card reveal reveal-up">
                <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-shield"></use></svg></span>
                <h3>كل خطوة متسجلة ومحسوبة</h3>
                <p>كل تفصيلة مهما كانت صغيرة بيتم تسجيلها ومتابعتها من خلال خبراء لضمان الشفافية والدقة.</p>
            </article>

            <article class="service-card reveal reveal-up">
                <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-hand-heart"></use></svg></span>
                <h3>معاينة بواسطة فنيين</h3>
                <p>بيتم معاينة الموارد من خلال فنيين على أعلى مستوى لضمان التعامل الصحيح مع كل مورد.</p>
            </article>

            <article class="service-card reveal reveal-up">
                <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-truck"></use></svg></span>
                <h3>متابعة خط سير الطلب</h3>
                <p>تقدر تتابع طلبك من خلال الموقع من أول التسجيل لحد الاستلام والمعالجة.</p>
            </article>

            <article class="service-card reveal reveal-up">
                <span class="card-icon"><svg class="gl-icon" aria-hidden="true"><use href="#gl-recycle"></use></svg></span>
                <h3>ربط مجتمعي حقيقي</h3>
                <p>بنربط خدماتنا بتطبيقات محلية وحملات مجتمعية على أرض الواقع لتحقيق تأثير بيئي أكبر.</p>
            </article>
        </div>
    </div>
            </div>
        </section>

        <section class="cta-section" id="contact">
            <div class="landing-container">
                <div class="cta-card reveal reveal-up">
                    <span class="section-kicker">ابدأ النهارده</span>
                    <h2>ابدأ رحلتك مع Green Life وساهم في بيئة أنضف وحياة أفضل.</h2>
                    <div class="hero-actions center-actions">
                        <a class="btn btn-primary btn-large" href="@loginUrl">تسجيل الدخول</a>
                        @if (!string.IsNullOrWhiteSpace(registerUrl))
                        {
                            <a class="btn btn-secondary btn-large" href="@registerUrl">انضم الآن</a>
                        }
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="landing-footer">
        <div class="landing-container">
            <span>© 2026 Green Life</span>
            <span>الموقع الرسمي لإعادة التدوير</span>
        </div>
    </footer>

    <script src="~/js/landing.js" asp-append-version="true"></script>
</body>
</html>
